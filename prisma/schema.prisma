}

model PerformanceReviewCriteria {
  id           String            @id @default(cuid())
  reviewId     String
  criteriaName String
  rating       Float
  comments     String?
  weight       Float             @default(1.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceGoal {
  id           String             @id @default(cuid())
  employeeId   String
  tenantId     String
  title        String
  description  String?
  category     String?
  targetValue  Float?
  targetUnit   String?
  startDate    DateTime
  targetDate   DateTime
  status       String             @default("active")
  progress     Float              @default(0)
  currentValue Float?
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reviewId     String?
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  review       PerformanceReview? @relation(fields: [reviewId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                  String   @id @default(cuid())
  employeeId          String
  feedbackGiverId     String
  tenantId            String
  feedbackType        String   @default("peer")
  reviewId            String?
  rating              Float?
  strengths           String?
  areasForImprovement String?
  suggestions         String?
  isAnonymous         Boolean  @default(false)
  status              String   @default("submitted")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  employee            Employee @relation("FeedbackReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbackGiver       Employee @relation("FeedbackGiven", fields: [feedbackGiverId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([feedbackGiverId])
  @@index([feedbackType])
  @@index([createdAt])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  assets      Asset[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                      String                 @id @default(cuid())
  name                    String
  description             String?
  categoryId              String
  purchaseDate            DateTime
  originalCost            Float
  usefulLifeYears         Int
  depreciationMethod      String                 @default("straight_line")
  status                  String                 @default("active")
  location                String?
  serialNumber            String?
  supplier                String?
  warrantyExpiry          DateTime?
  notes                   String?
  isExistingAsset         Boolean                @default(false)
  accumulatedDepreciation Float                  @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenantId                String
  createdById             String
  category                AssetCategory          @relation(fields: [categoryId], references: [id])
  createdBy               User                   @relation("AssetCreatedBy", fields: [createdById], references: [id])
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntries          AssetJournalEntry[]
  depreciationSchedules   DepreciationSchedule[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([purchaseDate])
}

model DepreciationSchedule {
  id                      String   @id @default(cuid())
  assetId                 String
  periodStart             DateTime
  periodEnd               DateTime
  depreciationAmount      Float
  accumulatedDepreciation Float
  netBookValue            Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodStart])
}

model AssetJournalEntry {
  id          String   @id @default(cuid())
  assetId     String
  entryType   String   @default("purchase")
  amount      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entryType])
}

model LiabilityCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenantId    String
  liabilities Liability[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ExpenseCategory {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  accountId           String              @unique
  accountCode         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenantId            String
  expenses            Expense[]
  purchaseOrderItems  PurchaseOrderItem[]
  account             Account             @relation("ExpenseCategoryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountId])
}

model Liability {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  categoryId            String
  liabilityType         String
  principalAmount       Float
  interestRate          Float?             @default(0)
  interestType          String             @default("reducing_balance")
  oneTimeInterestAmount Float?             @default(0)
  startDate             DateTime
  maturityDate          DateTime?
  termMonths            Int?
  paymentFrequency      String?
  status                String             @default("active")
  lender                String?
  accountNumber         String?
  notes                 String?
  currentBalance        Float              @default(0)
  totalPaid             Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String
  createdById           String
  category              LiabilityCategory  @relation(fields: [categoryId], references: [id])
  createdBy             User               @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments              LiabilityPayment[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([liabilityType])
}

model LiabilityPayment {
  id            String    @id @default(cuid())
  liabilityId   String
  amount        Float
  paymentDate   DateTime
  paymentType   String    @default("principal")
  principalPaid Float     @default(0)
  interestPaid  Float     @default(0)
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  liability     Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId])
  @@index([paymentDate])
}

model Budget {
  id              String                   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  budgetType      String                   @default("revenue") // revenue, expense
  periodType      String                   @default("annual") // monthly, quarterly, yearly
  startDate       DateTime
  endDate         DateTime
  expectedRevenue Float                    @default(0) // Expected revenue amount for this budget
  status          String                   @default("draft") // draft, active, closed
  version         Int                      @default(1)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  currency        String                   @default("MWK")
  isLocked        Boolean                  @default(false)
  lockedAt        DateTime?
  activatedById   String?
  activatedAt     DateTime?
  approvedBy      User?                    @relation("BudgetApprover", fields: [approvedById], references: [id])
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           BudgetItem[]
  breakdowns      RevenueBudgetBreakdown[]

  @@index([tenantId])
  @@index([budgetType])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
  @@index([isLocked])
}

model RevenueBudgetBreakdown {
  id              String   @id @default(cuid())
  budgetId        String
  breakdownType   String // branch, product_category
  referenceId     String // branchId or categoryId
  referenceName   String // branch name or category name
  budgetedAmount  Float
  actualAmount    Float    @default(0)
  variance        Float?
  variancePercent Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, breakdownType, referenceId])
  @@index([budgetId])
  @@index([breakdownType])
  @@index([referenceId])
}

model BudgetItem {
  id              String   @id @default(cuid())
  budgetId        String
  accountId       String?
  branchId        String?
  categoryId      String?
  period          DateTime
  budgetedAmount  Float
  actualAmount    Float    @default(0)
  variance        Float?
  variancePercent Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        String?
  account         Account? @relation(fields: [accountId], references: [id])
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id])

  @@unique([budgetId, accountId, category, period])
  @@index([budgetId])
  @@index([accountId])
  @@index([category])
  @@index([period])
  @@index([branchId])
  @@index([categoryId])
}

model Currency {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  symbol          String
  isActive        Boolean        @default(true)
  isBase          Boolean        @default(false)
  exchangeRates   ExchangeRate[] @relation("FromCurrency")
  toExchangeRates ExchangeRate[] @relation("ToCurrency")

  @@index([isActive])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  effectiveDate  DateTime
  tenantId       String?
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([tenantId])
}

model StockTransfer {
  id            String    @id @default(cuid())
  tenantId      String
  fromBranchId  String
  toBranchId    String
  productId     String
  quantity      Decimal   @db.Decimal(18, 4)
  status        String    @default("pending") // pending, approved, cancelled
  notes         String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch    Branch    @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch      Branch    @relation("StockTransferTo", fields: [toBranchId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  createdBy     User      @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?     @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([productId])
  @@index([status])
  @@index([createdById])
}
