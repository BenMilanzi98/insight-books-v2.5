/// Period payroll run — authoritative calculation + posting container.
model PayrollRun {
  id                 String                 @id @default(cuid())
  tenantId           String
  runNumber          String?
  periodStart        DateTime
  periodEnd          DateTime
  status             String                 @default("DRAFT")
  version            Int                    @default(1)
  currency           String                 @default("MWK")
  inputSnapshot      Json?
  mappingSnapshot    Json?
  totals             Json?
  checksum           String?
  exceptions         Json?
  recognitionJournalId String?
  paymentBatchId     String?
  replacedRunId      String?
  reversedRunId      String?
  calculatedAt       DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedById       String?
  postedAt           DateTime?
  paidAt             DateTime?
  reversedAt         DateTime?
  createdById        String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
