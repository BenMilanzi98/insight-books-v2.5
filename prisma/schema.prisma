}

model TaxType {
  id                 String              @id @default(cuid())
  taxId              String
  taxName            String
  taxCode            String?
  taxRate            Float
  calculationType    String              @default("Percentage")
  accountId          String
  status             String              @default("Active")
  /// Wave 3 — optional versioning window (null = always effective while Active)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  supersededById     String?
  tenantId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productTaxes       ProductTax[]
  saleItemTaxes      SaleItemTax[]
  invoiceItemTaxes   InvoiceItemTax[]
  quotationItemTaxes QuotationItemTax[]
  purchaseOrderItems PurchaseOrderItem[]
  expenses           Expense[]
  account            Account             @relation("TaxTypeAccount", fields: [accountId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supersededBy       TaxType?            @relation("TaxTypeSupersession", fields: [supersededById], references: [id])
  supersedes         TaxType[]           @relation("TaxTypeSupersession")

  @@unique([tenantId, taxId])
  @@unique([tenantId, taxCode])
  @@index([tenantId])
  @@index([status])
  @@index([accountId])
  @@index([tenantId, effectiveFrom, effectiveTo])
