/// Platform feature entitlement overrides (plan vs tenant). Disabling does not delete tenant data.
model PlatformFeatureEntitlement {
  id          String    @id @default(cuid())
  tenantId    String
  featureCode String
  featureName String?
  source      String    @default("TENANT_OVERRIDE")
  status      String    @default("ACTIVE")
  reason      String?
