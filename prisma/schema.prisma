generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                           String                        @id @default(cuid())
  name                         String
  subdomain                    String                        @unique
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  status                       String                        @default("active")
  subscriptionPlan             String
  logoUrl                      String?
  primaryColor                 String?
  faviconUrl                   String?
  secondaryColor               String?
  defaultBranchId              String?
  defaultBranch                Branch?                       @relation("TenantDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  ownerUserId                  String? // Main tenant user: always has access to all branches
  owner                        User?                         @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  accounts                     Account[]
  AccountBalance               AccountBalance[]
  accountSubscriptions         AccountSubscription[]
  adminAccess                  AdminTenantAccess[]
  customerOwnerships           CustomerOwnership[]
  customerSegmentMemberships   CustomerSegmentMembership[]
  customerSignals              CustomerSignal[]
  customerHealthSnapshots      CustomerHealthSnapshot[]
  csCases                      CsCase[]
  csTasks                      CsTask[]
  csInterventions              CsIntervention[]
  csRenewalWorkspaces          CsRenewalWorkspace[]
  csPlaybookExecutions         CsPlaybookExecution[]
  csSuccessPlans               CsSuccessPlan[]
  csExpansionHandoffs          CsExpansionHandoff[]
  csOnboardingRecords          CsOnboardingRecord[]
  csTrainingRecords            CsTrainingRecord[]
  csSurveyResponses            CsSurveyResponse[]
  supportTickets               SupportTicket[]
  crmAccounts                  CrmAccount[]
  affiliateReferrals           AffiliateReferral[]
  assets                       Asset[]
  assetCategories              AssetCategory[]
  assetTransfersOut            AssetInterBusinessTransfer[]  @relation("AssetTransferFromTenant")
  assetTransfersIn             AssetInterBusinessTransfer[]  @relation("AssetTransferToTenant")
  attendanceRecords            AttendanceRecord[]
  attendanceRegisters          AttendanceRegister[]
  bankAccounts                 BankAccount[]
  branches                     Branch[]
  branchSubscriptions          BranchSubscription[]
  legacyBudgets                LegacyBudget[]
  planningBudgets              Budget[]                      @relation("PlanningBudgetTenant")
  planningForecasts            Forecast[]                    @relation("PlanningForecastTenant")
  forecastAssumptionSets       ForecastAssumptionSet[]
  bfExpenseBudgetHeaders       BfExpenseBudgetHeader[]
  bfRevenueForecastHeaders     BfRevenueForecastHeader[]
  clients                      Client[]
  benefits                     Benefit[]
  deductions                   Deduction[]
  departments                  Department[]
  emailLogs                    EmailLog[]
  employees                    Employee[]
  employmentContracts          EmploymentContract[]
  equityAccounts               EquityAccount[]
  exchangeRates                ExchangeRate[]
  expenses                     Expense[]
  goodsReceipts                GoodsReceipt[]
  gratuityAccounts             GratuityAccount[]
  inventoryBatches             InventoryBatch[]
  inventoryBatchConsumptions   InventoryBatchConsumption[]
  inventoryCategories          InventoryCategory[]
  inventoryLocations           InventoryLocation[]
  inventoryTransactions        InventoryTransaction[]
  invoices                     Invoice[]
  invoiceRefunds               InvoiceRefund[]
  creditNotes                  CreditNote[]
  debitNotes                   DebitNote[]
  invoiceTemplates             InvoiceTemplate[]
  invoiceAttachments           InvoiceAttachment[]
  journalEntries               JournalEntry[]
  leaveBalances                LeaveBalance[]
  leavePolicies                LeavePolicy[]
  leaveRequests                LeaveRequest[]
  liabilities                  Liability[]
  liabilityCategories          LiabilityCategory[]
  expenseCategories            ExpenseCategory[]
  payments                     Payment[]
  paymentGateways              PaymentGateway[]
  paymentAccounts              PaymentAccount[]
  payrolls                     Payroll[]
  payrollRuns                  PayrollRun[]
  payrollPaymentBatches        PayrollPaymentBatch[]
  payrollComponentDefinitions  PayrollComponentDefinition[]
  payrollFormulaTemplates      PayrollFormulaTemplate[]
  pensionRules                 PensionRule[]
  pensionContributions         PensionContribution[]
  pensionRemittances           PensionRemittance[]
  leaveAccrualLedgers          LeaveAccrualLedger[]
  overtimeRequests             OvertimeRequest[]
  disciplinaryCases            DisciplinaryCase[]
  payrollTaxConfigurations     PayrollTaxConfiguration[]
  performanceFeedback          PerformanceFeedback[]
  performanceGoals             PerformanceGoal[]
  performanceReviews           PerformanceReview[]
  productBarcodes              ProductBarcode[]
  products                     Product[]
  purchaseOrders               PurchaseOrder[]
  documentSequences            DocumentSequence[]
  quotations                   Quotation[]
  recurringExpenses            RecurringExpense[]
  roles                        Role[]
  salaryAdvances               SalaryAdvance[]
  sales                        Sale[]                        @relation("TenantSales")
  suppliers                    Supplier[]
  supplierBills                SupplierBill[]
  supplierPayments             SupplierPayment[]
  supplierPaymentAllocations   SupplierPaymentAllocation[]
  taxTypes                     TaxType[]
  taxAccountMappings           TaxAccountMapping[]
  taxTransactions              TaxTransaction[]
  taxPeriods                   TaxPeriod[]
  taxReturns                   TaxReturn[]
  taxPayments                  TaxPayment[]
  taxRefunds                   TaxRefund[]
  taxCredits                   TaxCredit[]
  taxWithholdingRemittances    TaxWithholdingRemittance[]
  settings                     TenantSettings?

  transactions                 Transaction[]
  users                        User[]
  members                      User[]                        @relation("UserTenants")
  memberships                  TenantMembership[]
  accountingPeriods            AccountingPeriod[]
  stockTransfers               StockTransfer[]
  stockTransferReceiptNotices  StockTransferReceiptNotice[]
  inventoryExpiryAudits        InventoryExpiryAudit[]
  stockImportBatches           StockImportBatch[]
  posCashDays                  PosCashDay[]
  tpin                         String?
  eisEnabled                   Boolean                       @default(false)
  eisInvoices                  EISInvoice[]
  eisConfiguration             EISConfiguration?
  eisUsage                     EISUsage[]
  rentalAssets                 RentalAsset[]
  rentalTransactions           RentalTransaction[]
  rentalUnits                  RentalUnit[]
  rentalRatePlans              RentalRatePlan[]
  rentalQuotations             RentalQuotation[]
  rentalReservations           RentalReservation[]
  rentalContracts              RentalContract[]
  rentalDeposits               RentalDeposit[]
  hireRequests                 HireRequest[]
  hireAgreements               HireAgreement[]
  hireSupplierDeposits         HireSupplierDeposit[]
  /// When true, CoA-affecting mutations and postings should be blocked (migration / maintenance).
  coaLocked                    Boolean                       @default(false)
  /// Guide Phase 3: equity auto-merge requires explicit approval per tenant.
  coaEquityMigrationApproved   Boolean                       @default(false)
  coaMigrationLogs             CoaMigrationLog[]
  accountingMappingCorrections AccountingMappingCorrection[]
  transactionReversals         TransactionReversal[]
}


model Branch {
  id                    String                 @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForTenant      Tenant[]               @relation("TenantDefaultBranch")
  branchSubscriptions   BranchSubscription[]
  expenses              Expense[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  payments              Payment[]
  products              Product[]
  sales                 Sale[]
  transactions          Transaction[]
  legacyBudgetItems     LegacyBudgetItem[]
  defaultUsers          User[]                 @relation("UserDefaultBranch")
  userBranches          UserBranch[]
  stockTransfersFrom    StockTransfer[]        @relation("StockTransferFrom")
  stockTransfersTo      StockTransfer[]        @relation("StockTransferTo")
  rentalAssets          RentalAsset[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

/// Per-tenant monotonic counters for PO, goods receipt, invoice, and quotation numeric suffixes.
model DocumentSequence {
  id           String   @id @default(cuid())
  tenantId     String
  documentType String
  lastIssued   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
  @@index([tenantId])
}

model TenantSettings {
  id                               String    @id @default(cuid())
  tenantId                         String    @unique
  taxEnabled                       Boolean   @default(true)
  defaultTaxRate                   Float     @default(17.5)
  currencyCode                     String    @default("MWK")
  /// UI default language for the tenant: en | ny (users may override).
  defaultLanguage                  String    @default("en")
  invoicePrefix                    String    @default("INV")
  invoiceTemplate                  String    @default("default")
  enabledModules                   String[]
  customDomain                     String?
  dailyReports                     Boolean   @default(false)
  emailFooter                      String?
  emailNotifications               Boolean   @default(true)
  inAppNotifications               Boolean   @default(true)
  invoiceReminders                 Boolean   @default(true)
  lowStockAlerts                   Boolean   @default(true)
  monthlyReports                   Boolean   @default(true)
  paymentReceipts                  Boolean   @default(true)
  smsNotifications                 Boolean   @default(false)
  weeklyReports                    Boolean   @default(true)
  buildingName                     String?
  businessAddress                  String?
  businessCity                     String?
  businessEmail                    String?
  businessPhone                    String?
  receiptFooter                    String?
  /// Preferred thermal receipt roll width in mm (58–90). Used by web + Android POS print.
  receiptPaperWidthMm              Int       @default(80)
  defaultBankDetails               String? // Default bank account details for invoice/quotation/receipt footers
  // NPS rates are tenant-configurable; null means "not configured".
  // Calculation code should treat null as 0% unless explicitly set.
  npsEmployeeRatePercent           Float?
  npsEmployerRatePercent           Float?
  balanceReminderSubject           String?
  balanceReminderBody              String?
  taxInflowAccountId               String? // Default account for tax collected (inflow from sales/invoices)
  taxOutflowAccountId              String? // Default account for tax paid (outflow from expenses/supplier bills)
  eisApiKey                        String? // Encrypted MRA EIS API key
  eisClientSecret                  String? // Encrypted MRA EIS client secret
  /// Cumulative owner contributions (not reduced by transfers to payment accounts). New rows default 0; migration seeds existing tenants.
  ownerContributedCapital          Float     @default(0)
  /// Null = owner must complete capital onboarding. Migration sets NOW() for all pre-existing TenantSettings rows.
  capitalSetupCompletedAt          DateTime?
  /// Null = owner must confirm payment accounts. Migration sets NOW() for all pre-existing TenantSettings rows.
  paymentAccountsSetupCompletedAt  DateTime?
  /// 1–12: first month of fiscal year (1 = calendar year). Used for Yearly accounting periods.
  fiscalYearStartMonth             Int       @default(1)
  /// Optional display / reminder; authoritative opening date is on posted Opening transactions.
  openingBalancesAsOfDate          DateTime?
  /// When set and in the future, dashboard setup reminder is hidden.
  setupReminderSnoozedUntil        DateTime?
  /// { completed: Record<stepId, iso>, skipped: Record<stepId, iso> } — see lib/setupWizardService.js
  setupWizardState                 Json?
  /// Payroll GL account mapping — see lib/payrollEngine/accountMappings.js
  payrollAccountMappings           Json?
  /// When true, outbound rental bookings create+post a Customer Invoice immediately.
  /// Prefer false once Contract/billing engine owns recognition. Existing tenants migrated to true.
  rentalPostInvoiceOnBook          Boolean   @default(true)
  /// When true, past-end bookings are auto-completed and availability released (unsafe vs inspection).
  /// Default false — mark overdue only; require explicit complete/return.
  rentalAutoCompleteExpired        Boolean   @default(false)
  /// When false, POST /api/rentals booking create is refused (use Contracts V2).
  rentalLegacyBookingEnabled       Boolean   @default(true)
  /// Days before expiry for "early" alerts; null = use default 30.
  expiryWarnDaysEarly              Int?
  /// Days before expiry for "urgent" alerts; null = use default 7.
  expiryWarnDaysUrgent             Int?
  /// Optional GL for inventory write-off loss; null = auto-resolve "Inventory Adjustment Loss".
  inventoryAdjustmentLossAccountId String?
  /// When true, document reversals require a separate approver before execute (Wave 6 SoD).
  reversalRequireSeparateApprover  Boolean   @default(true)
  tenant                           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}


model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Role {
  id          String             @id @default(cuid())
  name        String
  description String
  permissions Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  users       User[]
  memberships TenantMembership[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model User {
  id                              String                       @id @default(cuid())
  /// Unique per tenant; same address may exist for users in different businesses (SaaS).
  email                           String
  name                            String?
  password                        String                       @db.VarChar(255)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  tenantId                        String?
  lastLogin                       DateTime?
  isActive                        Boolean                      @default(true)
  mfaEnabled                      Boolean                      @default(false)
  isEmailVerified                 Boolean                      @default(false)
  otpCode                         String?
  otpExpiry                       DateTime?
  department                      String?
  phone                           String?
  roleId                          String
  status                          String                       @default("active")
  authProvider                    String?
  authProviderId                  String?
  profilePicture                  String?
  resetToken                      String?
  resetTokenExpiry                DateTime?
  defaultBranchId                 String?
  /// Preferred UI language: en | ny. Null = resolve via tenant/cookie/browser.
  preferredLanguage               String?
  adminActivityLogs               AdminActivityLog[]           @relation("AdminActivityLog")
  affiliateReferrals              AffiliateReferral[]
  createdAssets                   Asset[]                      @relation("AssetCreatedBy")
  assetInterBusinessTransfers     AssetInterBusinessTransfer[] @relation("AssetInterBusinessTransferBy")
  attendanceRegistersFinalized    AttendanceRegister[]
  auditLogs                       AuditLog[]
  approvedLegacyBudgets           LegacyBudget[]               @relation("LegacyBudgetApprover")
  createdPlanningBudgets          Budget[]                     @relation("PlanningBudgetCreatedBy")
  approvedPlanningBudgets         Budget[]                     @relation("PlanningBudgetApprovedBy")
  lockedPlanningBudgets           Budget[]                     @relation("PlanningBudgetLockedBy")
  createdPlanningForecasts        Forecast[]                   @relation("PlanningForecastCreatedBy")
  approvedPlanningForecasts       Forecast[]                   @relation("PlanningForecastApprovedBy")
  budgetApprovalsRequested        BudgetApproval[]             @relation("BudgetApprovalRequester")
  budgetApprovalsDecided          BudgetApproval[]             @relation("BudgetApprovalApprover")
  budgetVersionsCreated           BudgetVersion[]              @relation("BudgetVersionCreatedBy")
  budgetVersionsApproved          BudgetVersion[]              @relation("BudgetVersionApprovedBy")
  forecastAssumptionSetsCreated   ForecastAssumptionSet[]      @relation("ForecastAssumptionSetCreatedBy")
  sentEmails                      EmailLog[]                   @relation("EmailLogSender")
  deletedExpenses                 Expense[]                    @relation("ExpenseDeletedBy")
  expenseSubmissions              Expense[]
  uploadedAttachments             ExpenseAttachment[]          @relation("UploadedAttachments")
  invoiceAttachments              InvoiceAttachment[]          @relation("InvoiceAttachmentUploader")
  goodsReceiptsReceived           GoodsReceipt[]               @relation("GoodsReceiptReceiver")
  inventoryTransactions           InventoryTransaction[]
  createdInvoices                 Invoice[]                    @relation("InvoiceCreator")
  deletedInvoices                 Invoice[]                    @relation("InvoiceDeletedBy")
  refundedInvoices                Invoice[]                    @relation("InvoiceRefundedBy")
  voidedInvoices                  Invoice[]                    @relation("InvoiceVoidedBy")
  processedRefunds                InvoiceRefund[]              @relation("InvoiceRefundedBy")
  createdJournalEntries           JournalEntry[]               @relation("JournalEntryCreatedBy")
  postedJournalEntries            JournalEntry[]               @relation("JournalEntryPostedBy")
  leaveRequestsReviewed           LeaveRequest[]
  createdLiabilities              Liability[]                  @relation("LiabilityCreatedBy")
  performanceReviewsAcknowledged  PerformanceReview[]          @relation("ReviewAcknowledgedBy")
  performanceReviewsConducted     PerformanceReview[]
  deletedProducts                 Product[]                    @relation("ProductDeletions")
  purchaseOrdersApproved          PurchaseOrder[]              @relation("PurchaseOrderApprover")
  purchaseOrdersCreated           PurchaseOrder[]              @relation("PurchaseOrderCreator")
  createdQuotations               Quotation[]                  @relation("QuotationCreator")
  recurringExpenses               RecurringExpense[]
  createdSales                    Sale[]                       @relation("SaleCreations")
  refundedSales                   Sale[]                       @relation("SaleRefunds")
  voidedSales                     Sale[]                       @relation("SaleVoids")
  supplierBillsApproved           SupplierBill[]               @relation("SupplierBillApprover")
  supplierBillsCreated            SupplierBill[]               @relation("SupplierBillCreator")
  supplierBillsFinalized          SupplierBill[]               @relation("SupplierBillFinalizedBy")
  supplierPaymentsCreated         SupplierPayment[]
  createdTransactions             Transaction[]                @relation("TransactionCreatedBy")
  postedTransactions              Transaction[]                @relation("TransactionPostedBy")
  creditNotesCreated              CreditNote[]                 @relation("CreditNoteCreatedBy")
  creditNotesPosted               CreditNote[]                 @relation("CreditNotePostedBy")
  debitNotesCreated               DebitNote[]                  @relation("DebitNoteCreatedBy")
  debitNotesPosted                DebitNote[]                  @relation("DebitNotePostedBy")
  closedAccountingPeriods         AccountingPeriod[]           @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods       AccountingPeriod[]           @relation("AccountingPeriodReopenedBy")
  stockTransfersCreated           StockTransfer[]              @relation("StockTransferCreatedBy")
  stockTransfersApproved          StockTransfer[]              @relation("StockTransferApprovedBy")
  stockTransfersReceived          StockTransfer[]              @relation("StockTransferReceivedBy")
  stockTransfersRejected          StockTransfer[]              @relation("StockTransferRejectedBy")
  inventoryExpiryAudits           InventoryExpiryAudit[]
  stockImportBatchesCreated       StockImportBatch[]           @relation("StockImportBatchCreatedBy")
  defaultBranch                   Branch?                      @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  userBranches                    UserBranch[]
  role                            Role                         @relation(fields: [roleId], references: [id])
  tenant                          Tenant?                      @relation(fields: [tenantId], references: [id])
  tenants                         Tenant[]                     @relation("UserTenants")
  ownedTenants                    Tenant[]                     @relation("TenantOwner")
  memberships                     TenantMembership[]
  posCashDaysOpened               PosCashDay[]                 @relation("PosCashDayOpenedBy")
  posCashDaysClosed               PosCashDay[]                 @relation("PosCashDayClosedBy")
  posCashDayDepositsCreated       PosCashDayDeposit[]          @relation("PosCashDayDepositCreatedBy")
  rentalTransactionsCreated       RentalTransaction[]          @relation("RentalTransactionCreatedBy")
  createdBfExpenseBudgetHeaders   BfExpenseBudgetHeader[]      @relation("BfExpenseBudgetHeaderCreatedBy")
  createdBfRevenueForecastHeaders BfRevenueForecastHeader[]    @relation("BfRevenueForecastHeaderCreatedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([authProvider, authProviderId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  periodType   String // Monthly | Yearly
  startDate    DateTime
  endDate      DateTime
  status       String    @default("open") // open | closed
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closedBy   User?  @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy User?  @relation("AccountingPeriodReopenedBy", fields: [reopenedById], references: [id])

  @@unique([tenantId, periodType, startDate])
  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([status])
}

// Legacy table backing the ReversalSummary view (kept to avoid accidental drops)
model ReversalAudit {
  id String @id

  @@map("ReversalAudit")
  @@ignore
}

/// Canonical reversal register (Wave 2). Operational docs keep isReversal flags; GL stays on V2 journals.
model TransactionReversal {
  id                     String    @id @default(cuid())
  tenantId               String
  sourceType             String
  sourceId               String
  status                 String    @default("REQUESTED")
  reason                 String
  requestedById          String?
  approvedById           String?
  executedById           String?
  requestedAt            DateTime  @default(now())
  approvedAt             DateTime?
  executedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  periodPolicy           String    @default("REVERSE_IN_CURRENT_OPEN_PERIOD")
  crossPeriodDisclosure  Boolean   @default(false)
  originalDocumentDate   DateTime?
  postingDate            DateTime?
  reversalDocumentId     String?
  originalJournalEntryId String?
  reversalJournalEntryId String?
  idempotencyKey         String?
  impactSnapshot         Json?
  errorCode              String?
  errorMessage           String?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("transaction_reversal")
}


model Admin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  password       String              @db.VarChar(255)
  role           String              @default("Super Admin")
  permissions    Json                @default("{}")
  isActive       Boolean             @default(true)
  lastLogin      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  profilePicture String?
  phone          String?
  department     String?
  notes          String?
  adminAuditLogs              AdminAuditLog[]
  managedTenants              AdminTenantAccess[]
  emailLogs                   EmailLog[]               @relation("EmailLogAdminSender")
  ownedCustomerPortfolios     CustomerPortfolio[]      @relation("PortfolioOwner")
  customerOwnerships          CustomerOwnership[]      @relation("OwnershipOwner")
  assignedCustomerOwnerships  CustomerOwnership[]      @relation("OwnershipAssignedBy")
  csCasesOpened               CsCase[]                 @relation("CsCaseOpenedBy")
  csCasesOwned                CsCase[]                 @relation("CsCaseOwner")
  csTasksAssigned             CsTask[]                 @relation("CsTaskAssignee")
  csTasksCreated              CsTask[]                 @relation("CsTaskCreatedBy")
  csInterventionsPerformed    CsIntervention[]         @relation("CsInterventionPerformedBy")
  csRenewalsOpened            CsRenewalWorkspace[]     @relation("CsRenewalOpenedBy")
  csRenewalsOutcomeBy         CsRenewalWorkspace[]     @relation("CsRenewalOutcomeBy")
  csPlaybookExecutionsStarted CsPlaybookExecution[]    @relation("CsPlaybookExecutionStartedBy")
  csSuccessPlansOwned         CsSuccessPlan[]          @relation("CsSuccessPlanOwner")
  csSuccessPlansCreated       CsSuccessPlan[]          @relation("CsSuccessPlanCreatedBy")
  csExpansionHandoffsCreated  CsExpansionHandoff[]     @relation("CsExpansionHandoffCreatedBy")
  supportTicketsCreated       SupportTicket[]          @relation("SupportTicketCreatedBy")
  supportTicketsAssigned      SupportTicket[]          @relation("SupportTicketAssignee")
  supportTicketStatusChanges  SupportTicketStatusHistory[] @relation("SupportTicketStatusChangedBy")
  supportMessagesAuthored     SupportMessage[]         @relation("SupportMessageAuthor")
  supportAttachmentsUploaded  SupportAttachment[]      @relation("SupportAttachmentUploadedBy")
  supportAssignmentChanges    SupportAssignmentHistory[] @relation("SupportAssignmentChangedBy")
  supportTeamMemberships      SupportTeamMembership[]
  supportSlaPoliciesCreated   SupportSlaPolicy[]       @relation("SupportSlaPolicyCreatedBy")
  supportSlaCalendarsCreated  SupportSlaCalendar[]     @relation("SupportSlaCalendarCreatedBy")
  supportHandoffsCreated      SupportHandoff[]         @relation("SupportHandoffCreatedBy")
  supportReconciliationRuns   SupportReconciliationRun[] @relation("SupportReconciliationRunBy")
  supportExportAudits         SupportExportAudit[]     @relation("SupportExportAuditBy")
  crmAccountsOwned            CrmAccount[]             @relation("CrmAccountOwner")
  crmContactsOwned            CrmContact[]             @relation("CrmContactOwner")
  crmLeadsOwned               CrmLead[]                @relation("CrmLeadOwner")
  crmLeadsCreated             CrmLead[]                @relation("CrmLeadCreatedBy")
  crmLeadStatusChanges        CrmLeadStatusHistory[]   @relation("CrmLeadStatusChangedBy")
  crmDuplicateReviews         CrmDuplicateCandidate[]  @relation("CrmDuplicateReviewedBy")
  crmQualificationResponses   CrmQualificationResponse[] @relation("CrmQualificationAnsweredBy")
  crmQualificationVersions    CrmQualificationDefinitionVersion[] @relation("CrmQualificationVersionCreatedBy")
  crmScoreEvaluations         CrmScoreEvaluation[]     @relation("CrmScoreEvaluationCreatedBy")
  crmScoreVersions            CrmScoreDefinitionVersion[] @relation("CrmScoreVersionCreatedBy")
  crmSalesTeamMemberships     CrmSalesTeamMember[]
  crmAssignmentChanges        CrmAssignmentHistory[]   @relation("CrmAssignmentChangedBy")
  crmConsentRecords           CrmConsentRecord[]       @relation("CrmConsentCreatedBy")
  crmDoNotContactSets         CrmDoNotContact[]        @relation("CrmDncSetBy")
  crmTimelineEvents           CrmTimelineEvent[]       @relation("CrmTimelineActor")
  crmNotesAuthored            CrmNote[]                @relation("CrmNoteAuthor")
