  planVersion             CrmConversionPlanVersion? @relation(fields: [conversionPlanVersionId], references: [id], onDelete: SetNull)
  statusHistory           CrmConversionStatusHistory[]
  steps                   CrmConversionStep[]
  attempts                CrmConversionAttempt[]
  failures                CrmConversionFailure[]
  matchDecisions          CrmConversionMatchDecision[]
  resources               CrmConversionResource[]
  invitations             CrmConversionInvitation[]

  @@index([conversionRequestId, status])
  @@index([opportunityId])
  @@index([acceptanceId])
  @@index([inputHash])
  @@index([status, createdAt])
