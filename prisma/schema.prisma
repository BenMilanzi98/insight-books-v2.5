generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                         String                      @id @default(cuid())
  name                       String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  faviconUrl                 String?
  logoUrl                    String?
  primaryColor               String?
  secondaryColor             String?
  status                     String                      @default("active")
  subdomain                  String                      @unique
  subscriptionPlan           String
  AccountBalance             AccountBalance[]
  accountSubscriptions       AccountSubscription[]
  adminAccess                AdminTenantAccess[]
  affiliateReferrals         AffiliateReferral[]
  clients                    Client[]
  deductions                 Deduction[]
  departments                Department[]
  emailLogs                  EmailLog[]
  employees                  Employee[]
  expenses                   Expense[]
  inventoryCategories        InventoryCategory[]
  inventoryLocations         InventoryLocation[]
  inventoryBatches           InventoryBatch[]
  inventoryBatchConsumptions InventoryBatchConsumption[]
  inventoryTransactions      InventoryTransaction[]
  invoices                   Invoice[]
  invoiceRefunds             InvoiceRefund[]
  invoiceTemplates           InvoiceTemplate[]
  payments                   Payment[]
  paymentGateways            PaymentGateway[]
  products                   Product[]
  quotations                 Quotation[]
  recurringExpenses          RecurringExpense[]
  roles                      Role[]
  sales                      Sale[]                      @relation("TenantSales")
  settings                   TenantSettings?
  transactions               Transaction[]
  users                      User[]
  members                    User[]                      @relation("UserTenants")
  attendanceRecords          AttendanceRecord[]
  attendanceRegisters        AttendanceRegister[]
  assetCategories            AssetCategory[]
  assets                     Asset[]
  liabilityCategories        LiabilityCategory[]
  liabilities                Liability[]
  payrolls                   Payroll[]
  accounts                   Account[]
  journalEntries             JournalEntry[]
  suppliers                  Supplier[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  leavePolicies              LeavePolicy[]
  leaveRequests              LeaveRequest[]
  leaveBalances              LeaveBalance[]
  performanceReviews         PerformanceReview[]
  performanceGoals           PerformanceGoal[]
  performanceFeedback        PerformanceFeedback[]
  budgets                    Budget[]
  exchangeRates              ExchangeRate[]
  supplierBills              SupplierBill[]
  supplierPayments           SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  bankAccounts               BankAccount[]
  equityAccounts             EquityAccount[]
  gratuityAccounts           GratuityAccount[]
  salaryAdvances             SalaryAdvance[]
  branches                   Branch[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  invoices     Invoice[]
  expenses     Expense[]
  payments     Payment[]
  transactions Transaction[]
  journalEntries JournalEntry[]
  defaultUsers User[]        @relation("UserDefaultBranch")
  products     Product[]
  inventoryTransactions InventoryTransaction[]
  inventoryBatches       InventoryBatch[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model TenantSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  taxEnabled         Boolean  @default(true)
  defaultTaxRate     Float    @default(0)
  currencyCode       String   @default("MWK")
  invoicePrefix      String   @default("INV")
  invoiceTemplate    String   @default("default")
  enabledModules     String[]
  emailFooter        String?
  customDomain       String?
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  inAppNotifications Boolean  @default(true)
  dailyReports       Boolean  @default(false)
  weeklyReports      Boolean  @default(true)
  monthlyReports     Boolean  @default(true)
  invoiceReminders   Boolean  @default(true)
  lowStockAlerts     Boolean  @default(true)
  paymentReceipts    Boolean  @default(true)
  npsEmployeeRatePercent Float @default(5) // NPS employee contribution rate (%)
  npsEmployerRatePercent Float @default(5) // NPS employer contribution rate (%)
  buildingName       String?
  businessAddress    String?
  businessCity       String?
  businessEmail      String?
  businessPhone      String?
  receiptFooter      String?
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model User {
  id                           String                 @id @default(cuid())
  email                        String                 @unique
  name                         String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  tenantId                     String?
  defaultBranchId              String?
  authProvider                 String?
  authProviderId               String?
  department                   String?
  isActive                     Boolean                @default(true)
  isEmailVerified              Boolean                @default(false)
  lastLogin                    DateTime?
  mfaEnabled                   Boolean                @default(false)
  otpCode                      String?
  otpExpiry                    DateTime?
  password                     String                 @db.VarChar(255)
  phone                        String?
  profilePicture               String?
  resetToken                   String?
  resetTokenExpiry             DateTime?
  roleId                       String
  status                       String                 @default("active")
  adminActivityLogs            AdminActivityLog[]     @relation("AdminActivityLog")
  affiliateReferrals           AffiliateReferral[]
  auditLogs                    AuditLog[]
  sentEmails                   EmailLog[]             @relation("EmailLogSender")
  deletedExpenses              Expense[]              @relation("ExpenseDeletedBy")
  expenseSubmissions           Expense[]
  uploadedAttachments          ExpenseAttachment[]    @relation("UploadedAttachments")
  inventoryTransactions        InventoryTransaction[]
  createdInvoices              Invoice[]              @relation("InvoiceCreator")
  refundedInvoices             Invoice[]              @relation("InvoiceRefundedBy")
  voidedInvoices               Invoice[]              @relation("InvoiceVoidedBy")
  processedRefunds             InvoiceRefund[]        @relation("InvoiceRefundedBy")
  deletedProducts              Product[]              @relation("ProductDeletions")
  createdQuotations            Quotation[]            @relation("QuotationCreator")
  recurringExpenses            RecurringExpense[]
  createdSales                 Sale[]                 @relation("SaleCreations")
  refundedSales                Sale[]                 @relation("SaleRefunds")
  voidedSales                  Sale[]                 @relation("SaleVoids")
  purchaseOrdersCreated        PurchaseOrder[]        @relation("PurchaseOrderCreator")
  purchaseOrdersApproved       PurchaseOrder[]        @relation("PurchaseOrderApprover")
  goodsReceiptsReceived        GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  supplierBillsCreated         SupplierBill[]         @relation("SupplierBillCreator")
  supplierBillsApproved        SupplierBill[]         @relation("SupplierBillApprover")
  supplierBillsFinalized       SupplierBill[]         @relation("SupplierBillFinalizedBy")
  supplierPaymentsCreated      SupplierPayment[]
  approvedBudgets              Budget[]               @relation("BudgetApprover")
  role                         Role                   @relation(fields: [roleId], references: [id])
  tenant                       Tenant?                @relation(fields: [tenantId], references: [id])
  tenants                      Tenant[]               @relation("UserTenants")
  attendanceRegistersFinalized AttendanceRegister[]
  createdAssets                Asset[]                @relation("AssetCreatedBy")
  createdLiabilities           Liability[]            @relation("LiabilityCreatedBy")
  createdJournalEntries        JournalEntry[]         @relation("JournalEntryCreatedBy")
  postedJournalEntries         JournalEntry[]         @relation("JournalEntryPostedBy")
  createdTransactions          Transaction[]          @relation("TransactionCreatedBy")
  leaveRequestsReviewed        LeaveRequest[]
  performanceReviewsConducted  PerformanceReview[]
  performanceReviewsAcknowledged PerformanceReview[] @relation("ReviewAcknowledgedBy")
  postedTransactions           Transaction[]          @relation("TransactionPostedBy")
  defaultBranch                Branch?                @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])

  @@index([email])
  @@index([tenantId])
  @@index([authProvider, authProviderId])
}

model Admin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  password       String              @db.VarChar(255)
  role           String              @default("Super Admin")
  permissions    Json                @default("{}")
  isActive       Boolean             @default(true)
  lastLogin      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  profilePicture String?
  phone          String?
  department     String?
  notes          String?
  adminAuditLogs AdminAuditLog[]
  managedTenants AdminTenantAccess[]
  emailLogs      EmailLog[]          @relation("EmailLogAdminSender")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  userAgent  String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

model AdminTenantAccess {
  id          String    @id @default(cuid())
  adminId     String
  tenantId    String
  accessLevel String    @default("full")
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminId, tenantId])
  @@index([adminId])
  @@index([tenantId])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  tenantId   String?
  user       User     @relation(fields: [userId], references: [id])
}

model Client {
  id            String      @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  contactPerson String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  invoices      Invoice[]
  quotations    Quotation[]
  sales         Sale[]
}

model Invoice {
  id                  String          @id @default(cuid())
  invoiceNumber       String
  clientId            String
  createdById         String
  issueDate           DateTime
  dueDate             DateTime
  discount            Float           @default(0)
  subtotal            Float
  taxAmount           Float
  total               Float
  status              String          @default("draft")
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenantId            String
  totalDiscountAmount Float           @default(0)
  totalPaid           Float           @default(0)
  remainingBalance    Float           @default(0)
  lastPaymentDate     DateTime?
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  refundedAt          DateTime?
  refundedById        String?
  refundReason        String?
  refundAmount        Float           @default(0)
  originalTotal       Float           @default(0)
  branchId            String?
  client              Client          @relation(fields: [clientId], references: [id])
  createdBy           User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  refundedBy          User?           @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  voidedBy            User?           @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  refunds             InvoiceRefund[]
  payments            Payment[]

  @@index([branchId])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Float
  unitPrice      Float
  taxRate        Float
  amount         Float
  productId      String?
  discountAmount Float    @default(0)
  discountRate   Float    @default(0)
  netAmount      Float    @default(0)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
}

model InvoiceRefund {
  id              String    @id @default(cuid())
  invoiceId       String
  refundedById    String
  refundAmount    Float
  refundReason    String
  refundMethod    String
  refundDate      DateTime  @default(now())
  notes           String?
  tenantId        String
  status          String    @default("pending")
  processedAt     DateTime?
  transactionId   String?
  processingNotes String?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refundedBy      User      @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([refundedById])
  @@index([tenantId])
  @@index([refundDate])
  @@index([status])
}

model Payment {
  id                 String   @id @default(cuid())
  invoiceId          String?
  saleId             String?
  expenseId          String?
  amount             Float
  paymentDate        DateTime
  paymentMethod      String
  type               String?
  sourceAccount      String?
  destinationAccount String?
  reference          String?
  notes              String?
  status             String   @default("Completed")
  refundedAmount     Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenantId           String
  branchId           String?
  expense            Expense? @relation(fields: [expenseId], references: [id])
  invoice            Invoice? @relation(fields: [invoiceId], references: [id])
  sale               Sale?    @relation(fields: [saleId], references: [id])
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([expenseId])
  @@index([status])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([type])
  @@index([branchId])
}

model AccountBalance {
  id        String   @id @default(cuid())
  tenantId  String
  account   String
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, account])
}

model PaymentGateway {
  id         String  @id @default(cuid())
  name       String
  isActive   Boolean @default(true)
  configData String
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
}

model EmailLog {
  id              String    @id @default(cuid())
  recipientEmail  String
  recipientName   String
  subject         String
  template        String    @default("custom")
  priority        String    @default("normal")
  status          String    @default("pending")
  errorMessage    String?
  sentBy          String?
  sentByAdmin     String?
  tenantId        String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sentByAdminUser Admin?    @relation("EmailLogAdminSender", fields: [sentByAdmin], references: [id])
  sentByUser      User?     @relation("EmailLogSender", fields: [sentBy], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActivityLog", fields: [adminId], references: [id])
}

model Expense {
  id                      String                    @id @default(cuid())
  description             String
  amount                  Float
  date                    DateTime
  category                String
  paymentMethod           String?
  sourceAccountId         String?
  receiptUrl              String?
  submittedById           String
  status                  String
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tenantId                String
  branchId                String?
  merchant                String?
  isHistorical            Boolean                   @default(false)
  historicalDate          DateTime?
  migrationBatch          String?
  originalReference       String?
  isDeleted               Boolean                   @default(false)
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?
  paymentStatus           String                    @default("Fully paid")
  paidAmount              Float?
  paymentReference        String?
  deletedBy               User?                     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  sourceAccount           Account?                  @relation(fields: [sourceAccountId], references: [id])
  submittedBy             User                      @relation(fields: [submittedById], references: [id])
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  branch                  Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  expenseAttachments      ExpenseAttachment[]
  payments                Payment[]
  recurringExpenseHistory RecurringExpenseHistory[]

  @@index([paymentMethod])
  @@index([isDeleted])
  @@index([isHistorical])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isHistorical])
  @@index([paymentStatus])
  @@index([branchId])
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  filename     String
  fileType     String
  fileSize     Int
  filePath     String
  uploadedAt   DateTime @default(now())
  uploadedById String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])
}

model Sale {
  id                  String     @id @default(cuid())
  saleNumber          String
  clientId            String?
  createdById         String
  saleDate            DateTime   @default(now())
  discount            Float      @default(0)
  subtotal            Float
  taxRate             Float      @default(0)
  taxAmount           Float      @default(0)
  total               Float
  status              String     @default("completed")
  notes               String?
  paymentMethod       String     @default("cash")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenantId            String
  branchId            String?
  totalDiscountAmount Float      @default(0)
  refundReason        String?
  refundedAt          DateTime?
  refundedById        String?
  totalTaxAmount      Float      @default(0)
  voidReason          String?
  voidedAt            DateTime?
  voidedById          String?
  isHistorical        Boolean    @default(false)
  historicalDate      DateTime?
  migrationBatch      String?
  originalReference   String?
  payments            Payment[]
  client              Client?    @relation(fields: [clientId], references: [id])
  createdBy           User       @relation("SaleCreations", fields: [createdById], references: [id])
  refundedBy          User?      @relation("SaleRefunds", fields: [refundedById], references: [id])
  tenant              Tenant     @relation("TenantSales", fields: [tenantId], references: [id])
  branch              Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  voidedBy            User?      @relation("SaleVoids", fields: [voidedById], references: [id])
  items               SaleItem[]
  inventoryBatchConsumptions InventoryBatchConsumption[]

  @@index([clientId])
  @@index([tenantId])
  @@index([createdById])
  @@index([status])
  @@index([saleDate])
  @@index([branchId])
  @@index([isHistorical])
  @@index([historicalDate])
  @@index([migrationBatch])
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  productId         String?
  description       String
  quantity          Float
  unitPrice         Float
  amount            Float
  discountAmount    Float    @default(0)
  taxAmount         Float    @default(0)
  taxDescription    String?
  taxRate           Float    @default(0)
  customProductData Json?
  discount          Float    @default(0)
  isCustom          Boolean  @default(false)
  product           Product? @relation("ProductSales", fields: [productId], references: [id])
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([isCustom])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  sku                   String?
  price                 Float
  cost                  Float?
  stockLevel            Decimal?               @db.Decimal(15, 6)
  averageCost           Decimal?               @default("0") @db.Decimal(15, 2)
  lastPurchaseCost      Decimal?               @db.Decimal(15, 2)
  lastPurchaseDate      DateTime?
  totalStockValue       Decimal?               @default("0") @db.Decimal(18, 2)
  isService             Boolean                @default(false)
  taxRate               Float                  @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenantId              String
  branchId              String?
  category              String?
  location              String?
  reorderPoint          Int?
  reorderLevel          Decimal?               @db.Decimal(15, 2)
  reorderQuantity       Decimal?               @db.Decimal(15, 2)
  leadTimeDays          Int?
  image                 String?
  barcode               String?
  batchNumber           String?
  categoryId            String?
  dimensions            String?
  discountAmount        Float?
  expiryDate            DateTime?
  isPerishable          Boolean                @default(false)
  locationId            String?
  supplier              String?
  preferredSupplierId   String?
  tags                  String[]               @default([])
  weight                Float?
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  deletedBy             String?
  deletionReason        String?
  totalPurchasedQty     Decimal?               @default("0") @db.Decimal(18, 4)
  totalSoldQty          Decimal?               @default("0") @db.Decimal(18, 4)
  inventoryAccountId    String?
  cogsAccountId         String?
  inventoryTransactions InventoryTransaction[]
  inventoryBatches       InventoryBatch[]
  invoiceItems          InvoiceItem[]
  supplierBillItems     SupplierBillItem[]
  inventoryCategory     InventoryCategory?     @relation(fields: [categoryId], references: [id])
  deletedByUser         User?                  @relation("ProductDeletions", fields: [deletedBy], references: [id])
  inventoryLocation     InventoryLocation?     @relation(fields: [locationId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  branch                Branch?                @relation(fields: [branchId], references: [id])
  quotationItems        QuotationItem[]
  saleItems             SaleItem[]             @relation("ProductSales")
  productUnits          ProductUnit[]
  preferredSupplier     Supplier?              @relation(fields: [preferredSupplierId], references: [id])
  inventoryAccount      Account?               @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  cogsAccount           Account?               @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]

  @@index([categoryId])
  @@index([locationId])
  @@index([branchId])
  @@index([isDeleted])
  @@index([deletedAt])
}

model Supplier {
  id                String            @id @default(cuid())
  tenantId          String
  supplierCode      String            @unique
  supplierName      String
  contactPerson     String?
  email             String?
  phone             String?
  mobile            String?
  address           String?
  city              String?
  country           String?           @default("Malawi")
  postalCode        String?
  taxId             String?
  paymentTerms      Int?              @default(30)
  currency          String?           @default("MWK")
  creditLimit       Float?
  currentBalance    Float             @default(0)
  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  isActive          Boolean           @default(true)
  notes             String?
  createdById       String?
  modifiedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products          Product[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]

  @@index([tenantId, supplierName])
  @@index([tenantId, isActive])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  tenantId             String
  supplierId           String
  createdById          String?
  approvedById         String?
  poDate               DateTime
  expectedDeliveryDate DateTime?
  deliveryAddress      String?
  paymentTerms         Int?
  currency             String?             @default("MWK")
  subtotal             Float?              @default(0)
  taxRate              Float?              @default(0)
  taxAmount            Float?              @default(0)
  totalAmount          Float?              @default(0)
  status               String              @default("Draft")
  notes                String?
  termsAndConditions   String?
  approvedDate         DateTime?
  sentDate             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  createdBy            User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy           User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  items                PurchaseOrderItem[]
  receipts             GoodsReceipt[]
  supplierBills        SupplierBill[]

  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  lineNumber       Int
  productId        String
  description      String?
  quantityOrdered  Decimal            @db.Decimal(12, 4)
  quantityReceived Decimal            @default(0) @db.Decimal(12, 4)
  unitCost         Decimal            @db.Decimal(15, 2)
  taxRate          Float?             @default(0)
  taxAmount        Float?             @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                String             @id @default(cuid())
  receiptNumber     String             @unique
  tenantId          String
  supplierId        String
  purchaseOrderId   String?
  receiptDate       DateTime
  supplierReference String?
  totalAmount       Float?             @default(0)
  status            String             @default("Draft")
  receivedById      String?
  notes             String?
  journalEntryId    String?
  createdAt         DateTime           @default(now())
  postedDate        DateTime?
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy        User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])
  journalEntry      JournalEntry?      @relation("GoodsReceiptJournalEntry", fields: [journalEntryId], references: [id])
  items             GoodsReceiptItem[]
  supplierBills     SupplierBill[]

  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model GoodsReceiptItem {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  lineNumber          Int
  productId           String
  purchaseOrderItemId String?
  quantityReceived    Decimal            @db.Decimal(12, 4)
  unitCost            Decimal            @db.Decimal(15, 2)
  batchNumber         String?
  expiryDate          DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([goodsReceiptId])
  @@index([productId])
}

model SupplierBill {
  id                    String                      @id @default(cuid())
  billNumber            String                      @unique
  tenantId              String
  supplierId            String
  purchaseOrderId       String?
  goodsReceiptId        String?
  billDate              DateTime
  dueDate               DateTime
  billType              String                      @default("inventory") // "inventory" or "expense"
  supplierInvoiceNumber String? // Supplier's invoice/reference number
  subtotal              Float?
  taxAmount             Float?
  totalAmount           Float?
  amountPaid            Float?                      @default(0)
  status                String                      @default("Draft") // Draft, Unpaid, Partial, Paid, Overdue
  paymentTerms          Int?
  currency              String?                     @default("MWK")
  notes                 String?
  journalEntryId        String?
  createdById           String?
  approvedById          String?
  finalizedAt           DateTime? // When bill was finalized/posted
  finalizedById         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])
  purchaseOrder         PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt          GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  journalEntry          JournalEntry?               @relation("SupplierBillJournalEntry", fields: [journalEntryId], references: [id])
  createdBy             User?                       @relation("SupplierBillCreator", fields: [createdById], references: [id])
  approvedBy            User?                       @relation("SupplierBillApprover", fields: [approvedById], references: [id])
  finalizedBy           User?                       @relation("SupplierBillFinalizedBy", fields: [finalizedById], references: [id])
  items                 SupplierBillItem[]
  allocations           SupplierPaymentAllocation[]

  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, billType])
  @@index([dueDate])
}

model SupplierBillItem {
  id               String       @id @default(cuid())
  billId           String
  lineNumber       Int
  productId        String? // For inventory purchases
  expenseAccountId String? // For operating expenses
  description      String
  quantity         Decimal?     @db.Decimal(12, 4) // For inventory purchases
  unitCost         Decimal      @db.Decimal(15, 2)
  lineTotal        Decimal      @db.Decimal(15, 2)
  taxRate          Float?       @default(0)
  taxAmount        Float?       @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  bill             SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product          Product?     @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
}

model SupplierPayment {
  id              String                      @id @default(cuid())
  paymentNumber   String                      @unique
  tenantId        String
  supplierId      String
  paymentDate     DateTime
  paymentMethod   String
  bankAccountId   String?
  referenceNumber String?
  totalAmount     Float
  currency        String?                     @default("MWK")
  exchangeRate    Float?                      @default(1)
  notes           String?
  journalEntryId  String?
  createdById     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier                    @relation(fields: [supplierId], references: [id])
  bankAccount     BankAccount?                @relation(fields: [bankAccountId], references: [id])
  journalEntry    JournalEntry?               @relation("SupplierPaymentJournalEntry", fields: [journalEntryId], references: [id])
