/// Phase 14 Wave 1–4 — CrmDemo (DEMO-YYYY-######). Scheduling requires Meeting + Calendar.
/// RSVP ≠ attendance; readiness blocks READY_TO_DELIVER when Meeting/presenter/Contact missing.
/// Wave 2 pins historical Agenda/Script/Scenario/Content version ids (ACTIVE immutable).
/// Wave 3: optional logical env / checklist / rehearsal gates when configured.
/// Wave 4: delivery / attendance / recording gov / feedback / outcome / handoffs.
model CrmDemo {
  id                     String    @id @default(cuid())
  demoNumber             String    @unique
  status                 String    @default("PLANNED")
  readinessStatus        String    @default("NOT_READY")
  readinessJson          Json?
  requestId              String?
  leadId                 String?
  opportunityId          String?
  accountId              String?
  contactId              String?
  meetingId              String?
  calendarEventId        String?
  title                  String?
  notes                  String?
  timezone               String?
  startsAtUtc            DateTime?
  endsAtUtc              DateTime?
  startsAtOriginal       String?
  endsAtOriginal         String?
  ownerAdminId           String?
  createdByAdminId       String?
  convertIdempotencyKey  String?   @unique
  scheduleIdempotencyKey String?   @unique
  idempotencyKey         String?   @unique
  /// Wave 2 — pinned version ids (historical; not rewritten when newer ACTIVE ships)
  pinnedAgendaId         String?
  pinnedScriptId         String?
  pinnedScenarioId       String?
  pinnedContentId        String?
  /// Wave 3 — readiness gates (opt-in via configure / create flags)
  requiresLogicalEnvironment Boolean @default(false)
  requiresChecklist      Boolean   @default(false)
  requiresRehearsal      Boolean   @default(false)
  environmentId          String?
  pinnedChecklistId      String?
  latestChecklistExecutionId String?
  latestRehearsalId      String?
  /// Wave 4 — delivery / outcome pointers
  latestDeliverySessionId String?
  latestOutcomeId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  request                CrmDemoRequest? @relation("CrmDemoRequestDemos", fields: [requestId], references: [id], onDelete: SetNull)
  convertedFromRequests  CrmDemoRequest[] @relation("CrmDemoFromRequest")
  ownerAdmin             Admin?    @relation("CrmDemoOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  createdByAdmin         Admin?    @relation("CrmDemoCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  participants           CrmDemoParticipant[]
  statusHistory          CrmDemoStatusHistory[]
  environments           CrmDemoEnvironment[] @relation("CrmDemoEnvironments")
  checklistExecutions    CrmDemoChecklistExecution[]
  rehearsals             CrmDemoRehearsal[]
