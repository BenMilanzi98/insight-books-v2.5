  currency             String?             @default("MWK")
  subtotal             Float?              @default(0)
  taxRate              Float?              @default(0)
  taxAmount            Float?              @default(0)
  totalAmount          Float?              @default(0)
  status               String              @default("Draft")
  notes                String?
  termsAndConditions   String?
  approvedDate         DateTime?
  sentDate             DateTime?
  pricesIncludeTax     Boolean             @default(false)
  supplierInvoiceUrl   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  receipts             GoodsReceipt[]
  expenses             Expense[]
  approvedBy           User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  createdBy            User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]
  supplierBills        SupplierBill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id                String             @id @default(cuid())
  purchaseOrderId   String
  lineNumber        Int
  lineType          String?            @default("goods") // "goods" | "service"
  productId         String?
  /// Which ProductUnit this line is priced/ordered in (flexible measurements); null = legacy / single-unit products.
  productUnitId     String?
  expenseCategoryId String?
  description       String?
  quantityOrdered   Decimal            @db.Decimal(12, 4)
  quantityReceived  Decimal            @default(0) @db.Decimal(12, 4)
  unitCost          Decimal            @db.Decimal(15, 2)
  taxTypeId         String?
  taxRate           Float?             @default(0)
  taxAmount         Float?             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  receiptItems      GoodsReceiptItem[]
  billItems         SupplierBillItem[]
  product           Product?           @relation(fields: [productId], references: [id])
  productUnit       ProductUnit?       @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  expenseCategory   ExpenseCategory?   @relation(fields: [expenseCategoryId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  taxType           TaxType?           @relation(fields: [taxTypeId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([productUnitId])
  @@index([expenseCategoryId])
  @@index([taxTypeId])
}

model GoodsReceipt {
  id                 String             @id @default(cuid())
  receiptNumber      String
  tenantId           String
  supplierId         String
  purchaseOrderId    String?
  receiptDate        DateTime
  supplierReference  String?
  totalAmount        Float?             @default(0)
  status             String             @default("Draft")
  receivedById       String?
  notes              String?
  journalEntryId     String?
  /// Set when FIFO/stock, GL journal, and linked supplier bill have been applied (immediate or via scheduled job).
  inventoryAppliedAt DateTime?
  idempotencyKey     String?
  postingStatus      String?
  inspectionStatus   String?
  createdAt          DateTime           @default(now())
  postedDate         DateTime?
  updatedAt          DateTime           @updatedAt
  journalEntry       JournalEntry?      @relation("GoodsReceiptJournalEntry", fields: [journalEntryId], references: [id])
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy         User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])
  supplier           Supplier           @relation(fields: [supplierId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items              GoodsReceiptItem[]
  supplierBills      SupplierBill[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([status, inventoryAppliedAt, receiptDate])
}

model GoodsReceiptItem {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  lineNumber          Int
  productId           String
  purchaseOrderItemId String?
  quantityReceived    Decimal            @db.Decimal(12, 4)
  acceptedQuantity    Decimal?           @db.Decimal(12, 4)
  rejectedQuantity    Decimal?           @default(0) @db.Decimal(12, 4)
  damagedQuantity     Decimal?           @default(0) @db.Decimal(12, 4)
  unitCost            Decimal            @db.Decimal(15, 2)
  batchNumber         String?
  expiryDate          DateTime?
  expiryAllocations   Json?
  notes               String?
  qualityStatus       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  billItems           SupplierBillItem[]

  @@index([goodsReceiptId])
  @@index([productId])
}

model SupplierBill {
  id                    String                      @id @default(cuid())
  billNumber            String                      @unique
  tenantId              String
  supplierId            String
  purchaseOrderId       String?
  goodsReceiptId        String?
  billDate              DateTime
  dueDate               DateTime
  billType              String                      @default("inventory")
  supplierInvoiceNumber String?
  subtotal              Decimal?                    @db.Decimal(18, 2)
  taxAmount             Decimal?                    @db.Decimal(18, 2)
  totalAmount           Decimal?                    @db.Decimal(18, 2)
  amountPaid            Decimal?                    @default(0) @db.Decimal(18, 2)
  status                String                      @default("Draft")
  paymentTerms          Int?
  currency              String?                     @default("MWK")
  notes                 String?
  journalEntryId        String?
  matchingStatus        String?
  postingStatus         String?
  idempotencyKey        String?
  createdById           String?
  approvedById          String?
  finalizedAt           DateTime?
  finalizedById         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  approvedBy            User?                       @relation("SupplierBillApprover", fields: [approvedById], references: [id])
  createdBy             User?                       @relation("SupplierBillCreator", fields: [createdById], references: [id])
  finalizedBy           User?                       @relation("SupplierBillFinalizedBy", fields: [finalizedById], references: [id])
  goodsReceipt          GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  journalEntry          JournalEntry?               @relation("SupplierBillJournalEntry", fields: [journalEntryId], references: [id])
  purchaseOrder         PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                 SupplierBillItem[]
  allocations           SupplierPaymentAllocation[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, billType])
  @@index([tenantId, supplierId, supplierInvoiceNumber])
  @@index([tenantId, matchingStatus])
  @@index([dueDate])
}

model SupplierBillItem {
  id                  String            @id @default(cuid())
  billId              String
  lineNumber          Int
  productId           String?
  expenseAccountId    String?
  purchaseOrderItemId String?
  goodsReceiptItemId  String?
  description         String
  quantity            Decimal?          @db.Decimal(12, 4)
  unitCost            Decimal           @db.Decimal(15, 2)
  lineTotal           Decimal           @db.Decimal(15, 2)
  taxRate             Float?            @default(0)
  taxAmount           Float?            @default(0)
  matchStatus         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  bill                SupplierBill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  product             Product?          @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  goodsReceiptItem    GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id])

  @@index([billId])
  @@index([productId])
  @@index([goodsReceiptItemId])
  @@index([purchaseOrderItemId])
}

model SupplierPayment {
  id                    String                      @id @default(cuid())
  paymentNumber         String                      @unique
  tenantId              String
  supplierId            String
  paymentDate           DateTime
  paymentMethod         String
  bankAccountId         String?
  referenceNumber       String?
  totalAmount           Float
  currency              String?                     @default("MWK")
  exchangeRate          Float?                      @default(1)
  notes                 String?
  journalEntryId        String?
  idempotencyKey        String?
  postingStatus         String?
  createdById           String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  // Reversal fields
  isReversal            Boolean                     @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  bankAccount           BankAccount?                @relation(fields: [bankAccountId], references: [id])
  createdBy             User?                       @relation(fields: [createdById], references: [id])
  journalEntry          JournalEntry?               @relation("SupplierPaymentJournalEntry", fields: [journalEntryId], references: [id])
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations           SupplierPaymentAllocation[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, supplierId])
  @@index([paymentDate])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model SupplierPaymentAllocation {
  id        String          @id @default(cuid())
  tenantId  String
  paymentId String
  billId    String
  amount    Float
  createdAt DateTime        @default(now())
  bill      SupplierBill    @relation(fields: [billId], references: [id])
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([billId])
}

model BankAccount {
  id               String            @id @default(cuid())
  tenantId         String
  accountName      String
  accountNumber    String?
  bankName         String?
  bankBranch       String?
  accountType      String?           @default("Current")
  currency         String?           @default("MWK")
  openingBalance   Float             @default(0)
  currentBalance   Float             @default(0)
  coaAccountId     String?
  isActive         Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chartAccount     Account?          @relation(fields: [coaAccountId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierPayments SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model EquityAccount {
  id                  String   @id @default(cuid())
  tenantId            String
  accountName         String
  accountType         String
  openingBalance      Float    @default(0)
  currentBalance      Float    @default(0)
  coaAccountId        String?
  ownerShareholder    String?
  ownershipPercentage Float?
  isActive            Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  chartAccount        Account? @relation(fields: [coaAccountId], references: [id])
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, accountType])
}

model InventoryCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?   @default("#4f46e5")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryLocation {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  type      String
  /// Matches fractional goods receipts / product stock (was Int; migration widens column).
  quantity  Decimal  @db.Decimal(18, 4)
  notes     String?
  createdAt DateTime @default(now())
  productId String
  userId    String
  tenantId  String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@index([tenantId, productId, createdAt])
}

model InventoryBatch {
  id           String                      @id @default(cuid())
  tenantId     String
  branchId     String?
  productId    String
  sourceType   String?
  sourceId     String?
  purchaseDate DateTime
  /// Null = non-perishable / unknown; used for expiry alerts and FIFO issuance blocking.
  expiryDate   DateTime?
  qtyPurchased Decimal                     @db.Decimal(18, 4)
  qtyRemaining Decimal                     @db.Decimal(18, 4)
  unitCost     Decimal                     @db.Decimal(15, 2)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  branch       Branch?                     @relation(fields: [branchId], references: [id])
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consumptions InventoryBatchConsumption[]

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId, expiryDate])
  @@index([tenantId, sourceType, sourceId])
}

/// Audit trail for batch expiry write-offs and optional restock linkage.
model InventoryExpiryAudit {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String?
  userId         String?
  productId      String
  batchId        String?
  action         String // write_off | restock
  quantity       Decimal  @db.Decimal(18, 4)
  unitCost       Decimal? @db.Decimal(15, 2)
  lossAmount     Decimal? @db.Decimal(18, 2)
  restockBatchId String?
  journalEntryId String?
  notes          String?
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([batchId])
}

model InventoryBatchConsumption {
  id         String         @id @default(cuid())
  tenantId   String
  batchId    String
  saleId     String?
  saleItemId String?
  quantity   Decimal        @db.Decimal(18, 4)
  unitCost   Decimal        @db.Decimal(15, 2)
  cogsAmount Decimal        @db.Decimal(18, 2)
  createdAt  DateTime       @default(now())
  batch      InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sale       Sale?          @relation(fields: [saleId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId])
  @@index([saleId])
  @@index([saleItemId])
}

model Employee {
  id                          String                @id @default(cuid())
  name                        String
  email                       String
  phone                       String?
  position                    String?
  department                  String?
  startDate                   DateTime
  salary                      Decimal?              @db.Decimal(18, 2)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  tenantId                    String
  address                     String?
  status                      String?               @default("Active")
  departmentId                String?
  bankDetails                 Json?
  contactDetails              Json?
  dateOfBirth                 DateTime?
  emergencyContact            Json?
  employeeId                  String?
  employmentType              String?               @default("Permanent")
  gender                      String?
  grossSalary                 Decimal?              @db.Decimal(18, 2)
  hourlyRate                  Decimal?              @db.Decimal(18, 2)
  idNumber                    String?
  isActive                    Boolean               @default(true)
  jobTitle                    String?
  maritalStatus               String?
  nationality                 String?               @default("Malawian")
  reportingManager            Json?
  selectedDeductions          Json?
  workLocation                String?
  suspendedFrom               DateTime?
  suspendedTo                 DateTime?
  suspensionReason            String?
  terminationDate             DateTime?
  terminationReason           String?
  attendanceRecords           AttendanceRecord[]
  departmentRef               Department?           @relation(fields: [departmentId], references: [id])
  employeeBenefits            EmployeeBenefit[]
  employmentContracts         EmploymentContract[]
  tenant                      Tenant                @relation(fields: [tenantId], references: [id])
  expenses                    Expense[]
  gratuityAccount             GratuityAccount?
  leaveBalances               LeaveBalance[]
  leaveRequests               LeaveRequest[]
  payrolls                    Payroll[]
  performanceFeedbackReceived PerformanceFeedback[] @relation("FeedbackReceived")
  performanceFeedbackGiven    PerformanceFeedback[] @relation("FeedbackGiven")
  performanceGoals            PerformanceGoal[]
  performanceReviews          PerformanceReview[]
  salaryAdvances              SalaryAdvance[]
  payrollRunEmployees         PayrollRunEmployee[]
  overtimeRequests            OvertimeRequest[]
  disciplinaryCases           DisciplinaryCase[]
  leaveAccrualLedgers         LeaveAccrualLedger[]
  pensionContributions        PensionContribution[]
  employeeDeductionAssignments EmployeeDeductionAssignment[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([departmentId])
}

model Department {
  id          String     @id @default(cuid())
  name        String
  description String?
  color       String?    @default("#4f46e5")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  employees   Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Versioned employment terms — payroll must resolve the contract effective for the period.
model EmploymentContract {
  id                   String    @id @default(cuid())
  tenantId             String
  employeeId           String
  version              Int       @default(1)
  status               String    @default("DRAFT")
  payBasis             String    @default("MONTHLY_SALARY")
  payFrequency         String    @default("MONTHLY")
  basicSalary          Decimal   @default(0) @db.Decimal(18, 2)
  hourlyRate           Decimal?  @db.Decimal(18, 2)
  dailyRate            Decimal?  @db.Decimal(18, 2)
  standardWeeklyHours  Decimal?  @db.Decimal(8, 2)
  standardMonthlyHours Decimal?  @db.Decimal(8, 2)
  overtimeEligible     Boolean   @default(true)
  overtimeMultiplier   Decimal   @default(1.5) @db.Decimal(8, 4)
  currency             String    @default("MWK")
  position             String?
  departmentId         String?
  branchId             String?
  employmentType       String?
  pensionEligible      Boolean   @default(true)
  gratuityEligible     Boolean   @default(true)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  notes                String?
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId, status])
  @@index([effectiveFrom])
}

model Payroll {
  id                    String    @id @default(cuid())
  employeeId            String
  periodStart           DateTime
  periodEnd             DateTime
  basicSalary           Decimal   @default(0) @db.Decimal(18, 2)
  deductions            Decimal   @default(0) @db.Decimal(18, 2)
  additions             Decimal   @default(0) @db.Decimal(18, 2)
  netPay                Decimal   @default(0) @db.Decimal(18, 2)
  status                String    @default("Pending")
  paymentDate           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  notes                 String?
  grossPay              Decimal?  @default(0) @db.Decimal(18, 2)
  payeAmount            Decimal?  @default(0) @db.Decimal(18, 2)
  tenantId              String
  totalNpsAmount        Decimal?  @default(0) @db.Decimal(18, 2)
  gratuityAccruedAmount Decimal?  @default(0) @db.Decimal(18, 2)
  /// Optional link when a V2 run materializes legacy per-employee rows
  payrollRunId          String?
  employee              Employee  @relation(fields: [employeeId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun            PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@index([payrollRunId])
}

/// Configurable PAYE/tax bands per tenant (Malawi default seeded when missing).
model PayrollTaxConfiguration {
  id                      String    @id @default(cuid())
  tenantId                String
  country                 String    @default("MW")
  taxYear                 Int
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  /// [{ ceiling: number|null, rate: number, label?: string }] — marginal monthly bands
  bands                   Json
  monthlyTaxFreeAllowance Float     @default(0)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([effectiveFrom])
}

model Benefit {
  id                String            @id @default(cuid())
  name              String
  code              String?
  description       String?
  defaultAmount     Decimal?          @default(0) @db.Decimal(18, 2)
  defaultPercentage Decimal?          @default(0) @db.Decimal(8, 4)
  isTaxable         Boolean           @default(true)
  isPensionable     Boolean           @default(false)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeBenefits  EmployeeBenefit[]

  @@index([tenantId])
  @@index([isActive])
  @@index([tenantId, code])
}

model EmployeeBenefit {
  id            String    @id @default(cuid())
  tenantId      String?
  employeeId    String
  benefitId     String
  amount        Decimal   @default(0) @db.Decimal(18, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefit       Benefit   @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([employeeId, benefitId])
  @@index([employeeId])
  @@index([benefitId])
  @@index([tenantId])
}

model Deduction {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  amount      Decimal? @db.Decimal(18, 2)
  percentage  Decimal? @db.Decimal(8, 4)
  priority    Int      @default(100)
  isPreTax    Boolean  @default(false)
  isStatutory Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  assignments EmployeeDeductionAssignment[]

  @@index([tenantId])
  @@index([isStatutory])
  @@index([isActive])
  @@index([tenantId, code])
}

/// Explicit employee ↔ deduction assignment (replaces opaque selectedDeductions Json over time).
model EmployeeDeductionAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  deductionId   String
  amountOverride Decimal? @db.Decimal(18, 2)
  percentOverride Decimal? @db.Decimal(8, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deduction     Deduction @relation(fields: [deductionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, deductionId, effectiveFrom])
  @@index([tenantId])
  @@index([employeeId])
  @@index([deductionId])
}

model GratuityAccount {
  id                String            @id @default(cuid())
  employeeId        String            @unique
  tenantId          String
  accrualRate       Decimal           @default(5) @db.Decimal(8, 4)
  totalAccrued      Decimal           @default(0) @db.Decimal(18, 2)
  totalPaid         Decimal           @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal           @default(0) @db.Decimal(18, 2)
  lastCalculatedAt  DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          GratuityPayment[]
  provisionEntries  GratuityProvisionEntry[]

  @@index([tenantId])
  @@index([employeeId])
}

model GratuityPayment {
  id                String          @id @default(cuid())
  tenantId          String?
  gratuityAccountId String
  amount            Decimal         @db.Decimal(18, 2)
  paymentDate       DateTime
  reference         String?
  notes             String?
  journalId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  gratuityAccount   GratuityAccount @relation(fields: [gratuityAccountId], references: [id], onDelete: Cascade)

  @@index([gratuityAccountId])
  @@index([paymentDate])
  @@index([tenantId])
}

model GratuityProvisionEntry {
  id                String          @id @default(cuid())
  tenantId          String
  gratuityAccountId String
  payrollRunId      String?
  amount            Decimal         @db.Decimal(18, 2)
  periodEnd         DateTime
  journalId         String?
  createdAt         DateTime        @default(now())
  gratuityAccount   GratuityAccount @relation(fields: [gratuityAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([gratuityAccountId])
  @@index([payrollRunId])
}

model SalaryAdvance {
  id                String             @id @default(cuid())
  employeeId        String
  tenantId          String
  amount            Decimal            @db.Decimal(18, 2)
  advanceDate       DateTime
  repaymentMonths   Int                @default(1)
  monthlyDeduction  Decimal            @db.Decimal(18, 2)
  totalDeducted     Decimal            @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal            @db.Decimal(18, 2)
  status            String             @default("Active")
  reference         String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deductions        AdvanceDeduction[]
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([advanceDate])
}

model AdvanceDeduction {
  id              String        @id @default(cuid())
  tenantId        String?
  salaryAdvanceId String
  payrollId       String?
  payrollRunId    String?
  installmentNo   Int           @default(1)
  amount          Decimal       @db.Decimal(18, 2)
  deductionDate   DateTime
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salaryAdvance   SalaryAdvance @relation(fields: [salaryAdvanceId], references: [id], onDelete: Cascade)

  @@unique([salaryAdvanceId, payrollRunId, installmentNo])
  @@index([salaryAdvanceId])
  @@index([payrollId])
  @@index([payrollRunId])
  @@index([deductionDate])
  @@index([tenantId])
}

model Affiliate {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  paymentMethod    String
  paymentDetails   String?
  status           String              @default("active")
  referralCode     String              @unique @default(cuid())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  businessName     String?
  commissionRate   Float               @default(20)
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  totalCommissions Float               @default(0)
  totalReferrals   Int                 @default(0)
  totalSales       Float               @default(0)
  payouts          AffiliatePayout[]
  referrals        AffiliateReferral[]
}

model AffiliateReferral {
  id                    String    @id @default(cuid())
  affiliateId           String
  tenantId              String
  commissionAmount      Float     @default(0)
  status                String    @default("pending")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  completedAt           DateTime?
  registrationTimestamp DateTime  @default(now())
  userId                String?
  /// Platform payment / conversion id — one eligible conversion → one commission
  paymentId             String?
  idempotencyKey        String?   @unique
  affiliate             Affiliate @relation(fields: [affiliateId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  user                  User?     @relation(fields: [userId], references: [id])

  @@index([affiliateId])
  @@index([tenantId])
  @@index([status])
}

model AffiliatePayout {
  id             String    @id @default(cuid())
  affiliateId    String
  amount         Float
  paymentMethod  String
  reference      String?
  status         String
  processedDate  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  periodKey      String?
  idempotencyKey String?   @unique
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

model Transaction {
  id                    String            @id @default(cuid())
  date                  DateTime
  description           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenantId              String
  reference             String?
  status                String            @default("posted")
  createdById           String?
  entryType             String            @default("Regular")
  notes                 String?
  postedById            String?
  postedDate            DateTime?
  sourceId              String?
  sourceType            String?
  branchId              String?
  isReversal            Boolean           @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  branch                Branch?           @relation(fields: [branchId], references: [id])
  createdBy             User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  postedBy              User?             @relation("TransactionPostedBy", fields: [postedById], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  lines                 TransactionLine[]

  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([sourceType])
  @@index([sourceId])
  @@index([reference])
  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  lineNumber    Int
  accountId     String
  debitAmount   Decimal     @default(0) @db.Decimal(18, 2)
  creditAmount  Decimal     @default(0) @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       Account     @relation("TransactionLineAccount", fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId])
}

/// Singleton JSON payload edited in /insightbooks/chart-of-accounts; applied to all tenants.
model SystemCoaDefinition {
  id             String   @id @default("default")
  payload        Json
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@map("system_coa_definition")
}

model Account {
  id                       String                  @id @default(cuid())
  code                     String?                 @map("code")
  name                     String?                 @map("name")
  type                     String?                 @map("type")
  balance                  Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  tenantId                 String?
  isActive                 Boolean                 @default(true)
  isSystem                 Boolean                 @default(false)
  accountCode              String?
  accountName              String?
  accountSubtype           String?
  accountType              String?
  description              String?
  normalBalance            String?
  parentAccountId          String?
  /// Logical merge (system CoA): posting stays on this row (original code); reporting/UI roll up to mergedInto target.
  mergedIntoAccountId      String?
  parentAccount            Account?                @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts            Account[]               @relation("AccountHierarchy")
  mergedIntoAccount        Account?                @relation("AccountCoaMerge", fields: [mergedIntoAccountId], references: [id], onDelete: SetNull)
  accountsMergedIntoThis   Account[]               @relation("AccountCoaMerge")
  tenant                   Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountBalances          AccountBalanceHistory[]
  bankAccounts             BankAccount[]
  legacyBudgetItems        LegacyBudgetItem[]
  budgetLines              BudgetLine[]
  forecastLines            ForecastLine[]
  forecastAssumptions      ForecastAssumption[]
  bfExpenseBudgetLines     BfExpenseBudgetLine[]
  bfRevenueForecastLines   BfRevenueForecastLine[]
  equityAccounts           EquityAccount[]
  expenseAccounts          Expense[]               @relation("ExpenseAccount")
  expenseSources           Expense[]               @relation("ExpenseSourceAccount")
  recurringExpenseAccounts RecurringExpense[]      @relation("RecurringExpenseAccount")
  journalEntryLines        JournalEntryLine[]
  productsCogs             Product[]               @relation("ProductCogsAccount")
  productsInventory        Product[]               @relation("ProductInventoryAccount")
  productsIncome           Product[]               @relation("ProductIncomeAccount")
  taxTypes                 TaxType[]               @relation("TaxTypeAccount")
  taxAccountMappings       TaxAccountMapping[]     @relation("TaxAccountMappingAccount")
  transactionLines         TransactionLine[]       @relation("TransactionLineAccount")

  invoiceItems             InvoiceItem[]
  saleItems                SaleItem[]
  expenseCategory          ExpenseCategory?        @relation("ExpenseCategoryAccount")
  paymentAccountsLinked    PaymentAccount[]        @relation("PaymentAccountCoa")
  assetsGlLinked           Asset[]                 @relation("AssetGlAccount")
  liabilitiesGlLinked      Liability[]             @relation("LiabilityGlAccount")
  /// Catch-all / unclassified bucket; surfaced in CoA UI for reclassification (guide).
  requiresReclassification Boolean                 @default(false)
  /// Soft retire after migration; row kept for audit (guide: do not delete).
  retiredAt                DateTime?
  /// Target canonical GL code string at migration time (audit).
  migratedToAccountCode    String?
  /// When false, block new postings to this account (retired / merged sources).
  acceptsNewTransactions   Boolean                 @default(true)
  /// Default chart list hides rows with false (migrated sources, etc.).
  visibleInChart           Boolean                 @default(true)
  coaMigrationLogsAsSource CoaMigrationLog[]       @relation("CoaMigrationOriginalAccount")

  /// ── CoA V2 governance (Phase 3, additive; nullable until Stage-2 backfill classifies) ──
  coaV2Category                String?
  coaV2SubType                 String?
  coaV2Behaviour               String?
  coaV2NormalBalance           String?
  coaV2Status                  String?
  postingAllowed               Boolean?
  manualPostingAllowed         Boolean?
  reconciliationRequired       Boolean?
  currencyPolicy               String?
  specificCurrency             String?
  financialStatementSection    String?
  financialStatementSubsection String?
  cashFlowClassification       String?
  systemPurpose                String?
  controlAccountPurpose        String?
  consolidationGroup           String?
  displayOrder                 Int?
  coaDepth                     Int?
  hierarchyPath                String?
  deprecationReason            String?
  replacementAccountId         String?
  coaEffectiveFrom             DateTime?
  coaEffectiveTo               DateTime?
  coaArchitectureVersion       String?
  coaV2Metadata                Json?
  archivedAt                   DateTime?
  coaV2UpdatedBy               String?
  replacementAccount           Account?  @relation("AccountReplacement", fields: [replacementAccountId], references: [id], onDelete: SetNull)
  replacedAccounts             Account[] @relation("AccountReplacement")
  coaV2Mappings                CoaV2AccountMapping[]
  coaV2AliasesAsLegacy         CoaV2AccountAlias[]   @relation("AliasLegacyAccount")
  coaV2AliasesAsCanonical      CoaV2AccountAlias[]   @relation("AliasCanonicalAccount")
  coaV2ConsolidationsAsDuplicate CoaV2ConsolidationPlan[] @relation("ConsolidationDuplicateAccount")
  coaV2ConsolidationsAsCanonical CoaV2ConsolidationPlan[] @relation("ConsolidationCanonicalAccount")

  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountType])
  @@index([isActive])
  @@index([parentAccountId])
  @@index([accountCode])
  @@index([mergedIntoAccountId])
  @@index([tenantId, systemPurpose])
  @@index([tenantId, coaV2Status])
  @@index([tenantId, coaV2Category])
  @@index([tenantId, coaV2Behaviour])
  @@index([replacementAccountId])
}

/// Audit trail for chart-of-accounts consolidation (implementation guide Phase 0 / 4).
model CoaMigrationLog {
  id                String    @id @default(cuid())
  tenantId          String
  originalAccountId String
  originalCode      String?
  originalName      String?
  originalType      String?
  mappedToCode      String?
  mappedToName      String?
  status            String    @default("pending")
  errorMessage      String?
  migratedAt        DateTime?
  migrationBatchId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalAccount Account @relation("CoaMigrationOriginalAccount", fields: [originalAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([status])
  @@index([migrationBatchId])
  @@index([originalAccountId])
  @@map("coa_migration_log")
}

/// Row-level audit trail for accounting mapping corrections.
model AccountingMappingCorrection {
  id             String   @id @default(cuid())
  tenantId       String
  batchId        String
  entityType     String
  entityId       String
  fieldName      String
  oldAccountId   String?
  oldAccountCode String?
  oldAccountName String?
  newAccountId   String?
  newAccountCode String?
  newAccountName String?
  reason         String
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId])
  @@index([entityType, entityId])
  @@map("accounting_mapping_correction")
}

model TaxType {
  id                 String              @id @default(cuid())
  taxId              String
  taxName            String
  taxCode            String?
  taxRate            Float
  calculationType    String              @default("Percentage")
  accountId          String
  status             String              @default("Active")
  /// Wave 3 — optional versioning window (null = always effective while Active)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  supersededById     String?
  tenantId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productTaxes       ProductTax[]
  saleItemTaxes      SaleItemTax[]
  purchaseOrderItems PurchaseOrderItem[]
  expenses           Expense[]
  account            Account             @relation("TaxTypeAccount", fields: [accountId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supersededBy       TaxType?            @relation("TaxTypeSupersession", fields: [supersededById], references: [id])
  supersedes         TaxType[]           @relation("TaxTypeSupersession")

  @@unique([tenantId, taxId])
  @@unique([tenantId, taxCode])
  @@index([tenantId])
  @@index([status])
  @@index([accountId])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

/// Purpose → CoA mapping (effective-dated). Dual-run with TaxType.accountId.
model TaxAccountMapping {
  id          String    @id @default(cuid())
  tenantId    String
  purpose     String
  accountId   String
  taxTypeId   String?
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  status      String    @default("ACTIVE")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account  @relation("TaxAccountMappingAccount", fields: [accountId], references: [id])

  @@index([tenantId, purpose, status])
  @@index([tenantId, accountId])
  @@index([taxTypeId])
  @@map("tax_account_mapping")
}

/// Immutable tax subledger projected from posted V2 journal lines.
model TaxTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  journalEntryId  String
  journalLineId   String   @unique
  taxTypeId       String?
  purpose         String?
  direction       String
  amountSigned    Decimal  @db.Decimal(18, 2)
  postingDate     DateTime
  sourceModule    String?
  sourceType      String?
  sourceId        String?
  isReversal      Boolean  @default(false)
  reversedFromId  String?
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, postingDate])
  @@index([tenantId, taxTypeId])
  @@index([tenantId, purpose])
  @@index([journalEntryId])
  @@map("tax_transaction")
}

/// Wave 4 — filing calendar period (state machine).
model TaxPeriod {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  label       String
  periodType  String    @default("MONTHLY")
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  status      String    @default("OPEN")
  closedAt    DateTime?
  closedById  String?
  reopenedAt  DateTime?
  reopenedById String?
  notes       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returns  TaxReturn[]
  payments TaxPayment[]
  refunds  TaxRefund[]
  credits  TaxCredit[]
  withholdings TaxWithholdingRemittance[]

  @@unique([tenantId, code])
  @@unique([tenantId, startDate, endDate, periodType])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("tax_period")
}

/// Wave 4 — tax return (filing does not auto-journal).
model TaxReturn {
  id              String    @id @default(cuid())
  tenantId        String
  taxPeriodId     String
  returnType      String    @default("VAT")
  status          String    @default("DRAFT")
  reference       String?
  outputTax       Decimal   @default(0) @db.Decimal(18, 2)
  inputTax        Decimal   @default(0) @db.Decimal(18, 2)
  netTax          Decimal   @default(0) @db.Decimal(18, 2)
  filedAt         DateTime?
  filedById       String?
  amendedFromId   String?
  amendmentReason String?
  notes           String?
  snapshot        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod  @relation(fields: [taxPeriodId], references: [id], onDelete: Restrict)
  amendedFrom TaxReturn? @relation("TaxReturnAmendment", fields: [amendedFromId], references: [id])
  amendments  TaxReturn[] @relation("TaxReturnAmendment")

  @@index([tenantId, status])
  @@index([taxPeriodId])
  @@map("tax_return")
}

/// Wave 4 — tax payment / settlement register (GL via existing settle / V2 path).
model TaxPayment {
  id                 String    @id @default(cuid())
  tenantId           String
  taxPeriodId        String?
  taxTypeId          String?
  taxReturnId        String?
  status             String    @default("POSTED")
  amount             Decimal   @db.Decimal(18, 2)
  paymentDate        DateTime  @db.Date
  paymentMethod      String?
  paymentAccountId   String?
  expenseId          String?
  paymentId          String?
  journalEntryId     String?
  description        String?
  notes              String?
  allocationJson     Json?
  reversedAt         DateTime?
  reversedById       String?
  reversalPaymentId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod? @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, paymentDate])
  @@index([taxPeriodId])
  @@index([taxTypeId])
  @@map("tax_payment")
}

model TaxRefund {
  id               String    @id @default(cuid())
  tenantId         String
  taxPeriodId      String?
  taxTypeId        String?
  status           String    @default("DRAFT")
  amount           Decimal   @db.Decimal(18, 2)
  refundDate       DateTime? @db.Date
  paymentAccountId String?
  journalEntryId   String?
  reason           String?
  notes            String?
  postedAt         DateTime?
  postedById       String?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod? @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([taxPeriodId])
  @@map("tax_refund")
}

model TaxCredit {
  id            String    @id @default(cuid())
  tenantId      String
  taxPeriodId   String?
  taxTypeId     String?
  status        String    @default("OPEN")
  amount        Decimal   @db.Decimal(18, 2)
  remaining     Decimal   @db.Decimal(18, 2)
  source        String?
  reference     String?
  notes         String?
  appliedAt     DateTime?
  appliedToPaymentId String?
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod? @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([taxPeriodId])
  @@map("tax_credit")
}

model TaxWithholdingRemittance {
  id               String    @id @default(cuid())
  tenantId         String
  taxPeriodId      String?
  status           String    @default("DRAFT")
  amount           Decimal   @db.Decimal(18, 2)
  remittanceDate   DateTime? @db.Date
  counterparty     String?
  paymentAccountId String?
  journalEntryId   String?
  reference        String?
  notes            String?
  postedAt         DateTime?
  postedById       String?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod? @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([taxPeriodId])
  @@map("tax_withholding_remittance")
}


model ProductTax {
  id        String   @id @default(cuid())
  productId String
  taxTypeId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxType   TaxType  @relation(fields: [taxTypeId], references: [id], onDelete: Cascade)

  @@unique([productId, taxTypeId])
  @@index([productId])
  @@index([taxTypeId])
}

model SaleItemTax {
  id         String   @id @default(cuid())
  saleItemId String
  taxTypeId  String
  taxName    String
  taxCode    String
  taxRate    Float
  taxAmount  Float
  createdAt  DateTime @default(now())
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  taxType    TaxType  @relation(fields: [taxTypeId], references: [id])

  @@index([saleItemId])
  @@index([taxTypeId])
}

model JournalEntry {
  id               String             @id @default(cuid())
  transactionId    String?            @map("transactionId")
  accountId        String?            @map("accountId")
  debit            Float?             @default(0) @map("debit")
  credit           Float?             @default(0) @map("credit")
  description      String?
  status           String             @default("Draft")
  createdAt        DateTime           @default(now())
  createdById      String?
  entryDate        DateTime?
  entryType        String             @default("Regular")
  notes            String?
  postedById       String?
  postedDate       DateTime?
  referenceNumber  String?            @unique
  sourceId         String?
  sourceType       String?
  tenantId         String?
  updatedAt        DateTime           @default(now())
  branchId         String?
  /// ── Accounting V2 posting-engine columns (Phase 4, additive) ──
  /// Journal number allocated by the concurrency-safe sequence (unique per business).
  journalNumber        String?
  /// Exact decimal totals written by the V2 engine (legacy Float header debit/credit unused).
  totalDebit           Decimal?  @db.Decimal(18, 2)
  totalCredit          Decimal?  @db.Decimal(18, 2)
  currency             String?
  exchangeRate         Decimal?  @db.Decimal(18, 8)
  baseCurrency         String?
  /// Posting date determines the accounting period; transaction date preserved in entryDate.
  postingDate          DateTime?
  accountingPeriodId   String?
  financialYearLabel   String?
  /// Traceability: template + architecture version + accounting event identity.
  templateId           String?
  templateVersion      Int?
  architectureVersion  String    @default("LEGACY_V1")
  /// One active posting per accounting event — database-enforced.
  accountingEventId    String?   @unique
  postingMode          String?
  approvedById         String?
  approvedAt           DateTime?
  adjustmentCategory   String?
  adjustmentReason     String?
  relatedJournalId     String?
  metadata             Json?
  /// ── Phase 5 canonical journal columns (additive) ──
  /// Human-readable source document number (invoice number, receipt number, …).
  sourceNumber         String?
  /// Reversal linkage: NOT_REVERSED | REVERSED | REVERSAL (this row reverses another).
  reversalStatus       String?
  /// Set on reversal journals: the journal this row reverses.
  originalJournalId    String?
  /// Set on reversed originals: the posted reversal journal.
  reversedByJournalId  String?
  reversedAt           DateTime?
  reversedById         String?
  goodsReceipts    GoodsReceipt[]     @relation("GoodsReceiptJournalEntry")
  branch           Branch?            @relation(fields: [branchId], references: [id])
  createdBy        User?              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedBy         User?              @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines            JournalEntryLine[]
  supplierBills    SupplierBill[]     @relation("SupplierBillJournalEntry")
  supplierPayments SupplierPayment[]  @relation("SupplierPaymentJournalEntry")

  @@unique([tenantId, journalNumber])
  @@index([tenantId])
  @@index([entryDate])
  @@index([status])
  @@index([entryType])
  @@index([referenceNumber])
  @@index([branchId])
  @@index([tenantId, architectureVersion, status])
  @@index([tenantId, postingDate])
  @@index([tenantId, sourceType, sourceId])
  @@index([originalJournalId])
  @@index([reversedByJournalId])
  @@index([tenantId, entryType])
}

