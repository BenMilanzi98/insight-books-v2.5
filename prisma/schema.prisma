  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments              LiabilityPayment[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([liabilityType])
