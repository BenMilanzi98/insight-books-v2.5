  postedBy    User?     @relation("CreditNotePostedBy", fields: [postedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([status])
  @@index([noteDate])
