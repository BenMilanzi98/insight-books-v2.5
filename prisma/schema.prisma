  serviceDefaultQty     Decimal?               @db.Decimal(12, 4)
  incomeAccountId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenantId              String
  category              String?
  location              String?
  reorderPoint          Int?
  image                 String?
  averageCost           Decimal?               @default(0) @db.Decimal(15, 2)
  barcode               String?
  batchNumber           String?
  categoryId            String?
  cogsAccountId         String?
  deletedAt             DateTime?
  deletedBy             String?
  deletionReason        String?
  dimensions            String?
  discountAmount        Decimal?               @db.Decimal(18, 2)
  expiryDate            DateTime?
  inventoryAccountId    String?
  isDeleted             Boolean                @default(false)
  isPerishable          Boolean                @default(false)
  lastPurchaseCost      Decimal?               @db.Decimal(15, 2)
  lastPurchaseDate      DateTime?
  leadTimeDays          Int?
  locationId            String?
  preferredSupplierId   String?
  reorderLevel          Decimal?               @db.Decimal(15, 2)
  reorderQuantity       Decimal?               @db.Decimal(15, 2)
  supplier              String?
  tags                  String[]               @default([])
  taxRate               Float                  @default(0)
  totalPurchasedQty     Decimal?               @default(0) @db.Decimal(18, 4)
  totalSoldQty          Decimal?               @default(0) @db.Decimal(18, 4)
  totalStockValue       Decimal?               @default(0) @db.Decimal(18, 2)
  /// Case/whitespace-normalized name for Business-scoped matching (simple stock import).
  normalizedName        String?
  weight                Float?
  branchId              String?
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoiceItems          InvoiceItem[]
  branch                Branch?                @relation(fields: [branchId], references: [id])
  inventoryCategory     InventoryCategory?     @relation(fields: [categoryId], references: [id])
  incomeAccount         Account?               @relation("ProductIncomeAccount", fields: [incomeAccountId], references: [id])
  cogsAccount           Account?               @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  deletedByUser         User?                  @relation("ProductDeletions", fields: [deletedBy], references: [id])
  inventoryAccount      Account?               @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  inventoryLocation     InventoryLocation?     @relation(fields: [locationId], references: [id])
  preferredSupplier     Supplier?              @relation(fields: [preferredSupplierId], references: [id])
