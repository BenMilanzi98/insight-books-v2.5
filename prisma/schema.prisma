  amendedFrom TaxReturn? @relation("TaxReturnAmendment", fields: [amendedFromId], references: [id])
  amendments  TaxReturn[] @relation("TaxReturnAmendment")

  @@index([tenantId, status])
  @@index([taxPeriodId])
  @@map("tax_return")
}

/// Wave 4 — tax payment / settlement register (GL via existing settle / V2 path).
model TaxPayment {
