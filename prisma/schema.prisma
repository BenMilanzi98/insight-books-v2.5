  privacyClass   String   @default("INTERNAL")
  actorType      String?
  actorId        String?
  correlationId  String?
  requestId      String?
  payload        Json
  outboxId       String?

  @@index([eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([sourceType, sourceId])
}

model AnalyticsConsumerCheckpoint {
  id           String   @id @default(cuid())
  consumerName String   @unique
  lastEventId  String?
  lastOccurredAt DateTime?
  cursor       Json?
  updatedAt    DateTime @updatedAt
}

model AnalyticsDeadLetter {
  id             String   @id @default(cuid())
  outboxId       String?
  eventId        String?
  eventType      String?
  errorCode      String?
  errorMessage   String
  payload        Json?
  attemptCount   Int      @default(0)
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

