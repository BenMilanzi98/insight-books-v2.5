  at             DateTime @default(now())
  createdAt      DateTime @default(now())
  conversion     CrmConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  step           CrmConversionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([conversionId, stepCode])
  @@index([stepId])
}

model CrmConversionFailure {
  id                  String   @id @default(cuid())
  conversionId        String?
  conversionRequestId String?
  errorCode           String
  detailJson          Json?
  createdAt           DateTime @default(now())
  conversion          CrmConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@index([conversionId])
  @@index([conversionRequestId])
  @@index([errorCode])
}

/// Phase 16 Wave 2 — audited Customer/Tenant match create-or-link decisions.
model CrmConversionMatchDecision {
  id              String   @id @default(cuid())
  conversionId    String
  decisionType    String
  matchState      String?
  decision        String?
  actionRequested String?
  ok              Boolean  @default(false)
  errorCode       String?
  candidateJson   Json?
  actorAdminId    String?
  createdAt       DateTime @default(now())
  conversion      CrmConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@index([conversionId, decisionType])
  @@index([matchState])
  @@index([actorAdminId])
}

/// Phase 16 Wave 2 — durable provisioned resource refs (Customer/Tenant/Business/Branch/Invite).
model CrmConversionResource {
  id             String   @id @default(cuid())
  conversionId   String
  resourceType   String
  resourceId     String
  action         String?
  status         String?
  idempotencyKey String?
  metaJson       Json?
  actorAdminId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversion     CrmConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, resourceType, idempotencyKey])
  @@index([conversionId, resourceType])
  @@index([resourceId])
  @@index([idempotencyKey])
}

/// Phase 16 Wave 2 — hash-only user invitations (no raw tokens / passwords).
model CrmConversionInvitation {
  id               String    @id @default(cuid())
  conversionId     String?
  tenantId         String
  contactId        String?
  email            String
  tokenHash        String
  status           String    @default("PENDING")
  expiresAt        DateTime?
  revokedAt        DateTime?
  idempotencyKey   String?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  conversion       CrmConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@unique([conversionId, idempotencyKey])
  @@index([tenantId, status])
  @@index([email])
  @@index([tokenHash])
  @@index([idempotencyKey])
}

/// Phase 16 Wave 2 — optional Platform Customer representation for conversion identity plane.
/// Distinct from CRM Account and from Tenant; status PROVISIONING until activation policy (Wave 3).
model PlatformCustomer {
  id                   String   @id @default(cuid())
  displayName          String
  registrationNumber   String?
  taxId                String?
  domain               String?
  email                String?
  accountId            String?
  status               String   @default("PROVISIONING")
  externalKey          String?
  createdByAdminId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([registrationNumber])
  @@index([taxId])
  @@index([domain])
  @@index([status])
  @@index([accountId])
  @@index([displayName])
}

/// Phase 16 Wave 3 — Platform Billing Account (SaaS plane; not Tenant AR).
model PlatformBillingAccount {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String?
  currency         String   @default("MWK")
  status           String   @default("ACTIVE")
  action           String?
  idempotencyKey   String   @unique
  metaJson         Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

/// Phase 16 Wave 3 — Platform Billing Schedule bound to subscription + accepted period.
model PlatformBillingSchedule {
  id               String    @id @default(cuid())
  billingAccountId String
  subscriptionId   String?
  cycle            String    @default("month")
  periodStart      DateTime?
  periodEnd        DateTime?
  status           String    @default("SCHEDULED")
  idempotencyKey   String    @unique
  metaJson         Json?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([billingAccountId])
  @@index([subscriptionId])
  @@index([status])
}

/// Phase 16 Wave 3 — Activation policy attempts (idempotent; Closed Won ≠ ACTIVE).
model CrmConversionActivationAttempt {
  id                         String   @id @default(cuid())
  subscriptionId             String
  policy                     String
  activationPolicyVersionId  String?
  ok                         Boolean  @default(false)
  activated                  Boolean  @default(false)
  status                     String?
  errorCode                  String?
  evidenceJson               Json?
  idempotencyKey             String
  actorAdminId               String?
  createdAt                  DateTime @default(now())

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId])
  @@index([policy])
  @@index([activated])
}

/// Phase 16 Wave 4 — CS assignment audit (ownership row; never fabricates health).
model CrmConversionCsAssignment {
  id               String   @id @default(cuid())
  conversionId     String?
  tenantId         String
  ownerAdminId     String
  portfolioId      String?
  ownershipId      String?
  status           String   @default("ASSIGNED")
  idempotencyKey   String   @unique
  metaJson         Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([conversionId])
  @@index([tenantId, status])
  @@index([ownerAdminId])
}

/// Phase 16 Wave 4 — Domain handoffs (onboarding/training/migration/MRA). Handoff ≠ execute.
model CrmConversionDomainHandoff {
  id               String   @id @default(cuid())
  conversionId     String?
  tenantId         String?
  handoffType      String
  status           String   @default("EMITTED")
  executionStatus  String   @default("NOT_STARTED")
  idempotencyKey   String   @unique
  payloadJson      Json?
  checksumSha256   String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([conversionId, handoffType])
  @@index([tenantId, handoffType])
  @@index([status])
}

/// Phase 16 Wave 4 — Completion certificate (stable checksum; ≠ PAID/ACTIVE/onboarding complete).
model CrmConversionCompletionCertificate {
  id                 String   @id @default(cuid())
  conversionId       String
  acceptanceId       String?
  documentVersionId  String?
  tenantId           String?
  checksumSha256     String
  status             String   @default("ISSUED")
  idempotencyKey     String   @unique
  payloadJson        Json?
  createdByAdminId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([conversionId])
  @@index([acceptanceId])
  @@index([checksumSha256])
}

/// Phase 16 Wave 4 — Conversion DQ incidents (gate fail ≠ fabricated zero).
model CrmConversionDqIncident {
  id        String   @id @default(cuid())
  code      String
  severity  String   @default("MEDIUM")
  count     Int      @default(0)
  detailJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code, createdAt])
  @@index([severity])
}

/// Phase 16 Wave 4 — Conversion reconciliation runs.
model CrmConversionReconRun {
  id               String   @id @default(cuid())
  status           String
  cardsJson        Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

/// Phase 13 Wave 4 — Reminder (dedupe rule+activity+recipient+occurrence+channel).
/// Delivery ≠ Activity complete; ≠ billing subscription reminders.
model CrmReminder {
  id               String    @id @default(cuid())
  dedupeKey        String    @unique
  ruleKey          String
  activityId       String?
  recipientAdminId String?
  channel          String    @default("IN_APP")
  occurrenceKey    String
  status           String    @default("SCHEDULED")
  dueAt            DateTime
  snoozeUntil      DateTime?
  deliveredAt      DateTime?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  activity         CrmActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recipientAdmin   Admin?    @relation("CrmReminderRecipient", fields: [recipientAdminId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?    @relation("CrmReminderCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([activityId, status])
  @@index([recipientAdminId, status, dueAt])
  @@index([status, dueAt])
  @@index([ruleKey, occurrenceKey])
}

/// Phase 13 Wave 4 — versioned Activity/Task templates (ACTIVE not directly editable).
model CrmActivityTemplate {
  id               String   @id @default(cuid())
  code             String
  version          Int
  kind             String   @default("TASK")
  status           String   @default("DRAFT")
  name             String?
  titleTemplate    String?
  bodyTemplate     String?
  defaultsJson     Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByAdmin   Admin?   @relation("CrmActivityTemplateCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([code, version])
  @@index([code, status])
  @@index([kind, status])
  @@index([createdByAdminId])
}

/// Phase 13 Wave 4 — automation rule (small approved trigger set; SoD approval).
model CrmAutomationRule {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String?
  trigger            String
  action             String
  status             String    @default("DRAFT")
  configJson         Json?
  requestedByAdminId String?
  approvedByAdminId  String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  requestedByAdmin   Admin?    @relation("CrmAutomationRuleRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  approvedByAdmin    Admin?    @relation("CrmAutomationRuleApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvals          CrmAutomationApproval[]
  executions         CrmAutomationExecution[]

  @@index([status, trigger])
  @@index([requestedByAdminId])
  @@index([approvedByAdminId])
}

model CrmAutomationApproval {
  id           String   @id @default(cuid())
  ruleId       String
  action       String
  actorAdminId String?
  note         String?
  at           DateTime @default(now())
  rule         CrmAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actorAdmin   Admin?   @relation("CrmAutomationApprovalActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([ruleId, at])
  @@index([actorAdminId])
}

/// Idempotent automation execution (rule+trigger+subject+occurrence).
model CrmAutomationExecution {
  id               String   @id @default(cuid())
  ruleId           String
  idempotencyKey   String   @unique
  trigger          String
  action           String
  subjectType      String?
  subjectId        String?
  status           String
  resultJson       Json?
  executedByAdminId String?
  at               DateTime @default(now())
  rule             CrmAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  executedByAdmin  Admin?   @relation("CrmAutomationExecutionBy", fields: [executedByAdminId], references: [id], onDelete: SetNull)

  @@index([ruleId, at])
  @@index([subjectType, subjectId])
  @@index([status, at])
  @@index([executedByAdminId])
}

/// Phase 13 Wave 4 — Activity report schedules + audited runs.
model CrmActivityReportSchedule {
  id               String    @id @default(cuid())
  name             String
  activityType     String?
  cronExpression   String?
  status           String    @default("ACTIVE")
  createdByAdminId String?
  lastRunAt        DateTime?
  lastRunStatus    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdByAdmin   Admin?    @relation("CrmActivityReportScheduleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  runs             CrmActivityReportRun[]

  @@index([status, createdAt])
  @@index([createdByAdminId])
}

model CrmActivityReportRun {
  id           String   @id @default(cuid())
  scheduleId   String?
  status       String
  summaryJson  Json?
  runByAdminId String?
  at           DateTime @default(now())
  schedule     CrmActivityReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  runByAdmin   Admin?   @relation("CrmActivityReportRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)

  @@index([scheduleId, at])
  @@index([status, at])
  @@index([runByAdminId])
}

/// Phase 11 Wave 4 — controlled merge request (SoD: requester ≠ approver).
model CrmMergeRequest {
  id                   String    @id @default(cuid())
  entityType           String    @default("LEAD")
  survivorId           String
  loserId              String
  status               String    @default("PENDING")
  requestedByAdminId   String?
  approvedByAdminId    String?
  executedByAdminId    String?
  duplicateCandidateId String?
  reason               String?
  evidenceJson         Json?
  requestedAt          DateTime  @default(now())
  approvedAt           DateTime?
  executedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  requestedByAdmin     Admin?    @relation("CrmMergeRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  approvedByAdmin      Admin?    @relation("CrmMergeApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  executedByAdmin      Admin?    @relation("CrmMergeExecutedBy", fields: [executedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([survivorId])
  @@index([loserId])
  @@index([entityType, status])
  @@index([requestedByAdminId])
  @@index([approvedByAdminId])
}

/// Phase 11 Wave 4 — light CRM reconciliation run audit.
model CrmReconciliationRun {
  id          String   @id @default(cuid())
  status      String
  summaryJson Json?
  runByAdminId String?
  at          DateTime @default(now())
  runByAdmin  Admin?   @relation("CrmReconciliationRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([status, at])
  @@index([runByAdminId])
}

/// Phase 11 Wave 4 — CRM export audit (JSON/CSV foundation).
model CrmExportAudit {
  id               String   @id @default(cuid())
  dataset          String
  format           String
  rowCount         Int      @default(0)
  exportedByAdminId String?
  at               DateTime @default(now())
  exportedByAdmin  Admin?   @relation("CrmExportAuditBy", fields: [exportedByAdminId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([dataset, at])
  @@index([exportedByAdminId])
}

/// Phase 12 Wave 1 — versioned Sales Pipeline catalogue (≠ analytics-pipeline).
model CrmPipeline {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  CrmPipelineVersion[]

  @@index([status])
}

/// Phase 12 Wave 1 — Pipeline version (ACTIVE NEW_BUSINESS v1 first).
model CrmPipelineVersion {
  id          String   @id @default(cuid())
  pipelineId  String
  versionId   String
  version     String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stages      CrmPipelineStage[]

  @@unique([pipelineId, versionId])
  @@index([pipelineId, status])
  @@index([status])
}

/// Phase 12 Wave 1 — Pipeline stage defs (entry/exit + optional defaultProbability stub).
model CrmPipelineStage {
  id                String   @id @default(cuid())
  pipelineVersionId String
  code              String
  name              String
  sortOrder         Int
  terminal          Boolean  @default(false)
  /// Wave 2 consumes; Wave 1 stub OK
  defaultProbability Int?
  entryCriteria     Json?
  exitCriteria      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  pipelineVersion   CrmPipelineVersion @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade)

  @@unique([pipelineVersionId, code])
  @@index([pipelineVersionId, sortOrder])
}

/// Phase 12 Wave 1–2 — CrmOpportunity (≠ Lead ≠ Customer ≠ Subscription ≠ Invoice).
/// Wave 2 adds commercial / probability / close-date; never invent when unset.
model CrmOpportunity {
  id                     String   @id @default(cuid())
  opportunityNumber      String   @unique
  pipelineCode           String   @default("NEW_BUSINESS")
  pipelineVersionId      String?
  stageCode              String
  status                 String   @default("OPEN")
  leadId                 String?
  accountId              String?
  contactId              String?
  title                  String
  ownerAdminId           String?
  createdByAdminId       String?
  handoffIdempotencyKey  String?  @unique
  /// Optimistic locking for stage transitions
  version                Int      @default(1)
  /// Wave 2 — non-binding commercial estimate
  amount                 Decimal? @db.Decimal(18, 2)
  currency               String?
  amountBasis            String?
  recurringAnnualAmount  Decimal? @db.Decimal(18, 2)
  oneTimeAmount          Decimal? @db.Decimal(18, 2)
  /// Wave 2 — explainable probability (not ML / not Revenue certainty)
  probability            Int?
  probabilitySource      String?
  probabilityConfidence  String?
  probabilityOverrideReason String?
  /// Wave 2 — expected close with provenance
  expectedCloseDate      DateTime?
  closeDateSource        String?
  closeDateConfidence    String?
  /// Wave 3 — win/loss close (never provisions Tenant/Subscription/Invoice)
  winReason              String?
  lossReason             String?
  decisionDate           DateTime?
  closeEvidence          Json?
  closedAt               DateTime?
  closedByAdminId        String?
  closeApprovalStatus    String?
  reopenReason           String?
  reopenedAt             DateTime?
  reopenedByAdminId      String?
  /// Wave 4 — audited import idempotency (distinct from handoff key)
  importIdempotencyKey   String?  @unique
  /// Wave 4 — controlled merge loser pointer
  mergedIntoOpportunityId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  ownerAdmin             Admin?   @relation("CrmOpportunityOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  createdByAdmin         Admin?   @relation("CrmOpportunityCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  closedByAdmin          Admin?   @relation("CrmOpportunityClosedBy", fields: [closedByAdminId], references: [id], onDelete: SetNull)
  reopenedByAdmin        Admin?   @relation("CrmOpportunityReopenedBy", fields: [reopenedByAdminId], references: [id], onDelete: SetNull)
  stageHistory           CrmOpportunityStageHistory[]
  contactRoles           CrmOpportunityContactRole[]
  contactRoleHistory     CrmOpportunityContactRoleHistory[]
  products               CrmOpportunityProduct[]
  amountHistory          CrmOpportunityAmountHistory[]
  probabilityHistory     CrmOpportunityProbabilityHistory[]
  closeDateHistory       CrmOpportunityCloseDateHistory[]
  risks                  CrmOpportunityRisk[]
  duplicateCandidatesAsPrimary CrmOpportunityDuplicateCandidate[] @relation("CrmOppDupPrimary")
  duplicateCandidatesAsPeer    CrmOpportunityDuplicateCandidate[] @relation("CrmOppDupPeer")

  @@index([stageCode, createdAt])
  @@index([status, createdAt])
  @@index([leadId])
  @@index([accountId])
  @@index([contactId])
  @@index([ownerAdminId, status])
  @@index([pipelineCode, stageCode])
  @@index([currency, status])
  @@index([expectedCloseDate])
  @@index([closedAt])
  @@index([mergedIntoOpportunityId])
}

/// Phase 12 Wave 1 — append-only Opportunity stage history (immutable).
model CrmOpportunityStageHistory {
  id                 String   @id @default(cuid())
  opportunityId      String
  fromStageCode      String?
  toStageCode        String
  changedByAdminId   String?
  reason             String?
  evidenceReferences Json?
  idempotencyKey     String?
  at                 DateTime @default(now())
  opportunity        CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedByAdmin     Admin?   @relation("CrmOpportunityStageChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@unique([opportunityId, idempotencyKey])
  @@index([opportunityId, at])
  @@index([changedByAdminId])
  @@index([toStageCode, at])
}

/// Phase 12 Wave 2 — Opportunity-specific contact roles (≠ platform permission grant).
model CrmOpportunityContactRole {
