model AffiliatePayout {
  id            String    @id @default(cuid())
  affiliateId   String
  amount        Float
  paymentMethod String
  reference     String?
  status        String
  processedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  description String
  reference   String?
  status      String    @default("posted") // draft, posted, void
  entryType   String    @default("Regular") // Regular, Adjusting, Closing, Opening
  sourceType  String? // Sale, Expense, Invoice, Manual, etc.
  sourceId    String? // Link to sale_id, expense_id, invoice_id, etc.
  createdById String?
  postedById  String?
  postedDate  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  branchId    String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  postedBy    User?     @relation("TransactionPostedBy", fields: [postedById], references: [id])

  // Relations
  lines TransactionLine[]

  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([sourceType])
  @@index([sourceId])
  @@index([reference])
  @@index([branchId])
}

// Transaction Lines (Double-entry)
model TransactionLine {
  id            String   @id @default(cuid())
  transactionId String
  lineNumber    Int
  accountId     String
  debitAmount   Float    @default(0)
  creditAmount  Float    @default(0)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account     @relation("TransactionLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
}

// Chart of Accounts - Enhanced
model Account {
  id              String   @id @default(cuid())
  accountCode     String? // e.g., "1010", "4010" - nullable for migration
  accountName     String? // nullable for migration
  accountType     String? // Asset, Liability, Equity, Income, Expense - nullable for migration
  accountSubtype  String? // Current Asset, Operating Income, etc.
  normalBalance   String? // Debit or Credit - nullable for migration
  parentAccountId String? // For hierarchical structure
  description     String?
  isActive        Boolean  @default(true)
  balance         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Legacy fields for migration
  code String? @map("code")
  name String? @map("name")
  type String? @map("type")

  // Relations
  parentAccount     Account?                @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     Account[]               @relation("AccountHierarchy")
  Expense           Expense[]
  journalEntryLines JournalEntryLine[]
  transactionLines  TransactionLine[]       @relation("TransactionLineAccount")
  accountBalances   AccountBalanceHistory[]
  productsInventory Product[]               @relation("ProductInventoryAccount")
  productsCogs      Product[]               @relation("ProductCogsAccount")
  bankAccounts      BankAccount[]
  equityAccounts    EquityAccount[]
  budgetItems       BudgetItem[]

  @@index([tenantId])
  @@index([accountType])
  @@index([isActive])
  @@index([parentAccountId])
  @@index([accountCode])
}

// Journal Entry Header
model JournalEntry {
  id              String    @id @default(cuid())
  entryDate       DateTime? // nullable for migration
  referenceNumber String?   @unique // nullable for migration
  description     String?
  entryType       String    @default("Regular") // Regular, Adjusting, Closing, Opening
  status          String    @default("Draft") // Draft, Posted, Void
  createdById     String? // nullable for migration
  postedById      String?
  postedDate      DateTime?
  sourceType      String? // Invoice, Expense, Manual, etc.
  sourceId        String? // Link to invoice_id, expense_id, etc.
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) // Changed from @updatedAt for migration
  tenantId        String?
  branchId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy       User?     @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedBy        User?     @relation("JournalEntryPostedBy", fields: [postedById], references: [id])

  // Legacy fields for migration
  transactionId String? @map("transactionId")
  accountId     String? @map("accountId")
  debit         Float?  @default(0) @map("debit")
  credit        Float?  @default(0) @map("credit")

  // Relations
  lines            JournalEntryLine[]
  goodsReceipts    GoodsReceipt[]     @relation("GoodsReceiptJournalEntry")
  supplierBills    SupplierBill[]     @relation("SupplierBillJournalEntry")
  supplierPayments SupplierPayment[]  @relation("SupplierPaymentJournalEntry")

  @@index([tenantId])
  @@index([entryDate])
  @@index([status])
  @@index([entryType])
  @@index([referenceNumber])
  @@index([branchId])
}

// Journal Entry Lines (Double-entry)
model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  debitAmount    Float    @default(0)
  creditAmount   Float    @default(0)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
}

// Account Balance History (for General Ledger)
model AccountBalanceHistory {
  id             String   @id @default(cuid())
  accountId      String
  periodDate     DateTime // Last day of period (month/quarter/year)
  openingBalance Float    @default(0)
  totalDebits    Float    @default(0)
  totalCredits   Float    @default(0)
  closingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodDate])
  @@index([accountId])
  @@index([periodDate])
}

model RecurringExpense {
  id                   String                    @id @default(cuid())
  description          String
  amount               Float
  category             String
  frequency            String
  dayOfMonth           Int?
  dayOfWeek            Int?
  startDate            DateTime
  endDate              DateTime?
  occurrences          Int?
  remainingOccurrences Int?
  endType              String
  status               String
  lastRunDate          DateTime?
  nextRunDate          DateTime?
  notes                String?
  createdById          String
  tenantId             String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdBy            User                      @relation(fields: [createdById], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  history              RecurringExpenseHistory[]

  @@index([tenantId])
  @@index([createdById])
}

model RecurringExpenseHistory {
  id                 String           @id @default(cuid())
  recurringExpenseId String
  expenseId          String
  scheduledDate      DateTime
  processedDate      DateTime
  status             String
  error              String?
  createdAt          DateTime         @default(now())
  expense            Expense          @relation(fields: [expenseId], references: [id])
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)

  @@index([recurringExpenseId])
  @@index([expenseId])
}

model Quotation {
  id                  String          @id @default(cuid())
  quotationNumber     String
  clientId            String
  createdById         String
  title               String
  issueDate           DateTime
  validUntil          DateTime
  discount            Float           @default(0)
  subtotal            Float
  taxAmount           Float
  total               Float
  status              String
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenantId            String
  invoiceId           String?
  totalDiscountAmount Float           @default(0)
  client              Client          @relation(fields: [clientId], references: [id])
  createdBy           User            @relation("QuotationCreator", fields: [createdById], references: [id])
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  items               QuotationItem[]

  @@index([clientId])
  @@index([tenantId])
  @@index([createdById])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  productId      String?
  description    String
  quantity       Float
  unitPrice      Float
  taxRate        Float
  amount         Float
  discountAmount Float     @default(0)
  discountRate   Float     @default(0)
  netAmount      Float     @default(0)
  product        Product?  @relation(fields: [productId], references: [id])
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
}

model AccountSubscription {
  id              String    @id @default(cuid())
  tenantId        String
  plan            String
  txRef           String    @unique
  amount          Float
  currency        String
  status          String    @default("Pending")
  paymentMethod   String?
  notes           String?
  isActive        Boolean   @default(false)
  startedAt       DateTime?
  expiresAt       DateTime?
  paymentDate     DateTime?
  gatewayResponse Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isTrial         Boolean   @default(false)
  trialEndDate    DateTime?
  trialStartDate  DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([isActive])
  @@index([expiresAt])
  @@index([isTrial])
  @@index([trialEndDate])
}

model BaseUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  baseUnit    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]

  @@map("base_units")
}

model Unit {
  id               String        @id @default(cuid())
  baseUnitId       String
  name             String
  symbol           String        @unique
  conversionToBase Decimal       @db.Decimal(15, 6)
  isBaseUnit       Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  productUnits     ProductUnit[]
  baseUnit         BaseUnit      @relation(fields: [baseUnitId], references: [id], onDelete: Cascade)

  @@map("units")
}

model ProductUnit {
  id              String   @id @default(cuid())
  productId       String
  unitId          String
  isDefault       Boolean  @default(false)
  unitPrice       Decimal  @db.Decimal(10, 2)
  costPrice       Decimal  @db.Decimal(10, 2)
  quantityInStock Decimal  @default(0) @db.Decimal(15, 6)
  reorderPoint    Decimal  @default(0) @db.Decimal(15, 6)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([productId, unitId])
  @@map("product_units")
}

model AttendanceRecord {
  id            String    @id @default(cuid())
  employeeId    String
  tenantId      String
  date          DateTime
  clockIn       DateTime?
  clockOut      DateTime?
  hoursWorked   Float     @default(0)
  overtimeHours Float     @default(0)
  status        String    @default("Present") // Present, Absent, Late, Leave
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([date])
  @@index([employeeId])
}

model AttendanceRegister {
  id             String    @id @default(cuid())
  tenantId       String
  date           DateTime
  totalEmployees Int       @default(0)
  presentCount   Int       @default(0)
  absentCount    Int       @default(0)
  lateCount      Int       @default(0)
  leaveCount     Int       @default(0)
  finalizedAt    DateTime?
  finalizedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finalizedByUser User?  @relation(fields: [finalizedById], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
}

model LeavePolicy {
  id                    String        @id @default(cuid())
  name                  String
  description           String?
  leaveType             String        // annual, sick, maternity, paternity, emergency, unpaid
  maxDaysPerYear        Int?
  maxDaysPerRequest     Int?
  minDaysPerRequest     Int?
  requiresApproval      Boolean       @default(true)
  requiresDocumentation Boolean      @default(false)
  isPaid                Boolean       @default(true)
  accrualRate           Float?        // Days per month (e.g., 1.25 for 15 days/year)
  carryOverLimit        Int?          // Max days that can be carried over
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]

  @@index([tenantId])
  @@index([leaveType])
  @@index([isActive])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  leavePolicyId   String
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String?
  documentation  String?      // URL to uploaded document
  status          String      @default("pending") // pending, approved, rejected, cancelled
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewComments  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenantId        String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy     LeavePolicy  @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer        User?       @relation(fields: [reviewedBy], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model LeaveBalance {
  id                String      @id @default(cuid())
  employeeId        String
  leavePolicyId     String
  tenantId          String
  allocatedDays     Float       @default(0)  // Total days allocated for the year
  usedDays          Float       @default(0)  // Days used
  pendingDays       Float       @default(0)  // Days in pending requests
  availableDays     Float       @default(0)  // Available days (allocated - used - pending)
  carriedOverDays   Float       @default(0)  // Days carried over from previous year
  year              Int         // The year this balance is for
  lastCalculatedAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy       LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leavePolicyId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([year])
}

model PerformanceReview {
  id                String      @id @default(cuid())
  employeeId        String
  reviewerId        String      // User who conducted the review
  tenantId          String
  reviewPeriod      String      // e.g., "Q1 2024", "Annual 2024"
  reviewType        String      @default("annual") // annual, quarterly, mid-year, probation
  reviewDate        DateTime
  overallRating     Float       // 1-5 scale
  overallComments   String?
  strengths         String?
  areasForImprovement String?
  goalsAchieved     Int         @default(0)
  goalsTotal        Int         @default(0)
  status            String      @default("draft") // draft, completed, acknowledged
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer          User        @relation(fields: [reviewerId], references: [id])
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewCriteria    PerformanceReviewCriteria[]
  acknowledger      User?       @relation("ReviewAcknowledgedBy", fields: [acknowledgedBy], references: [id])
  goals             PerformanceGoal[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewDate])
  @@index([status])
}

model PerformanceReviewCriteria {
  id                String            @id @default(cuid())
  reviewId          String
  criteriaName      String            // e.g., "Communication", "Technical Skills"
  rating            Float             // 1-5 scale
  comments          String?
  weight            Float             @default(1.0) // Weight for calculating overall rating
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  review            PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceGoal {
  id                String      @id @default(cuid())
  employeeId        String
  tenantId          String
  title             String
  description       String?
  category          String?     // e.g., "Professional Development", "Sales", "Quality"
  targetValue       Float?      // Numeric target if applicable
  targetUnit        String?     // e.g., "sales", "projects", "percentage"
  startDate         DateTime
  targetDate        DateTime
  status            String      @default("active") // active, completed, cancelled, on-hold
  progress          Float       @default(0) // 0-100 percentage
  currentValue      Float?      // Current progress value
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review            PerformanceReview? @relation(fields: [reviewId], references: [id])
  reviewId          String?

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                String      @id @default(cuid())
  employeeId        String      // Employee receiving feedback
  feedbackGiverId   String      // Employee/User giving feedback
  tenantId          String
  feedbackType      String      @default("peer") // peer, manager, subordinate, self, 360
  reviewId          String?     // Optional link to performance review
  rating            Float?      // 1-5 scale (optional)
  strengths         String?
  areasForImprovement String?
  suggestions       String?
  isAnonymous       Boolean     @default(false)
  status            String      @default("submitted") // submitted, reviewed, archived
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  employee          Employee    @relation("FeedbackReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbackGiver     Employee    @relation("FeedbackGiven", fields: [feedbackGiverId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([feedbackGiverId])
  @@index([feedbackType])
  @@index([createdAt])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                      String                 @id @default(cuid())
  name                    String
  description             String?
  categoryId              String
  purchaseDate            DateTime
  originalCost            Float
  usefulLifeYears         Int
  depreciationMethod      String                 @default("straight_line")
  status                  String                 @default("active")
  location                String?
  serialNumber            String?
  supplier                String?
  warrantyExpiry          DateTime?
  notes                   String?
  isExistingAsset         Boolean                @default(false)
  accumulatedDepreciation Float                  @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenantId                String
  createdById             String
  category                AssetCategory          @relation(fields: [categoryId], references: [id])
  createdBy               User                   @relation("AssetCreatedBy", fields: [createdById], references: [id])
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depreciationSchedules   DepreciationSchedule[]
  journalEntries          AssetJournalEntry[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([purchaseDate])
}

model DepreciationSchedule {
  id                      String   @id @default(cuid())
  assetId                 String
  periodStart             DateTime
  periodEnd               DateTime
  depreciationAmount      Float
  accumulatedDepreciation Float
  netBookValue            Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodStart])
}

model AssetJournalEntry {
  id          String   @id @default(cuid())
  assetId     String
  entryType   String   @default("purchase")
  amount      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entryType])
}

model LiabilityCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liabilities Liability[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Liability {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  categoryId            String
  liabilityType         String // e.g., "loan", "credit_card", "mortgage", "other"
  principalAmount       Float
  interestRate          Float?             @default(0)
  interestType          String             @default("reducing_balance") // reducing_balance, one_time
  oneTimeInterestAmount Float?             @default(0)
  startDate             DateTime
  maturityDate          DateTime?
  termMonths            Int?
  paymentFrequency      String? // e.g., "monthly", "quarterly", "annually", "one_time"
  status                String             @default("active") // active, paid_off, defaulted
  lender                String? // Name of lender/creditor
  accountNumber         String?
  notes                 String?
  currentBalance        Float              @default(0) // Current outstanding balance
  totalPaid             Float              @default(0) // Total amount paid so far
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String
  createdById           String
  category              LiabilityCategory  @relation(fields: [categoryId], references: [id])
  createdBy             User               @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments              LiabilityPayment[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([liabilityType])
}

model LiabilityPayment {
  id            String    @id @default(cuid())
  liabilityId   String
  amount        Float
  paymentDate   DateTime
  paymentType   String    @default("principal") // principal, interest, both
  principalPaid Float     @default(0)
  interestPaid  Float     @default(0)
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  liability     Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId])
  @@index([paymentDate])
}

// Phase 3: Budget Management
model Budget {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  periodType   String       @default("annual") // 'annual', 'monthly', 'quarterly'
  startDate    DateTime
  endDate      DateTime
  status       String       @default("draft") // 'draft', 'approved', 'active', 'archived'
  version      Int          @default(1)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        BudgetItem[]
  approvedBy   User?        @relation("BudgetApprover", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([startDate, endDate])
}

model BudgetItem {
  id             String   @id @default(cuid())
  budgetId       String
  accountId      String?  // Optional: for account-based budgets
  category       String?  // Optional: for category-based budgets (e.g., "Rent Expense")
  period         DateTime // Month/quarter for this budget item
  budgetedAmount Float
  actualAmount   Float    @default(0)
  variance       Float? // Calculated: actual - budgeted
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account        Account? @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, category, period])
  @@index([budgetId])
  @@index([accountId])
  @@index([category])
  @@index([period])
}

// Phase 3: Currency Support
model Currency {
  id              String         @id @default(cuid())
  code            String         @unique // ISO 4217 code (USD, MWK, etc.)
  name            String
  symbol          String
  isActive        Boolean        @default(true)
  isBase          Boolean        @default(false) // Base currency for tenant
  exchangeRates   ExchangeRate[] @relation("FromCurrency")
  toExchangeRates ExchangeRate[] @relation("ToCurrency")

  @@index([isActive])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  effectiveDate  DateTime
  tenantId       String?
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([tenantId])
}
