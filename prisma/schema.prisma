model Payment {
  id                    String              @id @default(cuid())
  invoiceId             String?
  amount                Float
  paymentDate           DateTime
  paymentMethod         String
  reference             String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  status                String              @default("Completed")
  tenantId              String
  destinationAccount    String?
  sourceAccount         String?
  type                  String?
  expenseId             String?
  refundedAmount        Float               @default(0)
  saleId                String?
  branchId              String?
  // Reversal fields
  isReversal            Boolean             @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  branch                Branch?             @relation(fields: [branchId], references: [id])
  expense               Expense?            @relation(fields: [expenseId], references: [id])
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id])
  sale                  Sale?               @relation(fields: [saleId], references: [id])
  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  allocations           PaymentAllocation[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([expenseId])
  @@index([status])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([type])
  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model PaymentAccount {
  id                      String              @id @default(cuid())
  tenantId                String
  name                    String
  accountType             String // Cash, Bank, Mobile Money, Wallet, POS Terminal
  reference               String? // Account number, wallet ID, etc.
  isActive                Boolean             @default(true)
  isSystem                Boolean             @default(false) // System accounts (like Cash) cannot be deleted
  /// Links this POS/payment method to a Chart of Accounts asset (cash/bank) so GL and A/L stay in sync
  coaAccountId            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coaAccount              Account?            @relation("PaymentAccountCoa", fields: [coaAccountId], references: [id], onDelete: SetNull)
  allocations             PaymentAllocation[]
  posCashDaysAsSystemCash PosCashDay[]        @relation("PosCashDaySystemCash")
  posCashDayDepositsTo    PosCashDayDeposit[] @relation("PosCashDayDepositTo")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@index([isSystem])
  @@index([coaAccountId])
}

/// POS register: one row per tenant + branch scope + calendar business day (YYYY-MM-DD).
model PosCashDay {
  id                     String    @id @default(cuid())
  tenantId               String
  /// Stable branch scope: real branchId, or "none" when POS aggregates all allowed branches.
  branchKey              String    @default("none")
  businessDate           String
  status                 String    @default("OPEN")
  systemCashAccountId    String
  openingBalance         Float
  openedAt               DateTime  @default(now())
  openedById             String?
  closedAt               DateTime?
  closedById             String?
  autoClosed             Boolean   @default(false)
  totalSalesAtClose      Float?
  closingBalanceAtClose  Float?
  totalCashSalesSnapshot Float?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemCashAccount PaymentAccount      @relation("PosCashDaySystemCash", fields: [systemCashAccountId], references: [id], onDelete: Restrict)
  openedBy          User?               @relation("PosCashDayOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy          User?               @relation("PosCashDayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  deposits          PosCashDayDeposit[]

  @@unique([tenantId, branchKey, businessDate])
  @@index([tenantId, businessDate])
  @@index([status])
}

model PosCashDayDeposit {
  id           String   @id @default(cuid())
  posCashDayId String
  toAccountId  String
  amount       Float
  notes        String?
  isAutoSweep  Boolean  @default(false)
  createdAt    DateTime @default(now())
  createdById  String?

  posCashDay PosCashDay     @relation(fields: [posCashDayId], references: [id], onDelete: Cascade)
  toAccount  PaymentAccount @relation("PosCashDayDepositTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation("PosCashDayDepositCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([posCashDayId])
}

model PaymentAllocation {
  id               String         @id @default(cuid())
  paymentId        String
  paymentAccountId String
  amount           Float
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])

  @@index([paymentId])
  @@index([paymentAccountId])
}

model AccountBalance {
  id        String   @id @default(cuid())
  tenantId  String
  account   String
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, account])
}

model PaymentGateway {
  id         String  @id @default(cuid())
  name       String
  isActive   Boolean @default(true)
  configData String
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
}

model EmailLog {
  id              String    @id @default(cuid())
  recipientEmail  String
  recipientName   String
  subject         String
  template        String    @default("custom")
  priority        String    @default("normal")
  status          String    @default("pending")
  errorMessage    String?
  sentBy          String?
  sentByAdmin     String?
  tenantId        String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sentByAdminUser Admin?    @relation("EmailLogAdminSender", fields: [sentByAdmin], references: [id])
  sentByUser      User?     @relation("EmailLogSender", fields: [sentBy], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActivityLog", fields: [adminId], references: [id])
}

model Expense {
  id                      String                    @id @default(cuid())
  description             String
  amount                  Float // Total (incl. tax)
  taxAmount               Float?                    @default(0) // Tax component for reporting
  taxRate                 Float?                    @default(0) // Tax rate % when recorded
  date                    DateTime
  category                String
  categoryId              String?
  expenseAccountId        String?
  receiptUrl              String?
  submittedById           String
  status                  String
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tenantId                String
  merchant                String?
  sourceAccountId         String?
  paymentMethod           String?
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?
  historicalDate          DateTime?
  isDeleted               Boolean                   @default(false)
  isHistorical            Boolean                   @default(false)
  migrationBatch          String?
  originalReference       String?
  paidAmount              Float?
  paymentReference        String?
  paymentStatus           String                    @default("Fully paid")
  branchId                String?
  employeeId              String?
  supplierId              String?
  purchaseOrderId         String?
  purchaseOrderItemId     String?
  taxTypeId               String?
  // Reversal fields
  isReversal              Boolean                   @default(false)
  reversedTransactionId   String?
  reversalReason          String?
  reversedAt              DateTime?
  reversedById            String?
  branch                  Branch?                   @relation(fields: [branchId], references: [id])
  deletedBy               User?                     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  employee                Employee?                 @relation(fields: [employeeId], references: [id])
  expenseAccount          Account?                  @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  sourceAccount           Account?                  @relation("ExpenseSourceAccount", fields: [sourceAccountId], references: [id])
  submittedBy             User                      @relation(fields: [submittedById], references: [id])
  supplier                Supplier?                 @relation(fields: [supplierId], references: [id])
  expenseCategory         ExpenseCategory?          @relation(fields: [categoryId], references: [id])
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  taxType                 TaxType?                  @relation(fields: [taxTypeId], references: [id])
  purchaseOrder           PurchaseOrder?            @relation(fields: [purchaseOrderId], references: [id])
  expenseAttachments      ExpenseAttachment[]
  payments                Payment[]
  recurringExpenseHistory RecurringExpenseHistory[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([paymentMethod])
  @@index([isDeleted])
  @@index([isHistorical])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isHistorical])
  @@index([paymentStatus])
  @@index([branchId])
  @@index([employeeId])
  @@index([expenseAccountId])
  @@index([isReversal])
  @@index([reversedTransactionId])
  @@index([taxTypeId])
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  filename     String
  fileType     String
  fileSize     Int
  filePath     String
  uploadedAt   DateTime @default(now())
  uploadedById String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])
}

model Sale {
  id                         String                      @id @default(cuid())
  saleNumber                 String
  title                      String?
  orderNumber                String?
  clientId                   String?
  createdById                String
  saleDate                   DateTime                    @default(now())
  subtotal                   Float
  taxRate                    Float                       @default(0)
  taxAmount                  Float                       @default(0)
  total                      Float
  status                     String                      @default("completed")
  notes                      String?
  paymentMethod              String                      @default("cash")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  tenantId                   String
  discount                   Float                       @default(0)
  historicalDate             DateTime?
  isHistorical               Boolean                     @default(false)
  migrationBatch             String?
  originalReference          String?
  refundReason               String?
  refundedAt                 DateTime?
  refundedById               String?
  totalDiscountAmount        Float                       @default(0)
  totalTaxAmount             Float                       @default(0)
  voidReason                 String?
  voidedAt                   DateTime?
  voidedById                 String?
  branchId                   String?
  footerPhoneOverride        String? // Override default phone in receipt footer
  footerBankDetailsOverride  String? // Override default bank details in receipt footer
  /// Cash / POS: amount customer handed over (optional; for change calculation on receipt)
  posAmountTendered          Float?
  /// Cash / POS: change returned (optional)
  posChangeGiven             Float?
  // Reversal fields
  isReversal                 Boolean                     @default(false)
  reversedTransactionId      String?
  reversalReason             String?
  reversedAt                 DateTime?
  reversedById               String?
  inventoryBatchConsumptions InventoryBatchConsumption[]
  payments                   Payment[]
  branch                     Branch?                     @relation(fields: [branchId], references: [id])
  client                     Client?                     @relation(fields: [clientId], references: [id])
  createdBy                  User                        @relation("SaleCreations", fields: [createdById], references: [id])
  refundedBy                 User?                       @relation("SaleRefunds", fields: [refundedById], references: [id])
  tenant                     Tenant                      @relation("TenantSales", fields: [tenantId], references: [id])
  voidedBy                   User?                       @relation("SaleVoids", fields: [voidedById], references: [id])
  items                      SaleItem[]
  creditNotes                CreditNote[]
  debitNotes                 DebitNote[]

  @@index([clientId])
  @@index([tenantId])
  @@index([createdById])
  @@index([status])
  @@index([saleDate])
  @@index([branchId])
  @@index([isHistorical])
  @@index([historicalDate])
  @@index([migrationBatch])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model SaleItem {
  id                String        @id @default(cuid())
  saleId            String
  accountId         String?
  productId         String?
  description       String
  quantity          Float
  unitPrice         Float
  amount            Float
  customProductData Json?
  discount          Float         @default(0)
  discountAmount    Float         @default(0)
  isCustom          Boolean       @default(false)
  taxAmount         Float         @default(0)
  taxDescription    String?
  taxRate           Float         @default(0)
  product           Product?      @relation("ProductSales", fields: [productId], references: [id])
  account           Account?      @relation(fields: [accountId], references: [id])
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemTaxes         SaleItemTax[]

  @@index([saleId])
  @@index([productId])
  @@index([accountId])
  @@index([isCustom])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  sku                   String?
  price                 Float
  cost                  Float?
  stockLevel            Decimal?               @db.Decimal(15, 6)
  isService             Boolean                @default(false)
  /// Billing unit for sellable services: fixed | hourly | daily
  serviceBillingType    String?
  /// Default quantity on invoices/POS (e.g. 1 hour)
  serviceDefaultQty     Decimal?               @db.Decimal(12, 4)
  incomeAccountId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenantId              String
  category              String?
  location              String?
  reorderPoint          Int?
  image                 String?
  averageCost           Decimal?               @default(0) @db.Decimal(15, 2)
  barcode               String?
  batchNumber           String?
  categoryId            String?
  cogsAccountId         String?
  deletedAt             DateTime?
  deletedBy             String?
  deletionReason        String?
  dimensions            String?
  discountAmount        Float?
  expiryDate            DateTime?
  inventoryAccountId    String?
  isDeleted             Boolean                @default(false)
  isPerishable          Boolean                @default(false)
  lastPurchaseCost      Decimal?               @db.Decimal(15, 2)
  lastPurchaseDate      DateTime?
  leadTimeDays          Int?
  locationId            String?
  preferredSupplierId   String?
  reorderLevel          Decimal?               @db.Decimal(15, 2)
  reorderQuantity       Decimal?               @db.Decimal(15, 2)
  supplier              String?
  tags                  String[]               @default([])
  taxRate               Float                  @default(0)
  totalPurchasedQty     Decimal?               @default(0) @db.Decimal(18, 4)
  totalSoldQty          Decimal?               @default(0) @db.Decimal(18, 4)
  totalStockValue       Decimal?               @default(0) @db.Decimal(18, 2)
  weight                Float?
  branchId              String?
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoiceItems          InvoiceItem[]
  branch                Branch?                @relation(fields: [branchId], references: [id])
  inventoryCategory     InventoryCategory?     @relation(fields: [categoryId], references: [id])
  incomeAccount         Account?               @relation("ProductIncomeAccount", fields: [incomeAccountId], references: [id])
  cogsAccount           Account?               @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  deletedByUser         User?                  @relation("ProductDeletions", fields: [deletedBy], references: [id])
  inventoryAccount      Account?               @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  inventoryLocation     InventoryLocation?     @relation(fields: [locationId], references: [id])
  preferredSupplier     Supplier?              @relation(fields: [preferredSupplierId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  productTaxes          ProductTax[]
  purchaseOrderItems    PurchaseOrderItem[]
  quotationItems        QuotationItem[]
  saleItems             SaleItem[]             @relation("ProductSales")
  supplierBillItems     SupplierBillItem[]
  productUnits          ProductUnit[]
  productBarcodes       ProductBarcode[]
  stockTransfers        StockTransfer[]

  @@index([categoryId])
  @@index([locationId])
  @@index([branchId])
  @@index([isDeleted])
  @@index([deletedAt])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  barcode   String
  tenantId  String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@index([productId])
  @@index([tenantId])
}

model Supplier {
  id                String            @id @default(cuid())
  tenantId          String
  supplierCode      String            @unique
  supplierName      String
  contactPerson     String?
  email             String?
  phone             String?
  mobile            String?
  address           String?
  city              String?
  country           String?           @default("Malawi")
  postalCode        String?
  taxId             String?
  paymentTerms      Int?              @default(30)
  paymentPreference String? // Cash, Bank transfer, Card, Other
  currency          String?           @default("MWK")
  creditLimit       Float?
  currentBalance    Float             @default(0)
  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  isActive          Boolean           @default(true)
  notes             String?
  createdById       String?
  modifiedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  expenses          Expense[]
  goodsReceipts     GoodsReceipt[]
  products          Product[]
  purchaseOrders    PurchaseOrder[]
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]

  @@index([tenantId, supplierName])
  @@index([tenantId, isActive])
  @@index([tenantId, paymentPreference])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String
  tenantId             String
  supplierId           String
  orderType            String?             @default("goods") // "goods" | "services" | "mixed"
  createdById          String?
  approvedById         String?
  poDate               DateTime
  expectedDeliveryDate DateTime?
  deliveryAddress      String?
  paymentTerms         Int?
  currency             String?             @default("MWK")
  subtotal             Float?              @default(0)
  taxRate              Float?              @default(0)
  taxAmount            Float?              @default(0)
  totalAmount          Float?              @default(0)
  status               String              @default("Draft")
  notes                String?
  termsAndConditions   String?
  approvedDate         DateTime?
  sentDate             DateTime?
  pricesIncludeTax     Boolean             @default(false)
  supplierInvoiceUrl   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  receipts             GoodsReceipt[]
  expenses             Expense[]
  approvedBy           User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  createdBy            User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]
  supplierBills        SupplierBill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id                String             @id @default(cuid())
  purchaseOrderId   String
  lineNumber        Int
  lineType          String?            @default("goods") // "goods" | "service"
  productId         String?
  expenseCategoryId String?
  description       String?
  quantityOrdered   Decimal            @db.Decimal(12, 4)
  quantityReceived  Decimal            @default(0) @db.Decimal(12, 4)
  unitCost          Decimal            @db.Decimal(15, 2)
  taxTypeId         String?
  taxRate           Float?             @default(0)
  taxAmount         Float?             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  receiptItems      GoodsReceiptItem[]
  product           Product?           @relation(fields: [productId], references: [id])
  expenseCategory   ExpenseCategory?   @relation(fields: [expenseCategoryId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  taxType           TaxType?           @relation(fields: [taxTypeId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([expenseCategoryId])
  @@index([taxTypeId])
}

model GoodsReceipt {
  id                 String             @id @default(cuid())
  receiptNumber      String
  tenantId           String
  supplierId         String
  purchaseOrderId    String?
  receiptDate        DateTime
  supplierReference  String?
  totalAmount        Float?             @default(0)
  status             String             @default("Draft")
  receivedById       String?
  notes              String?
  journalEntryId     String?
  /// Set when FIFO/stock, GL journal, and linked supplier bill have been applied (immediate or via scheduled job).
  inventoryAppliedAt DateTime?
  createdAt          DateTime           @default(now())
  postedDate         DateTime?
  updatedAt          DateTime           @updatedAt
  journalEntry       JournalEntry?      @relation("GoodsReceiptJournalEntry", fields: [journalEntryId], references: [id])
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy         User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])
  supplier           Supplier           @relation(fields: [supplierId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items              GoodsReceiptItem[]
  supplierBills      SupplierBill[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([status, inventoryAppliedAt, receiptDate])
}

model GoodsReceiptItem {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  lineNumber          Int
  productId           String
  purchaseOrderItemId String?
  quantityReceived    Decimal            @db.Decimal(12, 4)
  unitCost            Decimal            @db.Decimal(15, 2)
  batchNumber         String?
  expiryDate          DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([goodsReceiptId])
  @@index([productId])
}

model SupplierBill {
  id                    String                      @id @default(cuid())
  billNumber            String                      @unique
  tenantId              String
  supplierId            String
  purchaseOrderId       String?
  goodsReceiptId        String?
  billDate              DateTime
  dueDate               DateTime
  billType              String                      @default("inventory")
  supplierInvoiceNumber String?
  subtotal              Float?
  taxAmount             Float?
  totalAmount           Float?
  amountPaid            Float?                      @default(0)
  status                String                      @default("Draft")
  paymentTerms          Int?
  currency              String?                     @default("MWK")
  notes                 String?
  journalEntryId        String?
  createdById           String?
  approvedById          String?
  finalizedAt           DateTime?
  finalizedById         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  approvedBy            User?                       @relation("SupplierBillApprover", fields: [approvedById], references: [id])
  createdBy             User?                       @relation("SupplierBillCreator", fields: [createdById], references: [id])
  finalizedBy           User?                       @relation("SupplierBillFinalizedBy", fields: [finalizedById], references: [id])
  goodsReceipt          GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  journalEntry          JournalEntry?               @relation("SupplierBillJournalEntry", fields: [journalEntryId], references: [id])
  purchaseOrder         PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
