  requiresDocumentation Boolean        @default(false)
  isPaid                Boolean        @default(true)
  accrualRate           Float?
  carryOverLimit        Int?
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tenantId              String
  leaveBalances         LeaveBalance[]
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests         LeaveRequest[]

  @@index([tenantId])
  @@index([leaveType])
  @@index([isActive])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  leavePolicyId  String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String?
  documentation  String?
  status         String      @default("pending")
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewComments String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenantId       String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy    LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  reviewer       User?       @relation(fields: [reviewedBy], references: [id])
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model LeaveBalance {
  id               String      @id @default(cuid())
  employeeId       String
  leavePolicyId    String
  tenantId         String
  allocatedDays    Float       @default(0)
  usedDays         Float       @default(0)
  pendingDays      Float       @default(0)
  availableDays    Float       @default(0)
  carriedOverDays  Float       @default(0)
  year             Int
  lastCalculatedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy      LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leavePolicyId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([year])
}

model PerformanceReview {
  id                  String                      @id @default(cuid())
  employeeId          String
  reviewerId          String
  tenantId            String
  reviewPeriod        String
  reviewType          String                      @default("annual")
  reviewDate          DateTime
  overallRating       Float
  overallComments     String?
  strengths           String?
  areasForImprovement String?
  goalsAchieved       Int                         @default(0)
  goalsTotal          Int                         @default(0)
  status              String                      @default("draft")
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  goals               PerformanceGoal[]
  acknowledger        User?                       @relation("ReviewAcknowledgedBy", fields: [acknowledgedBy], references: [id])
  employee            Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer            User                        @relation(fields: [reviewerId], references: [id])
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewCriteria      PerformanceReviewCriteria[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewDate])
  @@index([status])
}

model PerformanceReviewCriteria {
  id           String            @id @default(cuid())
  reviewId     String
  criteriaName String
  rating       Float
  comments     String?
  weight       Float             @default(1.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceGoal {
  id           String             @id @default(cuid())
  employeeId   String
  tenantId     String
  title        String
  description  String?
  category     String?
  targetValue  Float?
  targetUnit   String?
  startDate    DateTime
  targetDate   DateTime
  status       String             @default("active")
  progress     Float              @default(0)
  currentValue Float?
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reviewId     String?
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  review       PerformanceReview? @relation(fields: [reviewId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                  String   @id @default(cuid())
  employeeId          String
  feedbackGiverId     String
  tenantId            String
  feedbackType        String   @default("peer")
  reviewId            String?
  rating              Float?
  strengths           String?
  areasForImprovement String?
  suggestions         String?
  isAnonymous         Boolean  @default(false)
  status              String   @default("submitted")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  employee            Employee @relation("FeedbackReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbackGiver       Employee @relation("FeedbackGiven", fields: [feedbackGiverId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([feedbackGiverId])
  @@index([feedbackType])
  @@index([createdAt])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  assets      Asset[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                      String                       @id @default(cuid())
  name                    String
  description             String?
  categoryId              String
  purchaseDate            DateTime
  originalCost            Float
  usefulLifeYears         Int
  depreciationMethod      String                       @default("straight_line")
  status                  String                       @default("active")
  location                String?
  serialNumber            String?
  supplier                String?
  warrantyExpiry          DateTime?
  notes                   String?
  isExistingAsset         Boolean                      @default(false)
  accumulatedDepreciation Float                        @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  tenantId                String
  createdById             String
  category                AssetCategory                @relation(fields: [categoryId], references: [id])
  createdBy               User                         @relation("AssetCreatedBy", fields: [createdById], references: [id])
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntries          AssetJournalEntry[]
  depreciationSchedules   DepreciationSchedule[]
  interBusinessTransfers  AssetInterBusinessTransfer[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([purchaseDate])
}

/// Immutable audit row each time an asset is moved to another tenant (business).
model AssetInterBusinessTransfer {
  id               String   @id @default(cuid())
  assetId          String
  fromTenantId     String
  toTenantId       String
  fromTenantName   String
  toTenantName     String
  fromCategoryId   String
  toCategoryId     String
  fromCategoryName String
  toCategoryName   String
  transferredById  String
  transferredAt    DateTime @default(now())
  notes            String?
  snapshotJson     String

  asset         Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromTenant    Tenant @relation("AssetTransferFromTenant", fields: [fromTenantId], references: [id])
  toTenant      Tenant @relation("AssetTransferToTenant", fields: [toTenantId], references: [id])
  transferredBy User   @relation("AssetInterBusinessTransferBy", fields: [transferredById], references: [id])

  @@index([assetId])
  @@index([fromTenantId])
  @@index([toTenantId])
  @@index([transferredAt])
}

model DepreciationSchedule {
  id                      String   @id @default(cuid())
  assetId                 String
  periodStart             DateTime
  periodEnd               DateTime
  depreciationAmount      Float
  accumulatedDepreciation Float
  netBookValue            Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodStart])
}

model AssetJournalEntry {
  id          String   @id @default(cuid())
  assetId     String
