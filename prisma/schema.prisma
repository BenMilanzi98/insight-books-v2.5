model GratuityPayment {
  id                String          @id @default(cuid())
  tenantId          String?
  gratuityAccountId String
  amount            Decimal         @db.Decimal(18, 2)
  paymentDate       DateTime
  reference         String?
  notes             String?
  journalId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  gratuityAccount   GratuityAccount @relation(fields: [gratuityAccountId], references: [id], onDelete: Cascade)

  @@index([gratuityAccountId])
  @@index([paymentDate])
  @@index([tenantId])
}

model GratuityProvisionEntry {
  id                String          @id @default(cuid())
  tenantId          String
  gratuityAccountId String
  payrollRunId      String?
  amount            Decimal         @db.Decimal(18, 2)
  periodEnd         DateTime
  journalId         String?
  createdAt         DateTime        @default(now())
  gratuityAccount   GratuityAccount @relation(fields: [gratuityAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([gratuityAccountId])
  @@index([payrollRunId])
}

model SalaryAdvance {
  id                String             @id @default(cuid())
  employeeId        String
  tenantId          String
  amount            Decimal            @db.Decimal(18, 2)
  advanceDate       DateTime
  repaymentMonths   Int                @default(1)
  monthlyDeduction  Decimal            @db.Decimal(18, 2)
  totalDeducted     Decimal            @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal            @db.Decimal(18, 2)
  status            String             @default("Active")
  reference         String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deductions        AdvanceDeduction[]
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([advanceDate])
