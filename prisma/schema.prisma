  name        String
  description String?
  color       String?   @default("#4f46e5")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryLocation {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  type      String
  /// Matches fractional goods receipts / product stock (was Int; migration widens column).
  quantity  Decimal  @db.Decimal(18, 4)
  notes     String?
  createdAt DateTime @default(now())
  productId String
  userId    String
  tenantId  String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@index([tenantId, productId, createdAt])
}

model InventoryBatch {
  id           String                      @id @default(cuid())
  tenantId     String
  branchId     String?
  productId    String
  sourceType   String?
  sourceId     String?
  purchaseDate DateTime
  /// Null = non-perishable / unknown; used for expiry alerts and FIFO issuance blocking.
  expiryDate   DateTime?
  qtyPurchased Decimal                     @db.Decimal(18, 4)
  qtyRemaining Decimal                     @db.Decimal(18, 4)
  unitCost     Decimal                     @db.Decimal(15, 2)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  branch       Branch?                     @relation(fields: [branchId], references: [id])
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consumptions InventoryBatchConsumption[]

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId, expiryDate])
  @@index([tenantId, sourceType, sourceId])
}

/// Audit trail for batch expiry write-offs and optional restock linkage.
model InventoryExpiryAudit {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String?
  userId         String?
  productId      String
  batchId        String?
  action         String // write_off | restock
  quantity       Decimal  @db.Decimal(18, 4)
  unitCost       Decimal? @db.Decimal(15, 2)
  lossAmount     Decimal? @db.Decimal(18, 2)
  restockBatchId String?
  journalEntryId String?
  notes          String?
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([batchId])
}

model InventoryBatchConsumption {
  id         String         @id @default(cuid())
  tenantId   String
  batchId    String
  saleId     String?
  saleItemId String?
  quantity   Decimal        @db.Decimal(18, 4)
  unitCost   Decimal        @db.Decimal(15, 2)
  cogsAmount Decimal        @db.Decimal(18, 2)
  createdAt  DateTime       @default(now())
  batch      InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sale       Sale?          @relation(fields: [saleId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId])
  @@index([saleId])
  @@index([saleItemId])
}

model Employee {
