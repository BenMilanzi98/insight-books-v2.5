  resolutionType   String?
  resolutionReason String?
  resolvedBy       String?
  resolvedAt       DateTime?
  approvalId       String?
  evidenceReference String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, businessId, status])
  @@index([caseType, status])
  @@index([sourceEntityType, sourceEntityId])
}

model MraEisAlertState {
  id                String    @id @default(cuid())
  tenantId          String
  businessId        String?
  terminalId        String?
  alertType         String
  severity          String
  deduplicationKey  String    @unique
  status            String    @default("ACTIVE")
  firstTriggeredAt  DateTime  @default(now())
  lastTriggeredAt   DateTime  @default(now())
  triggerCount      Int       @default(1)
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionReason  String?
  sourceEntityType  String?
  sourceEntityId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([alertType, status])
}

model MraEisOutbox {
  id              String    @id @default(cuid())
  tenantId        String
  businessId      String?
  aggregateType   String
  aggregateId     String
  eventType       String
  eventVersion    String    @default("1")
  payload         Json
  payloadChecksum String
  idempotencyKey  String    @unique
  status          String    @default("PENDING")
  availableAt     DateTime  @default(now())
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  claimedBy       String?
  processedAt     DateTime?
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime?
  safeErrorCode   String?
  requestId       String?
  correlationId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([tenantId, businessId, eventType])
  @@index([aggregateType, aggregateId])
}

/// Phase 6 — encrypted credential backing store (no plaintext). Not exposed via ordinary CRUD.
model MraEisEncryptedSecret {
  id                         String    @id @default(cuid())
  credentialReferenceId      String    @unique
  tenantId                   String
  businessId                 String
  terminalId                 String
  environment                String
  credentialType             String
  ciphertext                 String
  wrappedDataKey             String
  nonce                      String
  authenticationTag          String
  algorithm                  String    @default("AES-256-GCM")
  algorithmVersion           String    @default("ENV_ENVELOPE_V1")
  masterKeyId                String
  keyVersion                 String
  authenticatedMetadataHash  String
  status                     String    @default("ACTIVE")
  createdAt                  DateTime  @default(now())
  rotatedAt                  DateTime?
  revokedAt                  DateTime?
  legalHold                  Boolean   @default(false)
  version                    Int       @default(1)

  @@index([tenantId, businessId, terminalId])
  @@index([masterKeyId, keyVersion, status])
  @@index([status])
}

/// Phase 6 — short-lived encrypted TAC / buyer-auth codes (one-time / expiry).
model MraEisEphemeralSecret {
  id                String    @id @default(cuid())
  tenantId          String
  businessId        String
  terminalId        String?
  environment       String
  secretType        String
  purpose           String
  ciphertext        String
  wrappedDataKey    String
  nonce             String
  authenticationTag String
  masterKeyId       String
  keyVersion        String
  metadataHash      String
  expiresAt         DateTime
  consumedAt        DateTime?
  destroyedAt       DateTime?
  oneTime           Boolean   @default(true)
  createdByService  String
  requestId         String?
  correlationId     String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, businessId, secretType, expiresAt])
  @@index([expiresAt, consumedAt])
}

/// Phase 6 — master/KEK metadata only (never raw master key material).
model MraEisCryptoKeyMeta {
  id            String    @id @default(cuid())
  keyId         String    @unique
  provider      String    @default("ENV_ENVELOPE")
  environment   String
  purpose       String
  status        String    @default("ACTIVE")
  version       String
  createdAt     DateTime  @default(now())
  activatedAt   DateTime?
  rotationDueAt DateTime?
  retiredAt     DateTime?
  revokedAt     DateTime?

  @@index([environment, purpose, status])
}

/// Phase 6 — master-key rewrap batch progress (idempotent rotation).
model MraEisKeyRotationBatch {
  id              String    @id @default(cuid())
  fromMasterKeyId String
  toMasterKeyId   String
  status          String    @default("PENDING")
  cursor          String?
  processedCount  Int       @default(0)
  failedCount     Int       @default(0)
  dryRun          Boolean   @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  safeErrorCode   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
}

/// Phase 7 — certified InsightBooks EIS product metadata (not inventory products).
model MraEisCertifiedProduct {
  id                   String    @id @default(cuid())
  environment          String
  productId            String
  productVersion       String
  certificationRecordId String?
  status               String    @default("ACTIVE")
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  approvedBy           String?
  verifiedAt           DateTime?
  sourceEvidenceReference String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([environment, productId, productVersion])
  @@index([environment, status])
}

/// Phase 7 — stable platform identity (non-ephemeral, environment-scoped).
model MraEisPlatformIdentity {
  id              String   @id @default(cuid())
  tenantId        String
  businessId      String
  environment     String
  identityKey     String
  identityValue   String
  version         String   @default("v1")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, businessId, environment, identityKey])
  @@index([tenantId, businessId, environment, status])
}

/// Phase 7 — append-only terminal activation attempts (no TAC plaintext).
model MraEisActivationAttempt {
  id                       String    @id @default(cuid())
  tenantId                 String
  businessId               String
  terminalId               String
  environment              String
  mode                     String    @default("MOCK")
  attemptNumber            Int
  status                   String
  idempotencyKey           String    @unique
  activationRequestChecksum String?
  endpointKey              String    @default("EP-ONB-01")
  requestContractVersion   String    @default("1")
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  httpStatus               Int?
  mraApplicationStatus     String?
  responseChecksum         String?
  outcome                  String?
  retryClassification      String?
  safeErrorCode            String?
  safeErrorSummary         String?
  unknownOutcomeAt         DateTime?
  tacEphemeralSecretId     String?
  sanitizedResponse        Json?
  requestId                String?
  correlationId            String?
  createdAt                DateTime  @default(now())

  @@unique([terminalId, attemptNumber])
  @@index([tenantId, businessId, terminalId, status])
  @@index([status, startedAt])
}

/// Phase 7 — append-only activation confirmation attempts (no secrets).
model MraEisConfirmationAttempt {
  id                     String    @id @default(cuid())
  tenantId               String
  businessId             String
  terminalId             String
  activationAttemptId    String?
  confirmationAttemptNumber Int
  status                 String
  requestChecksum        String?
  signerVersion          String?
  endpointKey            String    @default("EP-ONB-02")
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  httpStatus             Int?
  mraApplicationStatus   String?
  outcome                String?
  responseChecksum       String?
  retryClassification    String?
  safeErrorCode          String?
  unknownOutcomeAt       DateTime?
  sanitizedResponse      Json?
  requestId              String?
  correlationId          String?
  createdAt              DateTime  @default(now())

  @@unique([terminalId, confirmationAttemptNumber])
  @@index([tenantId, businessId, terminalId, status])
}

/// Phase 11 — append-only immutable eligibility decisions (no credentials / no BAC plaintext).
model MraEisEligibilityDecision {
  id                         String    @id @default(cuid())
  tenantId                   String
  businessId                 String
  sourceType                 String
  sourceId                   String
  sourceVersion              String
  sourceFinalizationIdentity String?
  environment                String
  decision                   String
  policyVersion              String
  evaluatedAt                DateTime
  evaluatedBy                String?
  terminalId                 String?
  configurationSetChecksum   String?
  mappingCompletenessVersion String?
  productServiceCompletenessVersion String?
  sourceChecksum             String?
  lineCount                  Int       @default(0)
  currency                   String    @default("MWK")
  grossAmount                Decimal?  @db.Decimal(18, 2)
  netAmount                  Decimal?  @db.Decimal(18, 2)
  taxAmount                  Decimal?  @db.Decimal(18, 2)
  levyAmount                 Decimal?  @db.Decimal(18, 2)
  discountAmount             Decimal?  @db.Decimal(18, 2)
  paymentTotal               Decimal?  @db.Decimal(18, 2)
  buyerClassification        String?
  blockerCodes               Json?
  warningCodes               Json?
  safeDecisionSummary        String?
  stageEvidence              Json?
  purpose                    String?
  supersedesDecisionId       String?
  createdAt                  DateTime  @default(now())

  bridges MraEisSalesBridge[]

  @@index([tenantId, businessId, sourceType, sourceId])
  @@index([tenantId, businessId, decision, evaluatedAt])
  @@index([sourceFinalizationIdentity])
}

/// Phase 11 — local sales transaction bridge (handoff to Phase 12 fiscal snapshot).
/// No credentials, no final MRA payload, no fiscal number, no MRA acceptance claim.
model MraEisSalesBridge {
  id                           String    @id @default(cuid())
  tenantId                     String
  businessId                   String
  branchId                     String?
  terminalId                   String?
  sourceType                   String
  sourceId                     String
  sourceVersion                String
  sourceFinalizationIdentity   String
  sourceTransactionNumber      String?
  sourceFinalizedAt            DateTime
  businessDate                 DateTime  @db.Date
  environment                  String
  status                       String
  applicabilityDecision        String?
  eligibilityDecisionId        String?
  eligibilityPolicyVersion     String?
  sourceChecksum               String?
  configurationSetChecksum     String?
  mappingCompletenessVersion   String?
  productServiceCompletenessVersion String?
  lineCount                    Int       @default(0)
  currency                     String    @default("MWK")
  grossAmount                  Decimal?  @db.Decimal(18, 2)
  taxAmount                    Decimal?  @db.Decimal(18, 2)
  levyAmount                   Decimal?  @db.Decimal(18, 2)
  discountAmount               Decimal?  @db.Decimal(18, 2)
  paymentTotal                 Decimal?  @db.Decimal(18, 2)
  buyerClassification          String?
  siteMappingId                String?
  warehouseMappingId           String?
  futureFiscalSnapshotId       String?
  bridgeCreatedAt              DateTime  @default(now())
  lastEvaluatedAt              DateTime?
  manualReviewCaseId           String?
  version                      Int       @default(1)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  eligibilityDecision MraEisEligibilityDecision? @relation(fields: [eligibilityDecisionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, businessId, sourceFinalizationIdentity, environment])
  @@unique([futureFiscalSnapshotId])
  @@index([tenantId, businessId, sourceType, sourceId])
  @@index([tenantId, businessId, status])
  @@index([status, lastEvaluatedAt])
  @@index([environment, status])
}

/// Phase 12 — scope-based fiscal sequence (never MAX+1; never from local invoice counts).
model MraEisFiscalSequenceScope {
  id                     String    @id @default(cuid())
  tenantId               String
  businessId             String
  environment            String
  scopeKey               String
  scopeType              String
  terminalId             String?
  mraSiteId              String?
  sourceType             String?
  onlineOrOfflineMode    String    @default("ONLINE")
  periodKey              String?
  prefix                 String?
  suffix                 String?
  padding                Int       @default(6)
  nextValue              Int       @default(1)
  lastReservedValue      Int?
  lastAssignedValue      Int?
  increment              Int       @default(1)
  resetPolicy            String    @default("PER_BUSINESS_DAY")
  contractVersion        String
  status                 String    @default("ACTIVE")
  initializationEvidence Json?
  initializedAt          DateTime?
  lastReconciledAt       DateTime?
  lastMraConfirmedValue  Int?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  reservations MraEisFiscalNumberReservation[]

  @@unique([tenantId, businessId, environment, scopeKey])
  @@index([tenantId, businessId, status])
  @@index([terminalId, environment])
}

/// Phase 12 — append-only fiscal number reservations (gaps preserved; no silent reuse).
model MraEisFiscalNumberReservation {
  id                     String    @id @default(cuid())
  tenantId               String
  businessId             String
  environment            String
  sequenceScopeId        String
  scopeKey               String
  fiscalSnapshotId       String
  reservationValue       Int
  formattedFiscalNumber  String
  status                 String
  idempotencyKey         String    @unique
  sequenceVersionBefore  Int
  sequenceVersionAfter   Int
  allocationId           String?
  reservedAt             DateTime  @default(now())
  assignedAt             DateTime?
  releasedAt             DateTime?
  voidedAt               DateTime?
  failureReason          String?
  createdBy              String?
  isSynthetic            Boolean   @default(true)
  isMraFiscalNumber      Boolean   @default(false)
  createdAt              DateTime  @default(now())

  sequenceScope MraEisFiscalSequenceScope @relation(fields: [sequenceScopeId], references: [id], onDelete: Restrict)

  @@unique([sequenceScopeId, reservationValue])
  @@unique([formattedFiscalNumber])
  @@index([tenantId, businessId, fiscalSnapshotId])
  @@index([status, reservedAt])
}

/// System Admin — timed support access into a tenant (real actor remains Admin).
model PlatformSupportAccess {
  id         String    @id @default(cuid())
  adminId    String
  tenantId   String
  reason     String
  status     String
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
  endReason  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([tenantId])
  @@index([status])
}

/// System Admin — singleton platform global settings (secrets stored in data JSON).
model PlatformGlobalSettings {
  id        String   @id @default("global")
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Platform SaaS invoices — separate from tenant AR Invoice.
model PlatformInvoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  tenantId       String
  subscriptionId String?
  periodStart    DateTime?
  periodEnd      DateTime?
  currency       String    @default("MWK")
  subtotal       Decimal   @db.Decimal(18, 2)
  discount       Decimal   @default(0) @db.Decimal(18, 2)
  tax            Decimal   @default(0) @db.Decimal(18, 2)
  total          Decimal   @db.Decimal(18, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(18, 2)
  outstanding    Decimal   @db.Decimal(18, 2)
  status         String    @default("DRAFT")
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([status])
}

/// Platform SaaS payments — separate from tenant AR Payment.
model PlatformPayment {
  id               String   @id @default(cuid())
  paymentNumber    String   @unique
  tenantId         String
  invoiceId        String?
  currency         String   @default("MWK")
  amount           Decimal  @db.Decimal(18, 2)
  method           String?
  gateway          String?
  gatewayReference String?
  status           String   @default("PENDING")
  idempotencyKey   String   @unique
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@unique([gateway, gatewayReference])
}

/// Versioned SaaS subscription plans — price edits create a new version.
model PlatformPlanVersion {
  id               String    @id @default(cuid())
  planCode         String
  version          Int
  name             String
  description      String?
  currency         String    @default("MWK")
  basePrice        Decimal   @db.Decimal(18, 2)
  billingFrequency String    @default("month")
  userLimit        Int?
  businessLimit    Int?
  featuresJson     Json      @default("[]")
  status           String    @default("ACTIVE")
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  @@unique([planCode, version])
  @@index([planCode])
  @@index([status])
}

/// Platform credits (e.g. overpayment) — separate from tenant AR.
model PlatformCredit {
  id             String    @id @default(cuid())
  creditNumber   String    @unique
  tenantId       String
  invoiceId      String?
  currency       String    @default("MWK")
  amount         Decimal   @db.Decimal(18, 2)
  remaining      Decimal   @db.Decimal(18, 2)
  reason         String?
  status         String    @default("OPEN")
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
}

/// Platform refunds against platform payments.
model PlatformRefund {
  id               String    @id @default(cuid())
  refundNumber     String    @unique
  tenantId         String
  paymentId        String
  invoiceId        String?
  currency         String    @default("MWK")
  amount           Decimal   @db.Decimal(18, 2)
  status           String    @default("COMPLETED")
  reason           String?
  gatewayReference String?
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  @@index([tenantId])
  @@index([paymentId])
  @@index([status])
}

/// Versioned platform email templates (no SMTP secrets).
model PlatformEmailTemplate {
  id          String   @id @default(cuid())
  code        String
  version     Int      @default(1)
  name        String
  subject     String
  bodyHtml    String
  bodyText    String?
  language    String   @default("en")
  category    String   @default("transactional")
  status      String   @default("ACTIVE")
  variables   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@unique([code, version])
  @@index([code])
  @@index([status])
}

/// Email suppression list (bounce / complaint / manual).
model PlatformEmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  source    String   @default("manual")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([active])
}

/// Platform feature entitlement overrides (plan vs tenant). Disabling does not delete tenant data.
model PlatformFeatureEntitlement {
  id          String    @id @default(cuid())
  tenantId    String
  featureCode String
  featureName String?
  source      String    @default("TENANT_OVERRIDE")
  status      String    @default("ACTIVE")
  reason      String?
  startDate   DateTime?
  endDate     DateTime?
  grantedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, featureCode])
  @@index([tenantId])
  @@index([featureCode])
  @@index([status])
}
