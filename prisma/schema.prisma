model Department {
  id          String     @id @default(cuid())
  name        String
  description String?
  color       String?    @default("#4f46e5")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  employees   Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Versioned employment terms — payroll must resolve the contract effective for the period.
model EmploymentContract {
  id                   String    @id @default(cuid())
  tenantId             String
  employeeId           String
  version              Int       @default(1)
  status               String    @default("DRAFT")
  payBasis             String    @default("MONTHLY_SALARY")
  payFrequency         String    @default("MONTHLY")
  basicSalary          Decimal   @default(0) @db.Decimal(18, 2)
  hourlyRate           Decimal?  @db.Decimal(18, 2)
  dailyRate            Decimal?  @db.Decimal(18, 2)
  standardWeeklyHours  Decimal?  @db.Decimal(8, 2)
  standardMonthlyHours Decimal?  @db.Decimal(8, 2)
  overtimeEligible     Boolean   @default(true)
  overtimeMultiplier   Decimal   @default(1.5) @db.Decimal(8, 4)
  currency             String    @default("MWK")
  position             String?
  departmentId         String?
  branchId             String?
  employmentType       String?
  pensionEligible      Boolean   @default(true)
  gratuityEligible     Boolean   @default(true)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  notes                String?
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId, status])
  @@index([effectiveFrom])
}

model Payroll {
  id                    String    @id @default(cuid())
  employeeId            String
  periodStart           DateTime
  periodEnd             DateTime
  basicSalary           Decimal   @default(0) @db.Decimal(18, 2)
  deductions            Decimal   @default(0) @db.Decimal(18, 2)
  additions             Decimal   @default(0) @db.Decimal(18, 2)
  netPay                Decimal   @default(0) @db.Decimal(18, 2)
  status                String    @default("Pending")
  paymentDate           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  notes                 String?
  grossPay              Decimal?  @default(0) @db.Decimal(18, 2)
  payeAmount            Decimal?  @default(0) @db.Decimal(18, 2)
  tenantId              String
  totalNpsAmount        Decimal?  @default(0) @db.Decimal(18, 2)
  gratuityAccruedAmount Decimal?  @default(0) @db.Decimal(18, 2)
  /// Optional link when a V2 run materializes legacy per-employee rows
  payrollRunId          String?
  employee              Employee  @relation(fields: [employeeId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun            PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@index([payrollRunId])
}

/// Configurable PAYE/tax bands per tenant (Malawi default seeded when missing).
model PayrollTaxConfiguration {
  id                      String    @id @default(cuid())
  tenantId                String
  country                 String    @default("MW")
  taxYear                 Int
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  /// [{ ceiling: number|null, rate: number, label?: string }] — marginal monthly bands
  bands                   Json
  monthlyTaxFreeAllowance Float     @default(0)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([effectiveFrom])
}

model Benefit {
  id                String            @id @default(cuid())
  name              String
  code              String?
  description       String?
  defaultAmount     Decimal?          @default(0) @db.Decimal(18, 2)
  defaultPercentage Decimal?          @default(0) @db.Decimal(8, 4)
  isTaxable         Boolean           @default(true)
  isPensionable     Boolean           @default(false)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeBenefits  EmployeeBenefit[]

  @@index([tenantId])
  @@index([isActive])
  @@index([tenantId, code])
}

model EmployeeBenefit {
  id            String    @id @default(cuid())
  tenantId      String?
  employeeId    String
  benefitId     String
  amount        Decimal   @default(0) @db.Decimal(18, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefit       Benefit   @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([employeeId, benefitId])
  @@index([employeeId])
  @@index([benefitId])
  @@index([tenantId])
