  minutesWorked          Int       @default(0)
  overtimeMinutes        Int       @default(0)
  status                 String    @default("Present")
  /// PENDING | APPROVED | REJECTED — only APPROVED rows enter payroll snapshots
  approvalStatus         String    @default("PENDING")
  approvedAt             DateTime?
  approvedById           String?
  overtimeApprovalStatus String    @default("PENDING")
  overtimeApprovedAt     DateTime?
  overtimeApprovedById   String?
  payrollLocked          Boolean   @default(false)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([date])
  @@index([employeeId])
  @@index([tenantId, approvalStatus])
}

model AttendanceRegister {
  id              String    @id @default(cuid())
  tenantId        String
  date            DateTime
  totalEmployees  Int       @default(0)
  presentCount    Int       @default(0)
  absentCount     Int       @default(0)
  lateCount       Int       @default(0)
  leaveCount      Int       @default(0)
  finalizedAt     DateTime?
  finalizedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finalizedByUser User?     @relation(fields: [finalizedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
}

model LeavePolicy {
  id                    String         @id @default(cuid())
  name                  String
  description           String?
  leaveType             String
  maxDaysPerYear        Int?
  maxDaysPerRequest     Int?
  minDaysPerRequest     Int?
  requiresApproval      Boolean        @default(true)
  requiresDocumentation Boolean        @default(false)
  isPaid                Boolean        @default(true)
  accrualRate           Float?
  carryOverLimit        Int?
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tenantId              String
  leaveBalances         LeaveBalance[]
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests         LeaveRequest[]

  @@index([tenantId])
  @@index([leaveType])
  @@index([isActive])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  leavePolicyId  String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String?
  documentation  String?
  status         String      @default("pending")
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewComments String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenantId       String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy    LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  reviewer       User?       @relation(fields: [reviewedBy], references: [id])
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model LeaveBalance {
  id               String      @id @default(cuid())
  employeeId       String
  leavePolicyId    String
  tenantId         String
  allocatedDays    Float       @default(0)
  usedDays         Float       @default(0)
  pendingDays      Float       @default(0)
  availableDays    Float       @default(0)
  carriedOverDays  Float       @default(0)
  year             Int
  lastCalculatedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy      LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leavePolicyId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leavePolicyId])
  @@index([year])
}

/// Idempotent leave accrual postings (one key per employee/policy/period).
model LeaveAccrualLedger {
  id              String   @id @default(cuid())
  tenantId        String
  employeeId      String
  leavePolicyId   String
  year            Int
  month           Int
  daysAccrued     Decimal  @db.Decimal(8, 2)
  idempotencyKey  String
  createdAt       DateTime @default(now())
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, employeeId, leavePolicyId, year, month])
}

model OvertimeRequest {
  id              String    @id @default(cuid())
  tenantId        String
  employeeId      String
  workDate        DateTime
  overtimeMinutes Int
  reason          String?
  status          String    @default("PENDING")
  reviewedAt      DateTime?
  reviewedById    String?
  attendanceId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([workDate])
}

model DisciplinaryCase {
  id           String                @id @default(cuid())
  tenantId     String
  employeeId   String
  title        String
  description  String?
  status       String                @default("OPEN")
  openedAt     DateTime              @default(now())
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  penalties    DisciplinaryPenalty[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

model DisciplinaryPenalty {
  id                 String           @id @default(cuid())
  tenantId           String
  disciplinaryCaseId String
  amount             Decimal          @db.Decimal(18, 2)
  effectivePeriodEnd DateTime
  status             String           @default("PENDING")
  approvedAt         DateTime?
  approvedById       String?
  payrollRunId       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  disciplinaryCase   DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([disciplinaryCaseId])
  @@index([status])
  @@index([effectivePeriodEnd])
}

model PensionRule {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String    @default("NPS")
  employeeRatePercent   Decimal   @db.Decimal(8, 4)
  employerRatePercent   Decimal   @db.Decimal(8, 4)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive, effectiveFrom])
}

model PensionContribution {
  id              String     @id @default(cuid())
  tenantId        String
  employeeId      String
  payrollRunId    String?
  periodEnd       DateTime
  employeeAmount  Decimal    @db.Decimal(18, 2)
  employerAmount  Decimal    @db.Decimal(18, 2)
  status          String     @default("ACCRUED")
  remittanceId    String?
  createdAt       DateTime   @default(now())
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun      PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  remittance      PensionRemittance? @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, payrollRunId])
  @@index([tenantId])
  @@index([periodEnd])
  @@index([remittanceId])
}

model PensionRemittance {
  id            String                @id @default(cuid())
  tenantId      String
  periodLabel   String
  amount        Decimal               @db.Decimal(18, 2)
  paidAt        DateTime?
  journalId     String?
  status        String                @default("DRAFT")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contributions PensionContribution[]

  @@index([tenantId])
  @@index([status])
}

model PayrollComponentDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  category    String
  calcMethod  String   @default("FIXED")
  isTaxable   Boolean  @default(false)
  isPensionable Boolean @default(false)
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PayrollFormulaTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  /// Structured AST JSON — never eval
  expression  Json
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, version])
  @@index([tenantId])
}

/// Period payroll run — authoritative calculation + posting container.
model PayrollRun {
  id                 String                 @id @default(cuid())
  tenantId           String
  runNumber          String?
  periodStart        DateTime
  periodEnd          DateTime
  status             String                 @default("DRAFT")
  version            Int                    @default(1)
  currency           String                 @default("MWK")
  inputSnapshot      Json?
  mappingSnapshot    Json?
  totals             Json?
  checksum           String?
  exceptions         Json?
  recognitionJournalId String?
  paymentBatchId     String?
  replacedRunId      String?
  reversedRunId      String?
  calculatedAt       DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedById       String?
  postedAt           DateTime?
  paidAt             DateTime?
  reversedAt         DateTime?
  createdById        String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees          PayrollRunEmployee[]
  results            EmployeePayrollResult[]
  paymentBatches     PayrollPaymentBatch[]
  legacyPayrolls     Payroll[]
  pensionContributions PensionContribution[]

  @@unique([tenantId, periodStart, periodEnd, version])
  @@index([tenantId])
  @@index([status])
  @@index([periodEnd])
}

model PayrollRunEmployee {
  id             String     @id @default(cuid())
  payrollRunId   String
  employeeId     String
  contractId     String?
  included       Boolean    @default(true)
  exclusionReason String?
  createdAt      DateTime   @default(now())
  payrollRun     PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model EmployeePayrollResult {
  id              String                  @id @default(cuid())
  tenantId        String
  payrollRunId    String
  employeeId      String
  grossPay        Decimal                 @default(0) @db.Decimal(18, 2)
  taxablePay      Decimal                 @default(0) @db.Decimal(18, 2)
  payeAmount      Decimal                 @default(0) @db.Decimal(18, 2)
  npsEmployee     Decimal                 @default(0) @db.Decimal(18, 2)
  npsEmployer     Decimal                 @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal                 @default(0) @db.Decimal(18, 2)
  advanceRecovery Decimal                 @default(0) @db.Decimal(18, 2)
  netPay          Decimal                 @default(0) @db.Decimal(18, 2)
  explanation     Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  payrollRun      PayrollRun              @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  components      PayrollResultComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
}

model PayrollResultComponent {
  id         String                @id @default(cuid())
  resultId   String
  code       String
  name       String
  category   String
  amount     Decimal               @db.Decimal(18, 2)
  isCredit   Boolean               @default(false)
  sortOrder  Int                   @default(100)
  meta       Json?
  result     EmployeePayrollResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([code])
}

model PayrollPaymentBatch {
  id            String     @id @default(cuid())
  tenantId      String
  payrollRunId  String
  paymentDate   DateTime
  totalAmount   Decimal    @db.Decimal(18, 2)
  paymentAccountId String?
  journalId     String?
  status        String     @default("DRAFT")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payrollRunId])
  @@index([status])
}

model PerformanceReview {
  id                  String                      @id @default(cuid())
  employeeId          String
  reviewerId          String
  tenantId            String
  reviewPeriod        String
  reviewType          String                      @default("annual")
  reviewDate          DateTime
  overallRating       Float
  overallComments     String?
  strengths           String?
  areasForImprovement String?
  goalsAchieved       Int                         @default(0)
  goalsTotal          Int                         @default(0)
  status              String                      @default("draft")
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  goals               PerformanceGoal[]
  acknowledger        User?                       @relation("ReviewAcknowledgedBy", fields: [acknowledgedBy], references: [id])
  employee            Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer            User                        @relation(fields: [reviewerId], references: [id])
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewCriteria      PerformanceReviewCriteria[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewDate])
  @@index([status])
}

model PerformanceReviewCriteria {
  id           String            @id @default(cuid())
  reviewId     String
  criteriaName String
  rating       Float
  comments     String?
  weight       Float             @default(1.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceGoal {
  id           String             @id @default(cuid())
  employeeId   String
  tenantId     String
  title        String
  description  String?
  category     String?
  targetValue  Float?
  targetUnit   String?
  startDate    DateTime
  targetDate   DateTime
  status       String             @default("active")
  progress     Float              @default(0)
  currentValue Float?
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reviewId     String?
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  review       PerformanceReview? @relation(fields: [reviewId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                  String   @id @default(cuid())
  employeeId          String
  feedbackGiverId     String
  tenantId            String
  feedbackType        String   @default("peer")
  reviewId            String?
  rating              Float?
  strengths           String?
  areasForImprovement String?
  suggestions         String?
  isAnonymous         Boolean  @default(false)
  status              String   @default("submitted")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  employee            Employee @relation("FeedbackReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbackGiver       Employee @relation("FeedbackGiven", fields: [feedbackGiverId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([feedbackGiverId])
  @@index([feedbackType])
  @@index([createdAt])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  assets      Asset[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                      String                       @id @default(cuid())
  name                    String
  description             String?
  categoryId              String
  purchaseDate            DateTime
  originalCost            Float
  usefulLifeYears         Int
  depreciationMethod      String                       @default("straight_line")
  status                  String                       @default("active")
  location                String?
  serialNumber            String?
  supplier                String?
  warrantyExpiry          DateTime?
  notes                   String?
  isExistingAsset         Boolean                      @default(false)
  accumulatedDepreciation Float                        @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  tenantId                String
  createdById             String
  glAccountId             String?
  category                AssetCategory                @relation(fields: [categoryId], references: [id])
  createdBy               User                         @relation("AssetCreatedBy", fields: [createdById], references: [id])
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  glAccount               Account?                     @relation("AssetGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  journalEntries          AssetJournalEntry[]
  depreciationSchedules   DepreciationSchedule[]
  interBusinessTransfers  AssetInterBusinessTransfer[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([purchaseDate])
  @@index([glAccountId])
}

/// Immutable audit row each time an asset is moved to another tenant (business).
model AssetInterBusinessTransfer {
  id               String   @id @default(cuid())
  assetId          String
  fromTenantId     String
  toTenantId       String
  fromTenantName   String
  toTenantName     String
  fromCategoryId   String
  toCategoryId     String
  fromCategoryName String
  toCategoryName   String
  transferredById  String
  transferredAt    DateTime @default(now())
  notes            String?
  snapshotJson     String

  asset         Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromTenant    Tenant @relation("AssetTransferFromTenant", fields: [fromTenantId], references: [id])
  toTenant      Tenant @relation("AssetTransferToTenant", fields: [toTenantId], references: [id])
  transferredBy User   @relation("AssetInterBusinessTransferBy", fields: [transferredById], references: [id])

  @@index([assetId])
  @@index([fromTenantId])
  @@index([toTenantId])
  @@index([transferredAt])
}

model DepreciationSchedule {
  id                      String   @id @default(cuid())
  assetId                 String
  periodStart             DateTime
  periodEnd               DateTime
  depreciationAmount      Float
  accumulatedDepreciation Float
  netBookValue            Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodStart])
}

model AssetJournalEntry {
  id          String   @id @default(cuid())
  assetId     String
  entryType   String   @default("purchase")
  amount      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entryType])
}

model LiabilityCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenantId    String
  liabilities Liability[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ExpenseCategory {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  accountId          String              @unique
  accountCode        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  expenses           Expense[]
  purchaseOrderItems PurchaseOrderItem[]
  account            Account             @relation("ExpenseCategoryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountId])
}

model Liability {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  categoryId            String
  liabilityType         String
  principalAmount       Float
  interestRate          Float?             @default(0)
  interestType          String             @default("reducing_balance")
  oneTimeInterestAmount Float?             @default(0)
  startDate             DateTime
  maturityDate          DateTime?
  termMonths            Int?
  paymentFrequency      String?
  status                String             @default("active")
  lender                String?
  accountNumber         String?
  notes                 String?
  currentBalance        Float              @default(0)
  totalPaid             Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String
  createdById           String
  glAccountId           String?
  category              LiabilityCategory  @relation(fields: [categoryId], references: [id])
  createdBy             User               @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  glAccount             Account?           @relation("LiabilityGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  payments              LiabilityPayment[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([liabilityType])
  @@index([glAccountId])
}

model LiabilityPayment {
  id            String    @id @default(cuid())
  liabilityId   String
  amount        Float
  paymentDate   DateTime
  paymentType   String    @default("principal")
  principalPaid Float     @default(0)
  interestPaid  Float     @default(0)
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  liability     Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId])
  @@index([paymentDate])
}

/// Pre-greenfield budget tables (renamed). Do not use for new planning work.
model LegacyBudget {
  id              String                         @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  budgetType      String                         @default("revenue")
  periodType      String                         @default("annual")
  startDate       DateTime
  endDate         DateTime
  expectedRevenue Float                          @default(0)
  status          String                         @default("draft")
  version         Int                            @default(1)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  currency        String                         @default("MWK")
  isLocked        Boolean                        @default(false)
  lockedAt        DateTime?
  activatedById   String?
  activatedAt     DateTime?
  approvedBy      User?                          @relation("LegacyBudgetApprover", fields: [approvedById], references: [id])
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           LegacyBudgetItem[]
  breakdowns      LegacyRevenueBudgetBreakdown[]

  @@index([tenantId])
  @@index([budgetType])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
  @@index([isLocked])
  @@map("LegacyBudget")
}

model LegacyRevenueBudgetBreakdown {
  id              String       @id @default(cuid())
  budgetId        String
  breakdownType   String
  referenceId     String
  referenceName   String
  budgetedAmount  Float
  actualAmount    Float        @default(0)
  variance        Float?
  variancePercent Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  budget          LegacyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, breakdownType, referenceId])
  @@index([budgetId])
  @@index([breakdownType])
  @@index([referenceId])
  @@map("LegacyRevenueBudgetBreakdown")
}

model LegacyBudgetItem {
  id              String       @id @default(cuid())
  budgetId        String
  accountId       String?
  branchId        String?
  categoryId      String?
  period          DateTime
  budgetedAmount  Float
  actualAmount    Float        @default(0)
  variance        Float?
  variancePercent Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        String?
  account         Account?     @relation(fields: [accountId], references: [id])
  budget          LegacyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id])

  @@unique([budgetId, accountId, category, period])
  @@index([budgetId])
  @@index([accountId])
  @@index([category])
  @@index([period])
  @@index([branchId])
  @@index([categoryId])
  @@map("LegacyBudgetItem")
}

/// Greenfield planning Budget (never posts to GL).
model Budget {
  id                        String    @id @default(cuid())
  tenantId                  String
  businessId                String
  name                      String
  description               String?
  budgetType                String    @default("OPERATING")
  budgetMethod              String    @default("CREATE_MANUALLY")
  frequency                 String    @default("MONTHLY")
  planningMode              String    @default("POSTING_ACCOUNT_DETAIL")
  fiscalYear                Int?
  startDate                 DateTime
  endDate                   DateTime
  currency                  String    @default("MWK")
  status                    String    @default("DRAFT")
  versionNumber             Int       @default(1)
  revisionNumber            Int       @default(1)
  branchId                  String?
  departmentId              String?
  projectId                 String?
  costCentreId              String?
  parentBudgetId            String?
  copiedFromBudgetId        String?
  generatedFromActualsStart DateTime?
  generatedFromActualsEnd   DateTime?
  assumptionSetId           String?
  approvalState             String    @default("NONE")
  approvedById              String?
  approvedAt                DateTime?
  lockedById                String?
  lockedAt                  DateTime?
  activatedAt               DateTime?
  supersededAt              DateTime?
  createdById               String?
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant      Tenant            @relation("PlanningBudgetTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("PlanningBudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?             @relation("PlanningBudgetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lockedBy    User?             @relation("PlanningBudgetLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  parent      Budget?           @relation("BudgetHierarchy", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  children    Budget[]          @relation("BudgetHierarchy")
  copiedFrom  Budget?           @relation("BudgetCopiedFrom", fields: [copiedFromBudgetId], references: [id], onDelete: SetNull)
  copies      Budget[]          @relation("BudgetCopiedFrom")
  lines       BudgetLine[]
  versions    BudgetVersion[]
  approvals   BudgetApproval[]
  forecasts   Forecast[]        @relation("ForecastSourceBudget")

  @@index([tenantId, businessId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@index([branchId])
  @@map("PlanningBudget")
}

model BudgetLine {
  id                      String   @id @default(cuid())
  budgetId                String
  accountId               String
  accountCodeSnapshot     String
  accountNameSnapshot     String
  accountTypeSnapshot     String?
  accountCategorySnapshot String?
  parentAccountIdSnapshot String?
  branchId                String?
  departmentId            String?
  projectId               String?
  costCentreId            String?
  lineType                String   @default("PLANNED")
  calculationMethod       String   @default("MANUAL")
  annualAmountMinor       Int      @default(0)
  notes                   String?
  assumptions             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  budget         Budget                @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodAmounts  BudgetPeriodAmount[]

  @@unique([budgetId, accountId, branchId, departmentId, projectId, costCentreId])
  @@index([budgetId])
  @@index([accountId])
}

model BudgetPeriodAmount {
  id                 String    @id @default(cuid())
  budgetLineId       String
  periodStart        DateTime
  periodEnd          DateTime
  monthNumber        Int?
  quarterNumber      Int?
  plannedAmountMinor Int       @default(0)
  sourceMethod       String    @default("MANUAL")
  growthRate         Float?
  distributionWeight Float?
  notes              String?

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, periodStart, periodEnd])
  @@index([budgetLineId])
}

model BudgetVersion {
  id              String    @id @default(cuid())
  budgetId        String
  versionNumber   Int
  revisionNumber  Int       @default(1)
  state           String
  changeReason    String?
  snapshotJson    Json?
  snapshotChecksum String?
  createdById     String?
  approvedById    String?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?

  budget     Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("BudgetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?  @relation("BudgetVersionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals  BudgetApproval[]

  @@unique([budgetId, versionNumber, revisionNumber])
  @@index([budgetId, state])
}

model BudgetApproval {
  id          String    @id @default(cuid())
  budgetId    String
  versionId   String?
  requestedById String
  approverId  String?
  state       String    @default("PENDING")
  reason      String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  version     BudgetVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  requestedBy User           @relation("BudgetApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver    User?          @relation("BudgetApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([budgetId, state])
