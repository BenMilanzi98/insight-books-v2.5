model AffiliatePayout {
  id             String    @id @default(cuid())
  affiliateId    String
  amount         Float
  paymentMethod  String
  reference      String?
  status         String
  processedDate  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  periodKey      String?
  idempotencyKey String?   @unique
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

model Transaction {
  id                    String            @id @default(cuid())
  date                  DateTime
  description           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenantId              String
  reference             String?
  status                String            @default("posted")
  createdById           String?
  entryType             String            @default("Regular")
  notes                 String?
  postedById            String?
  postedDate            DateTime?
  sourceId              String?
  sourceType            String?
  branchId              String?
  isReversal            Boolean           @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  branch                Branch?           @relation(fields: [branchId], references: [id])
  createdBy             User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  postedBy              User?             @relation("TransactionPostedBy", fields: [postedById], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  lines                 TransactionLine[]

  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([sourceType])
  @@index([sourceId])
  @@index([reference])
  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  lineNumber    Int
  accountId     String
  debitAmount   Decimal     @default(0) @db.Decimal(18, 2)
  creditAmount  Decimal     @default(0) @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       Account     @relation("TransactionLineAccount", fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId])
}

/// Singleton JSON payload edited in /insightbooks/chart-of-accounts; applied to all tenants.
model SystemCoaDefinition {
  id             String   @id @default("default")
  payload        Json
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@map("system_coa_definition")
}

model Account {
  id                       String                  @id @default(cuid())
  code                     String?                 @map("code")
  name                     String?                 @map("name")
  type                     String?                 @map("type")
  balance                  Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  tenantId                 String?
  isActive                 Boolean                 @default(true)
  isSystem                 Boolean                 @default(false)
  accountCode              String?
  accountName              String?
  accountSubtype           String?
  accountType              String?
  description              String?
  normalBalance            String?
  parentAccountId          String?
  /// Logical merge (system CoA): posting stays on this row (original code); reporting/UI roll up to mergedInto target.
  mergedIntoAccountId      String?
  parentAccount            Account?                @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts            Account[]               @relation("AccountHierarchy")
  mergedIntoAccount        Account?                @relation("AccountCoaMerge", fields: [mergedIntoAccountId], references: [id], onDelete: SetNull)
  accountsMergedIntoThis   Account[]               @relation("AccountCoaMerge")
  tenant                   Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountBalances          AccountBalanceHistory[]
  bankAccounts             BankAccount[]
  legacyBudgetItems        LegacyBudgetItem[]
  budgetLines              BudgetLine[]
  forecastLines            ForecastLine[]
  forecastAssumptions      ForecastAssumption[]
  bfExpenseBudgetLines     BfExpenseBudgetLine[]
  bfRevenueForecastLines   BfRevenueForecastLine[]
  equityAccounts           EquityAccount[]
  expenseAccounts          Expense[]               @relation("ExpenseAccount")
  expenseSources           Expense[]               @relation("ExpenseSourceAccount")
  recurringExpenseAccounts RecurringExpense[]      @relation("RecurringExpenseAccount")
  journalEntryLines        JournalEntryLine[]
  productsCogs             Product[]               @relation("ProductCogsAccount")
  productsInventory        Product[]               @relation("ProductInventoryAccount")
  productsIncome           Product[]               @relation("ProductIncomeAccount")
  taxTypes                 TaxType[]               @relation("TaxTypeAccount")
  taxAccountMappings       TaxAccountMapping[]     @relation("TaxAccountMappingAccount")
  transactionLines         TransactionLine[]       @relation("TransactionLineAccount")

  invoiceItems             InvoiceItem[]
  saleItems                SaleItem[]
  expenseCategory          ExpenseCategory?        @relation("ExpenseCategoryAccount")
  paymentAccountsLinked    PaymentAccount[]        @relation("PaymentAccountCoa")
  assetsGlLinked           Asset[]                 @relation("AssetGlAccount")
  liabilitiesGlLinked      Liability[]             @relation("LiabilityGlAccount")
  /// Catch-all / unclassified bucket; surfaced in CoA UI for reclassification (guide).
  requiresReclassification Boolean                 @default(false)
  /// Soft retire after migration; row kept for audit (guide: do not delete).
  retiredAt                DateTime?
  /// Target canonical GL code string at migration time (audit).
  migratedToAccountCode    String?
  /// When false, block new postings to this account (retired / merged sources).
  acceptsNewTransactions   Boolean                 @default(true)
  /// Default chart list hides rows with false (migrated sources, etc.).
  visibleInChart           Boolean                 @default(true)
  coaMigrationLogsAsSource CoaMigrationLog[]       @relation("CoaMigrationOriginalAccount")

  /// ── CoA V2 governance (Phase 3, additive; nullable until Stage-2 backfill classifies) ──
  coaV2Category                String?
  coaV2SubType                 String?
  coaV2Behaviour               String?
  coaV2NormalBalance           String?
  coaV2Status                  String?
  postingAllowed               Boolean?
  manualPostingAllowed         Boolean?
  reconciliationRequired       Boolean?
  currencyPolicy               String?
  specificCurrency             String?
  financialStatementSection    String?
  financialStatementSubsection String?
  cashFlowClassification       String?
  systemPurpose                String?
  controlAccountPurpose        String?
  consolidationGroup           String?
  displayOrder                 Int?
  coaDepth                     Int?
  hierarchyPath                String?
  deprecationReason            String?
  replacementAccountId         String?
  coaEffectiveFrom             DateTime?
  coaEffectiveTo               DateTime?
  coaArchitectureVersion       String?
  coaV2Metadata                Json?
  archivedAt                   DateTime?
  coaV2UpdatedBy               String?
  replacementAccount           Account?  @relation("AccountReplacement", fields: [replacementAccountId], references: [id], onDelete: SetNull)
  replacedAccounts             Account[] @relation("AccountReplacement")
  coaV2Mappings                CoaV2AccountMapping[]
  coaV2AliasesAsLegacy         CoaV2AccountAlias[]   @relation("AliasLegacyAccount")
  coaV2AliasesAsCanonical      CoaV2AccountAlias[]   @relation("AliasCanonicalAccount")
  coaV2ConsolidationsAsDuplicate CoaV2ConsolidationPlan[] @relation("ConsolidationDuplicateAccount")
  coaV2ConsolidationsAsCanonical CoaV2ConsolidationPlan[] @relation("ConsolidationCanonicalAccount")

  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountType])
  @@index([isActive])
  @@index([parentAccountId])
  @@index([accountCode])
  @@index([mergedIntoAccountId])
  @@index([tenantId, systemPurpose])
  @@index([tenantId, coaV2Status])
  @@index([tenantId, coaV2Category])
  @@index([tenantId, coaV2Behaviour])
  @@index([replacementAccountId])
}

/// Audit trail for chart-of-accounts consolidation (implementation guide Phase 0 / 4).
model CoaMigrationLog {
  id                String    @id @default(cuid())
  tenantId          String
  originalAccountId String
  originalCode      String?
  originalName      String?
  originalType      String?
  mappedToCode      String?
  mappedToName      String?
