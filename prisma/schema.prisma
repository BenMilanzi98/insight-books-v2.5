  tenantId              String
  supplierId            String
  paymentDate           DateTime
  paymentMethod         String
  bankAccountId         String?
  referenceNumber       String?
  totalAmount           Float
  currency              String?                     @default("MWK")
  exchangeRate          Float?                      @default(1)
