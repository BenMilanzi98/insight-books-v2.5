  taxRate                 Float?                    @default(0) // Tax rate % when recorded
  date                    DateTime
  category                String
  categoryId              String?
  expenseAccountId        String?
  receiptUrl              String?
  submittedById           String
  status                  String
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tenantId                String
  merchant                String?
  sourceAccountId         String?
  paymentMethod           String?
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?
  historicalDate          DateTime?
  isDeleted               Boolean                   @default(false)
  isHistorical            Boolean                   @default(false)
  migrationBatch          String?
  originalReference       String?
  paidAmount              Decimal?                  @db.Decimal(18, 2)
  paymentReference        String?
  paymentStatus           String                    @default("Fully paid")
  branchId                String?
  employeeId              String?
  supplierId              String?
  purchaseOrderId         String?
  purchaseOrderItemId     String?
  taxTypeId               String?
  // Reversal fields
