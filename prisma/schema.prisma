  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DebitNoteCreatedBy", fields: [createdById], references: [id])
  postedBy    User?     @relation("DebitNotePostedBy", fields: [postedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([status])
  @@index([noteDate])
