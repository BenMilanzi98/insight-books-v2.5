  /// Step-specific draft payload (profile, calendar, etc.).
  payload      Json?
  warningCount Int      @default(0)
  blockerCount Int      @default(0)
  lastSavedAt  DateTime?
  lastSavedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  setupRun BusinessSetupRun @relation(fields: [setupRunId], references: [id], onDelete: Cascade)

  @@unique([setupRunId, stepId])
  @@index([tenantId, stepId])
  @@index([setupRunId, status])
}

