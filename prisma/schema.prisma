  @@index([metricKey, snapshotDate])
}

model AnalyticsMonthlySnapshot {
  id             String   @id @default(cuid())
  yearMonth      String
  metricKey      String
  tenantId       String   @default("")
  valueNumeric   Decimal? @db.Decimal(18, 4)
  valueJson      Json?
  createdAt      DateTime @default(now())
  rebuiltAt      DateTime @default(now())

  @@unique([yearMonth, metricKey, tenantId])
  @@index([metricKey, yearMonth])
}

model AnalyticsDataFreshness {
  id              String   @id @default(cuid())
  sourceKey       String   @unique
  lastSuccessAt   DateTime?
  lastAttemptAt   DateTime?
  lagSeconds      Int?
  status          String   @default("UNKNOWN")
  detail          Json?
  updatedAt       DateTime @updatedAt
}

model AnalyticsReconciliationRun {
  id           String   @id @default(cuid())
  checkKey     String
  periodStart  DateTime
  periodEnd    DateTime
  expected     Int
  actual       Int
  variance     Int
  status       String
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([checkKey, createdAt])
}

/// Phase 7 Wave 3 — CS portfolio (not AdminTenantAccess / Tenant.ownerUserId)
model CustomerPortfolio {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  description  String?
  type         String              @default("CUSTOMER_SUCCESS")
  status       String              @default("ACTIVE")
  ownerAdminId String?
  ownerAdmin   Admin?              @relation("PortfolioOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  ownerships     CustomerOwnership[]
  csCases        CsCase[]
  supportTickets SupportTicket[]

  @@index([status])
  @@index([ownerAdminId])
  @@index([type])
}

/// Phase 7 Wave 3 — CS ownership assignment (tenant → CS owner / portfolio)
model CustomerOwnership {
  id                String             @id @default(cuid())
  tenantId          String
  portfolioId       String?
  ownerAdminId      String
  assignmentType    String             @default("CUSTOMER_SUCCESS_OWNER")
  isPrimary         Boolean            @default(true)
  startAt           DateTime           @default(now())
  endAt             DateTime?
  reason            String?
  assignedByAdminId String?
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolio         CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  ownerAdmin        Admin              @relation("OwnershipOwner", fields: [ownerAdminId], references: [id], onDelete: Cascade)
  assignedByAdmin   Admin?             @relation("OwnershipAssignedBy", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([ownerAdminId, status])
  @@index([portfolioId, status])
  @@index([status, endAt])
  @@index([isPrimary, status])
}

/// Optional segment foundation (Wave 3). Dynamic engine deferred; system filters in code.
model CustomerSegment {
  id          String                       @id @default(cuid())
  code        String                       @unique
  name        String
  description String?
  kind        String                       @default("SYSTEM")
  status      String                       @default("ACTIVE")
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  memberships CustomerSegmentMembership[]

  @@index([status])
  @@index([kind])
}

model CustomerSegmentMembership {
  id        String          @id @default(cuid())
  segmentId String
  tenantId  String
  status    String          @default("ACTIVE")
  startAt   DateTime        @default(now())
  endAt     DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  segment   CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([segmentId, tenantId])
  @@index([tenantId, status])
  @@index([segmentId, status])
}

/// Phase 7 Wave 4 — deterministic customer signals (verified sources only).
/// Status: NEW | ACKNOWLEDGED | RESOLVED_BY_SOURCE | DISMISSED
/// Ephemeral evaluation is used when this table/client is unavailable.
model CustomerSignal {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  severity        String
  status          String   @default("NEW")
  payload         Json?
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())
  ruleVersion     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([status, severity])
  @@index([code, status])
  @@index([lastDetectedAt])
}

/// Phase 8 Wave 1 — versioned health definition (optional DB override of builtin).
model CustomerHealthDefinition {
  id          String    @id @default(cuid())
  version     String    @unique
  name        String?
  isActive    Boolean   @default(false)
  payload     Json
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, activatedAt])
}

/// Phase 8 Wave 1 — immutable health snapshot (rebuild creates a new row).
model CustomerHealthSnapshot {
  id                 String   @id @default(cuid())
  tenantId           String
  definitionVersion  String
  score              Float?
  band               String
  confidence         String
  asOf               DateTime
  payload            Json?
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([band, createdAt])
  @@index([definitionVersion])
  @@index([asOf])
}

/// Phase 8 Wave 3 — CS case (not a support ticket; not signal ACK substitute).
/// Status: OPEN | IN_PROGRESS | RESOLVED | CLOSED
/// triggerType: SIGNAL | HEALTH | MANUAL
model CsCase {
  id                String           @id @default(cuid())
  tenantId          String
  portfolioId       String?
  status            String           @default("OPEN")
  priority          String           @default("MEDIUM")
  severity          String?
  title             String
  summary           String?
  triggerType       String
  triggerCode       String?
  definitionVersion String?
  idempotencyKey    String
  signalId          String?
  snapshotId        String?
  ownerAdminId      String?
  openedByAdminId   String?
  openedAt          DateTime         @default(now())
  closedAt          DateTime?
  resolvedAt        DateTime?
  payload           Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolio         CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  ownerAdmin        Admin?           @relation("CsCaseOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  openedByAdmin     Admin?           @relation("CsCaseOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
  tasks             CsTask[]
  interventions     CsIntervention[]
  playbookExecutions CsPlaybookExecution[]

  // Open-only uniqueness (OPEN/IN_PROGRESS) is enforced by partial unique index
  // CsCase_open_idempotencyKey_key in scripts/sql/customer-success-phase08.sql —
  // closed/resolved cases may reuse the same key so re-triggers can open a new case.
  @@index([idempotencyKey])
  @@index([tenantId, status])
  @@index([status, openedAt])
  @@index([triggerType, triggerCode])
  @@index([ownerAdminId, status])
  @@index([portfolioId])
}

/// Phase 8 Wave 3 — CS task (assignee = System Admin id).
model CsTask {
  id                String    @id @default(cuid())
  caseId            String?
  tenantId          String
  title             String
  status            String    @default("OPEN")
  assigneeAdminId   String?
  dueAt             DateTime?
  stepId            String?
  executionId       String?
  idempotencyKey    String?
  notes             String?
  createdByAdminId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigneeAdmin     Admin?    @relation("CsTaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  createdByAdmin    Admin?    @relation("CsTaskCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([tenantId, status])
  @@index([caseId, status])
  @@index([assigneeAdminId, status])
  @@index([executionId, stepId])
}

/// Phase 8 Wave 3 — CS intervention log (not a support ticket).
model CsIntervention {
  id                  String   @id @default(cuid())
  caseId              String?
  tenantId            String
  type                String
  notes               String?
  channel             String?
  performedByAdminId  String?
  performedAt         DateTime @default(now())
  payload             Json?
  createdAt           DateTime @default(now())
  case                CsCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  performedByAdmin    Admin?   @relation("CsInterventionPerformedBy", fields: [performedByAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, performedAt])
  @@index([caseId, performedAt])
  @@index([type])
}

/// Phase 8 Wave 3 — renewal workspace; outcome requires AccountSubscription evidence.
model CsRenewalWorkspace {
  id                String    @id @default(cuid())
  tenantId          String
  periodKey         String
  status            String    @default("OPEN")
  outcome           String?
  outcomeAt         DateTime?
  outcomeByAdminId  String?
  subscriptionId    String?
  evidenceNote      String?
  notes             String?
  openedByAdminId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedByAdmin     Admin?    @relation("CsRenewalOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
  outcomeByAdmin    Admin?    @relation("CsRenewalOutcomeBy", fields: [outcomeByAdminId], references: [id], onDelete: SetNull)

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
  @@index([outcome])
  @@index([periodKey])
}

/// Phase 8 Wave 4 — versioned playbook definition (steps JSON → tasks on execute).
model CsPlaybook {
  id          String                @id @default(cuid())
  key         String
  name        String
  version     String
  description String?
  status      String                @default("ACTIVE")
  steps       Json
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  executions  CsPlaybookExecution[]

  @@unique([key, version])
  @@index([status, key])
}

/// Phase 8 Wave 4 — playbook run; idempotent per key+version+tenant+case.
model CsPlaybookExecution {
  id                String    @id @default(cuid())
  playbookId        String
  tenantId          String
  caseId            String?
  status            String    @default("RUNNING")
  playbookVersion   String
  idempotencyKey    String?   @unique
  startedByAdminId  String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  payload           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  playbook          CsPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  startedByAdmin    Admin?    @relation("CsPlaybookExecutionStartedBy", fields: [startedByAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([playbookId, startedAt])
  @@index([caseId])
}

/// Phase 8 Wave 4 — success plan (no invented progress %).
/// Phase 19 Wave 4 — optional adoptionPlanId link (broken → UNKNOWN, never invent COMPLETED).
model CsSuccessPlan {
  id                String          @id @default(cuid())
  tenantId          String
  title             String
  status            String          @default("ACTIVE")
  summary           String?
  ownerAdminId      String?
  createdByAdminId  String?
  customerId        String?
  adoptionPlanId    String?
  migrationStatus   String?
  completedAt       DateTime?
  sourceNote        String?
  startedAt         DateTime?
  targetAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerAdmin        Admin?          @relation("CsSuccessPlanOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  createdByAdmin    Admin?          @relation("CsSuccessPlanCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  goals             CsSuccessGoal[]

  @@index([tenantId, status])
  @@index([ownerAdminId, status])
  @@index([adoptionPlanId])
  @@index([migrationStatus])
  @@index([customerId])
}

/// Phase 8 Wave 4 — success goal under a plan.
model CsSuccessGoal {
  id         String        @id @default(cuid())
  planId     String
  title      String
  status     String        @default("OPEN")
  targetNote String?
  dueAt      DateTime?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  plan       CsSuccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@index([planId, sortOrder])
}

/// Phase 8 Wave 4 — expansion handoff record-only (no CRM opportunity / auto upgrade).
model CsExpansionHandoff {
  id                 String   @id @default(cuid())
  tenantId           String
  status             String   @default("OPEN")
  reason             String?
  notes              String?
  recommendedAction  String   @default("OTHER")
  createdByAdminId   String?
  payload            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAdmin     Admin?   @relation("CsExpansionHandoffCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([recommendedAction])
  @@index([createdAt])
}

/// Phase 8 Wave 4 — onboarding foundation rows only (empty → NOT_INSTRUMENTED).
/// Phase 17 Wave 4 — optional link to CustomerOnboardingProject (UNKNOWN if unresolved).
model CsOnboardingRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  checklistKey        String?
  status              String?
  completedAt         DateTime?
  sourceNote          String?
  onboardingProjectId String?
  migrationStatus     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([checklistKey])
  @@index([onboardingProjectId])
  @@index([migrationStatus])
}

/// Phase 8 Wave 4 — training foundation rows only (empty → NOT_INSTRUMENTED).
/// Phase 18 Wave 4 — optional link to CustomerTrainingProgram (UNKNOWN if unresolved).
model CsTrainingRecord {
  id                String    @id @default(cuid())
  tenantId          String
  customerId        String?
  moduleKey         String?
  status            String?
  completedAt       DateTime?
  sourceNote        String?
  trainingProgramId String?
  migrationStatus   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([moduleKey])
  @@index([trainingProgramId])
  @@index([migrationStatus])
  @@index([customerId])
}

/// Phase 8 Wave 4 — survey foundation rows only (empty → NOT_INSTRUMENTED; never invent NPS).
model CsSurveyResponse {
  id         String    @id @default(cuid())
  tenantId   String
  surveyKey  String?
  status     String?
  score      Int?
  completedAt DateTime?
  sourceNote String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([surveyKey])
}

/// Phase 10 Wave 1 — per-UTC-year sequence for SUP-YYYY-###### (concurrency-safe CAS).
model SupportTicketNumberSeq {
  year       Int      @id
  lastIssued Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Phase 10 Wave 1 — Support ticket (≠ CsCase ≠ PlatformSupportAccess).
/// Never store Tenant GL lines, MRA credentials, or payment secrets.
model SupportTicket {
  id                 String    @id @default(cuid())
  ticketNumber       String    @unique
  tenantId           String
  portfolioId        String?
  status             String    @default("NEW")
  type               String
  impact             String?
  urgency            String?
  priority           String?
  severity           String?
  title              String
  description        String    @db.Text
  resolutionCategory String?
  createdByAdminId   String?
  assigneeAdminId    String?
  queueCode          String?
  sourceChannel      String    @default("ADMIN_MANUAL")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  closedAt           DateTime?
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolio          CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  createdByAdmin     Admin?    @relation("SupportTicketCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  assigneeAdmin      Admin?    @relation("SupportTicketAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  statusHistory      SupportTicketStatusHistory[]
  messages           SupportMessage[]
  attachments        SupportAttachment[]
  assignmentHistory  SupportAssignmentHistory[]
  slaClocks          SupportSlaClock[]
  handoffs           SupportHandoff[]

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@index([assigneeAdminId, status])
  @@index([queueCode, status])
  @@index([portfolioId])
  @@index([sourceChannel])
}

/// Phase 10 Wave 1 — append-only status history (evidence preserved on terminal statuses).
model SupportTicketStatusHistory {
  id               String   @id @default(cuid())
  ticketId         String
  fromStatus       String?
  toStatus         String
  changedByAdminId String?
  reason           String?
  at               DateTime @default(now())
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedByAdmin   Admin?   @relation("SupportTicketStatusChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, at])
  @@index([changedByAdminId])
  @@index([toStatus, at])
}

/// Phase 10 Wave 2 — ticket messages (PUBLIC / INTERNAL / RESTRICTED). Never expose INTERNAL/RESTRICTED to customers.
model SupportMessage {
  id              String   @id @default(cuid())
  ticketId        String
  type            String
  body            String   @db.Text
  authorAdminId   String?
  visibility      String?
  systemEventCode String?
  createdAt       DateTime @default(now())
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAdmin     Admin?   @relation("SupportMessageAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([ticketId, type])
  @@index([authorAdminId])
}

/// Phase 10 Wave 2 — attachment metadata; bytes in private storage/support-attachments/ (not public/uploads).
model SupportAttachment {
  id                 String    @id @default(cuid())
  ticketId           String
  fileName           String
  mimeType           String
  sizeBytes          Int
  storageKey         String
  scanState          String    @default("PENDING_SCAN")
  uploadedByAdminId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  scannedAt          DateTime?
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedByAdmin    Admin?    @relation("SupportAttachmentUploadedBy", fields: [uploadedByAdminId], references: [id], onDelete: SetNull)

  @@unique([storageKey])
  @@index([ticketId, scanState])
  @@index([scanState])
  @@index([uploadedByAdminId])
}

/// Phase 10 Wave 2 — queue catalogue (QUEUE_TEAM_MATRIX). liveStatus stays NOT_FOUND until real owners exist.
model SupportQueue {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  typicalOwnership  String?
  liveStatus        String   @default("NOT_FOUND")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

/// Phase 10 Wave 2 — team stub definitions for assignment eligibility.
model SupportTeam {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  queueCodes String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  memberships SupportTeamMembership[]

  @@index([active])
}

/// Phase 10 Wave 2 — optional team membership (stub; empty ⇒ eligibility not locked out).
model SupportTeamMembership {
  id        String   @id @default(cuid())
  teamCode  String
  adminId   String
  createdAt DateTime @default(now())
  team      SupportTeam @relation(fields: [teamCode], references: [code], onDelete: Cascade)
  admin     Admin       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([teamCode, adminId])
  @@index([adminId])
}

/// Phase 10 Wave 2 — append-only assignment / queue change history.
model SupportAssignmentHistory {
  id                   String   @id @default(cuid())
  ticketId             String
  fromAssigneeAdminId  String?
  toAssigneeAdminId    String?
  fromQueueCode        String?
  toQueueCode          String?
  changedByAdminId     String?
  reason               String?
  at                   DateTime @default(now())
  ticket               SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedByAdmin       Admin?   @relation("SupportAssignmentChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, at])
  @@index([changedByAdminId])
  @@index([toAssigneeAdminId])
}

/// Phase 10 Wave 3 — versioned SLA policy (pinned onto clock rows).
model SupportSlaPolicy {
  id                            String   @id @default(cuid())
  versionId                     String   @unique
  name                          String
  ackCountsAsFirstResponse      Boolean  @default(false)
  resolutionStartsOn            String   @default("CREATE")
  stopResolutionOnClosed        Boolean  @default(true)
  pauseOnWaitingForCustomer     Boolean  @default(true)
  pauseOnWaitingForInternalTeam Boolean  @default(true)
  pauseOnWaitingForVendor       Boolean  @default(true)
  /// JSON targets map: { FIRST_RESPONSE: { businessMs }, RESOLUTION: { businessMs }, ... }
  targetsJson                   String   @db.Text
  active                        Boolean  @default(true)
  createdByAdminId              String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  createdByAdmin                Admin?   @relation("SupportSlaPolicyCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([active])
}

/// Phase 10 Wave 3 — versioned business calendar (pinned onto clock rows).
model SupportSlaCalendar {
  id               String   @id @default(cuid())
  versionId        String   @unique
  name             String
  timezone         String
  /// JSON: workdays[], workingHours {start,end}, holidays[]
  definitionJson   String   @db.Text
  active           Boolean  @default(true)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByAdmin   Admin?   @relation("SupportSlaCalendarCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([active])
}

/// Phase 10 Wave 3 — SLA clock instance; policyVersion + calendarVersion pinned at start.
model SupportSlaClock {
  id               String    @id @default(cuid())
  ticketId         String
  clockType        String
  state            String    @default("RUNNING")
  policyVersion    String
  calendarVersion  String
  targetBusinessMs Int
  startedAt        DateTime  @default(now())
  dueAt            DateTime?
  pausedAt         DateTime?
  pausedMs         Int       @default(0)
  stoppedAt        DateTime?
  breachedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  events           SupportSlaEvent[]

  @@index([ticketId, clockType])
  @@index([ticketId, state])
  @@index([state, dueAt])
  @@index([policyVersion])
  @@index([calendarVersion])
}

/// Phase 10 Wave 3 — append-only SLA events (breach facts immutable).
model SupportSlaEvent {
  id        String   @id @default(cuid())
  clockId   String
  eventType String
  at        DateTime @default(now())
  metaJson  String?
  clock     SupportSlaClock @relation(fields: [clockId], references: [id], onDelete: Cascade)

  @@index([clockId, at])
  @@index([clockId, eventType])
  @@index([eventType, at])
}

/// Phase 10 Wave 4 — link-only handoff (≠ open/close CsCase; ≠ billing/MRA/GL mutation).
model SupportHandoff {
  id               String   @id @default(cuid())
  ticketId         String
  tenantId         String
  /// CS | PRODUCT | FINANCE | BILLING | MRA
  targetType       String
  status           String   @default("OPEN")
  summary          String?
  /// Optional link id only (csCaseId / invoiceId / subscriptionId / fiscalTransmissionId).
  targetRefId      String?
  /// Optional Phase 9 catalogue feature code (PRODUCT target).
  featureCode      String?
  /// Allowed link payload only — never credentials, raw MRA, or payment secrets.
  payload          Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdByAdmin   Admin?   @relation("SupportHandoffCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([tenantId, targetType])
  @@index([targetType, status])
  @@index([createdByAdminId])
}

/// Phase 10 Wave 4 — optional reconciliation run audit (never invents false zeroes).
model SupportReconciliationRun {
  id             String   @id @default(cuid())
  status         String
  summaryJson    String   @db.Text
  runByAdminId   String?
  createdAt      DateTime @default(now())
  runByAdmin     Admin?   @relation("SupportReconciliationRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([runByAdminId])
}

/// Phase 10 Wave 4 — export download audit (permission rechecked at download time).
model SupportExportAudit {
  id        String   @id @default(cuid())
  adminId   String?
  dataset   String
  format    String
  rowCount  Int?
  createdAt DateTime @default(now())
  admin     Admin?   @relation("SupportExportAuditBy", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([dataset, createdAt])
}

/// Phase 11 Wave 1 — per-prefix + UTC-year sequence for LEAD|ACC|CON-YYYY-###### (concurrency-safe CAS).
model CrmNumberSeq {
  prefix     String
  year       Int
  lastIssued Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([prefix, year])
}

/// Phase 11 Wave 1 — CRM Account (≠ canonical Customer; optional tenant/customer link only).
/// Never store Tenant GL, payment secrets, or MRA credentials.
model CrmAccount {
  id            String    @id @default(cuid())
  accountNumber String    @unique
  type          String    @default("PROSPECT")
  displayName   String
  status        String    @default("ACTIVE")
  country       String?
  region        String?
  ownerAdminId  String?
  /// Optional link to Customer identity (no auto-link; no billing copy).
  customerId    String?
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ownerAdmin    Admin?    @relation("CrmAccountOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contacts      CrmContact[]
  leads         CrmLead[]

  @@index([status, createdAt])
  @@index([ownerAdminId])
  @@index([tenantId])
  @@index([customerId])
  @@index([type, status])
}

/// Phase 11 Wave 1 — CRM Contact (≠ Platform User). No national ID / bank / passwords.
model CrmContact {
  id            String    @id @default(cuid())
  contactNumber String    @unique
  firstName     String
  lastName      String
  email         String?
  phone         String?
  role          String?
  accountId     String?
  ownerAdminId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ownerAdmin    Admin?    @relation("CrmContactOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  leads         CrmLead[]
  consentRecords CrmConsentRecord[]
  communicationPreferences CrmCommunicationPreference[]
  doNotContact  CrmDoNotContact[]

  @@index([accountId])
  @@index([ownerAdminId])
  @@index([email])
  @@index([createdAt])
}

/// Phase 11 Wave 1–3 — CRM Lead (≠ Opportunity ≠ SupportTicket ≠ CsCase).
model CrmLead {
  id                     String    @id @default(cuid())
  leadNumber             String    @unique
  type                   String
  personOrOrganisation   String
  accountId              String?
  contactId              String?
  source                 String
  channel                String    @default("ADMIN_MANUAL")
  sourceIdempotencyKey   String?   @unique
  status                 String    @default("NEW")
  title                  String
  summary                String?   @db.Text
  ownerAdminId           String?
  /// Wave 3 — sales team / territory ownership + acceptance SLA foundation
  teamId                 String?
  territoryId            String?
  assignedAt             DateTime?
  acceptedAt             DateTime?
  createdByAdminId       String?
  disqualificationReason String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  account                CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact                CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerAdmin             Admin?    @relation("CrmLeadOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  createdByAdmin         Admin?    @relation("CrmLeadCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  statusHistory          CrmLeadStatusHistory[]
  captureRecords         CrmCaptureRecord[]
  duplicateAsLead        CrmDuplicateCandidate[] @relation("CrmDuplicateLead")
  duplicateAsCandidate   CrmDuplicateCandidate[] @relation("CrmDuplicateCandidateLead")
  qualificationResponses CrmQualificationResponse[]
  scoreEvaluations       CrmScoreEvaluation[]
  assignmentHistory      CrmAssignmentHistory[]
  /// Wave 4 — set when this lead is the loser of an executed merge (evidence; history kept).
  mergedIntoLeadId       String?

  @@index([status, createdAt])
  @@index([ownerAdminId, status])
  @@index([teamId, status])
  @@index([territoryId])
  @@index([accountId])
  @@index([contactId])
  @@index([source, channel])
  @@index([type, status])
  @@index([mergedIntoLeadId])
}

/// Phase 11 Wave 1 — append-only Lead status history.
model CrmLeadStatusHistory {
  id               String   @id @default(cuid())
  leadId           String
  fromStatus       String?
  toStatus         String
  changedByAdminId String?
  reason           String?
  at               DateTime @default(now())
  lead             CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedByAdmin   Admin?   @relation("CrmLeadStatusChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([leadId, at])
  @@index([changedByAdminId])
  @@index([toStatus, at])
}

/// Phase 11 Wave 2 — capture identity + consent snapshot (source of email/phone for duplicates).
model CrmCaptureRecord {
  id                   String   @id @default(cuid())
  leadId               String
  sourceCode           String
  channel              String
  sourceIdempotencyKey String   @unique
  emailNormalized      String?
  phoneNormalized      String?
  handoffRefType       String?
  handoffRefId         String?
  businessName         String?
  contactName          String?
  payload              Json?
  consentStatus        String   @default("UNKNOWN")
  consentPurposes      Json?
  createdAt            DateTime @default(now())
  lead                 CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([handoffRefType, handoffRefId])
  @@index([sourceCode, createdAt])
}

/// Phase 11 Wave 2 — duplicate candidates only (no auto-merge).
model CrmDuplicateCandidate {
  id                 String    @id @default(cuid())
  leadId             String
  candidateLeadId    String
  matchType          String
  matchValue         String?
  status             String    @default("NEW")
  confidence         String?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  decisionReason     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lead               CrmLead   @relation("CrmDuplicateLead", fields: [leadId], references: [id], onDelete: Cascade)
  candidateLead      CrmLead   @relation("CrmDuplicateCandidateLead", fields: [candidateLeadId], references: [id], onDelete: Cascade)
  reviewedByAdmin    Admin?    @relation("CrmDuplicateReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([leadId, candidateLeadId, matchType])
  @@index([status, createdAt])
  @@index([leadId])
  @@index([candidateLeadId])
  @@index([reviewedByAdminId])
}

/// Phase 11 Wave 3 — versioned qualification definition header.
model CrmQualificationDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  CrmQualificationDefinitionVersion[]

  @@index([status])
}

/// Phase 11 Wave 3 — immutable published qualification version (criteria JSON).
model CrmQualificationDefinitionVersion {
  id               String   @id @default(cuid())
  definitionId     String?
  key              String?
  name             String?
  versionId        String   @unique
  status           String   @default("ACTIVE")
  criteriaJson     Json
  createdByAdminId String?
  createdAt        DateTime @default(now())
  definition       CrmQualificationDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?   @relation("CrmQualificationVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([key])
}

/// Phase 11 Wave 3 — per-lead criterion responses (UNKNOWN ≠ NO).
/// definitionVersionId is a pinned string (catalogue or DB) — no FK (SLA pattern).
model CrmQualificationResponse {
  id                   String   @id @default(cuid())
  leadId               String
  definitionVersionId  String
  criterionKey         String
  state                String
  note                 String?
  answeredByAdminId    String?
  answeredAt           DateTime @default(now())
  overrideReason       String?
  lead                 CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  answeredByAdmin      Admin?   @relation("CrmQualificationAnsweredBy", fields: [answeredByAdminId], references: [id], onDelete: SetNull)

  @@unique([leadId, definitionVersionId, criterionKey])
  @@index([leadId, definitionVersionId])
  @@index([answeredByAdminId])
}

/// Phase 11 Wave 3 — versioned score definition header.
model CrmScoreDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  CrmScoreDefinitionVersion[]

  @@index([status])
}

/// Phase 11 Wave 3 — immutable published score version (weights / bands / caps).
model CrmScoreDefinitionVersion {
  id                String   @id @default(cuid())
  definitionId      String?
  key               String?
  name              String?
  versionId         String   @unique
  status            String   @default("ACTIVE")
  displayLabel      String   @default("Lead fit score")
  dimensionsJson    Json
  bandsJson         Json
  criticalCapsJson  Json
  createdByAdminId  String?
  createdAt         DateTime @default(now())
  definition        CrmScoreDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
