model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  userAgent  String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

model AdminTenantAccess {
  id          String    @id @default(cuid())
  adminId     String
  tenantId    String
  accessLevel String    @default("full")
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminId, tenantId])
  @@index([adminId])
  @@index([tenantId])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  tenantId   String?
  user       User     @relation(fields: [userId], references: [id])
}

model Client {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  additionalEmails   String[]            @default([]) // Multiple email addresses for sending invoices
  phone              String?
  address            String?
  contactPerson      String?
  /// Persisted Active/Inactive — set from UI; not derived from invoice activity.
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  invoices           Invoice[]
  quotations         Quotation[]
  sales              Sale[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  rentalTransactions RentalTransaction[]

  @@index([tenantId, isActive])
}

model Invoice {
  id                        String              @id @default(cuid())
  invoiceNumber             String
  title                     String?
  orderNumber               String?
  clientId                  String
  createdById               String
  issueDate                 DateTime
  dueDate                   DateTime
  subtotal                  Decimal             @db.Decimal(18, 2)
  taxAmount                 Decimal             @db.Decimal(18, 2)
  total                     Decimal             @db.Decimal(18, 2)
  status                    String              @default("draft")
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  tenantId                  String
  discount                  Decimal             @default(0) @db.Decimal(18, 2)
  lastPaymentDate           DateTime?
  originalTotal             Decimal             @default(0) @db.Decimal(18, 2)
  refundAmount              Decimal             @default(0) @db.Decimal(18, 2)
  refundReason              String?
  refundedAt                DateTime?
  refundedById              String?
  remainingBalance          Decimal             @default(0) @db.Decimal(18, 2)
  totalDiscountAmount       Decimal             @default(0) @db.Decimal(18, 2)
  totalPaid                 Decimal             @default(0) @db.Decimal(18, 2)
  voidReason                String?
  voidedAt                  DateTime?
  voidedById                String?
  deletionReason            String?
  deletedAt                 DateTime?
  deletedById               String?
  isDeleted                 Boolean             @default(false)
  branchId                  String?
  footerPhoneOverride       String? // Override default phone in document footer
  footerBankDetailsOverride String? // Override default bank details in document footer
  // Reversal fields
  isReversal                Boolean             @default(false)
  reversedTransactionId     String?
  reversalReason            String?
  reversedAt                DateTime?
  reversedById              String?
  /// True when this invoice was created from Rental & Hiring (operational layer).
  isRentalInvoice           Boolean             @default(false)
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  client                    Client              @relation(fields: [clientId], references: [id])
  createdBy                 User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  deletedBy                 User?               @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])
  refundedBy                User?               @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant                    Tenant              @relation(fields: [tenantId], references: [id])
  voidedBy                  User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  items                     InvoiceItem[]
  refunds                   InvoiceRefund[]
  payments                  Payment[]
  attachments               InvoiceAttachment[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  rentalTransaction         RentalTransaction?

  @@unique([tenantId, invoiceNumber])
  @@index([branchId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([isReversal])
  @@index([reversedTransactionId])
  @@index([isRentalInvoice])
}

/// Bookable offering (catalogue) — commercial face; optional link to Asset / Product masters.
model RentalAsset {
  id              String    @id @default(cuid())
  tenantId        String
  branchId        String?
  code            String?
  name            String
  description     String?
  category        String    @default("general")
  /// rental = single-unit outbound; hiring = outbound quantity pool (not inbound supplier hire)
  kind            String
  /// SERIALISED_ASSET | POOLED_ASSET | QUANTITY_BASED_EQUIPMENT | VEHICLE | FACILITY | SERVICE | …
  rentalType      String    @default("CUSTOM")
  status          String    @default("available")
  totalQuantity   Int       @default(1)
  defaultRate     Decimal   @default(0) @db.Decimal(18, 2)
  rateUnit        String    @default("day")
  defaultDeposit  Decimal   @default(0) @db.Decimal(18, 2)
  /// Optional Fixed Asset Register link (capitalised rentable unit)
  fixedAssetId    String?
  productId       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]
  units             RentalUnit[]
  ratePlans         RentalRatePlan[]
  quotationLines    RentalQuotationLine[]
  contractLines     RentalContractLine[]

  @@unique([tenantId, code])
  @@index([tenantId, kind])
  @@index([tenantId, isActive])
  @@index([branchId])
  @@index([fixedAssetId])
  @@index([productId])
}

/// Outbound rental booking. Invoice optional when rentalPostInvoiceOnBook is false.
model RentalTransaction {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String?  @unique
  clientId       String
  kind           String
  startAt        DateTime
  endAt          DateTime
  status         String   @default("booked")
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  notes          String?
  /// Client-supplied or server-generated key — unique per tenant (retry-safe).
  idempotencyKey String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client            Client                    @relation(fields: [clientId], references: [id])
  createdBy         User                      @relation("RentalTransactionCreatedBy", fields: [createdById], references: [id])
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([clientId])
  @@index([startAt, endAt])
  @@index([status])
}

model RentalItem {
  id                  String  @id @default(cuid())
  rentalTransactionId String
  rentalAssetId       String
  quantity            Int     @default(1)
  unitRate            Decimal @db.Decimal(18, 2)
  billableUnits       Decimal @db.Decimal(18, 4)
  total               Decimal @db.Decimal(18, 2)
  returnedQuantity    Int     @default(0)

  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)
  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([rentalTransactionId])
  @@index([rentalAssetId])
}

/// Blocks double-booking: overlapping rows for the same asset must not exceed `totalQuantity` for hiring pools.
model RentalAssetAvailability {
  id                  String   @id @default(cuid())
  tenantId            String?
  rentalAssetId       String
  rentalTransactionId String
  startAt             DateTime
  endAt               DateTime
  status              String   @default("booked")
  quantity            Int      @default(1)

  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)
  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)

  @@index([rentalAssetId, startAt, endAt])
  @@index([rentalTransactionId])
  @@index([tenantId])
}

/// Serialised / pool unit under a RentalAsset offering.
model RentalUnit {
  id                 String    @id @default(cuid())
  tenantId           String
  branchId           String?
  rentalAssetId      String
  code               String?
  serialNumber       String?
  barcode            String?
  fixedAssetId       String?
  availabilityStatus String    @default("AVAILABLE")
  conditionStatus    String    @default("GOOD")
  maintenanceStatus  String    @default("OK")
  currentMeter       Decimal?  @db.Decimal(18, 4)
  meterType          String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAsset        RentalAsset @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)
  allocations        RentalUnitAllocation[]
  dispatchLines      RentalDispatchLine[]
  returnLines        RentalReturnLine[]
  inspections        RentalInspection[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([rentalAssetId])
  @@index([availabilityStatus])
  @@index([fixedAssetId])
}

model RentalRatePlan {
  id             String    @id @default(cuid())
  tenantId       String
  rentalAssetId  String
  code           String
  name           String
  currency       String    @default("MWK")
  billingUnit    String    @default("day")
  baseRate       Decimal   @db.Decimal(18, 2)
  minimumCharge  Decimal   @default(0) @db.Decimal(18, 2)
  depositAmount  Decimal   @default(0) @db.Decimal(18, 2)
  overtimeRate   Decimal?  @db.Decimal(18, 2)
  lateFeePerDay  Decimal?  @db.Decimal(18, 2)
  graceHours     Int       @default(0)
  version        Int       @default(1)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  approvalStatus String    @default("APPROVED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAsset    RentalAsset @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, version])
  @@index([tenantId, rentalAssetId])
  @@index([isActive])
}

model RentalQuotation {
  id             String    @id @default(cuid())
  tenantId       String
  quotationNumber String
  clientId       String
  status         String    @default("DRAFT")
  startAt        DateTime
  endAt          DateTime
  currency       String    @default("MWK")
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  taxEstimate    Decimal   @default(0) @db.Decimal(18, 2)
  totalEstimate  Decimal   @default(0) @db.Decimal(18, 2)
  depositEstimate Decimal  @default(0) @db.Decimal(18, 2)
  expiresAt      DateTime?
  pricingSnapshot Json?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines          RentalQuotationLine[]
  reservations   RentalReservation[]
  contracts      RentalContract[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model RentalQuotationLine {
  id              String   @id @default(cuid())
  quotationId     String
  rentalAssetId   String
  quantity        Int      @default(1)
  unitRate        Decimal  @db.Decimal(18, 2)
  billableUnits   Decimal  @db.Decimal(18, 4)
  lineTotal       Decimal  @db.Decimal(18, 2)
  description     String?
  quotation       RentalQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rentalAsset     RentalAsset     @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([rentalAssetId])
}

model RentalReservation {
  id               String    @id @default(cuid())
  tenantId         String
  reservationNumber String
  clientId         String
  quotationId      String?
  status           String    @default("DRAFT")
  startAt          DateTime
  endAt            DateTime
  expiresAt        DateTime?
  holdUntil        DateTime?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation        RentalQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  allocations      RentalUnitAllocation[]
  contracts        RentalContract[]

  @@unique([tenantId, reservationNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([startAt, endAt])
}

/// Soft allocation of a unit (or qty) for reservation/contract — enforces non-overlap for serialised units in app layer + unique active window checks.
model RentalUnitAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  rentalUnitId    String?
  rentalAssetId   String
  reservationId   String?
  contractId      String?
  startAt         DateTime
  endAt           DateTime
  quantity        Int      @default(1)
  status          String   @default("HELD")
  createdAt       DateTime @default(now())
  rentalUnit      RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: Cascade)
  reservation     RentalReservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  contract        RentalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rentalUnitId, startAt, endAt])
  @@index([rentalAssetId, startAt, endAt])
  @@index([reservationId])
  @@index([contractId])
  @@index([status])
}

model RentalContract {
  id                   String    @id @default(cuid())
  tenantId             String
  branchId             String?
  contractNumber       String
  clientId             String
  reservationId        String?
  quotationId          String?
  status               String    @default("DRAFT")
  billingPolicy        String    @default("BILL_AT_INVOICE")
  billingFrequency     String    @default("AT_RETURN")
  billingStatus        String    @default("UNBILLED")
  paymentStatus        String    @default("UNPAID")
  returnStatus         String    @default("NOT_RETURNED")
  startAt              DateTime
  endAt                DateTime
  expectedReturnAt     DateTime?
  actualReturnAt       DateTime?
  currency             String    @default("MWK")
  depositRequired      Decimal   @default(0) @db.Decimal(18, 2)
  depositReceived      Decimal   @default(0) @db.Decimal(18, 2)
  subtotalEstimate     Decimal   @default(0) @db.Decimal(18, 2)
  taxEstimate          Decimal   @default(0) @db.Decimal(18, 2)
  totalEstimate        Decimal   @default(0) @db.Decimal(18, 2)
  pricingVersion       Int       @default(1)
  pricingSnapshot      Json?
  mappingSnapshot      Json?
