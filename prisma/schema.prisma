generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                       @id @default(cuid())
  name                        String
  subdomain                   String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  status                      String                       @default("active")
  subscriptionPlan            String
  logoUrl                     String?
  primaryColor                String?
  faviconUrl                  String?
  secondaryColor              String?
  defaultBranchId             String?
  defaultBranch               Branch?                      @relation("TenantDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  ownerUserId                 String? // Main tenant user: always has access to all branches
  owner                       User?                        @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  accounts                    Account[]
  AccountBalance              AccountBalance[]
  accountSubscriptions        AccountSubscription[]
  adminAccess                 AdminTenantAccess[]
  affiliateReferrals          AffiliateReferral[]
  assets                      Asset[]
  assetCategories             AssetCategory[]
  assetTransfersOut           AssetInterBusinessTransfer[] @relation("AssetTransferFromTenant")
  assetTransfersIn            AssetInterBusinessTransfer[] @relation("AssetTransferToTenant")
  attendanceRecords           AttendanceRecord[]
  attendanceRegisters         AttendanceRegister[]
  bankAccounts                BankAccount[]
  branches                    Branch[]
  branchSubscriptions         BranchSubscription[]
  budgets                     Budget[]
  bfExpenseBudgetHeaders      BfExpenseBudgetHeader[]
  bfRevenueForecastHeaders    BfRevenueForecastHeader[]
  clients                     Client[]
  benefits                    Benefit[]
  deductions                  Deduction[]
  departments                 Department[]
  emailLogs                   EmailLog[]
  employees                   Employee[]
  equityAccounts              EquityAccount[]
  exchangeRates               ExchangeRate[]
  expenses                    Expense[]
  goodsReceipts               GoodsReceipt[]
  gratuityAccounts            GratuityAccount[]
  inventoryBatches            InventoryBatch[]
  inventoryBatchConsumptions  InventoryBatchConsumption[]
  inventoryCategories         InventoryCategory[]
  inventoryLocations          InventoryLocation[]
  inventoryTransactions       InventoryTransaction[]
  invoices                    Invoice[]
  invoiceRefunds              InvoiceRefund[]
  creditNotes                 CreditNote[]
  debitNotes                  DebitNote[]
  invoiceTemplates            InvoiceTemplate[]
  invoiceAttachments          InvoiceAttachment[]
  journalEntries              JournalEntry[]
  leaveBalances               LeaveBalance[]
  leavePolicies               LeavePolicy[]
  leaveRequests               LeaveRequest[]
  liabilities                 Liability[]
  liabilityCategories         LiabilityCategory[]
  expenseCategories           ExpenseCategory[]
  payments                    Payment[]
  paymentGateways             PaymentGateway[]
  paymentAccounts             PaymentAccount[]
  payrolls                    Payroll[]
  performanceFeedback         PerformanceFeedback[]
  performanceGoals            PerformanceGoal[]
  performanceReviews          PerformanceReview[]
  productBarcodes             ProductBarcode[]
  products                    Product[]
  purchaseOrders              PurchaseOrder[]
  documentSequences           DocumentSequence[]
  quotations                  Quotation[]
  recurringExpenses           RecurringExpense[]
  roles                       Role[]
  salaryAdvances              SalaryAdvance[]
  sales                       Sale[]                       @relation("TenantSales")
  suppliers                   Supplier[]
  supplierBills               SupplierBill[]
  supplierPayments            SupplierPayment[]
  supplierPaymentAllocations  SupplierPaymentAllocation[]
  taxTypes                    TaxType[]
  settings                    TenantSettings?
  transactions                Transaction[]
  users                       User[]
  members                     User[]                       @relation("UserTenants")
  memberships                 TenantMembership[]
  accountingPeriods           AccountingPeriod[]
  stockTransfers              StockTransfer[]
  stockTransferReceiptNotices StockTransferReceiptNotice[]
  posCashDays                 PosCashDay[]
  tpin                        String?
  eisEnabled                  Boolean                      @default(false)
  eisInvoices                 EISInvoice[]
  eisConfiguration            EISConfiguration?
  eisUsage                    EISUsage[]
  rentalAssets                RentalAsset[]
  rentalTransactions          RentalTransaction[]
  /// When true, CoA-affecting mutations and postings should be blocked (migration / maintenance).
  coaLocked                   Boolean                      @default(false)
  /// Guide Phase 3: equity auto-merge requires explicit approval per tenant.
  coaEquityMigrationApproved  Boolean                      @default(false)
  coaMigrationLogs            CoaMigrationLog[]
}

model Branch {
  id                    String                 @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForTenant      Tenant[]               @relation("TenantDefaultBranch")
  branchSubscriptions   BranchSubscription[]
  expenses              Expense[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  payments              Payment[]
  products              Product[]
  sales                 Sale[]
  transactions          Transaction[]
  budgetItems           BudgetItem[]
  defaultUsers          User[]                 @relation("UserDefaultBranch")
  userBranches          UserBranch[]
  stockTransfersFrom    StockTransfer[]        @relation("StockTransferFrom")
  stockTransfersTo      StockTransfer[]        @relation("StockTransferTo")
  rentalAssets          RentalAsset[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

/// Per-tenant monotonic counters for PO, goods receipt, invoice, and quotation numeric suffixes.
model DocumentSequence {
  id           String   @id @default(cuid())
  tenantId     String
  documentType String
  lastIssued   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
  @@index([tenantId])
}

model TenantSettings {
  id                              String    @id @default(cuid())
  tenantId                        String    @unique
  taxEnabled                      Boolean   @default(true)
  defaultTaxRate                  Float     @default(0)
  currencyCode                    String    @default("MWK")
  invoicePrefix                   String    @default("INV")
  invoiceTemplate                 String    @default("default")
  enabledModules                  String[]
  customDomain                    String?
  dailyReports                    Boolean   @default(false)
  emailFooter                     String?
  emailNotifications              Boolean   @default(true)
  inAppNotifications              Boolean   @default(true)
  invoiceReminders                Boolean   @default(true)
  lowStockAlerts                  Boolean   @default(true)
  monthlyReports                  Boolean   @default(true)
  paymentReceipts                 Boolean   @default(true)
  smsNotifications                Boolean   @default(false)
  weeklyReports                   Boolean   @default(true)
  buildingName                    String?
  businessAddress                 String?
  businessCity                    String?
  businessEmail                   String?
  businessPhone                   String?
  receiptFooter                   String?
  defaultBankDetails              String? // Default bank account details for invoice/quotation/receipt footers
  // NPS rates are tenant-configurable; null means "not configured".
  // Calculation code should treat null as 0% unless explicitly set.
  npsEmployeeRatePercent          Float?
  npsEmployerRatePercent          Float?
  balanceReminderSubject          String?
  balanceReminderBody             String?
  taxInflowAccountId              String? // Default account for tax collected (inflow from sales/invoices)
  taxOutflowAccountId             String? // Default account for tax paid (outflow from expenses/supplier bills)
  eisApiKey                       String? // Encrypted MRA EIS API key
  eisClientSecret                 String? // Encrypted MRA EIS client secret
  /// Cumulative owner contributions (not reduced by transfers to payment accounts). New rows default 0; migration seeds existing tenants.
  ownerContributedCapital         Float     @default(0)
  /// Null = owner must complete capital onboarding. Migration sets NOW() for all pre-existing TenantSettings rows.
  capitalSetupCompletedAt         DateTime?
  /// Null = owner must confirm payment accounts. Migration sets NOW() for all pre-existing TenantSettings rows.
  paymentAccountsSetupCompletedAt DateTime?
  /// 1–12: first month of fiscal year (1 = calendar year). Used for Yearly accounting periods.
  fiscalYearStartMonth            Int       @default(1)
  /// Optional display / reminder; authoritative opening date is on posted Opening transactions.
  openingBalancesAsOfDate         DateTime?
  /// When set and in the future, dashboard setup reminder is hidden.
  setupReminderSnoozedUntil       DateTime?
  /// { completed: Record<stepId, iso>, skipped: Record<stepId, iso> } — see lib/setupWizardService.js
  setupWizardState                Json?
  tenant                          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Role {
  id          String             @id @default(cuid())
  name        String
  description String
  permissions Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  users       User[]
  memberships TenantMembership[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model User {
  id                              String                       @id @default(cuid())
  /// Unique per tenant; same address may exist for users in different businesses (SaaS).
  email                           String
  name                            String?
  password                        String                       @db.VarChar(255)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  tenantId                        String?
  lastLogin                       DateTime?
  isActive                        Boolean                      @default(true)
  mfaEnabled                      Boolean                      @default(false)
  isEmailVerified                 Boolean                      @default(false)
  otpCode                         String?
  otpExpiry                       DateTime?
  department                      String?
  phone                           String?
  roleId                          String
  status                          String                       @default("active")
  authProvider                    String?
  authProviderId                  String?
  profilePicture                  String?
  resetToken                      String?
  resetTokenExpiry                DateTime?
  defaultBranchId                 String?
  adminActivityLogs               AdminActivityLog[]           @relation("AdminActivityLog")
  affiliateReferrals              AffiliateReferral[]
  createdAssets                   Asset[]                      @relation("AssetCreatedBy")
  assetInterBusinessTransfers     AssetInterBusinessTransfer[] @relation("AssetInterBusinessTransferBy")
  attendanceRegistersFinalized    AttendanceRegister[]
  auditLogs                       AuditLog[]
  approvedBudgets                 Budget[]                     @relation("BudgetApprover")
  sentEmails                      EmailLog[]                   @relation("EmailLogSender")
  deletedExpenses                 Expense[]                    @relation("ExpenseDeletedBy")
  expenseSubmissions              Expense[]
  uploadedAttachments             ExpenseAttachment[]          @relation("UploadedAttachments")
  invoiceAttachments              InvoiceAttachment[]          @relation("InvoiceAttachmentUploader")
  goodsReceiptsReceived           GoodsReceipt[]               @relation("GoodsReceiptReceiver")
  inventoryTransactions           InventoryTransaction[]
  createdInvoices                 Invoice[]                    @relation("InvoiceCreator")
  refundedInvoices                Invoice[]                    @relation("InvoiceRefundedBy")
  voidedInvoices                  Invoice[]                    @relation("InvoiceVoidedBy")
  processedRefunds                InvoiceRefund[]              @relation("InvoiceRefundedBy")
  createdJournalEntries           JournalEntry[]               @relation("JournalEntryCreatedBy")
  postedJournalEntries            JournalEntry[]               @relation("JournalEntryPostedBy")
  leaveRequestsReviewed           LeaveRequest[]
  createdLiabilities              Liability[]                  @relation("LiabilityCreatedBy")
  performanceReviewsAcknowledged  PerformanceReview[]          @relation("ReviewAcknowledgedBy")
  performanceReviewsConducted     PerformanceReview[]
  deletedProducts                 Product[]                    @relation("ProductDeletions")
  purchaseOrdersApproved          PurchaseOrder[]              @relation("PurchaseOrderApprover")
  purchaseOrdersCreated           PurchaseOrder[]              @relation("PurchaseOrderCreator")
  createdQuotations               Quotation[]                  @relation("QuotationCreator")
  recurringExpenses               RecurringExpense[]
  createdSales                    Sale[]                       @relation("SaleCreations")
  refundedSales                   Sale[]                       @relation("SaleRefunds")
  voidedSales                     Sale[]                       @relation("SaleVoids")
  supplierBillsApproved           SupplierBill[]               @relation("SupplierBillApprover")
  supplierBillsCreated            SupplierBill[]               @relation("SupplierBillCreator")
  supplierBillsFinalized          SupplierBill[]               @relation("SupplierBillFinalizedBy")
  supplierPaymentsCreated         SupplierPayment[]
  createdTransactions             Transaction[]                @relation("TransactionCreatedBy")
  postedTransactions              Transaction[]                @relation("TransactionPostedBy")
  creditNotesCreated              CreditNote[]                 @relation("CreditNoteCreatedBy")
  creditNotesPosted               CreditNote[]                 @relation("CreditNotePostedBy")
  debitNotesCreated               DebitNote[]                  @relation("DebitNoteCreatedBy")
  debitNotesPosted                DebitNote[]                  @relation("DebitNotePostedBy")
  closedAccountingPeriods         AccountingPeriod[]           @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods       AccountingPeriod[]           @relation("AccountingPeriodReopenedBy")
  stockTransfersCreated           StockTransfer[]              @relation("StockTransferCreatedBy")
  stockTransfersApproved          StockTransfer[]              @relation("StockTransferApprovedBy")
  stockTransfersReceived          StockTransfer[]              @relation("StockTransferReceivedBy")
  stockTransfersRejected          StockTransfer[]              @relation("StockTransferRejectedBy")
  defaultBranch                   Branch?                      @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  userBranches                    UserBranch[]
  role                            Role                         @relation(fields: [roleId], references: [id])
  tenant                          Tenant?                      @relation(fields: [tenantId], references: [id])
  tenants                         Tenant[]                     @relation("UserTenants")
  ownedTenants                    Tenant[]                     @relation("TenantOwner")
  memberships                     TenantMembership[]
  posCashDaysOpened               PosCashDay[]                 @relation("PosCashDayOpenedBy")
  posCashDaysClosed               PosCashDay[]                 @relation("PosCashDayClosedBy")
  posCashDayDepositsCreated       PosCashDayDeposit[]          @relation("PosCashDayDepositCreatedBy")
  rentalTransactionsCreated       RentalTransaction[]          @relation("RentalTransactionCreatedBy")
  createdBfExpenseBudgetHeaders   BfExpenseBudgetHeader[]      @relation("BfExpenseBudgetHeaderCreatedBy")
  createdBfRevenueForecastHeaders BfRevenueForecastHeader[]    @relation("BfRevenueForecastHeaderCreatedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([authProvider, authProviderId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  periodType   String // Monthly | Yearly
  startDate    DateTime
  endDate      DateTime
  status       String    @default("open") // open | closed
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closedBy   User?  @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy User?  @relation("AccountingPeriodReopenedBy", fields: [reopenedById], references: [id])

  @@unique([tenantId, periodType, startDate])
  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([status])
}

// Legacy table backing the ReversalSummary view (kept to avoid accidental drops)
model ReversalAudit {
  id String @id

  @@map("ReversalAudit")
  @@ignore
}

model Admin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  password       String              @db.VarChar(255)
  role           String              @default("Super Admin")
  permissions    Json                @default("{}")
  isActive       Boolean             @default(true)
  lastLogin      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  profilePicture String?
  phone          String?
  department     String?
  notes          String?
  adminAuditLogs AdminAuditLog[]
  managedTenants AdminTenantAccess[]
  emailLogs      EmailLog[]          @relation("EmailLogAdminSender")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  userAgent  String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

model AdminTenantAccess {
  id          String    @id @default(cuid())
  adminId     String
  tenantId    String
  accessLevel String    @default("full")
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminId, tenantId])
  @@index([adminId])
  @@index([tenantId])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  tenantId   String?
  user       User     @relation(fields: [userId], references: [id])
}

model Client {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  additionalEmails   String[]            @default([]) // Multiple email addresses for sending invoices
  phone              String?
  address            String?
  contactPerson      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  invoices           Invoice[]
  quotations         Quotation[]
  sales              Sale[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  rentalTransactions RentalTransaction[]
}

model Invoice {
  id                        String              @id @default(cuid())
  invoiceNumber             String
  title                     String?
  orderNumber               String?
  clientId                  String
  createdById               String
  issueDate                 DateTime
  dueDate                   DateTime
  subtotal                  Float
  taxAmount                 Float
  total                     Float
  status                    String              @default("draft")
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  tenantId                  String
  discount                  Float               @default(0)
  lastPaymentDate           DateTime?
  originalTotal             Float               @default(0)
  refundAmount              Float               @default(0)
  refundReason              String?
  refundedAt                DateTime?
  refundedById              String?
  remainingBalance          Float               @default(0)
  totalDiscountAmount       Float               @default(0)
  totalPaid                 Float               @default(0)
  voidReason                String?
  voidedAt                  DateTime?
  voidedById                String?
  branchId                  String?
  footerPhoneOverride       String? // Override default phone in document footer
  footerBankDetailsOverride String? // Override default bank details in document footer
  // Reversal fields
  isReversal                Boolean             @default(false)
  reversedTransactionId     String?
  reversalReason            String?
  reversedAt                DateTime?
  reversedById              String?
  /// True when this invoice was created from Rental & Hiring (operational layer).
  isRentalInvoice           Boolean             @default(false)
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  client                    Client              @relation(fields: [clientId], references: [id])
  createdBy                 User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  refundedBy                User?               @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant                    Tenant              @relation(fields: [tenantId], references: [id])
  voidedBy                  User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  items                     InvoiceItem[]
  refunds                   InvoiceRefund[]
  payments                  Payment[]
  attachments               InvoiceAttachment[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  rentalTransaction         RentalTransaction?

  @@unique([tenantId, invoiceNumber])
  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
  @@index([isRentalInvoice])
}

/// Bookable resource for Rental (time/room) or Hiring (quantity + time) — not the fixed-asset `Asset` model.
model RentalAsset {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  name          String
  description   String?
  category      String   @default("general")
  /// rental = single-unit time booking; hiring = quantity pool over time
  kind          String
  status        String   @default("available")
  totalQuantity Int      @default(1)
  defaultRate   Float    @default(0)
  rateUnit      String   @default("day")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]

  @@index([tenantId, kind])
  @@index([tenantId, isActive])
  @@index([branchId])
}

/// One rental/hiring booking linked 1:1 to an invoice.
model RentalTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String   @unique
  clientId    String
  kind        String
  startAt     DateTime
  endAt       DateTime
  status      String   @default("booked")
  totalAmount Float    @default(0)
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client            Client                    @relation(fields: [clientId], references: [id])
  createdBy         User                      @relation("RentalTransactionCreatedBy", fields: [createdById], references: [id])
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]

  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([clientId])
  @@index([startAt, endAt])
  @@index([status])
}

model RentalItem {
  id                  String @id @default(cuid())
  rentalTransactionId String
  rentalAssetId       String
  quantity            Int    @default(1)
  unitRate            Float
  billableUnits       Float
  total               Float
  returnedQuantity    Int    @default(0)

  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)
  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([rentalTransactionId])
  @@index([rentalAssetId])
}

/// Blocks double-booking: overlapping rows for the same asset must not exceed `totalQuantity` for hiring.
model RentalAssetAvailability {
  id                  String   @id @default(cuid())
  rentalAssetId       String
  rentalTransactionId String
  startAt             DateTime
  endAt               DateTime
  status              String   @default("booked")
  quantity            Int      @default(1)

  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)
  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)

  @@index([rentalAssetId, startAt, endAt])
  @@index([rentalTransactionId])
}

model InvoiceAttachment {
  id           String   @id @default(cuid())
  invoiceId    String
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())
  uploadedById String
  tenantId     String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("InvoiceAttachmentUploader", fields: [uploadedById], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@index([uploadedById])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  accountId      String?
  description    String
  quantity       Float
  unitPrice      Float
  taxRate        Float
  amount         Float
  productId      String?
  discountAmount Float    @default(0)
  discountRate   Float    @default(0)
  netAmount      Float    @default(0)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([accountId])
}

model InvoiceRefund {
  id              String    @id @default(cuid())
  invoiceId       String
  refundedById    String
  refundAmount    Float
  refundReason    String
  refundMethod    String
  refundDate      DateTime  @default(now())
  notes           String?
  tenantId        String
  status          String    @default("pending")
  processedAt     DateTime?
  transactionId   String?
  processingNotes String?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refundedBy      User      @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([refundedById])
  @@index([tenantId])
  @@index([refundDate])
  @@index([status])
}

model CreditNote {
