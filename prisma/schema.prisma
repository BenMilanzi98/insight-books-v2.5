  contactDetails              Json?
  dateOfBirth                 DateTime?
  emergencyContact            Json?
  employeeId                  String?
  employmentType              String?               @default("Permanent")
  gender                      String?
  grossSalary                 Decimal?              @db.Decimal(18, 2)
  hourlyRate                  Decimal?              @db.Decimal(18, 2)
  idNumber                    String?
  isActive                    Boolean               @default(true)
  jobTitle                    String?
  maritalStatus               String?
  nationality                 String?               @default("Malawian")
  reportingManager            Json?
  selectedDeductions          Json?
  workLocation                String?
  suspendedFrom               DateTime?
  suspendedTo                 DateTime?
  suspensionReason            String?
  terminationDate             DateTime?
  terminationReason           String?
  attendanceRecords           AttendanceRecord[]
