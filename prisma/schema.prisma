/// Singleton row (id = "global") — Android app version policy and optional broadcast.
model MobileAppConfig {
  id                    String    @id @default("global")
  latestVersionCode     Int       @default(1)
  latestVersionName     String    @default("1.0.0")
  apkDownloadUrl        String    @default("")
  /// SHA-256 hex of the published APK (signing credentials never stored)
  apkChecksum           String?
  apkFileSize           Int?
  releaseChannel        String    @default("STABLE")
  releaseNotes          String?
  /// When this rollout was published; grace window ends at publishedAt + duration unless [graceEndsAt] is set.
  publishedAt           DateTime?
  gracePeriodHours      Int       @default(24)
  /// When set, grace from publish uses this many minutes instead of [gracePeriodHours] (ignored if [graceEndsAt] is set).
  gracePeriodMinutes    Int?
  /// Hard deadline for the grace window (outdated installs lock after this). Overrides duration-from-publish when set.
  graceEndsAt           DateTime?
  /// Immediately lock all clients below latestVersionCode (ignores grace).
  forceLock             Boolean   @default(false)
  /// When true, /api/mobile-app/download is disabled instantly (website APK off).
  websiteDownloadLocked Boolean   @default(false)
  /// Optional message shown in the Android app (poll).
  broadcastMessage      String?
  /// When true, all app installs see full-screen lock (emergency / maintenance), regardless of versionCode.
  maintenanceLock       Boolean   @default(false)
  maintenanceMessage    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Anonymous Android client telemetry (version checks, OTA download funnel).
model MobileAppClientEvent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  eventType         String
  deviceId          String
  versionCode       Int
  versionName       String?
  targetVersionCode Int?
  bytesReceived     Int?
  bytesTotal        Int?
  error             String?
  meta              Json?

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([deviceId, createdAt])
}

// ============================================================================
// ACCOUNTING V2 — TRANSITION FOUNDATION (Phase 2)
// Additive only. No legacy table is modified. tenantId columns are plain
// strings (no FK to Tenant) so legacy models remain untouched and tenant
// deletion can never cascade into V2 accounting evidence.
// ============================================================================

/// Business-scoped Accounting V2 configuration. One row per tenant; absence
/// means full legacy behaviour.
model AcctV2Configuration {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  baseCurrency                  String   @default("MWK")
  accountingArchitectureVersion String   @default("ACCOUNTING_V2")
  defaultPostingMode            String   @default("NEW_ENGINE")
  strictPeriodControl           Boolean  @default(false)
  requireJournalApproval        Boolean  @default(false)
  requireReversalApproval       Boolean  @default(false)
  useNewLedgerQueries           Boolean  @default(false)
  enableShadowAccounting        Boolean  @default(false)
  enableIntegrityMonitoring     Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

/// Server-controlled accounting feature flags. Scope sentinels: "*" = all.
model AcctV2FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String   @default("*")
  flagKey   String
  moduleKey String   @default("*")
  eventType String   @default("*")
  enabled   Boolean  @default(false)
  reason    String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, flagKey, moduleKey, eventType])
  @@index([flagKey, enabled])
}

/// Accounting event registry — the database-enforced accounting identity.
/// One row per business event occurrence; the unique identity constraint is the
/// hard duplicate-posting guard the legacy system lacks.
model AcctV2EventRegistry {
  id                   String    @id @default(cuid())
  tenantId             String
  sourceModule         String
  sourceType           String
  sourceId             String
  eventType            String
  eventVersion         Int       @default(1)
  idempotencyKey       String    @unique
  commandHash          String?
  transactionDate      DateTime
  requestedPostingDate DateTime?
  currency             String    @default("MWK")
  amount               Decimal?  @db.Decimal(18, 2)
  status               String    @default("RECEIVED")
  postingMode          String    @default("LEGACY")
  architectureVersion  String    @default("TRANSITION_V2")
  correlationId        String?
  requestId            String?
  externalReference    String?
  importBatchId        String?
  webhookEventId       String?
  journalEntryId       String?
  legacyTransactionId  String?
  failureCode          String?
  failureMessage       String?
  /// Phase 4 additive columns: approval linkage + template traceability + retry state.
  approvalReference    String?
  approvedBy           String?
  templateId           String?
  templateVersion      Int?
  failureRetryable     Boolean   @default(false)
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  postedAt             DateTime?
  metadata             Json?

  attempts       AcctV2PostingAttempt[]
  shadowJournals AcctV2ShadowJournal[]

  @@unique([tenantId, sourceModule, sourceType, sourceId, eventType, eventVersion])
  @@index([tenantId, status])
  @@index([tenantId, transactionDate])
  @@index([tenantId, sourceType, sourceId])
  @@index([correlationId])
}

/// Execution log for every posting attempt — diagnoses retries and duplicates.
model AcctV2PostingAttempt {
  id                      String    @id @default(cuid())
  eventRegistryId         String
  attemptNumber           Int
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  status                  String    @default("STARTED")
  workerId                String?
  requestId               String?
  correlationId           String?
  transactionId           String?
  failureCode             String?
  sanitizedFailureMessage String?
  retryable               Boolean   @default(false)
  durationMs              Int?
  metadata                Json?

  eventRegistry AcctV2EventRegistry @relation(fields: [eventRegistryId], references: [id], onDelete: Restrict)

  @@unique([eventRegistryId, attemptNumber])
  @@index([status, startedAt])
}

/// Transactional outbox — written in the same DB transaction as the accounting
/// operation it describes; published after commit by a separate dispatcher.
model AcctV2Outbox {
  id            String    @id @default(cuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attemptCount  Int       @default(0)
  status        String    @default("PENDING")
  lastError     String?
  correlationId String?

  @@index([status, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
}

/// Shadow journal proposals. NEVER included in any production report or balance.
/// Disposable analysis data - cascade delete of lines is intentional.
model AcctV2ShadowJournal {
  id                  String   @id @default(cuid())
  tenantId            String
  eventRegistryId     String
  description         String
  transactionDate     DateTime
  postingDate         DateTime
  currency            String   @default("MWK")
  exchangeRate        Decimal  @default(1) @db.Decimal(18, 8)
  totalDebit          Decimal  @db.Decimal(18, 2)
  totalCredit         Decimal  @db.Decimal(18, 2)
  status              String   @default("PROPOSED")
  architectureVersion String   @default("TRANSITION_V2")
  metadata            Json?
  createdAt           DateTime @default(now())

  eventRegistry AcctV2EventRegistry       @relation(fields: [eventRegistryId], references: [id], onDelete: Restrict)
  lines         AcctV2ShadowJournalLine[]
  comparison    AcctV2ShadowComparison?

  @@index([tenantId, transactionDate])
  @@index([eventRegistryId])
}

model AcctV2ShadowJournalLine {
  id              String   @id @default(cuid())
  shadowJournalId String
  accountId       String
  debit           Decimal  @default(0) @db.Decimal(18, 2)
  credit          Decimal  @default(0) @db.Decimal(18, 2)
  description     String?
  sequence        Int      @default(0)
  dimensions      Json?
  createdAt       DateTime @default(now())

  shadowJournal AcctV2ShadowJournal @relation(fields: [shadowJournalId], references: [id], onDelete: Cascade)

  @@index([shadowJournalId])
}

/// Legacy-versus-proposed comparison result for one shadowed event.
model AcctV2ShadowComparison {
  id                   String   @id @default(cuid())
  tenantId             String
  shadowJournalId      String   @unique
  eventRegistryId      String?
  legacyTransactionId  String?
  legacyJournalEntryId String?
  legacyDebit          Decimal? @db.Decimal(18, 2)
  legacyCredit         Decimal? @db.Decimal(18, 2)
  proposedDebit        Decimal  @db.Decimal(18, 2)
  proposedCredit       Decimal  @db.Decimal(18, 2)
  status               String
  severity             String   @default("INFORMATIONAL")
  differences          Json?
  explanation          String?
  createdAt            DateTime @default(now())

  shadowJournal AcctV2ShadowJournal @relation(fields: [shadowJournalId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Concurrency-safe journal-number allocation (Phase 4). One row per business and
/// numbering scope (e.g. "MJ-2026"); allocation is a row-locking increment so two
/// concurrent postings can never receive the same number.
model AcctV2JournalSequence {
  id        String   @id @default(cuid())
  tenantId  String
  scopeKey  String
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, scopeKey])
}

/// Opening-balance batches (Phase 4). One approved opening event per business and
/// effective date/version — database-enforced.
model AcctV2OpeningBalanceBatch {
  id                String    @id @default(cuid())
  tenantId          String
  effectiveDate     DateTime
  version           Int       @default(1)
  status            String    @default("DRAFT")
  description       String?
  evidenceReference String?
  createdBy         String?
  approvedBy        String?
  approvedAt        DateTime?
  journalEntryId    String?   @unique
  accountingEventId String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, effectiveDate, version])
  @@index([tenantId, status])
}

/// General Ledger summary projection (Phase 5). NON-AUTHORITATIVE, rebuildable
/// monthly per-account aggregates derived from canonical posted journal lines.
/// Versioned rows: the rebuild service writes a new projectionVersion, validates
/// it against the canonical source, then removes superseded versions.
model AcctV2LedgerBalance {
  id                String   @id @default(cuid())
  tenantId          String
  accountId         String
  /// Calendar month of the posting date, "YYYY-MM".
  periodKey         String
  currency          String   @default("MWK")
  debit             Decimal  @default(0) @db.Decimal(18, 2)
  credit            Decimal  @default(0) @db.Decimal(18, 2)
  baseDebit         Decimal  @default(0) @db.Decimal(18, 2)
  baseCredit        Decimal  @default(0) @db.Decimal(18, 2)
  lineCount         Int      @default(0)
  projectionVersion Int
  projectedAt       DateTime @default(now())

  @@unique([tenantId, projectionVersion, accountId, periodKey, currency])
  @@index([tenantId, accountId])
  @@index([tenantId, projectionVersion])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Phase 6 — Historical accounting repair (additive tables only).
/// ────────────────────────────────────────────────────────────────────────────

/// Permanent Historical Accounting Anomaly Registry. One row per detected
/// anomaly instance; duplicate detection runs upsert on the natural key
/// instead of inserting twice. Findings are never deleted — resolved rows
/// keep their full history.
model AcctV2HistoricalAnomaly {
  id                 String    @id @default(cuid())
  /// Stable rule/finding code, e.g. JRN-104, GL-111, AR-001.
  findingCode        String
  tenantId           String
  financialYearLabel String?
  accountingPeriodId String?
  module             String?
  sourceType         String?
  sourceId           String?
  journalEntryId     String?
  journalLineId      String?
  transactionId      String?
  accountId          String?
  relatedEntityType  String?
  relatedEntityId    String?
  anomalyType        String
  severity           String    @default("MEDIUM")
  confidence         String    @default("MEDIUM_CONFIDENCE")
  /// Measured impact in base-currency minor units (signed), when known.
  financialImpactMinor BigInt?
  currency           String    @default("MWK")
  expectedCondition  String?
  actualCondition    String?
  rootCause          String?
  /// Natural identity of the anomaly instance for idempotent detection runs.
  detectionKey       String
  discoveredBy       String?
  discoveredAt       DateTime  @default(now())
  status             String    @default("DETECTED")
  assignedTo         String?
  reviewedBy         String?
  reviewedAt         DateTime?
  proposedRepairType String?
  proposedRepairData Json?
  approvalStatus     String?
  approvedBy         String?
  approvedAt         DateTime?
  repairBatchId      String?
  repairedAt         DateTime?
  verificationStatus String?
  verifiedBy         String?
  verifiedAt         DateTime?
  exceptionReason    String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  evidence AcctV2RepairEvidence[]
  actions  AcctV2RepairAction[]

  @@unique([tenantId, detectionKey])
  @@index([tenantId, status])
  @@index([tenantId, anomalyType])
  @@index([tenantId, severity])
  @@index([tenantId, accountId])
  @@index([repairBatchId])
}

/// Evidence attached to an anomaly. Append-only.
model AcctV2RepairEvidence {
  id           String   @id @default(cuid())
  anomalyId    String
  tenantId     String
  evidenceType String
  description  String
  /// Structured evidence payload (references, amounts, query output).
  payload      Json?
  /// Path/URI to an attachment or artifact, if any.
  reference    String?
  strength     String   @default("MEDIUM_CONFIDENCE")
  recordedBy   String?
  recordedAt   DateTime @default(now())

  anomaly AcctV2HistoricalAnomaly @relation(fields: [anomalyId], references: [id])

  @@index([anomalyId])
  @@index([tenantId])
}

/// Business-scoped repair batch: unit of review, approval, execution,
/// verification and sign-off.
model AcctV2RepairBatch {
  id                 String    @id @default(cuid())
  batchNumber        String
  tenantId           String
  financialYearLabel String?
  accountingPeriodId String?
  repairCategory     String
  description        String
  status             String    @default("DRAFT")
  dryRun             Boolean   @default(true)
  requestedBy        String?
  reviewedBy         String?
  approvedBy         String?
  approvedAt         DateTime?
  executedBy         String?
  verifiedBy         String?
  requestId          String?
  correlationId      String?
  startedAt          DateTime?
  completedAt        DateTime?
  recordCount        Int       @default(0)
  expectedDebitMinor  BigInt   @default(0)
  expectedCreditMinor BigInt   @default(0)
  actualDebitMinor    BigInt   @default(0)
  actualCreditMinor   BigInt   @default(0)
  backupReference    String?
  rollbackPlan       String?
  checksum           String?
  errorSummary       String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actions   AcctV2RepairAction[]
  snapshots AcctV2RepairSnapshot[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, status])
}

/// One idempotent repair action for one anomaly. The unique key is the
/// repair identity: the same repair can never run twice; a retry replays the
/// stored result; changed instructions under the same key are rejected via
/// commandHash comparison.
model AcctV2RepairAction {
  id             String    @id @default(cuid())
  tenantId       String
  batchId        String
  anomalyId      String
  repairType     String
  repairVersion  Int       @default(1)
  /// SHA-256 of the canonical repair command payload.
  commandHash    String
  status         String    @default("PENDING")
  dryRun         Boolean   @default(false)
  reason         String
  approvalReference String?
  approvedBy     String?
  executedBy     String?
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  /// For metadata repairs: exact previous field values (rollback source).
  previousValues Json?
  /// For metadata repairs: applied new values.
  newValues      Json?
  /// Journal(s) created by this action (reversal / reclass / adjustment / missing).
  journalEntryIds Json?
  resultSummary  Json?
  errorMessage   String?
  rolledBackAt   DateTime?
  rolledBackBy   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch   AcctV2RepairBatch       @relation(fields: [batchId], references: [id])
  anomaly AcctV2HistoricalAnomaly @relation(fields: [anomalyId], references: [id])

  @@unique([tenantId, anomalyId, repairType, repairVersion])
  @@index([batchId])
  @@index([tenantId, status])
}

/// Before/after accounting snapshot for a repair batch (business + window
/// scoped). Checksummed so results are reproducible and comparable.
model AcctV2RepairSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  batchId      String
  phase        String   // BEFORE | AFTER
  capturedAt   DateTime @default(now())
  journalCount Int
  lineCount    Int
  totalDebitMinor  BigInt
  totalCreditMinor BigInt
  /// Per-account canonical balances and control-account figures.
  balances     Json
  integrityFindingCount Int @default(0)
  checksum     String

  batch AcctV2RepairBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, phase])
  @@index([tenantId])
}

/// Exception register: anomalies that cannot be safely repaired yet.
model AcctV2RepairException {
  id                 String    @id @default(cuid())
  tenantId           String
  anomalyId          String    @unique
  module             String?
  accountingPeriodId String?
  amountMinor        BigInt?
  currency           String    @default("MWK")
  anomalyType        String
  evidenceGap        String
  reasonBlocked      String
  statementImpact    String?
  risk               String    @default("MEDIUM")
  requiredInformation String?
  responsibleOwner   String?
  targetReviewDate   DateTime?
  status             String    @default("OPEN")
  acceptedBy         String?
  acceptedAt         DateTime?
  disclosureRequired Boolean   @default(false)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, status])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Reporting V2 — Phase 7 Financial Reporting Engine. Additive tables only.
/// ────────────────────────────────────────────────────────────────────────────

/// One generated report run: filters, definition version, integrity outcome
/// and the review/approval workflow (§50). Generation is read-only for
/// accounting data; approval never alters journals.
model AcctV2ReportRun {
  id                    String    @id @default(cuid())
  tenantId              String
  reportType            String
  definitionId          String?
  definitionVersion     String?
  filters               Json
  filtersHash           String
  status                String    @default("GENERATED") // GENERATED | REVIEWED | APPROVED | SUPERSEDED
  integrityStatus       String    @default("UNVERIFIED")
  trialBalanceStatus    String?
  integrityWarnings     Json?
  totals                Json?
  resultChecksum        String
  accountingDataVersion String?
  generatedBy           String
  generatedAt           DateTime  @default(now())
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewComment         String?
  approvedBy            String?
  approvedAt            DateTime?
  approvalComment       String?
  supersededByRunId     String?
  supersededReason      String?
  requestId             String?
  correlationId         String?
  metadata              Json?

  snapshots AcctV2ReportSnapshotV2[]

  @@index([tenantId, reportType, generatedAt])
  @@index([tenantId, status])
  @@index([tenantId, filtersHash])
}

/// Immutable report snapshot (§51): full result payload, checksummed. Later
/// adjustments to a closed period produce a NEW snapshot version; the prior
/// version is marked superseded with a reason — never mutated or deleted.
model AcctV2ReportSnapshotV2 {
  id                     String    @id @default(cuid())
  tenantId               String
  runId                  String
  reportType             String
  definitionVersion      String?
  version                Int       @default(1)
  payload                Json
  checksum               String
  accountingDataVersion  String?
  integrityStatus        String?
  status                 String    @default("ACTIVE") // ACTIVE | SUPERSEDED
  supersededBySnapshotId String?
  supersededReason       String?
  createdBy              String
  createdAt              DateTime  @default(now())

  run AcctV2ReportRun @relation(fields: [runId], references: [id])

  @@index([tenantId, reportType, createdAt])
  @@index([tenantId, status])
}

/// Rebuildable report cache (§52). The General Ledger stays authoritative:
/// every read validates `sourceDataVersion` against the canonical journal
/// source and stale entries are rebuilt, never presented as verified.
model AcctV2ReportCache {
  id                String   @id @default(cuid())
  tenantId          String
  reportType        String
  filtersHash       String
  definitionVersion String   @default("1.0.0")
  sourceDataVersion String
  payload           Json
  builtAt           DateTime @default(now())

  @@unique([tenantId, reportType, filtersHash, definitionVersion])
  @@index([tenantId, reportType])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Phase 8 — Financial Calendar and Accounting Period control (additive).
/// The legacy `AccountingPeriod` table is preserved untouched; canonical
/// periods link back to it via `legacyPeriodId` for migration.
/// ────────────────────────────────────────────────────────────────────────────

/// Business-scoped financial calendar configuration (one row per business).
model AcctV2FinancialCalendarConfig {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  name                     String   @default("Standard Financial Calendar")
  /// Financial-year start month (1–12) and day.
  fyStartMonth             Int      @default(1)
  fyStartDay               Int      @default(1)
  timezone                 String   @default("Africa/Blantyre")
  periodFrequency          String   @default("MONTHLY")
  postingDatePolicy        String   @default("POSTING_DATE_DETERMINES_PERIOD")
  backdatingPolicy         String   @default("PERMISSION_AND_REASON")
  futureDatingPolicy       String   @default("TOLERANCE")
  futureToleranceDays      Int      @default(31)
  /// Optional rolling lock: normal posting on/before this date is rejected.
  lockDate                 DateTime?
  checklistTemplateId      String   @default("STANDARD_MONTHLY_CLOSE")
  checklistTemplateVersion String   @default("1.0.0")
  snapshotOnClose          Boolean  @default(true)
  recloseDeadlineDays      Int      @default(14)
  allowAdjustmentPeriod    Boolean  @default(false)
  metadata                 Json?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Canonical financial year. Statuses: DRAFT | OPEN | CLOSING | CLOSED |
/// REOPENED | ARCHIVED.
model AcctV2FinancialYear {
  id                      String    @id @default(cuid())
  tenantId                String
  name                    String
  code                    String
  startDate               DateTime
  endDate                 DateTime
  numberOfPeriods         Int       @default(12)
  periodFrequency         String    @default("MONTHLY")
  status                  String    @default("DRAFT")
  isCurrent               Boolean   @default(false)
  previousFinancialYearId String?
  architectureVersion     String    @default("ACCOUNTING_V2")
  createdBy               String?
  approvedBy              String?
  openedAt                DateTime?
  closedBy                String?
  closedAt                DateTime?
  reopenedBy              String?
  reopenedAt              DateTime?
  closeReason             String?
  reopenReason            String?
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  periods AcctV2AccountingPeriod[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

/// Canonical accounting period. Statuses: DRAFT | OPEN | CLOSING | CLOSED |
/// REOPENED. Deletion is never exposed by V2 services.
model AcctV2AccountingPeriod {
  id                  String    @id @default(cuid())
  tenantId            String
  financialYearId     String
  periodNumber        Int
  name                String
  code                String
  startDate           DateTime
  endDate             DateTime
  status              String    @default("DRAFT")
  sequence            Int
  lockDate            DateTime?
  closeDate           DateTime?
  reopenDate          DateTime?
  recloseDate         DateTime?
  isAdjustmentPeriod  Boolean   @default(false)
  isYearEndPeriod     Boolean   @default(false)
  /// Migration alias to the legacy `AccountingPeriod` row, when mapped.
  legacyPeriodId      String?
  architectureVersion String    @default("ACCOUNTING_V2")
  createdBy           String?
  closedBy            String?
  reopenedBy          String?
  reclosedBy          String?
  closeReason         String?
  reopenReason        String?
  currentCloseRunId   String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  financialYear AcctV2FinancialYear @relation(fields: [financialYearId], references: [id])
  closeRuns     AcctV2PeriodCloseRun[]

  @@unique([financialYearId, periodNumber])
  @@unique([tenantId, code])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, status])
}

/// Immutable period/year status transition history. Append-only.
model AcctV2PeriodStatusHistory {
  id                 String   @id @default(cuid())
  tenantId           String
  financialYearId    String?
  accountingPeriodId String?
  previousStatus     String?
  newStatus          String
  action             String
  reason             String?
  requestedBy        String?
  approvedBy         String?
  executedBy         String?
  requestId          String?
  correlationId      String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([tenantId, accountingPeriodId])
  @@index([tenantId, financialYearId])
}

/// Period close run: one versioned close attempt per period. Statuses:
/// DRAFT | IN_PROGRESS | BLOCKED | READY_FOR_REVIEW | APPROVED | COMPLETED |
/// CANCELLED | SUPERSEDED. Re-closing creates a new run; runs are never
/// overwritten.
model AcctV2PeriodCloseRun {
  id                       String    @id @default(cuid())
  tenantId                 String
  financialYearId          String
  accountingPeriodId       String
  closeNumber              Int       @default(1)
  status                   String    @default("IN_PROGRESS")
  checklistTemplateId      String
  checklistTemplateVersion String
  initiatedBy              String
  reviewedBy               String?
  approvedBy               String?
  closedBy                 String?
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  expectedTaskCount        Int       @default(0)
  completedTaskCount       Int       @default(0)
  blockedTaskCount         Int       @default(0)
  warningTaskCount         Int       @default(0)
  trialBalanceStatus       String?
  reportStatus             String?
  integrityStatus          String?
  snapshotReferences       Json?
  reason                   String?
  requestId                String?
  correlationId            String?
  metadata                 Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  period AcctV2AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  tasks  AcctV2PeriodCloseTask[]

  @@unique([accountingPeriodId, closeNumber])
  @@index([tenantId, status])
  @@index([tenantId, accountingPeriodId])
}

/// Materialized checklist task for a close run. Statuses: NOT_STARTED |
/// IN_PROGRESS | PASSED | PASSED_WITH_WARNING | FAILED | BLOCKED | WAIVED |
/// NOT_APPLICABLE.
model AcctV2PeriodCloseTask {
  id           String    @id @default(cuid())
  tenantId     String
  closeRunId   String
  taskKey      String
  name         String
  module       String
  kind         String // AUTOMATIC | MANUAL
  blocking     Boolean   @default(false)
  required     Boolean   @default(true)
  status       String    @default("NOT_STARTED")
  displayOrder Int       @default(0)
  /// Automated check result: { rule, expected, actual, difference, severity, evidence }.
  result       Json?
  evidence     Json?
  comment      String?
  completedBy  String?
  completedAt  DateTime?
  waivedBy     String?
  waiveReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  closeRun AcctV2PeriodCloseRun @relation(fields: [closeRunId], references: [id])

  @@unique([closeRunId, taskKey])
  @@index([tenantId, closeRunId])
}

/// Period close exception. Statuses: OPEN | UNDER_REVIEW |
/// ACCEPTED_TEMPORARILY | ACCEPTED_FOR_CLOSE | RESOLVED | REJECTED.
model AcctV2PeriodCloseException {
  id                 String    @id @default(cuid())
  tenantId           String
  financialYearId    String?
  accountingPeriodId String
  closeRunId         String?
  taskKey            String?
  category           String
  severity           String    @default("MEDIUM")
  amountMinor        BigInt?
  currency           String    @default("MWK")
  description        String
  rootCause          String?
  evidence           Json?
  status             String    @default("OPEN")
  acceptedBy         String?
  acceptedAt         DateTime?
  resolutionTarget   String?
  resolvedBy         String?
  resolvedAt         DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, accountingPeriodId, status])
}

/// Controlled reopening request for a CLOSED period. Statuses: PENDING |
/// APPROVED | REJECTED | EXECUTED | CANCELLED.
model AcctV2PeriodReopenRequest {
  id                  String    @id @default(cuid())
  tenantId            String
  financialYearId     String
  accountingPeriodId  String
  reason              String
  expectedCorrections String?
  status              String    @default("PENDING")
  impactAnalysis      Json?
  correctionScope     Json?
  recloseDeadline     DateTime?
  requestedBy         String
  requestedAt         DateTime  @default(now())
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectionReason     String?
  executedAt          DateTime?
  requestId           String?
  correlationId       String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, accountingPeriodId, status])
}

/// ────────────────────────────────────────────────────────────────────────────
/// CoA V2 — Chart of Accounts governance (Phase 3). Additive tables only.
/// ────────────────────────────────────────────────────────────────────────────

/// Business-scoped account mapping registry: one active mapping per
/// (business, purpose, module, transactionType, currency, branch) context.
/// Context sentinels: "*" = any. History of changes lives in AuditLog.
model CoaV2AccountMapping {
  id                  String    @id @default(cuid())
  tenantId            String
  purpose             String
  accountId           String
  moduleKey           String    @default("*")
  transactionType     String    @default("*")
  currency            String    @default("*")
  branchKey           String    @default("*")
  status              String    @default("ACTIVE")
  priority            Int       @default(0)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  architectureVersion String    @default("TRANSITION_V2")
  createdBy           String?
  updatedBy           String?
  approvedBy          String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, purpose, moduleKey, transactionType, currency, branchKey])
  @@index([tenantId, purpose, status])
  @@index([accountId])
}

/// Legacy code/name alias pointing to a canonical account. Controls FUTURE
/// resolution and presentation only — never rewrites posted history.
model CoaV2AccountAlias {
  id                 String    @id @default(cuid())
  tenantId           String
  aliasCode          String
  aliasName          String?
  legacyAccountId    String?
  canonicalAccountId String
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  reason             String?
  createdBy          String?
  createdAt          DateTime  @default(now())

  legacyAccount    Account? @relation("AliasLegacyAccount", fields: [legacyAccountId], references: [id], onDelete: SetNull)
  canonicalAccount Account  @relation("AliasCanonicalAccount", fields: [canonicalAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, aliasCode])
  @@index([tenantId, canonicalAccountId])
  @@index([legacyAccountId])
}

/// Versioned Chart of Accounts template header. Immutable after publication —
/// updates require a new version row.
model CoaV2Template {
  id             String    @id @default(cuid())
  templateKey    String
  name           String
  version        Int       @default(1)
  businessType   String
  country        String?
  description    String?
  status         String    @default("DRAFT")
  baseCodeRanges Json?
  effectiveFrom  DateTime?
  publishedAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts CoaV2TemplateAccount[]

  @@unique([templateKey, version])
  @@index([businessType, status])
}

/// One account definition inside a template version.
model CoaV2TemplateAccount {
  id                        String  @id @default(cuid())
  templateId                String
  code                      String
  name                      String
  description               String?
  parentCode                String?
  category                  String
  subType                   String?
  behaviour                 String
  normalBalance             String
  systemPurpose             String?
  controlAccountPurpose     String?
  financialStatementSection String?
  cashFlowClassification    String?
  currencyPolicy            String  @default("BASE_CURRENCY_ONLY")
  required                  Boolean @default(false)
  displayOrder              Int     @default(0)

  template CoaV2Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId])
}

/// Controlled account consolidation plan (Phase 3 §19). Execution marks the
/// duplicate deprecated + aliased; historical journal lines are NEVER rewritten
/// here — historical reclassification is recorded as a Phase 6 recommendation.
model CoaV2ConsolidationPlan {
  id                   String    @id @default(cuid())
  tenantId             String
  duplicateAccountId   String
  canonicalAccountId   String
  status               String    @default("DRAFT")
  duplicateClass       String?
  analysis             Json?
  reason               String?
  phase6RepairRequired Boolean   @default(false)
  createdBy            String?
  approvedBy           String?
  approvedAt           DateTime?
  executedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  duplicateAccount Account @relation("ConsolidationDuplicateAccount", fields: [duplicateAccountId], references: [id], onDelete: Restrict)
  canonicalAccount Account @relation("ConsolidationCanonicalAccount", fields: [canonicalAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([duplicateAccountId])
}

// ============================================================================
// Phase 10 — Bank Reconciliation (additive). Identity = PaymentAccount + CoA.
// tenantId is a plain string (AcctV2 convention — no Tenant FK / cascade).
// Statement rows are external evidence only; matches never mutate JE lines.
// ============================================================================

/// Per-PaymentAccount recon settings (tolerances, profile, approvals).
model BankRecConfiguration {
  id                      String   @id @default(cuid())
  tenantId                String
  paymentAccountId        String   @unique
  coaAccountId            String
  enabled                 Boolean  @default(true)
  currency                String   @default("MWK")
  dateToleranceDays       Int      @default(3)
  amountToleranceMinor    Int      @default(0)
  autoMatchMinConfidence  String   @default("HIGH") // EXACT | HIGH | MEDIUM
  requireSeparateApprover Boolean  @default(true)
  staleOutstandingDays    Int      @default(30)
  defaultProfileId        String?
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String?
  updatedBy               String?

  @@index([tenantId])
  @@index([coaAccountId])
}

/// Named import mapping profile (column map / OFX hints).
model BankRecStatementProfile {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  format      String // CSV | XLSX | OFX | QFX
  status      String   @default("ACTIVE")
  version     Int      @default(1)
  columnMap   Json // { date, description, reference, debit, credit, amount, balance, ... }
  options     Json? // delimiter, dateFormat, signedAmountMode, skipRows, sheetName
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

/// One uploaded statement file attempt.
model BankRecImportBatch {
  id                 String    @id @default(cuid())
  tenantId           String
  paymentAccountId   String
  reconciliationId   String?
  profileId          String?
  fileName           String
  fileHash           String
  mimeType           String?
  byteSize           Int?
  status             String    @default("PENDING") // PENDING|PREVIEWED|CONFIRMED|FAILED|REJECTED
  rowCount           Int       @default(0)
  duplicateRowCount  Int       @default(0)
  statementOpening   Decimal?  @db.Decimal(18, 2)
  statementClosing   Decimal?  @db.Decimal(18, 2)
  periodStart        DateTime? @db.Date
  periodEnd          DateTime? @db.Date
  balanceValid       Boolean?
  errorSummary       String?
  parseWarnings      Json?
  createdAt          DateTime  @default(now())
  confirmedAt        DateTime?
  createdBy          String?
  confirmedBy        String?

  transactions BankRecStatementTransaction[]

  @@unique([tenantId, paymentAccountId, fileHash])
  @@index([tenantId, paymentAccountId, status])
  @@index([reconciliationId])
}

/// External bank statement evidence row (immutable after confirm).
model BankRecStatementTransaction {
  id                   String    @id @default(cuid())
  tenantId             String
  importBatchId        String
  paymentAccountId     String
  reconciliationId     String?
  lineNumber           Int
  transactionDate      DateTime  @db.Date
  valueDate            DateTime? @db.Date
  description          String
  reference            String?
  referenceNormalized  String?
  payee                String?
  signedAmountMinor    Int // bank perspective: +in / -out
  signedAmount         Decimal   @db.Decimal(18, 2)
  runningBalance       Decimal?  @db.Decimal(18, 2)
  currency             String    @default("MWK")
  rowFingerprint       String
  matchingStatus       String    @default("UNMATCHED") // UNMATCHED|SUGGESTED|MATCHED|PARTIAL|EXCLUDED|CLASSIFIED
  classification       String? // BANK_CHARGE|INTEREST|TRANSFER|UNKNOWN|...
  remainingAmountMinor Int
  rawPayload           Json?
  createdAt            DateTime  @default(now())

  importBatch BankRecImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  matchLinks  BankRecMatchLink[]

  @@unique([importBatchId, lineNumber])
  @@unique([tenantId, paymentAccountId, rowFingerprint])
  @@index([tenantId, paymentAccountId, matchingStatus])
  @@index([tenantId, transactionDate])
  @@index([referenceNormalized])
  @@index([signedAmountMinor])
  @@index([reconciliationId])
}

/// Reconciliation session for a payment account + statement period.
model BankRecReconciliation {
  id                      String    @id @default(cuid())
  tenantId                String
  paymentAccountId        String
  coaAccountId            String
  version                 Int       @default(1)
  status                  String    @default("DRAFT") // DRAFT|IN_PROGRESS|IN_REVIEW|APPROVED|COMPLETED|REOPENED|REVERSED
  statementDate           DateTime  @db.Date
  periodStart             DateTime? @db.Date
  periodEnd               DateTime? @db.Date
  statementOpeningBalance Decimal?  @db.Decimal(18, 2)
  statementClosingBalance Decimal   @db.Decimal(18, 2)
  bookBalance             Decimal?  @db.Decimal(18, 2)
  clearedBookBalance      Decimal?  @db.Decimal(18, 2)
  outstandingPayments     Decimal?  @db.Decimal(18, 2)
  depositsInTransit       Decimal?  @db.Decimal(18, 2)
  adjustmentsTotal        Decimal?  @db.Decimal(18, 2)
  differenceMinor         Int       @default(0)
  currency                String    @default("MWK")
  preparedBy              String?
  reviewedBy              String?
  approvedBy              String?
  completedBy             String?
  preparedAt              DateTime?
  reviewedAt              DateTime?
  approvedAt              DateTime?
  completedAt             DateTime?
  reopenedFromId          String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  statusHistory   BankRecStatusHistory[]
  matches         BankRecMatch[]
  outstandingItems BankRecOutstandingItem[]
  exceptions      BankRecException[]
  approvals       BankRecApproval[]
  snapshots       BankRecSnapshot[]
  adjustments     BankRecAdjustmentLink[]

  @@unique([tenantId, paymentAccountId, statementDate, version])
  @@index([tenantId, paymentAccountId, status])
  @@index([tenantId, status, statementDate])
}

model BankRecStatusHistory {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  fromStatus       String?
  toStatus         String
  reason           String?
  actorUserId      String?
  createdAt        DateTime @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, createdAt])
}

/// Match group header (supports 1:1, 1:N, N:1, N:N, partial).
model BankRecMatch {
  id                 String   @id @default(cuid())
  tenantId           String
  reconciliationId   String
  matchType          String // ONE_TO_ONE|ONE_TO_MANY|MANY_TO_ONE|MANY_TO_MANY|PARTIAL
  confidence         String // EXACT|HIGH|MEDIUM|LOW|CONFLICTED|MANUAL
  status             String   @default("SUGGESTED") // SUGGESTED|ACCEPTED|REJECTED|REVERSED
  statementTotalMinor Int     @default(0)
  bookTotalMinor     Int      @default(0)
  differenceMinor    Int      @default(0)
  ruleKey            String?
  notes              String?
  createdBy          String?
  acceptedBy         String?
  createdAt          DateTime @default(now())
  acceptedAt         DateTime?

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  links          BankRecMatchLink[]

  @@index([tenantId, reconciliationId, status])
  @@index([confidence])
}

/// Side of a match: statement row and/or journal entry line.
model BankRecMatchLink {
  id                    String  @id @default(cuid())
  tenantId              String
  matchId               String
  side                  String // STATEMENT | BOOK
  statementTransactionId String?
  journalEntryLineId    String?
  journalEntryId        String?
  allocatedAmountMinor  Int
  createdAt             DateTime @default(now())

  match                 BankRecMatch                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  statementTransaction  BankRecStatementTransaction?  @relation(fields: [statementTransactionId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([statementTransactionId])
  @@index([journalEntryLineId])
  @@index([tenantId, journalEntryLineId])
}

model BankRecMatchingRule {
  id          String   @id @default(cuid())
  tenantId    String   @default("*")
  ruleKey     String
  name        String
  version     Int      @default(1)
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  matchType   String   @default("ONE_TO_ONE")
  confidence  String   @default("HIGH")
  criteria    Json // { amountExact, dateToleranceDays, referenceRequired, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, ruleKey, version])
  @@index([enabled, priority])
}

model BankRecOutstandingItem {
  id               String    @id @default(cuid())
  tenantId         String
  reconciliationId String
  itemType         String // OUTSTANDING_PAYMENT | DEPOSIT_IN_TRANSIT | OTHER
  description      String
  amountMinor      Int
  amount           Decimal   @db.Decimal(18, 2)
  itemDate         DateTime? @db.Date
  journalEntryLineId String?
  statementTransactionId String?
  agingDays        Int       @default(0)
  stale            Boolean   @default(false)
  createdAt        DateTime  @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, itemType])
}

model BankRecException {
  id               String    @id @default(cuid())
  tenantId         String
  reconciliationId String
  code             String
  severity         String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  status           String    @default("OPEN") // OPEN|RESOLVED|WAIVED
  message          String
  evidence         Json?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, status])
}

model BankRecApproval {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  action           String // PREPARE|REVIEW|APPROVE|COMPLETE|REOPEN|REVERSE
  actorUserId      String
  comment          String?
  createdAt        DateTime @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, action])
}

/// Immutable completion snapshot.
model BankRecSnapshot {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  version          Int
  payload          Json
  createdAt        DateTime @default(now())
  createdBy        String?

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, version])
  @@index([tenantId, createdAt])
}

/// Links a recon adjustment to the Posting Engine event / journal.
model BankRecAdjustmentLink {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  statementTransactionId String?
  adjustmentType   String // BANK_CHARGE|INTEREST_INCOME|TRANSFER|MANUAL_JOURNAL|RETURNED_PAYMENT
  eventRegistryId  String?
  journalEntryId   String?
  amountMinor      Int
  description      String?
  createdBy        String?
  createdAt        DateTime @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@index([journalEntryId])
  @@index([eventRegistryId])
}

// ============================================================================
// Phase 11 — Equity Management V2 (additive). tenantId plain string (no Tenant FK).
// Financial balances derive from posted JournalEntryLine — never typed independently.
// Legacy EquityAccount remains unused as authority.
// ============================================================================

/// Business-level equity / legal-structure configuration.
model EqV2Configuration {
  id                         String    @id @default(cuid())
  tenantId                   String    @unique
  legalStructure             String    @default("SOLE_PROPRIETORSHIP")
  equityModel                String    @default("OWNER_CAPITAL")
  ownershipTrackingEnabled   Boolean   @default(false)
  shareCapitalEnabled        Boolean   @default(false)
  partnershipCapitalEnabled  Boolean   @default(false)
  ownerCapitalEnabled        Boolean   @default(true)
  shareClassesEnabled        Boolean   @default(false)
  votingRightsEnabled        Boolean   @default(false)
  dividendManagementEnabled  Boolean   @default(false)
  ownerDrawingsEnabled       Boolean   @default(true)
  retainedEarningsEnabled    Boolean   @default(true)
  reservesEnabled            Boolean   @default(false)
  ownershipPercentageScale   Int       @default(4)
  shareQuantityScale         Int       @default(0)
  defaultCurrency            String    @default("MWK")
  requireContributionApproval Boolean  @default(true)
  requireDrawingApproval     Boolean   @default(true)
  requireDividendApproval    Boolean   @default(true)
  requireSeparateApprover    Boolean   @default(true)
  architectureVersion        String    @default("EQUITY_V2")
  status                     String    @default("ACTIVE")
  effectiveFrom              DateTime  @db.Date
  createdBy                  String?
  approvedBy                 String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  metadata                   Json?

  @@index([status])
}

/// Business-scoped owner / partner / shareholder relationship (not global party).
model EqV2PartyRelationship {
  id                    String    @id @default(cuid())
  tenantId              String
  partyName              String
  partyType             String    @default("PERSON") // PERSON | ORGANIZATION
  relationshipType      String // OWNER | PARTNER | SHAREHOLDER | MEMBER | BENEFICIAL_OWNER | OTHER
  ownershipStatus       String    @default("ACTIVE") // DRAFT|PENDING_VERIFICATION|ACTIVE|SUSPENDED|EXIT_PENDING|EXITED|DECEASED|ARCHIVED
  ownerNumber           String?
  shareholderNumber     String?
  partnerNumber         String?
  email                 String?
  phone                 String?
  taxIdentifierRef      String?
  address               String?
  beneficialOwnershipStatus String?
  verificationStatus    String    @default("UNVERIFIED")
  effectiveFrom         DateTime  @db.Date
  effectiveTo           DateTime? @db.Date
  legacyEquityAccountId String?
  createdBy             String?
  approvedBy            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  metadata              Json?

  holdings     EqV2OwnershipHolding[]
  movements    EqV2OwnershipMovement[] @relation("MovementHolder")
  transactions EqV2EquityTransaction[]
  allocations  EqV2DividendAllocation[]

  @@unique([tenantId, relationshipType, partyName, effectiveFrom])
  @@index([tenantId, ownershipStatus])
  @@index([tenantId, relationshipType])
}

model EqV2ShareClass {
  id                   String    @id @default(cuid())
  tenantId             String
  classCode            String
  className            String
  description          String?
  nominalValue         Decimal   @db.Decimal(18, 6)
  currency             String    @default("MWK")
  authorizedQuantity   Decimal?  @db.Decimal(18, 6)
  issuedQuantity       Decimal   @default(0) @db.Decimal(18, 6)
  paidQuantity         Decimal   @default(0) @db.Decimal(18, 6)
  votingRightsPerShare Decimal   @default(1) @db.Decimal(18, 6)
  dividendRights       String?
  liquidationRights    String?
  isRedeemable         Boolean   @default(false)
  isConvertible        Boolean   @default(false)
  equityAccountId      String?
  sharePremiumAccountId String?
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  status               String    @default("DRAFT") // DRAFT|ACTIVE|INACTIVE
  createdBy            String?
  approvedBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  metadata             Json?

  holdings EqV2OwnershipHolding[]

  @@unique([tenantId, classCode])
  @@index([tenantId, status])
}

/// Versioned ownership holding — never overwrite history.
model EqV2OwnershipHolding {
  id                   String    @id @default(cuid())
  tenantId             String
  relationshipId       String
  shareClassId         String?
  quantityHeld         Decimal   @default(0) @db.Decimal(18, 6)
  nominalValueHeld     Decimal   @default(0) @db.Decimal(18, 2)
  paidValue            Decimal   @default(0) @db.Decimal(18, 2)
  ownershipPercentage  Decimal   @default(0) @db.Decimal(18, 8)
  votingPercentage     Decimal   @default(0) @db.Decimal(18, 8)
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  sourceTransactionId  String?
  status               String    @default("ACTIVE")
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  metadata             Json?

  relationship EqV2PartyRelationship @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  shareClass   EqV2ShareClass?       @relation(fields: [shareClassId], references: [id], onDelete: Restrict)

  @@index([tenantId, relationshipId, status])
  @@index([tenantId, effectiveFrom, effectiveTo])
  @@index([shareClassId])
}

model EqV2OwnershipMovement {
  id                   String   @id @default(cuid())
  tenantId             String
  movementType         String // ISSUE|TRANSFER|REDEMPTION|ADJUSTMENT|EXIT
  fromRelationshipId   String?
  toRelationshipId     String?
  shareClassId         String?
  quantity             Decimal  @db.Decimal(18, 6)
  ownershipPercentage  Decimal? @db.Decimal(18, 8)
  effectiveDate        DateTime @db.Date
  considerationRef     String?
  createsCompanyJournal Boolean @default(false)
  equityTransactionId  String?
  status               String   @default("APPROVED")
  createdBy            String?
  approvedBy           String?
  createdAt            DateTime @default(now())
  metadata             Json?

  toHolder EqV2PartyRelationship? @relation("MovementHolder", fields: [toRelationshipId], references: [id], onDelete: Restrict)

  @@index([tenantId, effectiveDate])
  @@index([equityTransactionId])
}

/// Canonical equity transaction (financial + ownership events).
model EqV2EquityTransaction {
  id                   String    @id @default(cuid())
  tenantId             String
  transactionNumber    String
  transactionType      String
  relationshipId       String?
  shareClassId         String?
  transactionDate      DateTime  @db.Date
  requestedPostingDate DateTime? @db.Date
  amount               Decimal   @db.Decimal(18, 2)
  amountMinor          Int
  currency             String    @default("MWK")
  shareQuantity        Decimal?  @db.Decimal(18, 6)
  nominalValue         Decimal?  @db.Decimal(18, 6)
  issuePrice           Decimal?  @db.Decimal(18, 6)
  premiumAmount        Decimal?  @db.Decimal(18, 2)
  description          String?
  reason               String?
  sourceReference      String?
  status               String    @default("DRAFT")
  approvalStatus       String    @default("NONE")
  accountingStatus     String    @default("NOT_POSTED")
  accountingEventId    String?
  journalEntryId       String?
  reversalTransactionId String?
  originalTransactionId String?
  effectiveOwnershipDate DateTime? @db.Date
  altersOwnership      Boolean   @default(false)
  bankAccountId        String?
  assetAccountId       String?
  offsetAccountId      String?
  equityAccountId      String?
  assetId              String?
  liabilityId          String?
  dividendDeclarationId String?
  createdBy            String?
  submittedBy          String?
  approvedBy           String?
  postedBy             String?
  createdAt            DateTime  @default(now())
  approvedAt           DateTime?
  postedAt             DateTime?
  updatedAt            DateTime  @updatedAt
  metadata             Json?

  relationship EqV2PartyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  approvals    EqV2EquityApproval[]
  documents    EqV2EquityDocument[]

  @@unique([tenantId, transactionNumber])
  @@index([tenantId, transactionType, status])
  @@index([tenantId, accountingStatus])
  @@index([journalEntryId])
  @@index([accountingEventId])
  @@index([relationshipId])
}

model EqV2DividendDeclaration {
  id                String   @id @default(cuid())
  tenantId          String
  declarationNumber String
  declarationDate   DateTime @db.Date
  recordDate        DateTime? @db.Date
  paymentDate       DateTime? @db.Date
  totalAmount       Decimal  @db.Decimal(18, 2)
  totalAmountMinor  Int
  currency          String   @default("MWK")
  allocationMethod  String   @default("OWNERSHIP_PERCENTAGE") // SHARE_QUANTITY|OWNERSHIP_PERCENTAGE|FIXED|OTHER
  status            String   @default("DRAFT")
  equityTransactionId String?
  journalEntryId    String?
  retainedEarningsAccountId String?
  dividendsPayableAccountId String?
  createdBy         String?
  approvedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  metadata          Json?

  allocations EqV2DividendAllocation[]
  payments    EqV2DividendPayment[]

  @@unique([tenantId, declarationNumber])
  @@index([tenantId, status])
}

model EqV2DividendAllocation {
  id               String  @id @default(cuid())
  tenantId         String
  declarationId    String
  relationshipId   String
  eligibleQuantity Decimal? @db.Decimal(18, 6)
  ownershipPercentage Decimal? @db.Decimal(18, 8)
  grossAmount      Decimal @db.Decimal(18, 2)
  grossAmountMinor Int
  withholdingMinor Int     @default(0)
  netAmountMinor   Int
  currency         String  @default("MWK")
