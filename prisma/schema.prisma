model Budget {
  id              String                   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  budgetType      String                   @default("revenue") // revenue, expense
  periodType      String                   @default("annual") // monthly, quarterly, yearly
  startDate       DateTime
  endDate         DateTime
  expectedRevenue Float                    @default(0) // Expected revenue amount for this budget
  status          String                   @default("draft") // draft, active, closed
  version         Int                      @default(1)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  currency        String                   @default("MWK")
  isLocked        Boolean                  @default(false)
  lockedAt        DateTime?
  activatedById   String?
  activatedAt     DateTime?
  approvedBy      User?                    @relation("BudgetApprover", fields: [approvedById], references: [id])
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           BudgetItem[]
  breakdowns      RevenueBudgetBreakdown[]

  @@index([tenantId])
  @@index([budgetType])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
  @@index([isLocked])
}

model RevenueBudgetBreakdown {
  id              String   @id @default(cuid())
  budgetId        String
  breakdownType   String // branch, product_category
  referenceId     String // branchId or categoryId
  referenceName   String // branch name or category name
  budgetedAmount  Float
  actualAmount    Float    @default(0)
  variance        Float?
  variancePercent Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, breakdownType, referenceId])
  @@index([budgetId])
  @@index([breakdownType])
  @@index([referenceId])
}

model BudgetItem {
  id              String   @id @default(cuid())
  budgetId        String
  accountId       String?
  branchId        String?
  categoryId      String?
  period          DateTime
  budgetedAmount  Float
  actualAmount    Float    @default(0)
  variance        Float?
  variancePercent Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        String?
  account         Account? @relation(fields: [accountId], references: [id])
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id])

  @@unique([budgetId, accountId, category, period])
  @@index([budgetId])
  @@index([accountId])
  @@index([category])
  @@index([period])
  @@index([branchId])
  @@index([categoryId])
}

/// CoA-linked expense budgets (Budget & Forecast module). Actuals are never stored here.
model BfExpenseBudgetHeader {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  periodType  String // monthly | quarterly | yearly
  startDate   DateTime
  endDate     DateTime
  createdById String?
  status      String   @default("draft") // draft | active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("BfExpenseBudgetHeaderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BfExpenseBudgetLine[]

  @@index([tenantId])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
}

model BfExpenseBudgetLine {
  id                    String   @id @default(cuid())
  expenseBudgetHeaderId String
  accountId             String
  period                String // e.g. 2026-01, 2026-Q1, 2026
  plannedAmount         Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  header  BfExpenseBudgetHeader @relation(fields: [expenseBudgetHeaderId], references: [id], onDelete: Cascade)
  account Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([expenseBudgetHeaderId, accountId, period])
  @@index([expenseBudgetHeaderId])
  @@index([accountId])
}

/// CoA-linked revenue forecasts. Supports named versions (v1, v2, …).
model BfRevenueForecastHeader {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  periodType  String // monthly | quarterly | yearly
  startDate   DateTime
  endDate     DateTime
  version     String   @default("v1")
  createdById String?
  status      String   @default("draft") // draft | active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                   @relation("BfRevenueForecastHeaderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BfRevenueForecastLine[]

  @@index([tenantId])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
}

model BfRevenueForecastLine {
  id                      String   @id @default(cuid())
  revenueForecastHeaderId String
  accountId               String
  period                  String
  plannedAmount           Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  header  BfRevenueForecastHeader @relation(fields: [revenueForecastHeaderId], references: [id], onDelete: Cascade)
  account Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([revenueForecastHeaderId, accountId, period])
  @@index([revenueForecastHeaderId])
  @@index([accountId])
}

model Currency {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  symbol          String
  isActive        Boolean        @default(true)
  isBase          Boolean        @default(false)
  exchangeRates   ExchangeRate[] @relation("FromCurrency")
  toExchangeRates ExchangeRate[] @relation("ToCurrency")

  @@index([isActive])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  effectiveDate  DateTime
  tenantId       String?
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([tenantId])
}

model StockTransfer {
  id              String                      @id @default(cuid())
  tenantId        String
  fromBranchId    String
  toBranchId      String
  productId       String
  quantity        Decimal                     @db.Decimal(18, 4)
  status          String                      @default("pending") // pending, approved, received, rejected, cancelled
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  receivedById    String?
  receivedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch      Branch                      @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch        Branch                      @relation("StockTransferTo", fields: [toBranchId], references: [id])
  product         Product                     @relation(fields: [productId], references: [id])
  createdBy       User                        @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?                       @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  receivedBy      User?                       @relation("StockTransferReceivedBy", fields: [receivedById], references: [id])
  rejectedBy      User?                       @relation("StockTransferRejectedBy", fields: [rejectedById], references: [id])
  receiptNotice   StockTransferReceiptNotice?

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([productId])
  @@index([status])
  @@index([createdById])
  @@index([receivedById])
  @@index([rejectedById])
}

/// In-app notice on the receiving business dashboard when stock arrives from another tenant.
model StockTransferReceiptNotice {
  id               String    @id @default(cuid())
  tenantId         String
  stockTransferId  String    @unique
  sourceTenantId   String
  sourceTenantName String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, readAt])
}

// ─── MRA EIS (Electronic Invoice System) Models ───

model EISInvoice {
  id             String               @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String
  mraInvoiceId   String?
  invoiceDate    DateTime
  totalAmount    Float
  taxAmount      Float
  status         String // Pending, Submitted, Approved, Rejected, Error
  submissionId   String?
  submittedAt    DateTime?
  responseData   Json?
  errorMessage   String?
  retryCount     Int                  @default(0)
  lastRetryAt    DateTime?
  sourceType     String? // 'sale', 'invoice', 'quotation-convert'
  sourceId       String? // ID of the originating Sale or Invoice
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([submittedAt])
  @@index([mraInvoiceId])
  @@index([sourceType, sourceId])
}

model EISConfiguration {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  clientId     String
  clientSecret String
  apiKey       String?
  environment  String // sandbox | production
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  syncStatus   String?
  settings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([environment])
}

model EISSubmissionLog {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String
  requestPayload  Json
  responsePayload Json?
  status          String
  errorCode       String?
  errorMessage    String?
  durationMs      Int
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@index([createdAt])
}

model EISUsage {
  id              String   @id @default(cuid())
  tenantId        String
  monthYear       String
  invoiceCount    Int      @default(0)
  submissionCount Int      @default(0)
  approvedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  totalAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, monthYear])
  @@index([tenantId])
  @@index([monthYear])
}

/// Singleton row (id = "global") — Android app version policy and optional broadcast.
model MobileAppConfig {
  id                    String    @id @default("global")
  latestVersionCode     Int       @default(1)
  latestVersionName     String    @default("1.0.0")
  apkDownloadUrl        String    @default("")
  releaseNotes          String?
  /// When this rollout was published; grace window ends at publishedAt + gracePeriodHours.
  publishedAt           DateTime?
  gracePeriodHours      Int       @default(24)
  /// Immediately lock all clients below latestVersionCode (ignores grace).
  forceLock             Boolean   @default(false)
  /// When true, /api/mobile-app/download is disabled instantly (website APK off).
  websiteDownloadLocked Boolean   @default(false)
  /// Optional message shown in the Android app (poll).
  broadcastMessage      String?
  /// When true, all app installs see full-screen lock (emergency / maintenance), regardless of versionCode.
  maintenanceLock       Boolean   @default(false)
  maintenanceMessage    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Anonymous Android client telemetry (version checks, OTA download funnel).
model MobileAppClientEvent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  eventType         String
  deviceId          String
  versionCode       Int
  versionName       String?
  targetVersionCode Int?
  bytesReceived     Int?
  bytesTotal        Int?
  error             String?
  meta              Json?

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([deviceId, createdAt])
}
