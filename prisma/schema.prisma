}

model PerformanceReviewCriteria {
  id           String            @id @default(cuid())
  reviewId     String
  criteriaName String
  rating       Float
  comments     String?
  weight       Float             @default(1.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceGoal {
  id           String             @id @default(cuid())
  employeeId   String
  tenantId     String
  title        String
  description  String?
  category     String?
  targetValue  Float?
  targetUnit   String?
  startDate    DateTime
  targetDate   DateTime
  status       String             @default("active")
  progress     Float              @default(0)
  currentValue Float?
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reviewId     String?
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  review       PerformanceReview? @relation(fields: [reviewId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                  String   @id @default(cuid())
  employeeId          String
  feedbackGiverId     String
  tenantId            String
  feedbackType        String   @default("peer")
  reviewId            String?
  rating              Float?
  strengths           String?
  areasForImprovement String?
  suggestions         String?
  isAnonymous         Boolean  @default(false)
  status              String   @default("submitted")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  employee            Employee @relation("FeedbackReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbackGiver       Employee @relation("FeedbackGiven", fields: [feedbackGiverId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([feedbackGiverId])
  @@index([feedbackType])
  @@index([createdAt])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  assets      Asset[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                      String                       @id @default(cuid())
  name                    String
  description             String?
  categoryId              String
  purchaseDate            DateTime
  originalCost            Float
  usefulLifeYears         Int
  depreciationMethod      String                       @default("straight_line")
  status                  String                       @default("active")
  location                String?
  serialNumber            String?
  supplier                String?
  warrantyExpiry          DateTime?
  notes                   String?
  isExistingAsset         Boolean                      @default(false)
  accumulatedDepreciation Float                        @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  tenantId                String
  createdById             String
  glAccountId             String?
  category                AssetCategory                @relation(fields: [categoryId], references: [id])
  createdBy               User                         @relation("AssetCreatedBy", fields: [createdById], references: [id])
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  glAccount               Account?                     @relation("AssetGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  journalEntries          AssetJournalEntry[]
  depreciationSchedules   DepreciationSchedule[]
  interBusinessTransfers  AssetInterBusinessTransfer[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([purchaseDate])
  @@index([glAccountId])
}

/// Immutable audit row each time an asset is moved to another tenant (business).
model AssetInterBusinessTransfer {
  id               String   @id @default(cuid())
  assetId          String
  fromTenantId     String
  toTenantId       String
  fromTenantName   String
  toTenantName     String
  fromCategoryId   String
  toCategoryId     String
  fromCategoryName String
  toCategoryName   String
  transferredById  String
  transferredAt    DateTime @default(now())
  notes            String?
  snapshotJson     String

  asset         Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromTenant    Tenant @relation("AssetTransferFromTenant", fields: [fromTenantId], references: [id])
  toTenant      Tenant @relation("AssetTransferToTenant", fields: [toTenantId], references: [id])
  transferredBy User   @relation("AssetInterBusinessTransferBy", fields: [transferredById], references: [id])

  @@index([assetId])
  @@index([fromTenantId])
  @@index([toTenantId])
  @@index([transferredAt])
}

model DepreciationSchedule {
  id                      String   @id @default(cuid())
  assetId                 String
  periodStart             DateTime
  periodEnd               DateTime
  depreciationAmount      Float
  accumulatedDepreciation Float
  netBookValue            Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodStart])
}

model AssetJournalEntry {
  id          String   @id @default(cuid())
  assetId     String
  entryType   String   @default("purchase")
  amount      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entryType])
}

model LiabilityCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenantId    String
  liabilities Liability[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ExpenseCategory {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  accountId          String              @unique
  accountCode        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  expenses           Expense[]
  purchaseOrderItems PurchaseOrderItem[]
  account            Account             @relation("ExpenseCategoryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountId])
}

model Liability {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  categoryId            String
  liabilityType         String
  principalAmount       Float
  interestRate          Float?             @default(0)
  interestType          String             @default("reducing_balance")
  oneTimeInterestAmount Float?             @default(0)
  startDate             DateTime
  maturityDate          DateTime?
  termMonths            Int?
  paymentFrequency      String?
  status                String             @default("active")
  lender                String?
  accountNumber         String?
  notes                 String?
  currentBalance        Float              @default(0)
  totalPaid             Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String
  createdById           String
  glAccountId           String?
  category              LiabilityCategory  @relation(fields: [categoryId], references: [id])
  createdBy             User               @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  glAccount             Account?           @relation("LiabilityGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  payments              LiabilityPayment[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([liabilityType])
  @@index([glAccountId])
}

model LiabilityPayment {
  id            String    @id @default(cuid())
  liabilityId   String
  amount        Float
  paymentDate   DateTime
  paymentType   String    @default("principal")
  principalPaid Float     @default(0)
  interestPaid  Float     @default(0)
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  liability     Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId])
  @@index([paymentDate])
}

/// Pre-greenfield budget tables (renamed). Do not use for new planning work.
model LegacyBudget {
  id              String                         @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  budgetType      String                         @default("revenue")
  periodType      String                         @default("annual")
  startDate       DateTime
  endDate         DateTime
  expectedRevenue Float                          @default(0)
  status          String                         @default("draft")
  version         Int                            @default(1)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  currency        String                         @default("MWK")
  isLocked        Boolean                        @default(false)
  lockedAt        DateTime?
  activatedById   String?
  activatedAt     DateTime?
  approvedBy      User?                          @relation("LegacyBudgetApprover", fields: [approvedById], references: [id])
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           LegacyBudgetItem[]
  breakdowns      LegacyRevenueBudgetBreakdown[]

  @@index([tenantId])
  @@index([budgetType])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
  @@index([isLocked])
  @@map("LegacyBudget")
}

model LegacyRevenueBudgetBreakdown {
  id              String       @id @default(cuid())
  budgetId        String
  breakdownType   String
  referenceId     String
  referenceName   String
  budgetedAmount  Float
  actualAmount    Float        @default(0)
  variance        Float?
  variancePercent Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  budget          LegacyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, breakdownType, referenceId])
  @@index([budgetId])
  @@index([breakdownType])
  @@index([referenceId])
  @@map("LegacyRevenueBudgetBreakdown")
}

model LegacyBudgetItem {
  id              String       @id @default(cuid())
  budgetId        String
  accountId       String?
  branchId        String?
  categoryId      String?
  period          DateTime
  budgetedAmount  Float
  actualAmount    Float        @default(0)
  variance        Float?
  variancePercent Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        String?
  account         Account?     @relation(fields: [accountId], references: [id])
  budget          LegacyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id])

  @@unique([budgetId, accountId, category, period])
  @@index([budgetId])
  @@index([accountId])
  @@index([category])
  @@index([period])
  @@index([branchId])
  @@index([categoryId])
  @@map("LegacyBudgetItem")
}

/// Greenfield planning Budget (never posts to GL).
model Budget {
  id                        String    @id @default(cuid())
  tenantId                  String
  businessId                String
  name                      String
  description               String?
  budgetType                String    @default("OPERATING")
  budgetMethod              String    @default("CREATE_MANUALLY")
  frequency                 String    @default("MONTHLY")
  planningMode              String    @default("POSTING_ACCOUNT_DETAIL")
  fiscalYear                Int?
  startDate                 DateTime
  endDate                   DateTime
  currency                  String    @default("MWK")
  status                    String    @default("DRAFT")
  versionNumber             Int       @default(1)
  revisionNumber            Int       @default(1)
  branchId                  String?
  departmentId              String?
  projectId                 String?
  costCentreId              String?
  parentBudgetId            String?
  copiedFromBudgetId        String?
  generatedFromActualsStart DateTime?
  generatedFromActualsEnd   DateTime?
  assumptionSetId           String?
  approvalState             String    @default("NONE")
  approvedById              String?
  approvedAt                DateTime?
  lockedById                String?
  lockedAt                  DateTime?
  activatedAt               DateTime?
  supersededAt              DateTime?
  createdById               String?
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant      Tenant            @relation("PlanningBudgetTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("PlanningBudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?             @relation("PlanningBudgetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lockedBy    User?             @relation("PlanningBudgetLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  parent      Budget?           @relation("BudgetHierarchy", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  children    Budget[]          @relation("BudgetHierarchy")
  copiedFrom  Budget?           @relation("BudgetCopiedFrom", fields: [copiedFromBudgetId], references: [id], onDelete: SetNull)
  copies      Budget[]          @relation("BudgetCopiedFrom")
  lines       BudgetLine[]
  versions    BudgetVersion[]
  approvals   BudgetApproval[]
  forecasts   Forecast[]        @relation("ForecastSourceBudget")

  @@index([tenantId, businessId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@index([branchId])
  @@map("PlanningBudget")
}

model BudgetLine {
  id                      String   @id @default(cuid())
  budgetId                String
  accountId               String
  accountCodeSnapshot     String
  accountNameSnapshot     String
  accountTypeSnapshot     String?
  accountCategorySnapshot String?
  parentAccountIdSnapshot String?
  branchId                String?
  departmentId            String?
  projectId               String?
  costCentreId            String?
  lineType                String   @default("PLANNED")
  calculationMethod       String   @default("MANUAL")
  annualAmountMinor       Int      @default(0)
  notes                   String?
  assumptions             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  budget         Budget                @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodAmounts  BudgetPeriodAmount[]

  @@unique([budgetId, accountId, branchId, departmentId, projectId, costCentreId])
  @@index([budgetId])
  @@index([accountId])
}

model BudgetPeriodAmount {
  id                 String    @id @default(cuid())
  budgetLineId       String
  periodStart        DateTime
  periodEnd          DateTime
  monthNumber        Int?
  quarterNumber      Int?
  plannedAmountMinor Int       @default(0)
  sourceMethod       String    @default("MANUAL")
  growthRate         Float?
  distributionWeight Float?
  notes              String?

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, periodStart, periodEnd])
  @@index([budgetLineId])
}

model BudgetVersion {
  id              String    @id @default(cuid())
  budgetId        String
  versionNumber   Int
  revisionNumber  Int       @default(1)
  state           String
  changeReason    String?
  snapshotJson    Json?
  snapshotChecksum String?
  createdById     String?
  approvedById    String?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?

  budget     Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("BudgetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?  @relation("BudgetVersionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals  BudgetApproval[]

  @@unique([budgetId, versionNumber, revisionNumber])
  @@index([budgetId, state])
}

model BudgetApproval {
  id          String    @id @default(cuid())
  budgetId    String
  versionId   String?
  requestedById String
  approverId  String?
  state       String    @default("PENDING")
  reason      String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  version     BudgetVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  requestedBy User           @relation("BudgetApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver    User?          @relation("BudgetApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([budgetId, state])
}

model ForecastAssumptionSet {
  id          String   @id @default(cuid())
  tenantId    String
  businessId  String
  name        String
  description String?
  version     Int      @default(1)
  effectiveDate DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation("ForecastAssumptionSetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assumptions ForecastAssumption[]
  forecasts   Forecast[]

  @@index([tenantId, businessId])
}

model ForecastAssumption {
  id              String    @id @default(cuid())
  assumptionSetId String
  assumptionType  String
  scopeType       String    @default("GLOBAL")
  scopeId         String?
  accountId       String?
  value           Float
  unit            String    @default("PERCENT")
  startDate       DateTime?
  endDate         DateTime?
  notes           String?

  assumptionSet ForecastAssumptionSet @relation(fields: [assumptionSetId], references: [id], onDelete: Cascade)
  account       Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([assumptionSetId])
}

model Forecast {
  id                     String    @id @default(cuid())
  tenantId               String
  businessId             String
  name                   String
  description            String?
  forecastType           String    @default("ROLLING")
  scenarioType           String    @default("BASE_CASE")
  startDate              DateTime
  endDate                DateTime
  cutoffDate             DateTime?
  currency               String    @default("MWK")
  sourceBudgetId         String?
  sourceBudgetVersionId  String?
  status                 String    @default("DRAFT")
  versionNumber          Int       @default(1)
  calculationVersion     String    @default("1.0.0")
  branchId               String?
  departmentId           String?
  projectId              String?
  costCentreId           String?
  assumptionSetId        String?
  approvedById           String?
  approvedAt             DateTime?
  lockedAt               DateTime?
  createdById            String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant        Tenant                 @relation("PlanningForecastTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("PlanningForecastCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy    User?                  @relation("PlanningForecastApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sourceBudget  Budget?                @relation("ForecastSourceBudget", fields: [sourceBudgetId], references: [id], onDelete: SetNull)
  assumptionSet ForecastAssumptionSet? @relation(fields: [assumptionSetId], references: [id], onDelete: SetNull)
  lines         ForecastLine[]

  @@index([tenantId, businessId])
  @@index([tenantId, status])
  @@index([sourceBudgetId])
  @@map("PlanningForecast")
}

model ForecastLine {
  id                      String   @id @default(cuid())
  forecastId              String
  accountId               String
  accountCodeSnapshot     String
  accountNameSnapshot     String
  accountTypeSnapshot     String?
  forecastMethod          String   @default("MANUAL")
  historicalActualMinor   Int      @default(0)
  budgetAmountMinor       Int      @default(0)
  projectedAmountMinor    Int      @default(0)
  confidenceLevel         String?
  growthRate              Float?
  seasonalityFactor       Float?
  recurringAmountMinor    Int?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  forecast      Forecast                @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodAmounts ForecastPeriodAmount[]

  @@unique([forecastId, accountId])
  @@index([forecastId])
  @@index([accountId])
}

model ForecastPeriodAmount {
  id                 String   @id @default(cuid())
  forecastLineId     String
  periodStart        DateTime
  periodEnd          DateTime
  actualAmountMinor  Int      @default(0)
  budgetAmountMinor  Int      @default(0)
  forecastAmountMinor Int     @default(0)
  sourceType         String   @default("FORECAST")
  calculationVersion String   @default("1.0.0")
  assumptionReference String?

  forecastLine ForecastLine @relation(fields: [forecastLineId], references: [id], onDelete: Cascade)

  @@unique([forecastLineId, periodStart, periodEnd])
  @@index([forecastLineId])
}

/// CoA-linked expense budgets (Budget & Forecast module). Actuals are never stored here.
model BfExpenseBudgetHeader {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  periodType  String // monthly | quarterly | yearly
  startDate   DateTime
  endDate     DateTime
  createdById String?
  status      String   @default("draft") // draft | active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("BfExpenseBudgetHeaderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BfExpenseBudgetLine[]

  @@index([tenantId])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
}

model BfExpenseBudgetLine {
  id                    String   @id @default(cuid())
  expenseBudgetHeaderId String
  accountId             String
  period                String // e.g. 2026-01, 2026-Q1, 2026
  plannedAmount         Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  header  BfExpenseBudgetHeader @relation(fields: [expenseBudgetHeaderId], references: [id], onDelete: Cascade)
  account Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([expenseBudgetHeaderId, accountId, period])
  @@index([expenseBudgetHeaderId])
  @@index([accountId])
}

/// CoA-linked revenue forecasts. Supports named versions (v1, v2, …).
model BfRevenueForecastHeader {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  periodType  String // monthly | quarterly | yearly
  startDate   DateTime
  endDate     DateTime
  version     String   @default("v1")
  createdById String?
  status      String   @default("draft") // draft | active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                   @relation("BfRevenueForecastHeaderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BfRevenueForecastLine[]

  @@index([tenantId])
  @@index([status])
  @@index([periodType])
  @@index([startDate, endDate])
}

model BfRevenueForecastLine {
  id                      String   @id @default(cuid())
  revenueForecastHeaderId String
  accountId               String
  period                  String
  plannedAmount           Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  header  BfRevenueForecastHeader @relation(fields: [revenueForecastHeaderId], references: [id], onDelete: Cascade)
  account Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([revenueForecastHeaderId, accountId, period])
  @@index([revenueForecastHeaderId])
  @@index([accountId])
}

model Currency {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  symbol          String
  isActive        Boolean        @default(true)
  isBase          Boolean        @default(false)
  exchangeRates   ExchangeRate[] @relation("FromCurrency")
  toExchangeRates ExchangeRate[] @relation("ToCurrency")

  @@index([isActive])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  effectiveDate  DateTime
  tenantId       String?
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([tenantId])
}

model StockTransfer {
  id              String                      @id @default(cuid())
  tenantId        String
  fromBranchId    String
  toBranchId      String
  productId       String
  quantity        Decimal                     @db.Decimal(18, 4)
  status          String                      @default("pending") // pending, approved, received, rejected, cancelled
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  receivedById    String?
  receivedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch      Branch                      @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch        Branch                      @relation("StockTransferTo", fields: [toBranchId], references: [id])
  product         Product                     @relation(fields: [productId], references: [id])
  createdBy       User                        @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?                       @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  receivedBy      User?                       @relation("StockTransferReceivedBy", fields: [receivedById], references: [id])
  rejectedBy      User?                       @relation("StockTransferRejectedBy", fields: [rejectedById], references: [id])
  receiptNotice   StockTransferReceiptNotice?

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([productId])
  @@index([status])
  @@index([createdById])
  @@index([receivedById])
  @@index([rejectedById])
}

/// Basic four-column stock Excel import batch (Business-scoped; no user-facing branch).
model StockImportBatch {
  id                 String           @id @default(cuid())
  tenantId           String
  fileHash           String
  fileName           String?
  purpose            String           @default("STOCK_RECEIPT_IMPORT") // OPENING_STOCK_IMPORT | STOCK_RECEIPT_IMPORT | DATA_MIGRATION_IMPORT
  status             String           @default("UPLOADED")
  updateSellingPrice Boolean          @default(true)
  forceAsNewReceipt  Boolean          @default(false)
  rowCount           Int              @default(0)
  validCount         Int              @default(0)
  warningCount       Int              @default(0)
  invalidCount       Int              @default(0)
  createdById        String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  errorSummary       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation("StockImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rows               StockImportRow[]

  @@unique([tenantId, fileHash, purpose])
  @@index([tenantId, status])
  @@index([createdById])
}

model StockImportRow {
  id               String           @id @default(cuid())
  batchId          String
  tenantId         String
  rowNumber        Int
  itemName         String
  normalizedName   String
  quantity         Decimal          @db.Decimal(18, 4)
  orderPrice       Decimal          @db.Decimal(18, 2)
  sellingPrice     Decimal          @db.Decimal(18, 2)
  matchStatus      String           // NEW | MATCHED | AMBIGUOUS | INVALID
  productId        String?
  status           String           @default("PENDING") // PENDING | READY | BLOCKED | POSTED | FAILED | SKIPPED
  message          String?
  quantityBefore   Decimal?         @db.Decimal(18, 4)
  quantityAfter    Decimal?         @db.Decimal(18, 4)
  valueBefore      Decimal?         @db.Decimal(18, 2)
  valueAfter       Decimal?         @db.Decimal(18, 2)
  wacBefore        Decimal?         @db.Decimal(18, 2)
  wacAfter         Decimal?         @db.Decimal(18, 2)
  movementId       String?
  batchLayerId     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  batch            StockImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([tenantId, normalizedName])
  @@index([productId])
  @@index([status])
}

/// In-app notice on the receiving business dashboard when stock arrives from another tenant.
model StockTransferReceiptNotice {
  id               String    @id @default(cuid())
  tenantId         String
  stockTransferId  String    @unique
  sourceTenantId   String
  sourceTenantName String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, readAt])
}

// ─── MRA EIS (Electronic Invoice System) Models ───

model EISInvoice {
  id             String               @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String
  mraInvoiceId   String?
  invoiceDate    DateTime
  totalAmount    Float
  taxAmount      Float
  status         String // Pending, Submitted, Approved, Rejected, Error
  submissionId   String?
  submittedAt    DateTime?
  responseData   Json?
  errorMessage   String?
  retryCount     Int                  @default(0)
  lastRetryAt    DateTime?
  sourceType     String? // 'sale', 'invoice', 'quotation-convert'
  sourceId       String? // ID of the originating Sale or Invoice
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([submittedAt])
  @@index([mraInvoiceId])
  @@index([sourceType, sourceId])
}

model EISConfiguration {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  clientId     String
  clientSecret String
  apiKey       String?
  environment  String // sandbox | production
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  syncStatus   String?
  settings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([environment])
}

model EISSubmissionLog {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String
  requestPayload  Json
  responsePayload Json?
  status          String
  errorCode       String?
  errorMessage    String?
  durationMs      Int
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@index([createdAt])
}

model EISUsage {
  id              String   @id @default(cuid())
  tenantId        String
  monthYear       String
  invoiceCount    Int      @default(0)
  submissionCount Int      @default(0)
  approvedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  totalAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, monthYear])
  @@index([tenantId])
  @@index([monthYear])
}

/// Singleton row (id = "global") — Android app version policy and optional broadcast.
model MobileAppConfig {
  id                    String    @id @default("global")
  latestVersionCode     Int       @default(1)
  latestVersionName     String    @default("1.0.0")
  apkDownloadUrl        String    @default("")
  /// SHA-256 hex of the published APK (signing credentials never stored)
  apkChecksum           String?
  apkFileSize           Int?
  releaseChannel        String    @default("STABLE")
  releaseNotes          String?
  /// When this rollout was published; grace window ends at publishedAt + duration unless [graceEndsAt] is set.
  publishedAt           DateTime?
  gracePeriodHours      Int       @default(24)
  /// When set, grace from publish uses this many minutes instead of [gracePeriodHours] (ignored if [graceEndsAt] is set).
  gracePeriodMinutes    Int?
  /// Hard deadline for the grace window (outdated installs lock after this). Overrides duration-from-publish when set.
  graceEndsAt           DateTime?
  /// Immediately lock all clients below latestVersionCode (ignores grace).
  forceLock             Boolean   @default(false)
  /// When true, /api/mobile-app/download is disabled instantly (website APK off).
  websiteDownloadLocked Boolean   @default(false)
  /// Optional message shown in the Android app (poll).
  broadcastMessage      String?
  /// When true, all app installs see full-screen lock (emergency / maintenance), regardless of versionCode.
  maintenanceLock       Boolean   @default(false)
  maintenanceMessage    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Anonymous Android client telemetry (version checks, OTA download funnel).
model MobileAppClientEvent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  eventType         String
  deviceId          String
  versionCode       Int
  versionName       String?
  targetVersionCode Int?
  bytesReceived     Int?
  bytesTotal        Int?
  error             String?
  meta              Json?

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([deviceId, createdAt])
}

// ============================================================================
// ACCOUNTING V2 — TRANSITION FOUNDATION (Phase 2)
// Additive only. No legacy table is modified. tenantId columns are plain
// strings (no FK to Tenant) so legacy models remain untouched and tenant
// deletion can never cascade into V2 accounting evidence.
// ============================================================================

/// Business-scoped Accounting V2 configuration. One row per tenant; absence
/// means full legacy behaviour.
model AcctV2Configuration {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  baseCurrency                  String   @default("MWK")
  accountingArchitectureVersion String   @default("ACCOUNTING_V2")
  defaultPostingMode            String   @default("NEW_ENGINE")
  strictPeriodControl           Boolean  @default(false)
  requireJournalApproval        Boolean  @default(false)
  requireReversalApproval       Boolean  @default(false)
  useNewLedgerQueries           Boolean  @default(false)
  enableShadowAccounting        Boolean  @default(false)
  enableIntegrityMonitoring     Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

/// Server-controlled accounting feature flags. Scope sentinels: "*" = all.
model AcctV2FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String   @default("*")
  flagKey   String
  moduleKey String   @default("*")
  eventType String   @default("*")
  enabled   Boolean  @default(false)
  reason    String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, flagKey, moduleKey, eventType])
  @@index([flagKey, enabled])
}

/// Accounting event registry — the database-enforced accounting identity.
/// One row per business event occurrence; the unique identity constraint is the
/// hard duplicate-posting guard the legacy system lacks.
model AcctV2EventRegistry {
  id                   String    @id @default(cuid())
  tenantId             String
  sourceModule         String
  sourceType           String
  sourceId             String
  eventType            String
  eventVersion         Int       @default(1)
  idempotencyKey       String    @unique
  commandHash          String?
  transactionDate      DateTime
  requestedPostingDate DateTime?
  currency             String    @default("MWK")
  amount               Decimal?  @db.Decimal(18, 2)
  status               String    @default("RECEIVED")
  postingMode          String    @default("LEGACY")
  architectureVersion  String    @default("TRANSITION_V2")
  correlationId        String?
  requestId            String?
  externalReference    String?
  importBatchId        String?
  webhookEventId       String?
  journalEntryId       String?
  legacyTransactionId  String?
  failureCode          String?
  failureMessage       String?
  /// Phase 4 additive columns: approval linkage + template traceability + retry state.
  approvalReference    String?
  approvedBy           String?
  templateId           String?
  templateVersion      Int?
  failureRetryable     Boolean   @default(false)
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  postedAt             DateTime?
  metadata             Json?

  attempts       AcctV2PostingAttempt[]
  shadowJournals AcctV2ShadowJournal[]

  @@unique([tenantId, sourceModule, sourceType, sourceId, eventType, eventVersion])
  @@index([tenantId, status])
  @@index([tenantId, transactionDate])
  @@index([tenantId, sourceType, sourceId])
  @@index([correlationId])
}

/// Execution log for every posting attempt — diagnoses retries and duplicates.
model AcctV2PostingAttempt {
  id                      String    @id @default(cuid())
  eventRegistryId         String
  attemptNumber           Int
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  status                  String    @default("STARTED")
  workerId                String?
  requestId               String?
  correlationId           String?
  transactionId           String?
  failureCode             String?
  sanitizedFailureMessage String?
  retryable               Boolean   @default(false)
  durationMs              Int?
  metadata                Json?

  eventRegistry AcctV2EventRegistry @relation(fields: [eventRegistryId], references: [id], onDelete: Restrict)

  @@unique([eventRegistryId, attemptNumber])
  @@index([status, startedAt])
}

/// Transactional outbox — written in the same DB transaction as the accounting
/// operation it describes; published after commit by a separate dispatcher.
model AcctV2Outbox {
  id            String    @id @default(cuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attemptCount  Int       @default(0)
  status        String    @default("PENDING")
  lastError     String?
  correlationId String?

  @@index([status, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
}

/// Shadow journal proposals. NEVER included in any production report or balance.
/// Disposable analysis data - cascade delete of lines is intentional.
model AcctV2ShadowJournal {
  id                  String   @id @default(cuid())
  tenantId            String
  eventRegistryId     String
  description         String
  transactionDate     DateTime
  postingDate         DateTime
  currency            String   @default("MWK")
  exchangeRate        Decimal  @default(1) @db.Decimal(18, 8)
  totalDebit          Decimal  @db.Decimal(18, 2)
  totalCredit         Decimal  @db.Decimal(18, 2)
  status              String   @default("PROPOSED")
  architectureVersion String   @default("TRANSITION_V2")
  metadata            Json?
  createdAt           DateTime @default(now())

  eventRegistry AcctV2EventRegistry       @relation(fields: [eventRegistryId], references: [id], onDelete: Restrict)
  lines         AcctV2ShadowJournalLine[]
  comparison    AcctV2ShadowComparison?

  @@index([tenantId, transactionDate])
  @@index([eventRegistryId])
}

model AcctV2ShadowJournalLine {
  id              String   @id @default(cuid())
  shadowJournalId String
  accountId       String
  debit           Decimal  @default(0) @db.Decimal(18, 2)
  credit          Decimal  @default(0) @db.Decimal(18, 2)
  description     String?
  sequence        Int      @default(0)
  dimensions      Json?
  createdAt       DateTime @default(now())

  shadowJournal AcctV2ShadowJournal @relation(fields: [shadowJournalId], references: [id], onDelete: Cascade)

  @@index([shadowJournalId])
}

/// Legacy-versus-proposed comparison result for one shadowed event.
model AcctV2ShadowComparison {
  id                   String   @id @default(cuid())
  tenantId             String
  shadowJournalId      String   @unique
  eventRegistryId      String?
  legacyTransactionId  String?
  legacyJournalEntryId String?
  legacyDebit          Decimal? @db.Decimal(18, 2)
  legacyCredit         Decimal? @db.Decimal(18, 2)
  proposedDebit        Decimal  @db.Decimal(18, 2)
  proposedCredit       Decimal  @db.Decimal(18, 2)
  status               String
  severity             String   @default("INFORMATIONAL")
  differences          Json?
  explanation          String?
  createdAt            DateTime @default(now())

  shadowJournal AcctV2ShadowJournal @relation(fields: [shadowJournalId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Concurrency-safe journal-number allocation (Phase 4). One row per business and
/// numbering scope (e.g. "MJ-2026"); allocation is a row-locking increment so two
/// concurrent postings can never receive the same number.
model AcctV2JournalSequence {
  id        String   @id @default(cuid())
  tenantId  String
  scopeKey  String
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, scopeKey])
}

/// Opening-balance batches (Phase 4). One approved opening event per business and
/// effective date/version — database-enforced.
model AcctV2OpeningBalanceBatch {
  id                String    @id @default(cuid())
  tenantId          String
  effectiveDate     DateTime
  version           Int       @default(1)
  status            String    @default("DRAFT")
  description       String?
  evidenceReference String?
  createdBy         String?
  approvedBy        String?
  approvedAt        DateTime?
  journalEntryId    String?   @unique
  accountingEventId String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, effectiveDate, version])
  @@index([tenantId, status])
}

/// General Ledger summary projection (Phase 5). NON-AUTHORITATIVE, rebuildable
/// monthly per-account aggregates derived from canonical posted journal lines.
/// Versioned rows: the rebuild service writes a new projectionVersion, validates
/// it against the canonical source, then removes superseded versions.
model AcctV2LedgerBalance {
  id                String   @id @default(cuid())
  tenantId          String
  accountId         String
  /// Calendar month of the posting date, "YYYY-MM".
  periodKey         String
  currency          String   @default("MWK")
  debit             Decimal  @default(0) @db.Decimal(18, 2)
  credit            Decimal  @default(0) @db.Decimal(18, 2)
  baseDebit         Decimal  @default(0) @db.Decimal(18, 2)
  baseCredit        Decimal  @default(0) @db.Decimal(18, 2)
  lineCount         Int      @default(0)
  projectionVersion Int
  projectedAt       DateTime @default(now())

  @@unique([tenantId, projectionVersion, accountId, periodKey, currency])
  @@index([tenantId, accountId])
  @@index([tenantId, projectionVersion])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Phase 6 — Historical accounting repair (additive tables only).
/// ────────────────────────────────────────────────────────────────────────────

/// Permanent Historical Accounting Anomaly Registry. One row per detected
/// anomaly instance; duplicate detection runs upsert on the natural key
/// instead of inserting twice. Findings are never deleted — resolved rows
/// keep their full history.
model AcctV2HistoricalAnomaly {
  id                 String    @id @default(cuid())
  /// Stable rule/finding code, e.g. JRN-104, GL-111, AR-001.
  findingCode        String
  tenantId           String
  financialYearLabel String?
  accountingPeriodId String?
  module             String?
  sourceType         String?
  sourceId           String?
  journalEntryId     String?
  journalLineId      String?
  transactionId      String?
  accountId          String?
  relatedEntityType  String?
  relatedEntityId    String?
  anomalyType        String
  severity           String    @default("MEDIUM")
  confidence         String    @default("MEDIUM_CONFIDENCE")
  /// Measured impact in base-currency minor units (signed), when known.
  financialImpactMinor BigInt?
  currency           String    @default("MWK")
  expectedCondition  String?
  actualCondition    String?
  rootCause          String?
  /// Natural identity of the anomaly instance for idempotent detection runs.
  detectionKey       String
  discoveredBy       String?
  discoveredAt       DateTime  @default(now())
  status             String    @default("DETECTED")
  assignedTo         String?
  reviewedBy         String?
  reviewedAt         DateTime?
  proposedRepairType String?
  proposedRepairData Json?
  approvalStatus     String?
  approvedBy         String?
  approvedAt         DateTime?
  repairBatchId      String?
  repairedAt         DateTime?
  verificationStatus String?
  verifiedBy         String?
  verifiedAt         DateTime?
  exceptionReason    String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  evidence AcctV2RepairEvidence[]
  actions  AcctV2RepairAction[]

  @@unique([tenantId, detectionKey])
  @@index([tenantId, status])
  @@index([tenantId, anomalyType])
  @@index([tenantId, severity])
  @@index([tenantId, accountId])
  @@index([repairBatchId])
}

/// Evidence attached to an anomaly. Append-only.
model AcctV2RepairEvidence {
  id           String   @id @default(cuid())
  anomalyId    String
  tenantId     String
  evidenceType String
  description  String
  /// Structured evidence payload (references, amounts, query output).
  payload      Json?
  /// Path/URI to an attachment or artifact, if any.
  reference    String?
  strength     String   @default("MEDIUM_CONFIDENCE")
  recordedBy   String?
  recordedAt   DateTime @default(now())

  anomaly AcctV2HistoricalAnomaly @relation(fields: [anomalyId], references: [id])

  @@index([anomalyId])
  @@index([tenantId])
}

/// Business-scoped repair batch: unit of review, approval, execution,
/// verification and sign-off.
model AcctV2RepairBatch {
  id                 String    @id @default(cuid())
  batchNumber        String
  tenantId           String
  financialYearLabel String?
  accountingPeriodId String?
  repairCategory     String
  description        String
  status             String    @default("DRAFT")
  dryRun             Boolean   @default(true)
  requestedBy        String?
  reviewedBy         String?
  approvedBy         String?
  approvedAt         DateTime?
  executedBy         String?
  verifiedBy         String?
  requestId          String?
  correlationId      String?
  startedAt          DateTime?
  completedAt        DateTime?
  recordCount        Int       @default(0)
  expectedDebitMinor  BigInt   @default(0)
  expectedCreditMinor BigInt   @default(0)
  actualDebitMinor    BigInt   @default(0)
  actualCreditMinor   BigInt   @default(0)
  backupReference    String?
  rollbackPlan       String?
  checksum           String?
  errorSummary       String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actions   AcctV2RepairAction[]
  snapshots AcctV2RepairSnapshot[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, status])
}

/// One idempotent repair action for one anomaly. The unique key is the
/// repair identity: the same repair can never run twice; a retry replays the
/// stored result; changed instructions under the same key are rejected via
/// commandHash comparison.
model AcctV2RepairAction {
  id             String    @id @default(cuid())
  tenantId       String
  batchId        String
  anomalyId      String
  repairType     String
  repairVersion  Int       @default(1)
  /// SHA-256 of the canonical repair command payload.
  commandHash    String
  status         String    @default("PENDING")
  dryRun         Boolean   @default(false)
  reason         String
  approvalReference String?
  approvedBy     String?
  executedBy     String?
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  /// For metadata repairs: exact previous field values (rollback source).
  previousValues Json?
  /// For metadata repairs: applied new values.
  newValues      Json?
  /// Journal(s) created by this action (reversal / reclass / adjustment / missing).
  journalEntryIds Json?
  resultSummary  Json?
  errorMessage   String?
  rolledBackAt   DateTime?
  rolledBackBy   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch   AcctV2RepairBatch       @relation(fields: [batchId], references: [id])
  anomaly AcctV2HistoricalAnomaly @relation(fields: [anomalyId], references: [id])

  @@unique([tenantId, anomalyId, repairType, repairVersion])
  @@index([batchId])
  @@index([tenantId, status])
}

/// Before/after accounting snapshot for a repair batch (business + window
/// scoped). Checksummed so results are reproducible and comparable.
model AcctV2RepairSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  batchId      String
  phase        String   // BEFORE | AFTER
  capturedAt   DateTime @default(now())
  journalCount Int
  lineCount    Int
  totalDebitMinor  BigInt
  totalCreditMinor BigInt
  /// Per-account canonical balances and control-account figures.
  balances     Json
  integrityFindingCount Int @default(0)
  checksum     String

  batch AcctV2RepairBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, phase])
  @@index([tenantId])
}

/// Exception register: anomalies that cannot be safely repaired yet.
model AcctV2RepairException {
  id                 String    @id @default(cuid())
  tenantId           String
  anomalyId          String    @unique
  module             String?
  accountingPeriodId String?
  amountMinor        BigInt?
  currency           String    @default("MWK")
  anomalyType        String
  evidenceGap        String
  reasonBlocked      String
  statementImpact    String?
  risk               String    @default("MEDIUM")
  requiredInformation String?
  responsibleOwner   String?
  targetReviewDate   DateTime?
  status             String    @default("OPEN")
  acceptedBy         String?
  acceptedAt         DateTime?
  disclosureRequired Boolean   @default(false)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, status])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Reporting V2 — Phase 7 Financial Reporting Engine. Additive tables only.
/// ────────────────────────────────────────────────────────────────────────────

/// One generated report run: filters, definition version, integrity outcome
/// and the review/approval workflow (§50). Generation is read-only for
/// accounting data; approval never alters journals.
model AcctV2ReportRun {
  id                    String    @id @default(cuid())
  tenantId              String
  reportType            String
  definitionId          String?
  definitionVersion     String?
  filters               Json
  filtersHash           String
  status                String    @default("GENERATED") // GENERATED | REVIEWED | APPROVED | SUPERSEDED
  integrityStatus       String    @default("UNVERIFIED")
  trialBalanceStatus    String?
  integrityWarnings     Json?
  totals                Json?
  resultChecksum        String
  accountingDataVersion String?
  generatedBy           String
  generatedAt           DateTime  @default(now())
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewComment         String?
  approvedBy            String?
  approvedAt            DateTime?
  approvalComment       String?
  supersededByRunId     String?
  supersededReason      String?
  requestId             String?
  correlationId         String?
  metadata              Json?

  snapshots AcctV2ReportSnapshotV2[]

  @@index([tenantId, reportType, generatedAt])
  @@index([tenantId, status])
  @@index([tenantId, filtersHash])
}

/// Immutable report snapshot (§51): full result payload, checksummed. Later
/// adjustments to a closed period produce a NEW snapshot version; the prior
/// version is marked superseded with a reason — never mutated or deleted.
model AcctV2ReportSnapshotV2 {
  id                     String    @id @default(cuid())
  tenantId               String
  runId                  String
  reportType             String
  definitionVersion      String?
  version                Int       @default(1)
  payload                Json
  checksum               String
  accountingDataVersion  String?
  integrityStatus        String?
  status                 String    @default("ACTIVE") // ACTIVE | SUPERSEDED
  supersededBySnapshotId String?
  supersededReason       String?
  createdBy              String
  createdAt              DateTime  @default(now())

  run AcctV2ReportRun @relation(fields: [runId], references: [id])

  @@index([tenantId, reportType, createdAt])
  @@index([tenantId, status])
}

/// Rebuildable report cache (§52). The General Ledger stays authoritative:
/// every read validates `sourceDataVersion` against the canonical journal
/// source and stale entries are rebuilt, never presented as verified.
model AcctV2ReportCache {
  id                String   @id @default(cuid())
  tenantId          String
  reportType        String
  filtersHash       String
  definitionVersion String   @default("1.0.0")
  sourceDataVersion String
  payload           Json
  builtAt           DateTime @default(now())

  @@unique([tenantId, reportType, filtersHash, definitionVersion])
  @@index([tenantId, reportType])
}

/// ────────────────────────────────────────────────────────────────────────────
/// Phase 8 — Financial Calendar and Accounting Period control (additive).
/// The legacy `AccountingPeriod` table is preserved untouched; canonical
/// periods link back to it via `legacyPeriodId` for migration.
/// ────────────────────────────────────────────────────────────────────────────

/// Business-scoped financial calendar configuration (one row per business).
model AcctV2FinancialCalendarConfig {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  name                     String   @default("Standard Financial Calendar")
  /// Financial-year start month (1–12) and day.
  fyStartMonth             Int      @default(1)
  fyStartDay               Int      @default(1)
  timezone                 String   @default("Africa/Blantyre")
  periodFrequency          String   @default("MONTHLY")
  postingDatePolicy        String   @default("POSTING_DATE_DETERMINES_PERIOD")
  backdatingPolicy         String   @default("PERMISSION_AND_REASON")
  futureDatingPolicy       String   @default("TOLERANCE")
  futureToleranceDays      Int      @default(31)
  /// Optional rolling lock: normal posting on/before this date is rejected.
  lockDate                 DateTime?
  checklistTemplateId      String   @default("STANDARD_MONTHLY_CLOSE")
  checklistTemplateVersion String   @default("1.0.0")
  snapshotOnClose          Boolean  @default(true)
  recloseDeadlineDays      Int      @default(14)
  allowAdjustmentPeriod    Boolean  @default(false)
  metadata                 Json?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Canonical financial year. Statuses: DRAFT | OPEN | CLOSING | CLOSED |
/// REOPENED | ARCHIVED.
model AcctV2FinancialYear {
  id                      String    @id @default(cuid())
  tenantId                String
  name                    String
  code                    String
  startDate               DateTime
  endDate                 DateTime
  numberOfPeriods         Int       @default(12)
  periodFrequency         String    @default("MONTHLY")
  status                  String    @default("DRAFT")
  isCurrent               Boolean   @default(false)
  previousFinancialYearId String?
  architectureVersion     String    @default("ACCOUNTING_V2")
  createdBy               String?
  approvedBy              String?
  openedAt                DateTime?
  closedBy                String?
  closedAt                DateTime?
  reopenedBy              String?
  reopenedAt              DateTime?
  closeReason             String?
  reopenReason            String?
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  periods AcctV2AccountingPeriod[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

/// Canonical accounting period. Statuses: DRAFT | OPEN | CLOSING | CLOSED |
/// REOPENED. Deletion is never exposed by V2 services.
model AcctV2AccountingPeriod {
  id                  String    @id @default(cuid())
  tenantId            String
  financialYearId     String
  periodNumber        Int
  name                String
  code                String
  startDate           DateTime
  endDate             DateTime
  status              String    @default("DRAFT")
  sequence            Int
  lockDate            DateTime?
  closeDate           DateTime?
  reopenDate          DateTime?
  recloseDate         DateTime?
  isAdjustmentPeriod  Boolean   @default(false)
  isYearEndPeriod     Boolean   @default(false)
  /// Migration alias to the legacy `AccountingPeriod` row, when mapped.
  legacyPeriodId      String?
  architectureVersion String    @default("ACCOUNTING_V2")
  createdBy           String?
  closedBy            String?
  reopenedBy          String?
  reclosedBy          String?
  closeReason         String?
  reopenReason        String?
  currentCloseRunId   String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  financialYear AcctV2FinancialYear @relation(fields: [financialYearId], references: [id])
  closeRuns     AcctV2PeriodCloseRun[]

  @@unique([financialYearId, periodNumber])
  @@unique([tenantId, code])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, status])
}

/// Immutable period/year status transition history. Append-only.
model AcctV2PeriodStatusHistory {
  id                 String   @id @default(cuid())
  tenantId           String
  financialYearId    String?
  accountingPeriodId String?
  previousStatus     String?
  newStatus          String
  action             String
  reason             String?
  requestedBy        String?
  approvedBy         String?
  executedBy         String?
  requestId          String?
  correlationId      String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([tenantId, accountingPeriodId])
  @@index([tenantId, financialYearId])
}

/// Period close run: one versioned close attempt per period. Statuses:
/// DRAFT | IN_PROGRESS | BLOCKED | READY_FOR_REVIEW | APPROVED | COMPLETED |
/// CANCELLED | SUPERSEDED. Re-closing creates a new run; runs are never
/// overwritten.
model AcctV2PeriodCloseRun {
  id                       String    @id @default(cuid())
  tenantId                 String
  financialYearId          String
  accountingPeriodId       String
  closeNumber              Int       @default(1)
  status                   String    @default("IN_PROGRESS")
  checklistTemplateId      String
  checklistTemplateVersion String
  initiatedBy              String
  reviewedBy               String?
  approvedBy               String?
  closedBy                 String?
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  expectedTaskCount        Int       @default(0)
  completedTaskCount       Int       @default(0)
  blockedTaskCount         Int       @default(0)
  warningTaskCount         Int       @default(0)
  trialBalanceStatus       String?
  reportStatus             String?
  integrityStatus          String?
  snapshotReferences       Json?
  reason                   String?
  requestId                String?
  correlationId            String?
  metadata                 Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  period AcctV2AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  tasks  AcctV2PeriodCloseTask[]

  @@unique([accountingPeriodId, closeNumber])
  @@index([tenantId, status])
  @@index([tenantId, accountingPeriodId])
}

/// Materialized checklist task for a close run. Statuses: NOT_STARTED |
/// IN_PROGRESS | PASSED | PASSED_WITH_WARNING | FAILED | BLOCKED | WAIVED |
/// NOT_APPLICABLE.
model AcctV2PeriodCloseTask {
  id           String    @id @default(cuid())
  tenantId     String
  closeRunId   String
  taskKey      String
  name         String
  module       String
  kind         String // AUTOMATIC | MANUAL
  blocking     Boolean   @default(false)
  required     Boolean   @default(true)
  status       String    @default("NOT_STARTED")
  displayOrder Int       @default(0)
  /// Automated check result: { rule, expected, actual, difference, severity, evidence }.
  result       Json?
  evidence     Json?
  comment      String?
  completedBy  String?
  completedAt  DateTime?
  waivedBy     String?
  waiveReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  closeRun AcctV2PeriodCloseRun @relation(fields: [closeRunId], references: [id])

  @@unique([closeRunId, taskKey])
  @@index([tenantId, closeRunId])
}

/// Period close exception. Statuses: OPEN | UNDER_REVIEW |
/// ACCEPTED_TEMPORARILY | ACCEPTED_FOR_CLOSE | RESOLVED | REJECTED.
model AcctV2PeriodCloseException {
  id                 String    @id @default(cuid())
  tenantId           String
  financialYearId    String?
  accountingPeriodId String
  closeRunId         String?
  taskKey            String?
  category           String
  severity           String    @default("MEDIUM")
  amountMinor        BigInt?
  currency           String    @default("MWK")
  description        String
  rootCause          String?
  evidence           Json?
  status             String    @default("OPEN")
  acceptedBy         String?
  acceptedAt         DateTime?
  resolutionTarget   String?
  resolvedBy         String?
  resolvedAt         DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, accountingPeriodId, status])
}

/// Controlled reopening request for a CLOSED period. Statuses: PENDING |
/// APPROVED | REJECTED | EXECUTED | CANCELLED.
model AcctV2PeriodReopenRequest {
  id                  String    @id @default(cuid())
  tenantId            String
  financialYearId     String
  accountingPeriodId  String
  reason              String
  expectedCorrections String?
  status              String    @default("PENDING")
  impactAnalysis      Json?
  correctionScope     Json?
  recloseDeadline     DateTime?
  requestedBy         String
  requestedAt         DateTime  @default(now())
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectionReason     String?
  executedAt          DateTime?
  requestId           String?
  correlationId       String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, accountingPeriodId, status])
}

/// ────────────────────────────────────────────────────────────────────────────
/// CoA V2 — Chart of Accounts governance (Phase 3). Additive tables only.
/// ────────────────────────────────────────────────────────────────────────────

/// Business-scoped account mapping registry: one active mapping per
/// (business, purpose, module, transactionType, currency, branch) context.
/// Context sentinels: "*" = any. History of changes lives in AuditLog.
model CoaV2AccountMapping {
  id                  String    @id @default(cuid())
  tenantId            String
  purpose             String
  accountId           String
  moduleKey           String    @default("*")
  transactionType     String    @default("*")
  currency            String    @default("*")
  branchKey           String    @default("*")
  status              String    @default("ACTIVE")
  priority            Int       @default(0)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  architectureVersion String    @default("TRANSITION_V2")
  createdBy           String?
  updatedBy           String?
  approvedBy          String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, purpose, moduleKey, transactionType, currency, branchKey])
  @@index([tenantId, purpose, status])
  @@index([accountId])
}

/// Legacy code/name alias pointing to a canonical account. Controls FUTURE
/// resolution and presentation only — never rewrites posted history.
model CoaV2AccountAlias {
  id                 String    @id @default(cuid())
  tenantId           String
  aliasCode          String
  aliasName          String?
  legacyAccountId    String?
  canonicalAccountId String
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  reason             String?
  createdBy          String?
  createdAt          DateTime  @default(now())

  legacyAccount    Account? @relation("AliasLegacyAccount", fields: [legacyAccountId], references: [id], onDelete: SetNull)
  canonicalAccount Account  @relation("AliasCanonicalAccount", fields: [canonicalAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, aliasCode])
  @@index([tenantId, canonicalAccountId])
  @@index([legacyAccountId])
}

/// Versioned Chart of Accounts template header. Immutable after publication —
/// updates require a new version row.
model CoaV2Template {
  id             String    @id @default(cuid())
  templateKey    String
  name           String
  version        Int       @default(1)
  businessType   String
  country        String?
  description    String?
  status         String    @default("DRAFT")
  baseCodeRanges Json?
  effectiveFrom  DateTime?
  publishedAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts CoaV2TemplateAccount[]

  @@unique([templateKey, version])
  @@index([businessType, status])
}

/// One account definition inside a template version.
model CoaV2TemplateAccount {
  id                        String  @id @default(cuid())
  templateId                String
  code                      String
  name                      String
  description               String?
  parentCode                String?
  category                  String
  subType                   String?
  behaviour                 String
  normalBalance             String
  systemPurpose             String?
  controlAccountPurpose     String?
  financialStatementSection String?
  cashFlowClassification    String?
  currencyPolicy            String  @default("BASE_CURRENCY_ONLY")
  required                  Boolean @default(false)
  displayOrder              Int     @default(0)

  template CoaV2Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId])
}

/// Controlled account consolidation plan (Phase 3 §19). Execution marks the
/// duplicate deprecated + aliased; historical journal lines are NEVER rewritten
/// here — historical reclassification is recorded as a Phase 6 recommendation.
model CoaV2ConsolidationPlan {
  id                   String    @id @default(cuid())
  tenantId             String
  duplicateAccountId   String
  canonicalAccountId   String
  status               String    @default("DRAFT")
  duplicateClass       String?
  analysis             Json?
  reason               String?
  phase6RepairRequired Boolean   @default(false)
  createdBy            String?
  approvedBy           String?
  approvedAt           DateTime?
  executedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  duplicateAccount Account @relation("ConsolidationDuplicateAccount", fields: [duplicateAccountId], references: [id], onDelete: Restrict)
  canonicalAccount Account @relation("ConsolidationCanonicalAccount", fields: [canonicalAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([duplicateAccountId])
}

// ============================================================================
// Phase 10 — Bank Reconciliation (additive). Identity = PaymentAccount + CoA.
// tenantId is a plain string (AcctV2 convention — no Tenant FK / cascade).
// Statement rows are external evidence only; matches never mutate JE lines.
// ============================================================================

/// Per-PaymentAccount recon settings (tolerances, profile, approvals).
model BankRecConfiguration {
  id                      String   @id @default(cuid())
  tenantId                String
  paymentAccountId        String   @unique
  coaAccountId            String
  enabled                 Boolean  @default(true)
  currency                String   @default("MWK")
  dateToleranceDays       Int      @default(3)
  amountToleranceMinor    Int      @default(0)
  autoMatchMinConfidence  String   @default("HIGH") // EXACT | HIGH | MEDIUM
  requireSeparateApprover Boolean  @default(true)
  staleOutstandingDays    Int      @default(30)
  defaultProfileId        String?
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String?
  updatedBy               String?

  @@index([tenantId])
  @@index([coaAccountId])
}

/// Named import mapping profile (column map / OFX hints).
model BankRecStatementProfile {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  format      String // CSV | XLSX | OFX | QFX
  status      String   @default("ACTIVE")
  version     Int      @default(1)
  columnMap   Json // { date, description, reference, debit, credit, amount, balance, ... }
  options     Json? // delimiter, dateFormat, signedAmountMode, skipRows, sheetName
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

/// One uploaded statement file attempt.
model BankRecImportBatch {
  id                 String    @id @default(cuid())
  tenantId           String
  paymentAccountId   String
  reconciliationId   String?
  profileId          String?
  fileName           String
  fileHash           String
  mimeType           String?
  byteSize           Int?
  status             String    @default("PENDING") // PENDING|PREVIEWED|CONFIRMED|FAILED|REJECTED
  rowCount           Int       @default(0)
  duplicateRowCount  Int       @default(0)
  statementOpening   Decimal?  @db.Decimal(18, 2)
  statementClosing   Decimal?  @db.Decimal(18, 2)
  periodStart        DateTime? @db.Date
  periodEnd          DateTime? @db.Date
  balanceValid       Boolean?
  errorSummary       String?
  parseWarnings      Json?
  createdAt          DateTime  @default(now())
  confirmedAt        DateTime?
  createdBy          String?
  confirmedBy        String?

  transactions BankRecStatementTransaction[]

  @@unique([tenantId, paymentAccountId, fileHash])
  @@index([tenantId, paymentAccountId, status])
  @@index([reconciliationId])
}

/// External bank statement evidence row (immutable after confirm).
model BankRecStatementTransaction {
  id                   String    @id @default(cuid())
  tenantId             String
  importBatchId        String
  paymentAccountId     String
  reconciliationId     String?
  lineNumber           Int
  transactionDate      DateTime  @db.Date
  valueDate            DateTime? @db.Date
  description          String
  reference            String?
  referenceNormalized  String?
  payee                String?
  signedAmountMinor    Int // bank perspective: +in / -out
  signedAmount         Decimal   @db.Decimal(18, 2)
  runningBalance       Decimal?  @db.Decimal(18, 2)
  currency             String    @default("MWK")
  rowFingerprint       String
  matchingStatus       String    @default("UNMATCHED") // UNMATCHED|SUGGESTED|MATCHED|PARTIAL|EXCLUDED|CLASSIFIED
  classification       String? // BANK_CHARGE|INTEREST|TRANSFER|UNKNOWN|...
  remainingAmountMinor Int
  rawPayload           Json?
  createdAt            DateTime  @default(now())

  importBatch BankRecImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  matchLinks  BankRecMatchLink[]

  @@unique([importBatchId, lineNumber])
  @@unique([tenantId, paymentAccountId, rowFingerprint])
  @@index([tenantId, paymentAccountId, matchingStatus])
  @@index([tenantId, transactionDate])
  @@index([referenceNormalized])
  @@index([signedAmountMinor])
  @@index([reconciliationId])
}

/// Reconciliation session for a payment account + statement period.
model BankRecReconciliation {
  id                      String    @id @default(cuid())
  tenantId                String
  paymentAccountId        String
  coaAccountId            String
  version                 Int       @default(1)
  status                  String    @default("DRAFT") // DRAFT|IN_PROGRESS|IN_REVIEW|APPROVED|COMPLETED|REOPENED|REVERSED
  statementDate           DateTime  @db.Date
  periodStart             DateTime? @db.Date
  periodEnd               DateTime? @db.Date
  statementOpeningBalance Decimal?  @db.Decimal(18, 2)
  statementClosingBalance Decimal   @db.Decimal(18, 2)
  bookBalance             Decimal?  @db.Decimal(18, 2)
  clearedBookBalance      Decimal?  @db.Decimal(18, 2)
  outstandingPayments     Decimal?  @db.Decimal(18, 2)
  depositsInTransit       Decimal?  @db.Decimal(18, 2)
  adjustmentsTotal        Decimal?  @db.Decimal(18, 2)
  differenceMinor         Int       @default(0)
  currency                String    @default("MWK")
  preparedBy              String?
  reviewedBy              String?
  approvedBy              String?
  completedBy             String?
  preparedAt              DateTime?
  reviewedAt              DateTime?
  approvedAt              DateTime?
  completedAt             DateTime?
  reopenedFromId          String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  statusHistory   BankRecStatusHistory[]
  matches         BankRecMatch[]
  outstandingItems BankRecOutstandingItem[]
  exceptions      BankRecException[]
  approvals       BankRecApproval[]
  snapshots       BankRecSnapshot[]
  adjustments     BankRecAdjustmentLink[]

  @@unique([tenantId, paymentAccountId, statementDate, version])
  @@index([tenantId, paymentAccountId, status])
  @@index([tenantId, status, statementDate])
}

model BankRecStatusHistory {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  fromStatus       String?
  toStatus         String
  reason           String?
  actorUserId      String?
  createdAt        DateTime @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, createdAt])
}

/// Match group header (supports 1:1, 1:N, N:1, N:N, partial).
model BankRecMatch {
  id                 String   @id @default(cuid())
  tenantId           String
  reconciliationId   String
  matchType          String // ONE_TO_ONE|ONE_TO_MANY|MANY_TO_ONE|MANY_TO_MANY|PARTIAL
  confidence         String // EXACT|HIGH|MEDIUM|LOW|CONFLICTED|MANUAL
  status             String   @default("SUGGESTED") // SUGGESTED|ACCEPTED|REJECTED|REVERSED
  statementTotalMinor Int     @default(0)
  bookTotalMinor     Int      @default(0)
  differenceMinor    Int      @default(0)
  ruleKey            String?
  notes              String?
  createdBy          String?
  acceptedBy         String?
  createdAt          DateTime @default(now())
  acceptedAt         DateTime?

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  links          BankRecMatchLink[]

  @@index([tenantId, reconciliationId, status])
  @@index([confidence])
}

/// Side of a match: statement row and/or journal entry line.
model BankRecMatchLink {
  id                    String  @id @default(cuid())
  tenantId              String
  matchId               String
  side                  String // STATEMENT | BOOK
  statementTransactionId String?
  journalEntryLineId    String?
  journalEntryId        String?
  allocatedAmountMinor  Int
  createdAt             DateTime @default(now())

  match                 BankRecMatch                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  statementTransaction  BankRecStatementTransaction?  @relation(fields: [statementTransactionId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([statementTransactionId])
  @@index([journalEntryLineId])
  @@index([tenantId, journalEntryLineId])
}

model BankRecMatchingRule {
  id          String   @id @default(cuid())
  tenantId    String   @default("*")
  ruleKey     String
  name        String
  version     Int      @default(1)
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  matchType   String   @default("ONE_TO_ONE")
  confidence  String   @default("HIGH")
  criteria    Json // { amountExact, dateToleranceDays, referenceRequired, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, ruleKey, version])
  @@index([enabled, priority])
}

model BankRecOutstandingItem {
  id               String    @id @default(cuid())
  tenantId         String
  reconciliationId String
  itemType         String // OUTSTANDING_PAYMENT | DEPOSIT_IN_TRANSIT | OTHER
  description      String
  amountMinor      Int
  amount           Decimal   @db.Decimal(18, 2)
  itemDate         DateTime? @db.Date
  journalEntryLineId String?
  statementTransactionId String?
  agingDays        Int       @default(0)
  stale            Boolean   @default(false)
  createdAt        DateTime  @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, itemType])
}

model BankRecException {
  id               String    @id @default(cuid())
  tenantId         String
  reconciliationId String
  code             String
  severity         String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  status           String    @default("OPEN") // OPEN|RESOLVED|WAIVED
  message          String
  evidence         Json?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  reconciliation BankRecReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, status])
}

model BankRecApproval {
  id               String   @id @default(cuid())
  tenantId         String
  reconciliationId String
  action           String // PREPARE|REVIEW|APPROVE|COMPLETE|REOPEN|REVERSE
  actorUserId      String
  comment          String?
