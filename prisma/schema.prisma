generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                           String                        @id @default(cuid())
  name                         String
  subdomain                    String                        @unique
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  status                       String                        @default("active")
  subscriptionPlan             String
  logoUrl                      String?
  primaryColor                 String?
  faviconUrl                   String?
  secondaryColor               String?
  defaultBranchId              String?
  defaultBranch                Branch?                       @relation("TenantDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  ownerUserId                  String? // Main tenant user: always has access to all branches
  owner                        User?                         @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  accounts                     Account[]
  AccountBalance               AccountBalance[]
  accountSubscriptions         AccountSubscription[]
  adminAccess                  AdminTenantAccess[]
  affiliateReferrals           AffiliateReferral[]
  assets                       Asset[]
  assetCategories              AssetCategory[]
  assetTransfersOut            AssetInterBusinessTransfer[]  @relation("AssetTransferFromTenant")
  assetTransfersIn             AssetInterBusinessTransfer[]  @relation("AssetTransferToTenant")
  attendanceRecords            AttendanceRecord[]
  attendanceRegisters          AttendanceRegister[]
  bankAccounts                 BankAccount[]
  branches                     Branch[]
  branchSubscriptions          BranchSubscription[]
  legacyBudgets                LegacyBudget[]
  planningBudgets              Budget[]                      @relation("PlanningBudgetTenant")
  planningForecasts            Forecast[]                    @relation("PlanningForecastTenant")
  forecastAssumptionSets       ForecastAssumptionSet[]
  bfExpenseBudgetHeaders       BfExpenseBudgetHeader[]
  bfRevenueForecastHeaders     BfRevenueForecastHeader[]
  clients                      Client[]
  benefits                     Benefit[]
  deductions                   Deduction[]
  departments                  Department[]
  emailLogs                    EmailLog[]
  employees                    Employee[]
  employmentContracts          EmploymentContract[]
  equityAccounts               EquityAccount[]
  exchangeRates                ExchangeRate[]
  expenses                     Expense[]
  goodsReceipts                GoodsReceipt[]
  gratuityAccounts             GratuityAccount[]
  inventoryBatches             InventoryBatch[]
  inventoryBatchConsumptions   InventoryBatchConsumption[]
  inventoryCategories          InventoryCategory[]
  inventoryLocations           InventoryLocation[]
  inventoryTransactions        InventoryTransaction[]
  invoices                     Invoice[]
  invoiceRefunds               InvoiceRefund[]
  creditNotes                  CreditNote[]
  debitNotes                   DebitNote[]
  invoiceTemplates             InvoiceTemplate[]
  invoiceAttachments           InvoiceAttachment[]
  journalEntries               JournalEntry[]
  leaveBalances                LeaveBalance[]
  leavePolicies                LeavePolicy[]
  leaveRequests                LeaveRequest[]
  liabilities                  Liability[]
  liabilityCategories          LiabilityCategory[]
  expenseCategories            ExpenseCategory[]
  payments                     Payment[]
  paymentGateways              PaymentGateway[]
  paymentAccounts              PaymentAccount[]
  payrolls                     Payroll[]
  payrollRuns                  PayrollRun[]
  payrollPaymentBatches        PayrollPaymentBatch[]
  payrollComponentDefinitions  PayrollComponentDefinition[]
  payrollFormulaTemplates      PayrollFormulaTemplate[]
  pensionRules                 PensionRule[]
  pensionContributions         PensionContribution[]
  pensionRemittances           PensionRemittance[]
  leaveAccrualLedgers          LeaveAccrualLedger[]
  overtimeRequests             OvertimeRequest[]
  disciplinaryCases            DisciplinaryCase[]
  payrollTaxConfigurations     PayrollTaxConfiguration[]
  performanceFeedback          PerformanceFeedback[]
  performanceGoals             PerformanceGoal[]
  performanceReviews           PerformanceReview[]
  productBarcodes              ProductBarcode[]
  products                     Product[]
  purchaseOrders               PurchaseOrder[]
  documentSequences            DocumentSequence[]
  quotations                   Quotation[]
  recurringExpenses            RecurringExpense[]
  roles                        Role[]
  salaryAdvances               SalaryAdvance[]
  sales                        Sale[]                        @relation("TenantSales")
  suppliers                    Supplier[]
  supplierBills                SupplierBill[]
  supplierPayments             SupplierPayment[]
  supplierPaymentAllocations   SupplierPaymentAllocation[]
  taxTypes                     TaxType[]
  taxAccountMappings           TaxAccountMapping[]
  taxTransactions              TaxTransaction[]
  taxPeriods                   TaxPeriod[]
  taxReturns                   TaxReturn[]
  taxPayments                  TaxPayment[]
  taxRefunds                   TaxRefund[]
  taxCredits                   TaxCredit[]
  taxWithholdingRemittances    TaxWithholdingRemittance[]
  settings                     TenantSettings?

  transactions                 Transaction[]
  users                        User[]
  members                      User[]                        @relation("UserTenants")
  memberships                  TenantMembership[]
  accountingPeriods            AccountingPeriod[]
  stockTransfers               StockTransfer[]
  stockTransferReceiptNotices  StockTransferReceiptNotice[]
  inventoryExpiryAudits        InventoryExpiryAudit[]
  stockImportBatches           StockImportBatch[]
  posCashDays                  PosCashDay[]
  tpin                         String?
  eisEnabled                   Boolean                       @default(false)
  eisInvoices                  EISInvoice[]
  eisConfiguration             EISConfiguration?
  eisUsage                     EISUsage[]
  rentalAssets                 RentalAsset[]
  rentalTransactions           RentalTransaction[]
  rentalUnits                  RentalUnit[]
  rentalRatePlans              RentalRatePlan[]
  rentalQuotations             RentalQuotation[]
  rentalReservations           RentalReservation[]
  rentalContracts              RentalContract[]
  rentalDeposits               RentalDeposit[]
  hireRequests                 HireRequest[]
  hireAgreements               HireAgreement[]
  hireSupplierDeposits         HireSupplierDeposit[]
  /// When true, CoA-affecting mutations and postings should be blocked (migration / maintenance).
  coaLocked                    Boolean                       @default(false)
  /// Guide Phase 3: equity auto-merge requires explicit approval per tenant.
  coaEquityMigrationApproved   Boolean                       @default(false)
  coaMigrationLogs             CoaMigrationLog[]
  accountingMappingCorrections AccountingMappingCorrection[]
  transactionReversals         TransactionReversal[]
}


model Branch {
  id                    String                 @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForTenant      Tenant[]               @relation("TenantDefaultBranch")
  branchSubscriptions   BranchSubscription[]
  expenses              Expense[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  payments              Payment[]
  products              Product[]
  sales                 Sale[]
  transactions          Transaction[]
  legacyBudgetItems     LegacyBudgetItem[]
  defaultUsers          User[]                 @relation("UserDefaultBranch")
  userBranches          UserBranch[]
  stockTransfersFrom    StockTransfer[]        @relation("StockTransferFrom")
  stockTransfersTo      StockTransfer[]        @relation("StockTransferTo")
  rentalAssets          RentalAsset[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

/// Per-tenant monotonic counters for PO, goods receipt, invoice, and quotation numeric suffixes.
model DocumentSequence {
  id           String   @id @default(cuid())
  tenantId     String
  documentType String
  lastIssued   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
  @@index([tenantId])
}

model TenantSettings {
  id                               String    @id @default(cuid())
  tenantId                         String    @unique
  taxEnabled                       Boolean   @default(true)
  defaultTaxRate                   Float     @default(17.5)
  currencyCode                     String    @default("MWK")
  /// UI default language for the tenant: en | ny (users may override).
  defaultLanguage                  String    @default("en")
  invoicePrefix                    String    @default("INV")
  invoiceTemplate                  String    @default("default")
  enabledModules                   String[]
  customDomain                     String?
  dailyReports                     Boolean   @default(false)
  emailFooter                      String?
  emailNotifications               Boolean   @default(true)
  inAppNotifications               Boolean   @default(true)
  invoiceReminders                 Boolean   @default(true)
  lowStockAlerts                   Boolean   @default(true)
  monthlyReports                   Boolean   @default(true)
  paymentReceipts                  Boolean   @default(true)
  smsNotifications                 Boolean   @default(false)
  weeklyReports                    Boolean   @default(true)
  buildingName                     String?
  businessAddress                  String?
  businessCity                     String?
  businessEmail                    String?
  businessPhone                    String?
  receiptFooter                    String?
  defaultBankDetails               String? // Default bank account details for invoice/quotation/receipt footers
  // NPS rates are tenant-configurable; null means "not configured".
  // Calculation code should treat null as 0% unless explicitly set.
  npsEmployeeRatePercent           Float?
  npsEmployerRatePercent           Float?
  balanceReminderSubject           String?
  balanceReminderBody              String?
  taxInflowAccountId               String? // Default account for tax collected (inflow from sales/invoices)
  taxOutflowAccountId              String? // Default account for tax paid (outflow from expenses/supplier bills)
  eisApiKey                        String? // Encrypted MRA EIS API key
  eisClientSecret                  String? // Encrypted MRA EIS client secret
  /// Cumulative owner contributions (not reduced by transfers to payment accounts). New rows default 0; migration seeds existing tenants.
  ownerContributedCapital          Float     @default(0)
  /// Null = owner must complete capital onboarding. Migration sets NOW() for all pre-existing TenantSettings rows.
  capitalSetupCompletedAt          DateTime?
  /// Null = owner must confirm payment accounts. Migration sets NOW() for all pre-existing TenantSettings rows.
  paymentAccountsSetupCompletedAt  DateTime?
  /// 1–12: first month of fiscal year (1 = calendar year). Used for Yearly accounting periods.
  fiscalYearStartMonth             Int       @default(1)
  /// Optional display / reminder; authoritative opening date is on posted Opening transactions.
  openingBalancesAsOfDate          DateTime?
  /// When set and in the future, dashboard setup reminder is hidden.
  setupReminderSnoozedUntil        DateTime?
  /// { completed: Record<stepId, iso>, skipped: Record<stepId, iso> } — see lib/setupWizardService.js
  setupWizardState                 Json?
  /// Payroll GL account mapping — see lib/payrollEngine/accountMappings.js
  payrollAccountMappings           Json?
  /// When true, outbound rental bookings create+post a Customer Invoice immediately.
  /// Prefer false once Contract/billing engine owns recognition. Existing tenants migrated to true.
  rentalPostInvoiceOnBook          Boolean   @default(true)
  /// When true, past-end bookings are auto-completed and availability released (unsafe vs inspection).
  /// Default false — mark overdue only; require explicit complete/return.
  rentalAutoCompleteExpired        Boolean   @default(false)
  /// When false, POST /api/rentals booking create is refused (use Contracts V2).
  rentalLegacyBookingEnabled       Boolean   @default(true)
  /// Days before expiry for "early" alerts; null = use default 30.
  expiryWarnDaysEarly              Int?
  /// Days before expiry for "urgent" alerts; null = use default 7.
  expiryWarnDaysUrgent             Int?
  /// Optional GL for inventory write-off loss; null = auto-resolve "Inventory Adjustment Loss".
  inventoryAdjustmentLossAccountId String?
  /// When true, document reversals require a separate approver before execute (Wave 6 SoD).
  reversalRequireSeparateApprover  Boolean   @default(true)
  tenant                           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}


model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Role {
  id          String             @id @default(cuid())
  name        String
  description String
  permissions Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  users       User[]
  memberships TenantMembership[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model User {
  id                              String                       @id @default(cuid())
  /// Unique per tenant; same address may exist for users in different businesses (SaaS).
  email                           String
  name                            String?
  password                        String                       @db.VarChar(255)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  tenantId                        String?
  lastLogin                       DateTime?
  isActive                        Boolean                      @default(true)
  mfaEnabled                      Boolean                      @default(false)
  isEmailVerified                 Boolean                      @default(false)
  otpCode                         String?
  otpExpiry                       DateTime?
  department                      String?
  phone                           String?
  roleId                          String
  status                          String                       @default("active")
  authProvider                    String?
  authProviderId                  String?
  profilePicture                  String?
  resetToken                      String?
  resetTokenExpiry                DateTime?
  defaultBranchId                 String?
  /// Preferred UI language: en | ny. Null = resolve via tenant/cookie/browser.
  preferredLanguage               String?
  adminActivityLogs               AdminActivityLog[]           @relation("AdminActivityLog")
  affiliateReferrals              AffiliateReferral[]
  createdAssets                   Asset[]                      @relation("AssetCreatedBy")
  assetInterBusinessTransfers     AssetInterBusinessTransfer[] @relation("AssetInterBusinessTransferBy")
  attendanceRegistersFinalized    AttendanceRegister[]
  auditLogs                       AuditLog[]
  approvedLegacyBudgets           LegacyBudget[]               @relation("LegacyBudgetApprover")
  createdPlanningBudgets          Budget[]                     @relation("PlanningBudgetCreatedBy")
  approvedPlanningBudgets         Budget[]                     @relation("PlanningBudgetApprovedBy")
  lockedPlanningBudgets           Budget[]                     @relation("PlanningBudgetLockedBy")
  createdPlanningForecasts        Forecast[]                   @relation("PlanningForecastCreatedBy")
  approvedPlanningForecasts       Forecast[]                   @relation("PlanningForecastApprovedBy")
  budgetApprovalsRequested        BudgetApproval[]             @relation("BudgetApprovalRequester")
  budgetApprovalsDecided          BudgetApproval[]             @relation("BudgetApprovalApprover")
  budgetVersionsCreated           BudgetVersion[]              @relation("BudgetVersionCreatedBy")
  budgetVersionsApproved          BudgetVersion[]              @relation("BudgetVersionApprovedBy")
  forecastAssumptionSetsCreated   ForecastAssumptionSet[]      @relation("ForecastAssumptionSetCreatedBy")
  sentEmails                      EmailLog[]                   @relation("EmailLogSender")
  deletedExpenses                 Expense[]                    @relation("ExpenseDeletedBy")
  expenseSubmissions              Expense[]
  uploadedAttachments             ExpenseAttachment[]          @relation("UploadedAttachments")
  invoiceAttachments              InvoiceAttachment[]          @relation("InvoiceAttachmentUploader")
  goodsReceiptsReceived           GoodsReceipt[]               @relation("GoodsReceiptReceiver")
  inventoryTransactions           InventoryTransaction[]
  createdInvoices                 Invoice[]                    @relation("InvoiceCreator")
  deletedInvoices                 Invoice[]                    @relation("InvoiceDeletedBy")
  refundedInvoices                Invoice[]                    @relation("InvoiceRefundedBy")
  voidedInvoices                  Invoice[]                    @relation("InvoiceVoidedBy")
  processedRefunds                InvoiceRefund[]              @relation("InvoiceRefundedBy")
  createdJournalEntries           JournalEntry[]               @relation("JournalEntryCreatedBy")
  postedJournalEntries            JournalEntry[]               @relation("JournalEntryPostedBy")
  leaveRequestsReviewed           LeaveRequest[]
  createdLiabilities              Liability[]                  @relation("LiabilityCreatedBy")
  performanceReviewsAcknowledged  PerformanceReview[]          @relation("ReviewAcknowledgedBy")
  performanceReviewsConducted     PerformanceReview[]
  deletedProducts                 Product[]                    @relation("ProductDeletions")
  purchaseOrdersApproved          PurchaseOrder[]              @relation("PurchaseOrderApprover")
  purchaseOrdersCreated           PurchaseOrder[]              @relation("PurchaseOrderCreator")
  createdQuotations               Quotation[]                  @relation("QuotationCreator")
  recurringExpenses               RecurringExpense[]
  createdSales                    Sale[]                       @relation("SaleCreations")
  refundedSales                   Sale[]                       @relation("SaleRefunds")
  voidedSales                     Sale[]                       @relation("SaleVoids")
  supplierBillsApproved           SupplierBill[]               @relation("SupplierBillApprover")
  supplierBillsCreated            SupplierBill[]               @relation("SupplierBillCreator")
  supplierBillsFinalized          SupplierBill[]               @relation("SupplierBillFinalizedBy")
  supplierPaymentsCreated         SupplierPayment[]
  createdTransactions             Transaction[]                @relation("TransactionCreatedBy")
  postedTransactions              Transaction[]                @relation("TransactionPostedBy")
  creditNotesCreated              CreditNote[]                 @relation("CreditNoteCreatedBy")
  creditNotesPosted               CreditNote[]                 @relation("CreditNotePostedBy")
  debitNotesCreated               DebitNote[]                  @relation("DebitNoteCreatedBy")
  debitNotesPosted                DebitNote[]                  @relation("DebitNotePostedBy")
  closedAccountingPeriods         AccountingPeriod[]           @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods       AccountingPeriod[]           @relation("AccountingPeriodReopenedBy")
  stockTransfersCreated           StockTransfer[]              @relation("StockTransferCreatedBy")
  stockTransfersApproved          StockTransfer[]              @relation("StockTransferApprovedBy")
  stockTransfersReceived          StockTransfer[]              @relation("StockTransferReceivedBy")
  stockTransfersRejected          StockTransfer[]              @relation("StockTransferRejectedBy")
  inventoryExpiryAudits           InventoryExpiryAudit[]
  stockImportBatchesCreated       StockImportBatch[]           @relation("StockImportBatchCreatedBy")
  defaultBranch                   Branch?                      @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  userBranches                    UserBranch[]
  role                            Role                         @relation(fields: [roleId], references: [id])
  tenant                          Tenant?                      @relation(fields: [tenantId], references: [id])
  tenants                         Tenant[]                     @relation("UserTenants")
  ownedTenants                    Tenant[]                     @relation("TenantOwner")
  memberships                     TenantMembership[]
  posCashDaysOpened               PosCashDay[]                 @relation("PosCashDayOpenedBy")
  posCashDaysClosed               PosCashDay[]                 @relation("PosCashDayClosedBy")
  posCashDayDepositsCreated       PosCashDayDeposit[]          @relation("PosCashDayDepositCreatedBy")
  rentalTransactionsCreated       RentalTransaction[]          @relation("RentalTransactionCreatedBy")
  createdBfExpenseBudgetHeaders   BfExpenseBudgetHeader[]      @relation("BfExpenseBudgetHeaderCreatedBy")
  createdBfRevenueForecastHeaders BfRevenueForecastHeader[]    @relation("BfRevenueForecastHeaderCreatedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([authProvider, authProviderId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  periodType   String // Monthly | Yearly
  startDate    DateTime
  endDate      DateTime
  status       String    @default("open") // open | closed
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closedBy   User?  @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy User?  @relation("AccountingPeriodReopenedBy", fields: [reopenedById], references: [id])

  @@unique([tenantId, periodType, startDate])
  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([status])
}

// Legacy table backing the ReversalSummary view (kept to avoid accidental drops)
model ReversalAudit {
  id String @id

  @@map("ReversalAudit")
  @@ignore
}

/// Canonical reversal register (Wave 2). Operational docs keep isReversal flags; GL stays on V2 journals.
model TransactionReversal {
  id                     String    @id @default(cuid())
  tenantId               String
  sourceType             String
  sourceId               String
  status                 String    @default("REQUESTED")
  reason                 String
  requestedById          String?
  approvedById           String?
  executedById           String?
  requestedAt            DateTime  @default(now())
  approvedAt             DateTime?
  executedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  periodPolicy           String    @default("REVERSE_IN_CURRENT_OPEN_PERIOD")
  crossPeriodDisclosure  Boolean   @default(false)
  originalDocumentDate   DateTime?
  postingDate            DateTime?
  reversalDocumentId     String?
  originalJournalEntryId String?
  reversalJournalEntryId String?
  idempotencyKey         String?
  impactSnapshot         Json?
  errorCode              String?
  errorMessage           String?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("transaction_reversal")
}


model Admin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  password       String              @db.VarChar(255)
  role           String              @default("Super Admin")
  permissions    Json                @default("{}")
  isActive       Boolean             @default(true)
  lastLogin      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  profilePicture String?
  phone          String?
  department     String?
  notes          String?
  adminAuditLogs AdminAuditLog[]
  managedTenants AdminTenantAccess[]
  emailLogs      EmailLog[]          @relation("EmailLogAdminSender")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  userAgent  String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

model AdminTenantAccess {
  id          String    @id @default(cuid())
  adminId     String
  tenantId    String
  accessLevel String    @default("full")
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminId, tenantId])
  @@index([adminId])
  @@index([tenantId])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  tenantId   String?
  user       User     @relation(fields: [userId], references: [id])
}

model Client {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  additionalEmails   String[]            @default([]) // Multiple email addresses for sending invoices
  phone              String?
  address            String?
  contactPerson      String?
  /// Persisted Active/Inactive — set from UI; not derived from invoice activity.
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  invoices           Invoice[]
  quotations         Quotation[]
  sales              Sale[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  rentalTransactions RentalTransaction[]

  @@index([tenantId, isActive])
}

model Invoice {
  id                        String              @id @default(cuid())
  invoiceNumber             String
  title                     String?
  orderNumber               String?
  clientId                  String
  createdById               String
  issueDate                 DateTime
  dueDate                   DateTime
  subtotal                  Decimal             @db.Decimal(18, 2)
  taxAmount                 Decimal             @db.Decimal(18, 2)
  total                     Decimal             @db.Decimal(18, 2)
  status                    String              @default("draft")
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  tenantId                  String
  discount                  Decimal             @default(0) @db.Decimal(18, 2)
  lastPaymentDate           DateTime?
  originalTotal             Decimal             @default(0) @db.Decimal(18, 2)
  refundAmount              Decimal             @default(0) @db.Decimal(18, 2)
  refundReason              String?
  refundedAt                DateTime?
  refundedById              String?
  remainingBalance          Decimal             @default(0) @db.Decimal(18, 2)
  totalDiscountAmount       Decimal             @default(0) @db.Decimal(18, 2)
  totalPaid                 Decimal             @default(0) @db.Decimal(18, 2)
  voidReason                String?
  voidedAt                  DateTime?
  voidedById                String?
  deletionReason            String?
  deletedAt                 DateTime?
  deletedById               String?
  isDeleted                 Boolean             @default(false)
  branchId                  String?
  footerPhoneOverride       String? // Override default phone in document footer
  footerBankDetailsOverride String? // Override default bank details in document footer
  // Reversal fields
  isReversal                Boolean             @default(false)
  reversedTransactionId     String?
  reversalReason            String?
  reversedAt                DateTime?
  reversedById              String?
  /// True when this invoice was created from Rental & Hiring (operational layer).
  isRentalInvoice           Boolean             @default(false)
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  client                    Client              @relation(fields: [clientId], references: [id])
  createdBy                 User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  deletedBy                 User?               @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])
  refundedBy                User?               @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant                    Tenant              @relation(fields: [tenantId], references: [id])
  voidedBy                  User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  items                     InvoiceItem[]
  refunds                   InvoiceRefund[]
  payments                  Payment[]
  attachments               InvoiceAttachment[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  rentalTransaction         RentalTransaction?

  @@unique([tenantId, invoiceNumber])
  @@index([branchId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([isReversal])
  @@index([reversedTransactionId])
  @@index([isRentalInvoice])
}

/// Bookable offering (catalogue) — commercial face; optional link to Asset / Product masters.
model RentalAsset {
  id              String    @id @default(cuid())
  tenantId        String
  branchId        String?
  code            String?
  name            String
  description     String?
  category        String    @default("general")
  /// rental = single-unit outbound; hiring = outbound quantity pool (not inbound supplier hire)
  kind            String
  /// SERIALISED_ASSET | POOLED_ASSET | QUANTITY_BASED_EQUIPMENT | VEHICLE | FACILITY | SERVICE | …
  rentalType      String    @default("CUSTOM")
  status          String    @default("available")
  totalQuantity   Int       @default(1)
  defaultRate     Decimal   @default(0) @db.Decimal(18, 2)
  rateUnit        String    @default("day")
  defaultDeposit  Decimal   @default(0) @db.Decimal(18, 2)
  /// Optional Fixed Asset Register link (capitalised rentable unit)
  fixedAssetId    String?
  productId       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]
  units             RentalUnit[]
  ratePlans         RentalRatePlan[]
  quotationLines    RentalQuotationLine[]
  contractLines     RentalContractLine[]

  @@unique([tenantId, code])
  @@index([tenantId, kind])
  @@index([tenantId, isActive])
  @@index([branchId])
  @@index([fixedAssetId])
  @@index([productId])
}

/// Outbound rental booking. Invoice optional when rentalPostInvoiceOnBook is false.
model RentalTransaction {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String?  @unique
  clientId       String
  kind           String
  startAt        DateTime
  endAt          DateTime
  status         String   @default("booked")
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  notes          String?
  /// Client-supplied or server-generated key — unique per tenant (retry-safe).
  idempotencyKey String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client            Client                    @relation(fields: [clientId], references: [id])
  createdBy         User                      @relation("RentalTransactionCreatedBy", fields: [createdById], references: [id])
  items             RentalItem[]
  availabilitySlots RentalAssetAvailability[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([clientId])
  @@index([startAt, endAt])
  @@index([status])
}

model RentalItem {
  id                  String  @id @default(cuid())
  rentalTransactionId String
  rentalAssetId       String
  quantity            Int     @default(1)
  unitRate            Decimal @db.Decimal(18, 2)
  billableUnits       Decimal @db.Decimal(18, 4)
  total               Decimal @db.Decimal(18, 2)
  returnedQuantity    Int     @default(0)

  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)
  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([rentalTransactionId])
  @@index([rentalAssetId])
}

/// Blocks double-booking: overlapping rows for the same asset must not exceed `totalQuantity` for hiring pools.
model RentalAssetAvailability {
  id                  String   @id @default(cuid())
  tenantId            String?
  rentalAssetId       String
  rentalTransactionId String
  startAt             DateTime
  endAt               DateTime
  status              String   @default("booked")
  quantity            Int      @default(1)

  rentalAsset       RentalAsset       @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)
  rentalTransaction RentalTransaction @relation(fields: [rentalTransactionId], references: [id], onDelete: Cascade)

  @@index([rentalAssetId, startAt, endAt])
  @@index([rentalTransactionId])
  @@index([tenantId])
}

/// Serialised / pool unit under a RentalAsset offering.
model RentalUnit {
  id                 String    @id @default(cuid())
  tenantId           String
  branchId           String?
  rentalAssetId      String
  code               String?
  serialNumber       String?
  barcode            String?
  fixedAssetId       String?
  availabilityStatus String    @default("AVAILABLE")
  conditionStatus    String    @default("GOOD")
  maintenanceStatus  String    @default("OK")
  currentMeter       Decimal?  @db.Decimal(18, 4)
  meterType          String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAsset        RentalAsset @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)
  allocations        RentalUnitAllocation[]
  dispatchLines      RentalDispatchLine[]
  returnLines        RentalReturnLine[]
  inspections        RentalInspection[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([rentalAssetId])
  @@index([availabilityStatus])
  @@index([fixedAssetId])
}

model RentalRatePlan {
  id             String    @id @default(cuid())
  tenantId       String
  rentalAssetId  String
  code           String
  name           String
  currency       String    @default("MWK")
  billingUnit    String    @default("day")
  baseRate       Decimal   @db.Decimal(18, 2)
  minimumCharge  Decimal   @default(0) @db.Decimal(18, 2)
  depositAmount  Decimal   @default(0) @db.Decimal(18, 2)
  overtimeRate   Decimal?  @db.Decimal(18, 2)
  lateFeePerDay  Decimal?  @db.Decimal(18, 2)
  graceHours     Int       @default(0)
  version        Int       @default(1)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  approvalStatus String    @default("APPROVED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAsset    RentalAsset @relation(fields: [rentalAssetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, version])
  @@index([tenantId, rentalAssetId])
  @@index([isActive])
}

model RentalQuotation {
  id             String    @id @default(cuid())
  tenantId       String
  quotationNumber String
  clientId       String
  status         String    @default("DRAFT")
  startAt        DateTime
  endAt          DateTime
  currency       String    @default("MWK")
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  taxEstimate    Decimal   @default(0) @db.Decimal(18, 2)
  totalEstimate  Decimal   @default(0) @db.Decimal(18, 2)
  depositEstimate Decimal  @default(0) @db.Decimal(18, 2)
  expiresAt      DateTime?
  pricingSnapshot Json?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines          RentalQuotationLine[]
  reservations   RentalReservation[]
  contracts      RentalContract[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model RentalQuotationLine {
  id              String   @id @default(cuid())
  quotationId     String
  rentalAssetId   String
  quantity        Int      @default(1)
  unitRate        Decimal  @db.Decimal(18, 2)
  billableUnits   Decimal  @db.Decimal(18, 4)
  lineTotal       Decimal  @db.Decimal(18, 2)
  description     String?
  quotation       RentalQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rentalAsset     RentalAsset     @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([rentalAssetId])
}

model RentalReservation {
  id               String    @id @default(cuid())
  tenantId         String
  reservationNumber String
  clientId         String
  quotationId      String?
  status           String    @default("DRAFT")
  startAt          DateTime
  endAt            DateTime
  expiresAt        DateTime?
  holdUntil        DateTime?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation        RentalQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  allocations      RentalUnitAllocation[]
  contracts        RentalContract[]

  @@unique([tenantId, reservationNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([startAt, endAt])
}

/// Soft allocation of a unit (or qty) for reservation/contract — enforces non-overlap for serialised units in app layer + unique active window checks.
model RentalUnitAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  rentalUnitId    String?
  rentalAssetId   String
  reservationId   String?
  contractId      String?
  startAt         DateTime
  endAt           DateTime
  quantity        Int      @default(1)
  status          String   @default("HELD")
  createdAt       DateTime @default(now())
  rentalUnit      RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: Cascade)
  reservation     RentalReservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  contract        RentalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rentalUnitId, startAt, endAt])
  @@index([rentalAssetId, startAt, endAt])
  @@index([reservationId])
  @@index([contractId])
  @@index([status])
}

model RentalContract {
  id                   String    @id @default(cuid())
  tenantId             String
  branchId             String?
  contractNumber       String
  clientId             String
  reservationId        String?
  quotationId          String?
  status               String    @default("DRAFT")
  billingPolicy        String    @default("BILL_AT_INVOICE")
  billingFrequency     String    @default("AT_RETURN")
  billingStatus        String    @default("UNBILLED")
  paymentStatus        String    @default("UNPAID")
  returnStatus         String    @default("NOT_RETURNED")
  startAt              DateTime
  endAt                DateTime
  expectedReturnAt     DateTime?
  actualReturnAt       DateTime?
  currency             String    @default("MWK")
  depositRequired      Decimal   @default(0) @db.Decimal(18, 2)
  depositReceived      Decimal   @default(0) @db.Decimal(18, 2)
  subtotalEstimate     Decimal   @default(0) @db.Decimal(18, 2)
  taxEstimate          Decimal   @default(0) @db.Decimal(18, 2)
  totalEstimate        Decimal   @default(0) @db.Decimal(18, 2)
  pricingVersion       Int       @default(1)
  pricingSnapshot      Json?
  mappingSnapshot      Json?
  version              Int       @default(1)
  notes                String?
  approvedAt           DateTime?
  approvedById         String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation          RentalReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  quotation            RentalQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lines                RentalContractLine[]
  allocations          RentalUnitAllocation[]
  deposits             RentalDeposit[]
  dispatches           RentalDispatch[]
  returns              RentalReturn[]
  charges              RentalCharge[]
  billingPeriods       RentalBillingPeriod[]
  usageRecords         RentalUsageRecord[]
  extensions           RentalExtension[]

  @@unique([tenantId, contractNumber])
  @@unique([tenantId, reservationId])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([startAt, endAt])
}

model RentalContractLine {
  id              String   @id @default(cuid())
  contractId      String
  rentalAssetId   String
  rentalUnitId    String?
  lineType        String   @default("RENTAL_ASSET")
  quantity        Int      @default(1)
  description     String?
  startAt         DateTime
  endAt           DateTime
  billingUnit     String   @default("day")
  unitRate        Decimal  @db.Decimal(18, 2)
  minimumCharge   Decimal  @default(0) @db.Decimal(18, 2)
  depositAmount   Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)
  ratePlanId      String?
  ratePlanVersion Int?
  pricingSnapshot Json?
  status          String   @default("ACTIVE")
  contract        RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rentalAsset     RentalAsset @relation(fields: [rentalAssetId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([rentalAssetId])
}

model RentalDeposit {
  id               String    @id @default(cuid())
  tenantId         String
  contractId       String
  clientId         String
  depositType      String    @default("REFUNDABLE_SECURITY")
  amount           Decimal   @db.Decimal(18, 2)
  receivedAmount   Decimal   @default(0) @db.Decimal(18, 2)
  appliedAmount    Decimal   @default(0) @db.Decimal(18, 2)
  refundedAmount   Decimal   @default(0) @db.Decimal(18, 2)
  forfeitedAmount  Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("MWK")
  status           String    @default("PENDING")
  journalId        String?
  idempotencyKey   String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract         RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([contractId])
  @@index([clientId])
  @@index([status])
}

model RentalDispatch {
  id               String   @id @default(cuid())
  tenantId         String
  contractId       String
  dispatchNumber   String
  dispatchAt       DateTime @default(now())
  dispatchType     String   @default("PICKUP")
  status           String   @default("DRAFT")
  meterOpening     Decimal? @db.Decimal(18, 4)
  fuelLevel        String?
  conditionNotes   String?
  customerAck    Boolean  @default(false)
  idempotencyKey   String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contract         RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lines            RentalDispatchLine[]

  @@unique([tenantId, dispatchNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([contractId])
  @@index([status])
}

model RentalDispatchLine {
  id           String  @id @default(cuid())
  dispatchId   String
  rentalUnitId String?
  rentalAssetId String
  quantity     Int     @default(1)
  dispatch     RentalDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  rentalUnit   RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)

  @@index([dispatchId])
  @@index([rentalUnitId])
}

model RentalReturn {
  id             String   @id @default(cuid())
  tenantId       String
  contractId     String
  returnNumber   String
  returnAt       DateTime @default(now())
  status         String   @default("RETURN_REQUESTED")
  meterClosing   Decimal? @db.Decimal(18, 4)
  fuelLevel      String?
  isLate         Boolean  @default(false)
  lateHours      Decimal? @db.Decimal(18, 4)
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contract       RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lines          RentalReturnLine[]
  inspections    RentalInspection[]
  charges        RentalCharge[]

  @@unique([tenantId, returnNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([contractId])
  @@index([status])
}

model RentalReturnLine {
  id           String  @id @default(cuid())
  returnId     String
  rentalUnitId String?
  rentalAssetId String
  quantity     Int     @default(1)
  rentalReturn RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  rentalUnit   RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([rentalUnitId])
}

model RentalInspection {
  id                 String   @id @default(cuid())
  tenantId           String
  returnId           String
  rentalUnitId       String?
  inspectedAt        DateTime @default(now())
  outcome            String   @default("PASSED")
  damageDetected     Boolean  @default(false)
  maintenanceRequired Boolean @default(false)
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())
  rentalReturn       RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  rentalUnit         RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  charges            RentalCharge[]

  @@index([tenantId])
  @@index([returnId])
  @@index([rentalUnitId])
}

model RentalCharge {
  id               String   @id @default(cuid())
  tenantId         String
  contractId       String
  returnId         String?
  inspectionId     String?
  chargeType       String
  description      String?
  amount           Decimal  @db.Decimal(18, 2)
  currency         String   @default("MWK")
  approvalStatus   String   @default("PENDING")
  billingStatus    String   @default("UNBILLED")
  invoiceId        String?
  idempotencyKey   String?
  version          Int      @default(1)
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contract         RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rentalReturn     RentalReturn? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  inspection       RentalInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([contractId])
  @@index([approvalStatus])
  @@index([billingStatus])
}

model RentalBillingPeriod {
  id             String   @id @default(cuid())
  tenantId       String
  contractId     String
  periodStart    DateTime
  periodEnd      DateTime
  pricingVersion Int      @default(1)
  amount         Decimal  @db.Decimal(18, 2)
  invoiceId      String?
  status         String   @default("BILLED")
  idempotencyKey String
  createdAt      DateTime @default(now())
  contract       RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contractId, periodStart, periodEnd, pricingVersion])
  @@unique([tenantId, idempotencyKey])
  @@index([contractId])
}

model RentalUsageRecord {
  id             String   @id @default(cuid())
  tenantId       String
  contractId     String
  rentalUnitId   String?
  meterType      String
  openingReading Decimal  @db.Decimal(18, 4)
  closingReading Decimal  @db.Decimal(18, 4)
  usageAmount    Decimal  @db.Decimal(18, 4)
  billingStatus  String   @default("UNBILLED")
  approved       Boolean  @default(false)
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  contract       RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@index([billingStatus])
}

model RentalExtension {
  id              String   @id @default(cuid())
  tenantId        String
  contractId      String
  requestedEndAt  DateTime
  status          String   @default("REQUESTED")
  priceDelta      Decimal  @default(0) @db.Decimal(18, 2)
  conflictNotes   String?
  approvedAt      DateTime?
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contract        RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@index([status])
}

/// Inbound supplier hire request (no accounting).
model HireRequest {
  id              String   @id @default(cuid())
  tenantId        String
  requestNumber   String
  requestedById   String?
  branchId        String?
  projectId       String?
  description     String
  equipmentSpec   String?
  quantity        Int      @default(1)
  startAt         DateTime
  endAt           DateTime
  estimatedCost   Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("DRAFT")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreements      HireAgreement[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId])
  @@index([status])
}

model HireAgreement {
  id                String   @id @default(cuid())
  tenantId          String
  agreementNumber   String
  supplierId        String
  hireRequestId     String?
  branchId          String?
  projectId         String?
  status            String   @default("DRAFT")
  startAt           DateTime
  endAt             DateTime
  currency          String   @default("MWK")
  estimatedValue    Decimal  @default(0) @db.Decimal(18, 2)
  billedValue       Decimal  @default(0) @db.Decimal(18, 2)
  accountingPolicy  String   @default("DIRECT_BILL")
  version           Int      @default(1)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hireRequest       HireRequest? @relation(fields: [hireRequestId], references: [id], onDelete: SetNull)
  usageRecords      HireUsageRecord[]
  deliveries        HireDelivery[]
  deposits          HireSupplierDeposit[]
  accruals          HireAccrual[]

  @@unique([tenantId, agreementNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model HireDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  agreementId     String
  deliveredAt     DateTime @default(now())
  description     String?
  serialNumber    String?
  quantity        Int      @default(1)
  conditionNotes  String?
  status          String   @default("RECEIVED")
  createdAt       DateTime @default(now())
  agreement       HireAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agreementId])
}

model HireUsageRecord {
  id             String   @id @default(cuid())
  tenantId       String
  agreementId    String
  usageDate      DateTime
  hours          Decimal  @default(0) @db.Decimal(18, 4)
  quantity       Decimal  @default(1) @db.Decimal(18, 4)
  approved       Boolean  @default(false)
  billingStatus  String   @default("UNBILLED")
  notes          String?
  createdAt      DateTime @default(now())
  agreement      HireAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agreementId])
  @@index([billingStatus])
}

model HireSupplierDeposit {
  id              String   @id @default(cuid())
  tenantId        String
  agreementId     String
  supplierId      String
  amount          Decimal  @db.Decimal(18, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(18, 2)
  refundedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  appliedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("PENDING")
  journalId       String?
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
