model PaymentAccount {
  id                      String              @id @default(cuid())
  tenantId                String
  name                    String
  accountType             String // Cash, Bank, Mobile Money, Wallet, POS Terminal
  reference               String? // Account number, wallet ID, etc.
  isActive                Boolean             @default(true)
  isSystem                Boolean             @default(false) // System accounts (like Cash) cannot be deleted
  /// Links this POS/payment method to a Chart of Accounts asset (cash/bank) so GL and A/L stay in sync
  coaAccountId            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coaAccount              Account?            @relation("PaymentAccountCoa", fields: [coaAccountId], references: [id], onDelete: SetNull)
  allocations             PaymentAllocation[]
  posCashDaysAsSystemCash PosCashDay[]        @relation("PosCashDaySystemCash")
  posCashDayDepositsTo    PosCashDayDeposit[] @relation("PosCashDayDepositTo")

  /// Same display name allowed; account number (`reference`) must be unique per tenant when set.
  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([isActive])
  @@index([isSystem])
  @@index([coaAccountId])
}

/// POS register: one row per tenant + branch scope + calendar business day (YYYY-MM-DD).
model PosCashDay {
  id                     String    @id @default(cuid())
  tenantId               String
  /// Stable branch scope: real branchId, or "none" when POS aggregates all allowed branches.
  branchKey              String    @default("none")
  businessDate           String
  status                 String    @default("OPEN")
  systemCashAccountId    String
  openingBalance         Float
  openedAt               DateTime  @default(now())
  openedById             String?
  closedAt               DateTime?
  closedById             String?
  autoClosed             Boolean   @default(false)
  totalSalesAtClose      Float?
  closingBalanceAtClose  Float?
  totalCashSalesSnapshot Float?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemCashAccount PaymentAccount      @relation("PosCashDaySystemCash", fields: [systemCashAccountId], references: [id], onDelete: Restrict)
  openedBy          User?               @relation("PosCashDayOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy          User?               @relation("PosCashDayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  deposits          PosCashDayDeposit[]

  @@unique([tenantId, branchKey, businessDate])
  @@index([tenantId, businessDate])
  @@index([status])
}

model PosCashDayDeposit {
  id           String   @id @default(cuid())
  posCashDayId String
  toAccountId  String
  amount       Float
  notes        String?
  isAutoSweep  Boolean  @default(false)
  createdAt    DateTime @default(now())
  createdById  String?

  posCashDay PosCashDay     @relation(fields: [posCashDayId], references: [id], onDelete: Cascade)
  toAccount  PaymentAccount @relation("PosCashDayDepositTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation("PosCashDayDepositCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([posCashDayId])
}

model PaymentAllocation {
