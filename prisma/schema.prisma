  accountId   String
  taxTypeId   String?
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  status      String    @default("ACTIVE")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account  @relation("TaxAccountMappingAccount", fields: [accountId], references: [id])

  @@index([tenantId, purpose, status])
  @@index([tenantId, accountId])
  @@index([taxTypeId])
  @@map("tax_account_mapping")
}

/// Immutable tax subledger projected from posted V2 journal lines.
model TaxTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  journalEntryId  String
  journalLineId   String   @unique
  taxTypeId       String?
  purpose         String?
  direction       String
  amountSigned    Decimal  @db.Decimal(18, 2)
  postingDate     DateTime
  sourceModule    String?
  sourceType      String?
  sourceId        String?
  isReversal      Boolean  @default(false)
  reversedFromId  String?
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, postingDate])
  @@index([tenantId, taxTypeId])
  @@index([tenantId, purpose])
  @@index([journalEntryId])
  @@map("tax_transaction")
}

/// Wave 4 — filing calendar period (state machine).
model TaxPeriod {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  label       String
  periodType  String    @default("MONTHLY")
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  status      String    @default("OPEN")
  closedAt    DateTime?
  closedById  String?
  reopenedAt  DateTime?
  reopenedById String?
  notes       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returns  TaxReturn[]
  payments TaxPayment[]
  refunds  TaxRefund[]
  credits  TaxCredit[]
  withholdings TaxWithholdingRemittance[]

  @@unique([tenantId, code])
  @@unique([tenantId, startDate, endDate, periodType])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("tax_period")
}

/// Wave 4 — tax return (filing does not auto-journal).
model TaxReturn {
  id              String    @id @default(cuid())
  tenantId        String
  taxPeriodId     String
  returnType      String    @default("VAT")
  status          String    @default("DRAFT")
