  refundReason               String?
  refundedAt                 DateTime?
  refundedById               String?
  totalDiscountAmount        Decimal                     @default(0) @db.Decimal(18, 2)
  totalTaxAmount             Decimal                     @default(0) @db.Decimal(18, 2)
