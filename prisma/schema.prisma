model Deduction {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  amount      Decimal? @db.Decimal(18, 2)
  percentage  Decimal? @db.Decimal(8, 4)
  priority    Int      @default(100)
  isPreTax    Boolean  @default(false)
  isStatutory Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  assignments EmployeeDeductionAssignment[]

  @@index([tenantId])
  @@index([isStatutory])
  @@index([isActive])
  @@index([tenantId, code])
}

/// Explicit employee ↔ deduction assignment (replaces opaque selectedDeductions Json over time).
model EmployeeDeductionAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  deductionId   String
  amountOverride Decimal? @db.Decimal(18, 2)
  percentOverride Decimal? @db.Decimal(8, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deduction     Deduction @relation(fields: [deductionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, deductionId, effectiveFrom])
  @@index([tenantId])
  @@index([employeeId])
  @@index([deductionId])
}

model GratuityAccount {
  id                String            @id @default(cuid())
  employeeId        String            @unique
  tenantId          String
  accrualRate       Decimal           @default(5) @db.Decimal(8, 4)
  totalAccrued      Decimal           @default(0) @db.Decimal(18, 2)
  totalPaid         Decimal           @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal           @default(0) @db.Decimal(18, 2)
  lastCalculatedAt  DateTime?
  notes             String?
