  openingBalanceDate     DateTime?
  cutoverDate            DateTime?
  financialYearLabel     String?
  accountingPeriodId     String?
  baseCurrency           String?
  timezone               String?
  completionPercent      Int      @default(0)
  /// Optimistic concurrency for multi-user draft edits.
  draftVersion           Int      @default(1)
  activityClassification String?
  conversionApprovedAt   DateTime?
  conversionApprovedBy   String?
  sourceChecksum         String?
  openingBalanceBatchId  String?
  journalEntryId         String?
  reopenReason           String?
