}

model Sale {
  id                         String                      @id @default(cuid())
  saleNumber                 String
  title                      String?
  orderNumber                String?
  clientId                   String?
  createdById                String
  saleDate                   DateTime                    @default(now())
  subtotal                   Float
  taxRate                    Float                       @default(0)
  taxAmount                  Float                       @default(0)
  total                      Float
  status                     String                      @default("completed")
  notes                      String?
  paymentMethod              String                      @default("cash")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  tenantId                   String
  discount                   Float                       @default(0)
  historicalDate             DateTime?
  isHistorical               Boolean                     @default(false)
  migrationBatch             String?
  originalReference          String?
  refundReason               String?
  refundedAt                 DateTime?
  refundedById               String?
  totalDiscountAmount        Float                       @default(0)
  totalTaxAmount             Float                       @default(0)
  voidReason                 String?
  voidedAt                   DateTime?
  voidedById                 String?
  branchId                   String?
