/// ────────────────────────────────────────────────────────────────────────────
/// Business Setup Wizard — Setup Run aggregate (Slice 1).
/// Orchestrates draft openings; posts one consolidated Opening Journal via
/// AcctV2OpeningBalanceBatch + Posting Engine (B1).
/// ────────────────────────────────────────────────────────────────────────────

model BusinessSetupRun {
  id                     String   @id @default(cuid())
  tenantId               String
  setupVersion           Int      @default(1)
  setupType              String   @default("NEW_BUSINESS")
  status                 String   @default("IN_PROGRESS")
  currentStepId          String   @default("profile")
  openingBalanceDate     DateTime?
  cutoverDate            DateTime?
  financialYearLabel     String?
  accountingPeriodId     String?
  baseCurrency           String?
  timezone               String?
  completionPercent      Int      @default(0)
  /// Optimistic concurrency for multi-user draft edits.
  draftVersion           Int      @default(1)
  activityClassification String?
  conversionApprovedAt   DateTime?
  conversionApprovedBy   String?
  sourceChecksum         String?
  openingBalanceBatchId  String?
  journalEntryId         String?
  reopenReason           String?
  reversalReference      String?
  createdById            String?
  lastUpdatedById        String?
  submittedById          String?
  reviewedById           String?
  approvedById           String?
  postedById             String?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  approvedAt             DateTime?
  postedAt               DateTime?
  completedAt            DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  steps BusinessSetupStep[]

  @@unique([tenantId, setupVersion])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
}

model BusinessSetupStep {
  id           String   @id @default(cuid())
  setupRunId   String
  tenantId     String
  stepId       String
  status       String   @default("NOT_STARTED")
  sortOrder    Int      @default(0)
  optional     Boolean  @default(false)
  /// Step-specific draft payload (profile, calendar, etc.).
  payload      Json?
  warningCount Int      @default(0)
  blockerCount Int      @default(0)
  lastSavedAt  DateTime?
  lastSavedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  setupRun BusinessSetupRun @relation(fields: [setupRunId], references: [id], onDelete: Cascade)

  @@unique([setupRunId, stepId])
  @@index([tenantId, stepId])
  @@index([setupRunId, status])
}

