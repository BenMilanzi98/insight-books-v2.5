  tenantId       String
  subscriptionId String
  eventType      String
  planCode       String?
  amount         Decimal? @db.Decimal(18, 2)
  occurredAt     DateTime
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([subscriptionId])
}

model AnalyticsFactTenantActivity {
  id             String   @id @default(cuid())
  tenantId       String
  eventType      String
  occurredAt     DateTime
  idempotencyKey String   @unique
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([eventType, occurredAt])
}

/// Phase 9 Wave 2 — product usage facts from instrumented commerce events.
model AnalyticsFactProductUsage {
