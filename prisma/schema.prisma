  @@index([tenantId, status])
  @@index([sourceBudgetId])
  @@map("PlanningForecast")
}

model ForecastLine {
  id                      String   @id @default(cuid())
  forecastId              String
  accountId               String
  accountCodeSnapshot     String
  accountNameSnapshot     String
  accountTypeSnapshot     String?
  forecastMethod          String   @default("MANUAL")
  historicalActualMinor   Int      @default(0)
