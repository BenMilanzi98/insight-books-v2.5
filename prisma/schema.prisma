  @@index([productId])
}

model SupplierBill {
  id                    String                      @id @default(cuid())
  billNumber            String                      @unique
  tenantId              String
  supplierId            String
  purchaseOrderId       String?
  goodsReceiptId        String?
  billDate              DateTime
  dueDate               DateTime
  billType              String                      @default("inventory")
  supplierInvoiceNumber String?
  subtotal              Float?
  taxAmount             Float?
  totalAmount           Float?
  amountPaid            Float?                      @default(0)
  status                String                      @default("Draft")
  paymentTerms          Int?
  currency              String?                     @default("MWK")
  notes                 String?
  journalEntryId        String?
  createdById           String?
  approvedById          String?
  finalizedAt           DateTime?
  finalizedById         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  approvedBy            User?                       @relation("SupplierBillApprover", fields: [approvedById], references: [id])
  createdBy             User?                       @relation("SupplierBillCreator", fields: [createdById], references: [id])
  finalizedBy           User?                       @relation("SupplierBillFinalizedBy", fields: [finalizedById], references: [id])
  goodsReceipt          GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id])
  journalEntry          JournalEntry?               @relation("SupplierBillJournalEntry", fields: [journalEntryId], references: [id])
  purchaseOrder         PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                 SupplierBillItem[]
  allocations           SupplierPaymentAllocation[]

  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, billType])
  @@index([dueDate])
}

model SupplierBillItem {
  id               String       @id @default(cuid())
  billId           String
  lineNumber       Int
  productId        String?
  expenseAccountId String?
  description      String
  quantity         Decimal?     @db.Decimal(12, 4)
  unitCost         Decimal      @db.Decimal(15, 2)
  lineTotal        Decimal      @db.Decimal(15, 2)
