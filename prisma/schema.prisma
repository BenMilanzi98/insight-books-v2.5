model JournalEntry {
  id               String             @id @default(cuid())
  transactionId    String?            @map("transactionId")
  accountId        String?            @map("accountId")
  debit            Float?             @default(0) @map("debit")
  credit           Float?             @default(0) @map("credit")
  description      String?
  status           String             @default("Draft")
  createdAt        DateTime           @default(now())
  createdById      String?
  entryDate        DateTime?
  entryType        String             @default("Regular")
  notes            String?
  postedById       String?
  postedDate       DateTime?
  referenceNumber  String?            @unique
  sourceId         String?
  sourceType       String?
  tenantId         String?
  updatedAt        DateTime           @default(now())
  branchId         String?
