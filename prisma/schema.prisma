  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([productId])
  @@index([status])
  @@index([createdById])
  @@index([receivedById])
  @@index([rejectedById])
}

/// Basic four-column stock Excel import batch (Business-scoped; no user-facing branch).
model StockImportBatch {
  id                 String           @id @default(cuid())
  tenantId           String
  fileHash           String
  fileName           String?
  purpose            String           @default("STOCK_RECEIPT_IMPORT") // OPENING_STOCK_IMPORT | STOCK_RECEIPT_IMPORT | DATA_MIGRATION_IMPORT
  status             String           @default("UPLOADED")
  updateSellingPrice Boolean          @default(true)
  forceAsNewReceipt  Boolean          @default(false)
  rowCount           Int              @default(0)
  validCount         Int              @default(0)
  warningCount       Int              @default(0)
  invalidCount       Int              @default(0)
  createdById        String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  errorSummary       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation("StockImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rows               StockImportRow[]

  @@unique([tenantId, fileHash, purpose])
  @@index([tenantId, status])
  @@index([createdById])
}

model StockImportRow {
  id               String           @id @default(cuid())
  batchId          String
  tenantId         String
  rowNumber        Int
  itemName         String
  normalizedName   String
  quantity         Decimal          @db.Decimal(18, 4)
  orderPrice       Decimal          @db.Decimal(18, 2)
  sellingPrice     Decimal          @db.Decimal(18, 2)
  matchStatus      String           // NEW | MATCHED | AMBIGUOUS | INVALID
  productId        String?
  status           String           @default("PENDING") // PENDING | READY | BLOCKED | POSTED | FAILED | SKIPPED
  message          String?
  quantityBefore   Decimal?         @db.Decimal(18, 4)
  quantityAfter    Decimal?         @db.Decimal(18, 4)
  valueBefore      Decimal?         @db.Decimal(18, 2)
  valueAfter       Decimal?         @db.Decimal(18, 2)
  wacBefore        Decimal?         @db.Decimal(18, 2)
  wacAfter         Decimal?         @db.Decimal(18, 2)
  movementId       String?
  batchLayerId     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  batch            StockImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([tenantId, normalizedName])
  @@index([productId])
  @@index([status])
}

/// In-app notice on the receiving business dashboard when stock arrives from another tenant.
model StockTransferReceiptNotice {
  id               String    @id @default(cuid())
  tenantId         String
  stockTransferId  String    @unique
  sourceTenantId   String
  sourceTenantName String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, readAt])
}

