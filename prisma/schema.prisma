/// Platform SaaS payments — separate from tenant AR Payment.
model PlatformPayment {
  id               String   @id @default(cuid())
  paymentNumber    String   @unique
  tenantId         String
  invoiceId        String?
  currency         String   @default("MWK")
  amount           Decimal  @db.Decimal(18, 2)
