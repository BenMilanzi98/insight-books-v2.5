  @@index([tenantId])
}

model InventoryLocation {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
