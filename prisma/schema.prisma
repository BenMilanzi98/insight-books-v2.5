// FIFO batches for inventory costing (system-generated)
model InventoryBatch {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  productId     String
  sourceType    String?  // GoodsReceipt, SupplierBill, Adjustment, etc.
  sourceId      String?  // ID of the source document
  purchaseDate  DateTime
  qtyPurchased  Decimal  @db.Decimal(18, 4)
  qtyRemaining  Decimal  @db.Decimal(18, 4)
  unitCost      Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  consumptions InventoryBatchConsumption[]

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([purchaseDate])
}

// Tracks batch consumption for auditability (system-generated)
model InventoryBatchConsumption {
  id         String   @id @default(cuid())
  tenantId   String
  batchId    String
  saleId     String?
  saleItemId String?
  quantity   Decimal  @db.Decimal(18, 4)
  unitCost   Decimal  @db.Decimal(15, 2)
  cogsAmount Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sale   Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  // saleItemId is stored for tracing but not enforced as a relation to avoid migration complexity

  @@index([tenantId])
  @@index([batchId])
  @@index([saleId])
  @@index([saleItemId])
}

model Employee {
  id                 String             @id @default(cuid())
  employeeId         String?            @unique
  name               String
  email              String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenantId           String
  address            String?
  department         String?
  departmentId       String?
  phone              String?
  position           String?
  salary             Float?
  startDate          DateTime
  status             String?            @default("Active")
  bankDetails        Json?
  contactDetails     Json?
  dateOfBirth        DateTime?
  emergencyContact   Json?
  employmentType     String?            @default("Permanent")
  gender             String?
  grossSalary        Float?
  hourlyRate         Float?
  idNumber           String?
  isActive           Boolean            @default(true)
  jobTitle           String?
  maritalStatus      String?
  nationality        String?            @default("Malawian")
  reportingManager   Json?
  selectedDeductions Json?
  workLocation       String?
  terminationDate    DateTime?
  terminationReason  String?
  suspendedFrom      DateTime?
  suspendedTo        DateTime?
  suspensionReason   String?
  departmentRef      Department?        @relation(fields: [departmentId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  payrolls           Payroll[]
  attendanceRecords  AttendanceRecord[]
  gratuityAccount    GratuityAccount?
  salaryAdvances     SalaryAdvance[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  performanceReviews PerformanceReview[]
  performanceGoals   PerformanceGoal[]
  performanceFeedbackGiven PerformanceFeedback[] @relation("FeedbackGiven")
  performanceFeedbackReceived PerformanceFeedback[] @relation("FeedbackReceived")

  @@index([tenantId])
  @@index([departmentId])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  color       String?    @default("#4f46e5")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  employees   Employee[]

  @@index([tenantId])
}

model Payroll {
  id             String    @id @default(cuid())
  employeeId     String
  tenantId       String
  periodStart    DateTime
  periodEnd      DateTime
  basicSalary    Float     @default(0)
  grossPay       Float?    @default(0)
  deductions     Float     @default(0)
  additions      Float     @default(0)
  netPay         Float     @default(0)
  payeAmount     Float?    @default(0)
  totalNpsAmount Float?    @default(0)
  status         String    @default("Pending")
  notes          String?
  paymentDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

model Deduction {
  id          String   @id @default(cuid())
  name        String
  description String?
  amount      Float?
  percentage  Float?
  isStatutory Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([isStatutory])
  @@index([isActive])
}

model GratuityAccount {
  id                String            @id @default(cuid())
  employeeId        String            @unique
  tenantId          String
  accrualRate       Float             @default(5) // Default 5% per month (percentage points)
  totalAccrued      Float             @default(0)
  totalPaid         Float             @default(0)
  outstandingAmount Float             @default(0)
  lastCalculatedAt  DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          GratuityPayment[]

  @@index([tenantId])
  @@index([employeeId])
}

model GratuityPayment {
  id                String          @id @default(cuid())
  gratuityAccountId String
  amount            Float
  paymentDate       DateTime
  reference         String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  gratuityAccount   GratuityAccount @relation(fields: [gratuityAccountId], references: [id], onDelete: Cascade)

  @@index([gratuityAccountId])
  @@index([paymentDate])
}

model SalaryAdvance {
  id                String             @id @default(cuid())
  employeeId        String
  tenantId          String
  amount            Float
  advanceDate       DateTime
  repaymentMonths   Int                @default(1) // Number of months to repay
  monthlyDeduction  Float // Amount to deduct per month
  totalDeducted     Float              @default(0)
  outstandingAmount Float // Calculated: amount - totalDeducted
  status            String             @default("Active") // Active, Completed, Cancelled
  reference         String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deductions        AdvanceDeduction[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([advanceDate])
}

model AdvanceDeduction {
  id              String        @id @default(cuid())
  salaryAdvanceId String
  payrollId       String?
  amount          Float
  deductionDate   DateTime
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salaryAdvance   SalaryAdvance @relation(fields: [salaryAdvanceId], references: [id], onDelete: Cascade)

  @@index([salaryAdvanceId])
  @@index([payrollId])
  @@index([deductionDate])
}

model Affiliate {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  password         String?
  businessName     String?
  paymentMethod    String
  paymentDetails   String?
  status           String              @default("active")
  referralCode     String              @unique @default(cuid())
  commissionRate   Float               @default(20)
  totalReferrals   Int                 @default(0)
  totalSales       Float               @default(0)
  totalCommissions Float               @default(0)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  payouts          AffiliatePayout[]
  referrals        AffiliateReferral[]
}

model AffiliateReferral {
  id                    String    @id @default(cuid())
  affiliateId           String
  tenantId              String
  userId                String?
  commissionAmount      Float     @default(0)
  status                String    @default("pending")
  registrationTimestamp DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  affiliate             Affiliate @relation(fields: [affiliateId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  user                  User?     @relation(fields: [userId], references: [id])
