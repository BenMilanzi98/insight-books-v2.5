  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  conversion         CrmConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  attempts           CrmConversionAttempt[]

  @@unique([conversionId, stepCode])
  @@index([conversionId, stepOrder])
  @@index([status])
}

model CrmConversionAttempt {
  id             String   @id @default(cuid())
  conversionId   String
  stepId         String?
  stepCode       String?
  attemptNumber  Int      @default(1)
  inputHash      String?
  status         String?
  outputJson     Json?
