  evidenceSnapshots      CustomerAdoptionEvidenceSnapshot[]

  @@unique([planId, templateKey])
  @@index([planId, status])
  @@index([planTemplateVersionId])
  @@index([evidenceMode])
  @@index([critical, status])
}

/// Phase 19 Wave 2 — dated Phase 9 / Training / attestation evidence snapshot.
model CustomerAdoptionEvidenceSnapshot {
  id               String   @id @default(cuid())
  planId           String
  milestoneId      String?
  evidenceMode     String?
  status           String   @default("UNKNOWN")
  sourceSystem     String?
  observedAt       DateTime @default(now())
  snapshotJson     Json?
  reasonCode       String?
  reasonMessage    String?
  idempotencyKey   String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  plan             CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  milestone        CustomerAdoptionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([planId, observedAt])
  @@index([milestoneId])
  @@index([status])
}

/// Phase 19 Wave 2 — value outcome record (null/UNAVAILABLE not false zero).
model CustomerAdoptionValueOutcome {
  id               String   @id @default(cuid())
  planId           String
  outcomeType      String
  status           String   @default("UNKNOWN")
  value            Json?
  sourceSystem     String?
  observedAt       DateTime @default(now())
  lineageJson      Json?
  reasonCode       String?
  reasonMessage    String?
  idempotencyKey   String?  @unique
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  plan             CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, outcomeType])
  @@index([status])
  @@index([observedAt])
}

/// Phase 19 Wave 3 — contact-verified champion (no engagement scores).
model CustomerAdoptionChampion {
  id               String   @id @default(cuid())
  planId           String
  contactId        String
  role             String   @default("CHAMPION")
  enablementStatus String   @default("IDENTIFIED")
  lastEvidenceRef  String?
  tenantId         String?
  customerId       String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  plan             CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, contactId, role])
  @@index([planId, enablementStatus])
  @@index([contactId])
  @@index([tenantId])
}

/// Phase 19 Wave 3 — dormancy recovery case (Phase 9 inactive-class signals).
model CustomerAdoptionDormancyCase {
  id                        String    @id @default(cuid())
  planId                    String
  tenantId                  String?
  status                    String    @default("OPEN")
  signalIdentity            String?
  signalCode                String?
  featureCode               String?
  interventionId            String?
  playbookExecutionId       String?
  usageReturnSnapshotJson   Json?
  outreachAttestedAt        DateTime?
  outreachAttestedByAdminId String?
  outcomeReason             String?
  idempotencyKey            String?   @unique
  createdByAdminId          String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  plan                      CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  interventionLinks         CustomerAdoptionInterventionLink[]

  @@index([planId, status])
  @@index([tenantId, status])
  @@index([signalCode])
  @@index([interventionId])
}

/// Phase 19 Wave 3 — link to Phase 8 CsIntervention (link only, no engine rebuild).
model CustomerAdoptionInterventionLink {
  id                     String   @id @default(cuid())
  planId                 String
  dormancyCaseId         String
  interventionId         String
  playbookExecutionId    String?
  outcomeAttestationJson Json?
  createdByAdminId       String?
  createdAt              DateTime @default(now())
  plan                   CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dormancyCase           CustomerAdoptionDormancyCase @relation(fields: [dormancyCaseId], references: [id], onDelete: Cascade)

  @@unique([dormancyCaseId, interventionId])
  @@index([planId])
  @@index([interventionId])
}

/// Phase 19 Wave 3 — expansion/renewal handoff (record-only; no billing mutate).
model CustomerAdoptionExpansionHandoff {
  id                    String    @id @default(cuid())
  planId                String
  tenantId              String?
  status                String    @default("DRAFT")
  targetQueue           String
  signalPackageJson     Json?
  evidenceRefsJson      Json?
  idempotencyKey        String?   @unique
  createdByAdminId      String?
  handedOffAt           DateTime?
  handedOffByAdminId    String?
  acknowledgedAt        DateTime?
  acknowledgedByAdminId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  plan                  CustomerAdoptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@index([tenantId, status])
  @@index([targetQueue])
}
