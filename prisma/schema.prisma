model JournalEntry {
  id               String             @id @default(cuid())
  transactionId    String?            @map("transactionId")
  accountId        String?            @map("accountId")
  debit            Float?             @default(0) @map("debit")
  credit           Float?             @default(0) @map("credit")
  description      String?
  status           String             @default("Draft")
  createdAt        DateTime           @default(now())
  createdById      String?
  entryDate        DateTime?
  entryType        String             @default("Regular")
  notes            String?
  postedById       String?
  postedDate       DateTime?
  referenceNumber  String?            @unique
  sourceId         String?
  sourceType       String?
  tenantId         String?
  updatedAt        DateTime           @default(now())
  branchId         String?
  /// ── Accounting V2 posting-engine columns (Phase 4, additive) ──
  /// Journal number allocated by the concurrency-safe sequence (unique per business).
  journalNumber        String?
  /// Exact decimal totals written by the V2 engine (legacy Float header debit/credit unused).
  totalDebit           Decimal?  @db.Decimal(18, 2)
  totalCredit          Decimal?  @db.Decimal(18, 2)
  currency             String?
  exchangeRate         Decimal?  @db.Decimal(18, 8)
  baseCurrency         String?
  /// Posting date determines the accounting period; transaction date preserved in entryDate.
  postingDate          DateTime?
  accountingPeriodId   String?
  financialYearLabel   String?
  /// Traceability: template + architecture version + accounting event identity.
  templateId           String?
  templateVersion      Int?
  architectureVersion  String    @default("LEGACY_V1")
  /// One active posting per accounting event — database-enforced.
  accountingEventId    String?   @unique
  postingMode          String?
  approvedById         String?
  approvedAt           DateTime?
  adjustmentCategory   String?
  adjustmentReason     String?
  relatedJournalId     String?
  metadata             Json?
  /// ── Phase 5 canonical journal columns (additive) ──
  /// Human-readable source document number (invoice number, receipt number, …).
  sourceNumber         String?
  /// Reversal linkage: NOT_REVERSED | REVERSED | REVERSAL (this row reverses another).
  reversalStatus       String?
  /// Set on reversal journals: the journal this row reverses.
  originalJournalId    String?
  /// Set on reversed originals: the posted reversal journal.
  reversedByJournalId  String?
  reversedAt           DateTime?
  reversedById         String?
  goodsReceipts    GoodsReceipt[]     @relation("GoodsReceiptJournalEntry")
  branch           Branch?            @relation(fields: [branchId], references: [id])
  createdBy        User?              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedBy         User?              @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines            JournalEntryLine[]
  supplierBills    SupplierBill[]     @relation("SupplierBillJournalEntry")
  supplierPayments SupplierPayment[]  @relation("SupplierPaymentJournalEntry")

  @@unique([tenantId, journalNumber])
  @@index([tenantId])
  @@index([entryDate])
  @@index([status])
  @@index([entryType])
  @@index([referenceNumber])
  @@index([branchId])
  @@index([tenantId, architectureVersion, status])
  @@index([tenantId, postingDate])
  @@index([tenantId, sourceType, sourceId])
  @@index([originalJournalId])
  @@index([reversedByJournalId])
  @@index([tenantId, entryType])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  debitAmount    Decimal      @default(0) @db.Decimal(18, 2)
  creditAmount   Decimal      @default(0) @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// ── Accounting V2 posting-engine columns (Phase 4, additive) ──
  baseDebit      Decimal?     @db.Decimal(18, 2)
  baseCredit     Decimal?     @db.Decimal(18, 2)
  currency       String?
  taxCode        String?
  /// Subledger dimensions (customerId, supplierId, employeeId, ownerId, bankAccountId, …).
  dimensions     Json?
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
}

