generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                         String                      @id @default(cuid())
  name                       String
  subdomain                  String                      @unique
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  status                     String                      @default("active")
  subscriptionPlan           String
  logoUrl                    String?
  primaryColor               String?
  faviconUrl                 String?
  secondaryColor             String?
  accounts                   Account[]
  AccountBalance             AccountBalance[]
  accountSubscriptions       AccountSubscription[]
  adminAccess                AdminTenantAccess[]
  affiliateReferrals         AffiliateReferral[]
  assets                     Asset[]
  assetCategories            AssetCategory[]
  attendanceRecords          AttendanceRecord[]
  attendanceRegisters        AttendanceRegister[]
  bankAccounts               BankAccount[]
  branches                   Branch[]
  branchSubscriptions        BranchSubscription[]
  budgets                    Budget[]
  clients                    Client[]
  benefits                   Benefit[]
  deductions                 Deduction[]
  departments                Department[]
  emailLogs                  EmailLog[]
  employees                  Employee[]
  equityAccounts             EquityAccount[]
  exchangeRates              ExchangeRate[]
  expenses                   Expense[]
  goodsReceipts              GoodsReceipt[]
  gratuityAccounts           GratuityAccount[]
  inventoryBatches           InventoryBatch[]
  inventoryBatchConsumptions InventoryBatchConsumption[]
  inventoryCategories        InventoryCategory[]
  inventoryLocations         InventoryLocation[]
  inventoryTransactions      InventoryTransaction[]
  invoices                   Invoice[]
  invoiceRefunds             InvoiceRefund[]
  creditNotes                CreditNote[]
  debitNotes                 DebitNote[]
  invoiceTemplates           InvoiceTemplate[]
  invoiceAttachments          InvoiceAttachment[]
  journalEntries             JournalEntry[]
  leaveBalances              LeaveBalance[]
  leavePolicies              LeavePolicy[]
  leaveRequests              LeaveRequest[]
  liabilities                Liability[]
  liabilityCategories        LiabilityCategory[]
  expenseCategories          ExpenseCategory[]
  payments                   Payment[]
  paymentGateways            PaymentGateway[]
  paymentAccounts            PaymentAccount[]
  payrolls                   Payroll[]
  performanceFeedback        PerformanceFeedback[]
  performanceGoals           PerformanceGoal[]
  performanceReviews         PerformanceReview[]
  products                   Product[]
  purchaseOrders             PurchaseOrder[]
  quotations                 Quotation[]
  recurringExpenses          RecurringExpense[]
  roles                      Role[]
  salaryAdvances             SalaryAdvance[]
  sales                      Sale[]                      @relation("TenantSales")
  suppliers                  Supplier[]
  supplierBills              SupplierBill[]
  supplierPayments           SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  taxTypes                   TaxType[]
  settings                   TenantSettings?
  transactions               Transaction[]
  users                      User[]
  members                    User[]                      @relation("UserTenants")
  accountingPeriods          AccountingPeriod[]
  stockTransfers             StockTransfer[]
}

model Branch {
  id                    String                 @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchSubscriptions   BranchSubscription[]
  expenses              Expense[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  payments              Payment[]
  products              Product[]
  sales                 Sale[]
  transactions          Transaction[]
  budgetItems           BudgetItem[]
  defaultUsers          User[]                 @relation("UserDefaultBranch")
  stockTransfersFrom    StockTransfer[]         @relation("StockTransferFrom")
  stockTransfersTo      StockTransfer[]         @relation("StockTransferTo")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model TenantSettings {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  taxEnabled             Boolean  @default(true)
  defaultTaxRate         Float    @default(0)
  currencyCode           String   @default("MWK")
  invoicePrefix          String   @default("INV")
  invoiceTemplate        String   @default("default")
  enabledModules         String[]
  customDomain           String?
  dailyReports           Boolean  @default(false)
  emailFooter            String?
  emailNotifications     Boolean  @default(true)
  inAppNotifications     Boolean  @default(true)
  invoiceReminders       Boolean  @default(true)
  lowStockAlerts         Boolean  @default(true)
  monthlyReports         Boolean  @default(true)
  paymentReceipts        Boolean  @default(true)
  smsNotifications       Boolean  @default(false)
  weeklyReports          Boolean  @default(true)
  buildingName           String?
  businessAddress        String?
  businessCity           String?
  businessEmail          String?
  businessPhone          String?
  receiptFooter          String?
  defaultBankDetails     String?  // Default bank account details for invoice/quotation/receipt footers
  npsEmployeeRatePercent Float    @default(5)
  npsEmployerRatePercent Float    @default(5)
  balanceReminderSubject String?
  balanceReminderBody    String?
  taxOutflowAccountId    String?  // Account where tax from outflows (expenses, supplier bills) accumulates for offset vs collected tax
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model User {
  id                             String                 @id @default(cuid())
  email                          String                 @unique
  name                           String?
  password                       String                 @db.VarChar(255)
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  tenantId                       String?
  lastLogin                      DateTime?
  isActive                       Boolean                @default(true)
  mfaEnabled                     Boolean                @default(false)
  isEmailVerified                Boolean                @default(false)
  otpCode                        String?
  otpExpiry                      DateTime?
  department                     String?
  phone                          String?
  roleId                         String
  status                         String                 @default("active")
  authProvider                   String?
  authProviderId                 String?
  profilePicture                 String?
  resetToken                     String?
  resetTokenExpiry               DateTime?
  defaultBranchId                String?
  adminActivityLogs              AdminActivityLog[]     @relation("AdminActivityLog")
  affiliateReferrals             AffiliateReferral[]
  createdAssets                  Asset[]                @relation("AssetCreatedBy")
  attendanceRegistersFinalized   AttendanceRegister[]
  auditLogs                      AuditLog[]
  approvedBudgets                Budget[]               @relation("BudgetApprover")
  sentEmails                     EmailLog[]             @relation("EmailLogSender")
  deletedExpenses                Expense[]              @relation("ExpenseDeletedBy")
  expenseSubmissions             Expense[]
  uploadedAttachments            ExpenseAttachment[]    @relation("UploadedAttachments")
  invoiceAttachments             InvoiceAttachment[]   @relation("InvoiceAttachmentUploader")
  goodsReceiptsReceived          GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  inventoryTransactions          InventoryTransaction[]
  createdInvoices                Invoice[]              @relation("InvoiceCreator")
  refundedInvoices               Invoice[]              @relation("InvoiceRefundedBy")
  voidedInvoices                 Invoice[]              @relation("InvoiceVoidedBy")
  processedRefunds               InvoiceRefund[]        @relation("InvoiceRefundedBy")
  createdJournalEntries          JournalEntry[]         @relation("JournalEntryCreatedBy")
  postedJournalEntries           JournalEntry[]         @relation("JournalEntryPostedBy")
  leaveRequestsReviewed          LeaveRequest[]
  createdLiabilities             Liability[]            @relation("LiabilityCreatedBy")
  performanceReviewsAcknowledged PerformanceReview[]    @relation("ReviewAcknowledgedBy")
  performanceReviewsConducted    PerformanceReview[]
  deletedProducts                Product[]              @relation("ProductDeletions")
  purchaseOrdersApproved         PurchaseOrder[]        @relation("PurchaseOrderApprover")
  purchaseOrdersCreated          PurchaseOrder[]        @relation("PurchaseOrderCreator")
  createdQuotations              Quotation[]            @relation("QuotationCreator")
  recurringExpenses              RecurringExpense[]
  createdSales                   Sale[]                 @relation("SaleCreations")
  refundedSales                  Sale[]                 @relation("SaleRefunds")
  voidedSales                    Sale[]                 @relation("SaleVoids")
  supplierBillsApproved          SupplierBill[]         @relation("SupplierBillApprover")
  supplierBillsCreated           SupplierBill[]         @relation("SupplierBillCreator")
  supplierBillsFinalized         SupplierBill[]         @relation("SupplierBillFinalizedBy")
  supplierPaymentsCreated        SupplierPayment[]
  createdTransactions            Transaction[]          @relation("TransactionCreatedBy")
  postedTransactions             Transaction[]          @relation("TransactionPostedBy")
  creditNotesCreated             CreditNote[]           @relation("CreditNoteCreatedBy")
  creditNotesPosted              CreditNote[]           @relation("CreditNotePostedBy")
  debitNotesCreated              DebitNote[]            @relation("DebitNoteCreatedBy")
  debitNotesPosted               DebitNote[]            @relation("DebitNotePostedBy")
  closedAccountingPeriods        AccountingPeriod[]     @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods      AccountingPeriod[]     @relation("AccountingPeriodReopenedBy")
  stockTransfersCreated          StockTransfer[]        @relation("StockTransferCreatedBy")
  stockTransfersApproved         StockTransfer[]        @relation("StockTransferApprovedBy")
  defaultBranch                  Branch?                @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  role                           Role                   @relation(fields: [roleId], references: [id])
  tenant                         Tenant?                @relation(fields: [tenantId], references: [id])
  tenants                        Tenant[]               @relation("UserTenants")

  @@index([email])
  @@index([tenantId])
  @@index([authProvider, authProviderId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  periodType   String // Monthly | Yearly
  startDate    DateTime
  endDate      DateTime
  status       String    @default("open") // open | closed
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closedBy   User?  @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy User?  @relation("AccountingPeriodReopenedBy", fields: [reopenedById], references: [id])

  @@unique([tenantId, periodType, startDate])
  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([status])
}

// Legacy table backing the ReversalSummary view (kept to avoid accidental drops)
model ReversalAudit {
  id String @id

  @@map("ReversalAudit")
  @@ignore
}

model Admin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  password       String              @db.VarChar(255)
  role           String              @default("Super Admin")
  permissions    Json                @default("{}")
  isActive       Boolean             @default(true)
  lastLogin      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  profilePicture String?
  phone          String?
  department     String?
  notes          String?
  adminAuditLogs AdminAuditLog[]
  managedTenants AdminTenantAccess[]
  emailLogs      EmailLog[]          @relation("EmailLogAdminSender")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  userAgent  String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

model AdminTenantAccess {
  id          String    @id @default(cuid())
  adminId     String
  tenantId    String
  accessLevel String    @default("full")
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminId, tenantId])
  @@index([adminId])
  @@index([tenantId])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  timestamp  DateTime @default(now())
  details    String?
  ipAddress  String?
  tenantId   String?
  user       User     @relation(fields: [userId], references: [id])
}

model Client {
  id            String      @id @default(cuid())
  name          String
  email         String?
  additionalEmails String[]  @default([]) // Multiple email addresses for sending invoices
  phone         String?
  address       String?
  contactPerson String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  invoices      Invoice[]
  quotations    Quotation[]
  sales         Sale[]
  creditNotes   CreditNote[]
  debitNotes    DebitNote[]
}

model Invoice {
  id                    String          @id @default(cuid())
  invoiceNumber         String
  title                 String?
  orderNumber           String?
  clientId              String
  createdById           String
  issueDate             DateTime
  dueDate               DateTime
  subtotal              Float
  taxAmount             Float
  total                 Float
  status                String          @default("draft")
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenantId              String
  discount              Float           @default(0)
  lastPaymentDate       DateTime?
  originalTotal         Float           @default(0)
  refundAmount          Float           @default(0)
  refundReason          String?
  refundedAt            DateTime?
  refundedById          String?
  remainingBalance      Float           @default(0)
  totalDiscountAmount   Float           @default(0)
  totalPaid             Float           @default(0)
  voidReason            String?
  voidedAt              DateTime?
  voidedById            String?
  branchId              String?
  footerPhoneOverride   String?   // Override default phone in document footer
  footerBankDetailsOverride String? // Override default bank details in document footer
  // Reversal fields
  isReversal            Boolean         @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  branch                Branch?         @relation(fields: [branchId], references: [id])
  client                Client          @relation(fields: [clientId], references: [id])
  createdBy             User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  refundedBy            User?           @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  voidedBy              User?           @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  items                 InvoiceItem[]
  refunds               InvoiceRefund[]
  payments              Payment[]
  attachments           InvoiceAttachment[]
  creditNotes           CreditNote[]
  debitNotes            DebitNote[]

  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model InvoiceAttachment {
  id          String   @id @default(cuid())
  invoiceId   String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  uploadedAt  DateTime @default(now())
  uploadedById String
  tenantId    String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation("InvoiceAttachmentUploader", fields: [uploadedById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@index([uploadedById])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  accountId      String?
  description    String
  quantity       Float
  unitPrice      Float
  taxRate        Float
  amount         Float
  productId      String?
  discountAmount Float    @default(0)
  discountRate   Float    @default(0)
  netAmount      Float    @default(0)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([accountId])
}

model InvoiceRefund {
  id              String    @id @default(cuid())
  invoiceId       String
  refundedById    String
  refundAmount    Float
  refundReason    String
  refundMethod    String
  refundDate      DateTime  @default(now())
  notes           String?
  tenantId        String
  status          String    @default("pending")
  processedAt     DateTime?
  transactionId   String?
  processingNotes String?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refundedBy      User      @relation("InvoiceRefundedBy", fields: [refundedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([refundedById])
  @@index([tenantId])
  @@index([refundDate])
  @@index([status])
}

model CreditNote {
  id           String    @id @default(cuid())
  noteNumber   String    @unique
  tenantId     String
  clientId     String
  invoiceId    String?
  saleId       String?
  amount       Float
  reason       String
  noteDate     DateTime
  status       String    @default("Draft")
  createdById  String
  postedAt     DateTime?
  postedById   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id])
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sale         Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  postedBy     User?     @relation("CreditNotePostedBy", fields: [postedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([status])
  @@index([noteDate])
}

model DebitNote {
  id           String    @id @default(cuid())
  noteNumber   String    @unique
  tenantId     String
  clientId     String
  invoiceId    String?
  saleId       String?
  amount       Float
  reason       String
  noteDate     DateTime
  status       String    @default("Draft")
  createdById  String
  postedAt     DateTime?
  postedById   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id])
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sale         Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("DebitNoteCreatedBy", fields: [createdById], references: [id])
  postedBy     User?     @relation("DebitNotePostedBy", fields: [postedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([status])
  @@index([noteDate])
}

model Payment {
  id                    String              @id @default(cuid())
  invoiceId             String?
  amount                Float
  paymentDate           DateTime
  paymentMethod         String
  reference             String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  status                String              @default("Completed")
  tenantId              String
  destinationAccount    String?
  sourceAccount         String?
  type                  String?
  expenseId             String?
  refundedAmount        Float               @default(0)
  saleId                String?
  branchId              String?
  // Reversal fields
  isReversal            Boolean             @default(false)
  reversedTransactionId String?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?
  branch                Branch?             @relation(fields: [branchId], references: [id])
  expense               Expense?            @relation(fields: [expenseId], references: [id])
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id])
  sale                  Sale?               @relation(fields: [saleId], references: [id])
  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  allocations           PaymentAllocation[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([saleId])
  @@index([expenseId])
  @@index([status])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([type])
  @@index([branchId])
  @@index([isReversal])
  @@index([reversedTransactionId])
}

model PaymentAccount {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  accountType String // Cash, Bank, Mobile Money, Wallet, POS Terminal
  reference   String? // Account number, wallet ID, etc.
  isActive    Boolean             @default(true)
  isSystem    Boolean             @default(false) // System accounts (like Cash) cannot be deleted
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@index([isSystem])
}

model PaymentAllocation {
  id               String         @id @default(cuid())
  paymentId        String
  paymentAccountId String
  amount           Float
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])

  @@index([paymentId])
  @@index([paymentAccountId])
}

model AccountBalance {
  id        String   @id @default(cuid())
  tenantId  String
  account   String
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, account])
}

model PaymentGateway {
  id         String  @id @default(cuid())
  name       String
  isActive   Boolean @default(true)
  configData String
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
}

model EmailLog {
  id              String    @id @default(cuid())
  recipientEmail  String
  recipientName   String
  subject         String
  template        String    @default("custom")
  priority        String    @default("normal")
  status          String    @default("pending")
  errorMessage    String?
  sentBy          String?
  sentByAdmin     String?
  tenantId        String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sentByAdminUser Admin?    @relation("EmailLogAdminSender", fields: [sentByAdmin], references: [id])
  sentByUser      User?     @relation("EmailLogSender", fields: [sentBy], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActivityLog", fields: [adminId], references: [id])
}

model Expense {
  id                      String                    @id @default(cuid())
  description             String
  amount                  Float                     // Total (incl. tax)
  taxAmount               Float?                    @default(0)  // Tax component for reporting
  taxRate                 Float?                    @default(0)  // Tax rate % when recorded
  date                    DateTime
  category                String
  categoryId              String?
  expenseAccountId        String?
  receiptUrl              String?
  submittedById           String
  status                  String
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tenantId                String
  merchant                String?
  sourceAccountId         String?
  paymentMethod           String?
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?
  historicalDate          DateTime?
  isDeleted               Boolean                   @default(false)
  isHistorical            Boolean                   @default(false)
  migrationBatch          String?
  originalReference       String?
  paidAmount              Float?
  paymentReference        String?
  paymentStatus           String                    @default("Fully paid")
  branchId                String?
  employeeId              String?
  supplierId              String?
  purchaseOrderId         String?
  purchaseOrderItemId     String?
  taxTypeId               String?
  // Reversal fields
  isReversal              Boolean                   @default(false)
  reversedTransactionId   String?
  reversalReason          String?
  reversedAt              DateTime?
  reversedById            String?
  branch                  Branch?                   @relation(fields: [branchId], references: [id])
  deletedBy               User?                     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  employee                Employee?                 @relation(fields: [employeeId], references: [id])
  expenseAccount          Account?                  @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  sourceAccount           Account?                  @relation("ExpenseSourceAccount", fields: [sourceAccountId], references: [id])
  submittedBy             User                      @relation(fields: [submittedById], references: [id])
  supplier                Supplier?                 @relation(fields: [supplierId], references: [id])
  expenseCategory         ExpenseCategory?          @relation(fields: [categoryId], references: [id])
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  taxType                 TaxType?                  @relation(fields: [taxTypeId], references: [id])
  purchaseOrder            PurchaseOrder?            @relation(fields: [purchaseOrderId], references: [id])
  expenseAttachments      ExpenseAttachment[]
  payments                Payment[]
  recurringExpenseHistory RecurringExpenseHistory[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([paymentMethod])
  @@index([isDeleted])
  @@index([isHistorical])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isHistorical])
  @@index([paymentStatus])
  @@index([branchId])
  @@index([employeeId])
  @@index([expenseAccountId])
  @@index([isReversal])
  @@index([reversedTransactionId])
  @@index([taxTypeId])
}

model ExpenseAttachment {
