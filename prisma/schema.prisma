  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@index([expiresAt])
}

model BaseUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  baseUnit    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]

  @@map("base_units")
}

model Unit {
  id               String        @id @default(cuid())
  baseUnitId       String
  name             String
  symbol           String        @unique
  conversionToBase Decimal       @db.Decimal(15, 6)
  isBaseUnit       Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  productUnits     ProductUnit[]
  baseUnit         BaseUnit      @relation(fields: [baseUnitId], references: [id], onDelete: Cascade)

  @@map("units")
}

model ProductUnit {
  id              String   @id @default(cuid())
  productId       String
  unitId          String
  isDefault       Boolean  @default(false)
  unitPrice       Decimal  @db.Decimal(10, 2)
  costPrice       Decimal  @db.Decimal(10, 2)
