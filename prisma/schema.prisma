  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@unique([gateway, gatewayReference])
}

/// Versioned SaaS subscription plans — price edits create a new version.
/// planCategory: CORE | MRA_EIS (and future product families).
model PlatformPlanVersion {
  id               String    @id @default(cuid())
  planCode         String
  version          Int
  name             String
  publicName       String?
  description      String?
  planCategory     String    @default("CORE")
  productCode      String?
  currency         String    @default("MWK")
  basePrice        Decimal   @db.Decimal(18, 2)
  billingFrequency String    @default("month")
  userLimit        Int?
  businessLimit    Int?
  featuresJson     Json      @default("[]")
  limitsJson       Json      @default("{}")
  eligibilityJson  Json      @default("{}")
  billingCyclesJson Json     @default("[]")
  presentationJson Json      @default("{}")
  /// DRAFT | PENDING_APPROVAL | PUBLISHED | ACTIVE | SUSPENDED | RETIRED | SUPERSEDED
