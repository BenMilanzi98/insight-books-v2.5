  tenantId       String
  featureCode    String
  ruleVersion    String
  eventType      String
  sourceType     String
  sourceId       String
  sourceEventId  String?
  occurredAt     DateTime
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@unique([tenantId, featureCode, ruleVersion])
  @@index([tenantId, featureCode])
}

/// Phase 9 Wave 2 — append-only adoption state history (never silent overwrite).
model ProductAdoptionStateHistory {
  id                String   @id @default(cuid())
  tenantId          String
  featureCode       String
  state             String
  previousState     String?
  ruleVersion       String
  definitionVersion String
  reasonCode        String?
  evidence          Json?
  observedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([tenantId, featureCode, observedAt])
  @@index([tenantId, featureCode, state])
}

model AnalyticsDailySnapshot {
