/// Phase 12 Wave 2 — append-only amount history (immutable).
model CrmOpportunityAmountHistory {
  id                     String   @id @default(cuid())
  opportunityId          String
  amount                 Decimal  @db.Decimal(18, 2)
  currency               String
  amountBasis            String
  recurringAnnualAmount  Decimal? @db.Decimal(18, 2)
  oneTimeAmount          Decimal? @db.Decimal(18, 2)
