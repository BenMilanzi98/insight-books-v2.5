import { describe, it, expect, vi } from 'vitest';
import {
  emitProductMeaningfulAction,
  emitSalesInvoicePosted,
  emitPosTransactionCompleted,
  emitMraEisTransactionAccepted,
} from '@/lib/admin/productAnalytics';
