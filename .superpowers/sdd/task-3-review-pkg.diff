'use client';

import { Suspense } from 'react';
import { useSearchParams } from 'next/navigation';
import InboundHiringPanel from '@/components/rentals/InboundHiringPanel';

function HiringsHubInner() {
  const searchParams = useSearchParams();
  const tab = searchParams.get('tab') || 'customer';

  if (tab === 'supplier') {
    return <InboundHiringPanel />;
  }

  return (
    <div className="p-8">
      <h1 className="text-2xl font-semibold">Hirings</h1>
      <p className="mt-2 text-gray-600">
        Customer hiring (quantity rentals) — full hub UI coming in Task 4.
      </p>
    </div>
  );
}

export default function HiringsHub() {
  return (
    <Suspense fallback={<div className="p-8 text-sm text-gray-500">Loading…</div>}>
      <HiringsHubInner />
    </Suspense>
  );
}

