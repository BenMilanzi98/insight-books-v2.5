import { describe, it, expect, vi, beforeEach } from 'vitest';
import {
  evaluateClosedWonReadiness,
  createClosedWonConversionHandoff,
  getCommercialMetric,
  getCommercialReport,
  getCommercialOverview,
  applyCommercialReportHonesty,
