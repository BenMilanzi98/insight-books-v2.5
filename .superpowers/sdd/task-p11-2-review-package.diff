+/// Phase 8 Wave 3 ΓÇö renewal workspace; outcome requires AccountSubscription evidence.
+model CsRenewalWorkspace {
+  id                String    @id @default(cuid())
+  tenantId          String
+  periodKey         String
+  status            String    @default("OPEN")
+  outcome           String?
+  outcomeAt         DateTime?
+  outcomeByAdminId  String?
+  subscriptionId    String?
+  evidenceNote      String?
+  notes             String?
+  openedByAdminId   String?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  openedByAdmin     Admin?    @relation("CsRenewalOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
+  outcomeByAdmin    Admin?    @relation("CsRenewalOutcomeBy", fields: [outcomeByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([tenantId, periodKey])
+  @@index([tenantId, status])
+  @@index([outcome])
+  @@index([periodKey])
+}
+
+/// Phase 8 Wave 4 ΓÇö versioned playbook definition (steps JSON ΓåÆ tasks on execute).
+model CsPlaybook {
+  id          String                @id @default(cuid())
+  key         String
+  name        String
+  version     String
+  description String?
+  status      String                @default("ACTIVE")
+  steps       Json
+  createdAt   DateTime              @default(now())
+  updatedAt   DateTime              @updatedAt
+  executions  CsPlaybookExecution[]
+
+  @@unique([key, version])
+  @@index([status, key])
+}
+
+/// Phase 8 Wave 4 ΓÇö playbook run; idempotent per key+version+tenant+case.
+model CsPlaybookExecution {
+  id                String    @id @default(cuid())
+  playbookId        String
+  tenantId          String
+  caseId            String?
+  status            String    @default("RUNNING")
+  playbookVersion   String
+  idempotencyKey    String?   @unique
+  startedByAdminId  String?
+  startedAt         DateTime  @default(now())
+  completedAt       DateTime?
+  payload           Json?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  playbook          CsPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
+  startedByAdmin    Admin?    @relation("CsPlaybookExecutionStartedBy", fields: [startedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([tenantId, status])
+  @@index([playbookId, startedAt])
+  @@index([caseId])
+}
+
+/// Phase 8 Wave 4 ΓÇö success plan (no invented progress %).
+model CsSuccessPlan {
+  id                String          @id @default(cuid())
+  tenantId          String
+  title             String
+  status            String          @default("ACTIVE")
+  summary           String?
+  ownerAdminId      String?
+  createdByAdminId  String?
+  startedAt         DateTime?
+  targetAt          DateTime?
+  createdAt         DateTime        @default(now())
+  updatedAt         DateTime        @updatedAt
+  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  ownerAdmin        Admin?          @relation("CsSuccessPlanOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin    Admin?          @relation("CsSuccessPlanCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  goals             CsSuccessGoal[]
+
+  @@index([tenantId, status])
+  @@index([ownerAdminId, status])
+}
+
+/// Phase 8 Wave 4 ΓÇö success goal under a plan.
+model CsSuccessGoal {
+  id         String        @id @default(cuid())
+  planId     String
+  title      String
+  status     String        @default("OPEN")
+  targetNote String?
+  dueAt      DateTime?
+  sortOrder  Int           @default(0)
+  createdAt  DateTime      @default(now())
+  updatedAt  DateTime      @updatedAt
+  plan       CsSuccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
+
+  @@index([planId, status])
+  @@index([planId, sortOrder])
+}
+
+/// Phase 8 Wave 4 ΓÇö expansion handoff record-only (no CRM opportunity / auto upgrade).
+model CsExpansionHandoff {
+  id                 String   @id @default(cuid())
+  tenantId           String
+  status             String   @default("OPEN")
+  reason             String?
+  notes              String?
+  recommendedAction  String   @default("OTHER")
+  createdByAdminId   String?
+  payload            Json?
+  createdAt          DateTime @default(now())
+  updatedAt          DateTime @updatedAt
+  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  createdByAdmin     Admin?   @relation("CsExpansionHandoffCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([tenantId, status])
+  @@index([recommendedAction])
+  @@index([createdAt])
+}
+
+/// Phase 8 Wave 4 ΓÇö onboarding foundation rows only (empty ΓåÆ NOT_INSTRUMENTED).
+model CsOnboardingRecord {
+  id           String    @id @default(cuid())
+  tenantId     String
+  checklistKey String?
+  status       String?
+  completedAt  DateTime?
+  sourceNote   String?
+  createdAt    DateTime  @default(now())
+  updatedAt    DateTime  @updatedAt
+  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+
+  @@index([tenantId, status])
+  @@index([checklistKey])
+}
+
+/// Phase 8 Wave 4 ΓÇö training foundation rows only (empty ΓåÆ NOT_INSTRUMENTED).
+model CsTrainingRecord {
+  id          String    @id @default(cuid())
+  tenantId    String
+  moduleKey   String?
+  status      String?
+  completedAt DateTime?
+  sourceNote  String?
+  createdAt   DateTime  @default(now())
+  updatedAt   DateTime  @updatedAt
+  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+
+  @@index([tenantId, status])
+  @@index([moduleKey])
+}
+
+/// Phase 8 Wave 4 ΓÇö survey foundation rows only (empty ΓåÆ NOT_INSTRUMENTED; never invent NPS).
+model CsSurveyResponse {
+  id         String    @id @default(cuid())
+  tenantId   String
+  surveyKey  String?
+  status     String?
+  score      Int?
+  completedAt DateTime?
+  sourceNote String?
+  createdAt  DateTime  @default(now())
+  updatedAt  DateTime  @updatedAt
+  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+
+  @@index([tenantId, status])
+  @@index([surveyKey])
+}
+
+/// Phase 10 Wave 1 ΓÇö per-UTC-year sequence for SUP-YYYY-###### (concurrency-safe CAS).
+model SupportTicketNumberSeq {
+  year       Int      @id
+  lastIssued Int      @default(0)
+  updatedAt  DateTime @updatedAt
+}
+
+/// Phase 10 Wave 1 ΓÇö Support ticket (Γëá CsCase Γëá PlatformSupportAccess).
+/// Never store Tenant GL lines, MRA credentials, or payment secrets.
+model SupportTicket {
+  id                 String    @id @default(cuid())
+  ticketNumber       String    @unique
+  tenantId           String
+  portfolioId        String?
+  status             String    @default("NEW")
+  type               String
+  impact             String?
+  urgency            String?
+  priority           String?
+  severity           String?
+  title              String
+  description        String    @db.Text
+  resolutionCategory String?
+  createdByAdminId   String?
+  assigneeAdminId    String?
+  queueCode          String?
+  sourceChannel      String    @default("ADMIN_MANUAL")
+  createdAt          DateTime  @default(now())
+  updatedAt          DateTime  @updatedAt
+  resolvedAt         DateTime?
+  closedAt           DateTime?
+  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  portfolio          CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
+  createdByAdmin     Admin?    @relation("SupportTicketCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  assigneeAdmin      Admin?    @relation("SupportTicketAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
+  statusHistory      SupportTicketStatusHistory[]
+  messages           SupportMessage[]
+  attachments        SupportAttachment[]
+  assignmentHistory  SupportAssignmentHistory[]
+  slaClocks          SupportSlaClock[]
+  handoffs           SupportHandoff[]
+
+  @@index([tenantId, status])
+  @@index([status, createdAt])
+  @@index([assigneeAdminId, status])
+  @@index([queueCode, status])
+  @@index([portfolioId])
+  @@index([sourceChannel])
+}
+
+/// Phase 10 Wave 1 ΓÇö append-only status history (evidence preserved on terminal statuses).
+model SupportTicketStatusHistory {
+  id               String   @id @default(cuid())
+  ticketId         String
+  fromStatus       String?
+  toStatus         String
+  changedByAdminId String?
+  reason           String?
+  at               DateTime @default(now())
+  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  changedByAdmin   Admin?   @relation("SupportTicketStatusChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([ticketId, at])
+  @@index([changedByAdminId])
+  @@index([toStatus, at])
+}
+
+/// Phase 10 Wave 2 ΓÇö ticket messages (PUBLIC / INTERNAL / RESTRICTED). Never expose INTERNAL/RESTRICTED to customers.
+model SupportMessage {
+  id              String   @id @default(cuid())
+  ticketId        String
+  type            String
+  body            String   @db.Text
+  authorAdminId   String?
+  visibility      String?
+  systemEventCode String?
+  createdAt       DateTime @default(now())
+  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  authorAdmin     Admin?   @relation("SupportMessageAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)
+
+  @@index([ticketId, createdAt])
+  @@index([ticketId, type])
+  @@index([authorAdminId])
+}
+
+/// Phase 10 Wave 2 ΓÇö attachment metadata; bytes in private storage/support-attachments/ (not public/uploads).
+model SupportAttachment {
+  id                 String    @id @default(cuid())
+  ticketId           String
+  fileName           String
+  mimeType           String
+  sizeBytes          Int
+  storageKey         String
+  scanState          String    @default("PENDING_SCAN")
+  uploadedByAdminId  String?
+  createdAt          DateTime  @default(now())
+  updatedAt          DateTime  @updatedAt
+  scannedAt          DateTime?
+  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  uploadedByAdmin    Admin?    @relation("SupportAttachmentUploadedBy", fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([storageKey])
+  @@index([ticketId, scanState])
+  @@index([scanState])
+  @@index([uploadedByAdminId])
+}
+
+/// Phase 10 Wave 2 ΓÇö queue catalogue (QUEUE_TEAM_MATRIX). liveStatus stays NOT_FOUND until real owners exist.
+model SupportQueue {
+  id                String   @id @default(cuid())
+  code              String   @unique
+  name              String
+  typicalOwnership  String?
+  liveStatus        String   @default("NOT_FOUND")
+  active            Boolean  @default(true)
+  createdAt         DateTime @default(now())
+  updatedAt         DateTime @updatedAt
+
+  @@index([active])
+}
+
+/// Phase 10 Wave 2 ΓÇö team stub definitions for assignment eligibility.
+model SupportTeam {
+  id         String   @id @default(cuid())
+  code       String   @unique
+  name       String
+  queueCodes String[] @default([])
+  active     Boolean  @default(true)
+  createdAt  DateTime @default(now())
+  updatedAt  DateTime @updatedAt
+  memberships SupportTeamMembership[]
+
+  @@index([active])
+}
+
+/// Phase 10 Wave 2 ΓÇö optional team membership (stub; empty ΓçÆ eligibility not locked out).
+model SupportTeamMembership {
+  id        String   @id @default(cuid())
+  teamCode  String
+  adminId   String
+  createdAt DateTime @default(now())
+  team      SupportTeam @relation(fields: [teamCode], references: [code], onDelete: Cascade)
+  admin     Admin       @relation(fields: [adminId], references: [id], onDelete: Cascade)
+
+  @@unique([teamCode, adminId])
+  @@index([adminId])
+}
+
+/// Phase 10 Wave 2 ΓÇö append-only assignment / queue change history.
+model SupportAssignmentHistory {
+  id                   String   @id @default(cuid())
+  ticketId             String
+  fromAssigneeAdminId  String?
+  toAssigneeAdminId    String?
+  fromQueueCode        String?
+  toQueueCode          String?
+  changedByAdminId     String?
+  reason               String?
+  at                   DateTime @default(now())
+  ticket               SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  changedByAdmin       Admin?   @relation("SupportAssignmentChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([ticketId, at])
+  @@index([changedByAdminId])
+  @@index([toAssigneeAdminId])
+}
+
+/// Phase 10 Wave 3 ΓÇö versioned SLA policy (pinned onto clock rows).
+model SupportSlaPolicy {
+  id                            String   @id @default(cuid())
+  versionId                     String   @unique
+  name                          String
+  ackCountsAsFirstResponse      Boolean  @default(false)
+  resolutionStartsOn            String   @default("CREATE")
+  stopResolutionOnClosed        Boolean  @default(true)
+  pauseOnWaitingForCustomer     Boolean  @default(true)
+  pauseOnWaitingForInternalTeam Boolean  @default(true)
+  pauseOnWaitingForVendor       Boolean  @default(true)
+  /// JSON targets map: { FIRST_RESPONSE: { businessMs }, RESOLUTION: { businessMs }, ... }
+  targetsJson                   String   @db.Text
+  active                        Boolean  @default(true)
+  createdByAdminId              String?
+  createdAt                     DateTime @default(now())
+  updatedAt                     DateTime @updatedAt
+  createdByAdmin                Admin?   @relation("SupportSlaPolicyCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([active])
+}
+
+/// Phase 10 Wave 3 ΓÇö versioned business calendar (pinned onto clock rows).
+model SupportSlaCalendar {
+  id               String   @id @default(cuid())
+  versionId        String   @unique
+  name             String
+  timezone         String
+  /// JSON: workdays[], workingHours {start,end}, holidays[]
+  definitionJson   String   @db.Text
+  active           Boolean  @default(true)
+  createdByAdminId String?
+  createdAt        DateTime @default(now())
+  updatedAt        DateTime @updatedAt
+  createdByAdmin   Admin?   @relation("SupportSlaCalendarCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([active])
+}
+
+/// Phase 10 Wave 3 ΓÇö SLA clock instance; policyVersion + calendarVersion pinned at start.
+model SupportSlaClock {
+  id               String    @id @default(cuid())
+  ticketId         String
+  clockType        String
+  state            String    @default("RUNNING")
+  policyVersion    String
+  calendarVersion  String
+  targetBusinessMs Int
+  startedAt        DateTime  @default(now())
+  dueAt            DateTime?
+  pausedAt         DateTime?
+  pausedMs         Int       @default(0)
+  stoppedAt        DateTime?
+  breachedAt       DateTime?
+  createdAt        DateTime  @default(now())
+  updatedAt        DateTime  @updatedAt
+  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  events           SupportSlaEvent[]
+
+  @@index([ticketId, clockType])
+  @@index([ticketId, state])
+  @@index([state, dueAt])
+  @@index([policyVersion])
+  @@index([calendarVersion])
+}
+
+/// Phase 10 Wave 3 ΓÇö append-only SLA events (breach facts immutable).
+model SupportSlaEvent {
+  id        String   @id @default(cuid())
+  clockId   String
+  eventType String
+  at        DateTime @default(now())
+  metaJson  String?
+  clock     SupportSlaClock @relation(fields: [clockId], references: [id], onDelete: Cascade)
+
+  @@index([clockId, at])
+  @@index([clockId, eventType])
+  @@index([eventType, at])
+}
+
+/// Phase 10 Wave 4 ΓÇö link-only handoff (Γëá open/close CsCase; Γëá billing/MRA/GL mutation).
+model SupportHandoff {
+  id               String   @id @default(cuid())
+  ticketId         String
+  tenantId         String
+  /// CS | PRODUCT | FINANCE | BILLING | MRA
+  targetType       String
+  status           String   @default("OPEN")
+  summary          String?
+  /// Optional link id only (csCaseId / invoiceId / subscriptionId / fiscalTransmissionId).
+  targetRefId      String?
+  /// Optional Phase 9 catalogue feature code (PRODUCT target).
+  featureCode      String?
+  /// Allowed link payload only ΓÇö never credentials, raw MRA, or payment secrets.
+  payload          Json?
+  createdByAdminId String?
+  createdAt        DateTime @default(now())
+  updatedAt        DateTime @updatedAt
+  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
+  createdByAdmin   Admin?   @relation("SupportHandoffCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([ticketId, createdAt])
+  @@index([tenantId, targetType])
+  @@index([targetType, status])
+  @@index([createdByAdminId])
+}
+
+/// Phase 10 Wave 4 ΓÇö optional reconciliation run audit (never invents false zeroes).
+model SupportReconciliationRun {
+  id             String   @id @default(cuid())
+  status         String
+  summaryJson    String   @db.Text
+  runByAdminId   String?
+  createdAt      DateTime @default(now())
+  runByAdmin     Admin?   @relation("SupportReconciliationRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([status, createdAt])
+  @@index([runByAdminId])
+}
+
+/// Phase 10 Wave 4 ΓÇö export download audit (permission rechecked at download time).
+model SupportExportAudit {
+  id        String   @id @default(cuid())
+  adminId   String?
+  dataset   String
+  format    String
+  rowCount  Int?
+  createdAt DateTime @default(now())
+  admin     Admin?   @relation("SupportExportAuditBy", fields: [adminId], references: [id], onDelete: SetNull)
+
+  @@index([adminId, createdAt])
+  @@index([dataset, createdAt])
+}
+
+/// Phase 11 Wave 1 ΓÇö per-prefix + UTC-year sequence for LEAD|ACC|CON-YYYY-###### (concurrency-safe CAS).
+model CrmNumberSeq {
+  prefix     String
+  year       Int
+  lastIssued Int      @default(0)
+  updatedAt  DateTime @updatedAt
+
+  @@id([prefix, year])
+}
+
+/// Phase 11 Wave 1 ΓÇö CRM Account (Γëá canonical Customer; optional tenant/customer link only).
+/// Never store Tenant GL, payment secrets, or MRA credentials.
+model CrmAccount {
+  id            String    @id @default(cuid())
+  accountNumber String    @unique
+  type          String    @default("PROSPECT")
+  displayName   String
+  status        String    @default("ACTIVE")
+  country       String?
+  region        String?
+  ownerAdminId  String?
+  /// Optional link to Customer identity (no auto-link; no billing copy).
+  customerId    String?
+  tenantId      String?
+  createdAt     DateTime  @default(now())
+  updatedAt     DateTime  @updatedAt
+  ownerAdmin    Admin?    @relation("CrmAccountOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
+  contacts      CrmContact[]
+  leads         CrmLead[]
+
+  @@index([status, createdAt])
+  @@index([ownerAdminId])
+  @@index([tenantId])
+  @@index([customerId])
+  @@index([type, status])
+}
+
+/// Phase 11 Wave 1 ΓÇö CRM Contact (Γëá Platform User). No national ID / bank / passwords.
+model CrmContact {
+  id            String    @id @default(cuid())
+  contactNumber String    @unique
+  firstName     String
+  lastName      String
+  email         String?
+  phone         String?
+  role          String?
+  accountId     String?
+  ownerAdminId  String?
+  createdAt     DateTime  @default(now())
+  updatedAt     DateTime  @updatedAt
+  account       CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
+  ownerAdmin    Admin?    @relation("CrmContactOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  leads         CrmLead[]
+
+  @@index([accountId])
+  @@index([ownerAdminId])
+  @@index([email])
+  @@index([createdAt])
+}
+
+/// Phase 11 Wave 1 ΓÇö CRM Lead (Γëá Opportunity Γëá SupportTicket Γëá CsCase).
+model CrmLead {
+  id                     String    @id @default(cuid())
+  leadNumber             String    @unique
+  type                   String
+  personOrOrganisation   String
+  accountId              String?
+  contactId              String?
+  source                 String
+  channel                String    @default("ADMIN_MANUAL")
+  sourceIdempotencyKey   String?   @unique
+  status                 String    @default("NEW")
+  title                  String
+  summary                String?   @db.Text
+  ownerAdminId           String?
+  createdByAdminId       String?
+  disqualificationReason String?
+  createdAt              DateTime  @default(now())
+  updatedAt              DateTime  @updatedAt
+  account                CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
+  contact                CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
+  ownerAdmin             Admin?    @relation("CrmLeadOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin         Admin?    @relation("CrmLeadCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  statusHistory          CrmLeadStatusHistory[]
+  captureRecords         CrmCaptureRecord[]
+  duplicateAsLead        CrmDuplicateCandidate[] @relation("CrmDuplicateLead")
+  duplicateAsCandidate   CrmDuplicateCandidate[] @relation("CrmDuplicateCandidateLead")
+
+  @@index([status, createdAt])
+  @@index([ownerAdminId, status])
+  @@index([accountId])
+  @@index([contactId])
+  @@index([source, channel])
+  @@index([type, status])
+}
+
+/// Phase 11 Wave 1 ΓÇö append-only Lead status history.
+model CrmLeadStatusHistory {
+  id               String   @id @default(cuid())
+  leadId           String
+  fromStatus       String?
+  toStatus         String
+  changedByAdminId String?
+  reason           String?
+  at               DateTime @default(now())
+  lead             CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
+  changedByAdmin   Admin?   @relation("CrmLeadStatusChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([leadId, at])
+  @@index([changedByAdminId])
+  @@index([toStatus, at])
+}
+
+/// Phase 11 Wave 2 ΓÇö capture identity + consent snapshot (source of email/phone for duplicates).
+model CrmCaptureRecord {
+  id                   String   @id @default(cuid())
+  leadId               String
+  sourceCode           String
+  channel              String
+  sourceIdempotencyKey String   @unique
+  emailNormalized      String?
+  phoneNormalized      String?
+  handoffRefType       String?
+  handoffRefId         String?
+  businessName         String?
+  contactName          String?
+  payload              Json?
+  consentStatus        String   @default("UNKNOWN")
+  consentPurposes      Json?
+  createdAt            DateTime @default(now())
+  lead                 CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
+
+  @@index([leadId])
+  @@index([emailNormalized])
+  @@index([phoneNormalized])
+  @@index([handoffRefType, handoffRefId])
+  @@index([sourceCode, createdAt])
+}
+
+/// Phase 11 Wave 2 ΓÇö duplicate candidates only (no auto-merge).
+model CrmDuplicateCandidate {
+  id                 String    @id @default(cuid())
+  leadId             String
+  candidateLeadId    String
+  matchType          String
+  matchValue         String?
+  status             String    @default("NEW")
+  confidence         String?
+  reviewedByAdminId  String?
+  reviewedAt         DateTime?
+  decisionReason     String?
+  createdAt          DateTime  @default(now())
+  updatedAt          DateTime  @updatedAt
+  lead               CrmLead   @relation("CrmDuplicateLead", fields: [leadId], references: [id], onDelete: Cascade)
+  candidateLead      CrmLead   @relation("CrmDuplicateCandidateLead", fields: [candidateLeadId], references: [id], onDelete: Cascade)
+  reviewedByAdmin    Admin?    @relation("CrmDuplicateReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([leadId, candidateLeadId, matchType])
+  @@index([status, createdAt])
+  @@index([leadId])
+  @@index([candidateLeadId])
+  @@index([reviewedByAdminId])
+}
