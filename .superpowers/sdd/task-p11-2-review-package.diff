+/// Phase 8 Wave 3 ΓÇö CS case (not a support ticket; not signal ACK substitute).
+/// Status: OPEN | IN_PROGRESS | RESOLVED | CLOSED
+/// triggerType: SIGNAL | HEALTH | MANUAL
+model CsCase {
+  id                String           @id @default(cuid())
+  tenantId          String
+  portfolioId       String?
+  status            String           @default("OPEN")
+  priority          String           @default("MEDIUM")
+  severity          String?
+  title             String
+  summary           String?
+  triggerType       String
+  triggerCode       String?
+  definitionVersion String?
+  idempotencyKey    String
+  signalId          String?
+  snapshotId        String?
+  ownerAdminId      String?
+  openedByAdminId   String?
+  openedAt          DateTime         @default(now())
+  closedAt          DateTime?
+  resolvedAt        DateTime?
+  payload           Json?
+  createdAt         DateTime         @default(now())
+  updatedAt         DateTime         @updatedAt
+  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  portfolio         CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
+  ownerAdmin        Admin?           @relation("CsCaseOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  openedByAdmin     Admin?           @relation("CsCaseOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
+  tasks             CsTask[]
+  interventions     CsIntervention[]
+  playbookExecutions CsPlaybookExecution[]
+
+  // Open-only uniqueness (OPEN/IN_PROGRESS) is enforced by partial unique index
+  // CsCase_open_idempotencyKey_key in scripts/sql/customer-success-phase08.sql ΓÇö
+  // closed/resolved cases may reuse the same key so re-triggers can open a new case.
+  @@index([idempotencyKey])
+  @@index([tenantId, status])
+  @@index([status, openedAt])
+  @@index([triggerType, triggerCode])
+  @@index([ownerAdminId, status])
+  @@index([portfolioId])
+}
+
+/// Phase 8 Wave 3 ΓÇö CS task (assignee = System Admin id).
+model CsTask {
+  id                String    @id @default(cuid())
