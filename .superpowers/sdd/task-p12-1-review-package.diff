+
+describe('CRM Opportunity stage transitions', () => {
+  async function seedOpenOpportunity(prisma, stageCode = CRM_PIPELINE_STAGE.OPPORTUNITY_IDENTIFIED) {
+    const created = await createOpportunityFromHandoff(prisma, {
+      admin: makeAdmin(),
