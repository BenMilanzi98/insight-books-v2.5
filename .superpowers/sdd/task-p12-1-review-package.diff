+  CRM_OPPORTUNITY_NUMBER_RE,
+  CRM_NUMBER_PREFIX,
+} from './numbering.js';
+
+export { createOpportunityFromHandoff } from './create.js';
+
+export { convertLeadAfterOpportunityCreate } from './leads.js';
+
+export { getOpportunity } from './get.js';
+
+export { listOpportunities } from './list.js';
