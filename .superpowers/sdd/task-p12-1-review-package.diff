+  createdByAdminId String?
+  completedAt      DateTime?
+  createdAt        DateTime  @default(now())
+  updatedAt        DateTime  @updatedAt
+  assigneeAdmin    Admin?    @relation("CrmTaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin   Admin?    @relation("CrmTaskCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([subjectType, subjectId, status])
+  @@index([assigneeAdminId, status])
+  @@index([status, dueAt])
+  @@index([createdByAdminId])
+}
+
+/// Phase 11 Wave 4 ΓÇö controlled merge request (SoD: requester Γëá approver).
+model CrmMergeRequest {
+  id                   String    @id @default(cuid())
+  entityType           String    @default("LEAD")
+  survivorId           String
+  loserId              String
+  status               String    @default("PENDING")
+  requestedByAdminId   String?
+  approvedByAdminId    String?
+  executedByAdminId    String?
+  duplicateCandidateId String?
+  reason               String?
+  evidenceJson         Json?
+  requestedAt          DateTime  @default(now())
+  approvedAt           DateTime?
+  executedAt           DateTime?
+  createdAt            DateTime  @default(now())
+  updatedAt            DateTime  @updatedAt
+  requestedByAdmin     Admin?    @relation("CrmMergeRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
+  approvedByAdmin      Admin?    @relation("CrmMergeApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
+  executedByAdmin      Admin?    @relation("CrmMergeExecutedBy", fields: [executedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([status, createdAt])
+  @@index([survivorId])
+  @@index([loserId])
+  @@index([entityType, status])
+  @@index([requestedByAdminId])
+  @@index([approvedByAdminId])
+}
+
+/// Phase 11 Wave 4 ΓÇö light CRM reconciliation run audit.
+model CrmReconciliationRun {
+  id          String   @id @default(cuid())
+  status      String
+  summaryJson Json?
+  runByAdminId String?
+  at          DateTime @default(now())
+  runByAdmin  Admin?   @relation("CrmReconciliationRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([at])
+  @@index([status, at])
+  @@index([runByAdminId])
+}
+
+/// Phase 11 Wave 4 ΓÇö CRM export audit (JSON/CSV foundation).
+model CrmExportAudit {
+  id               String   @id @default(cuid())
+  dataset          String
+  format           String
+  rowCount         Int      @default(0)
+  exportedByAdminId String?
+  at               DateTime @default(now())
+  exportedByAdmin  Admin?   @relation("CrmExportAuditBy", fields: [exportedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([at])
+  @@index([dataset, at])
+  @@index([exportedByAdminId])
+}
+
+/// Phase 12 Wave 1 ΓÇö versioned Sales Pipeline catalogue (Γëá analytics-pipeline).
+model CrmPipeline {
+  id        String   @id @default(cuid())
+  code      String   @unique
+  name      String
+  status    String   @default("ACTIVE")
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  versions  CrmPipelineVersion[]
+
+  @@index([status])
+}
+
+/// Phase 12 Wave 1 ΓÇö Pipeline version (ACTIVE NEW_BUSINESS v1 first).
+model CrmPipelineVersion {
+  id          String   @id @default(cuid())
+  pipelineId  String
+  versionId   String
+  version     String
+  status      String   @default("ACTIVE")
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
+  stages      CrmPipelineStage[]
+
+  @@unique([pipelineId, versionId])
+  @@index([pipelineId, status])
+  @@index([status])
+}
+
+/// Phase 12 Wave 1 ΓÇö Pipeline stage defs (entry/exit + optional defaultProbability stub).
+model CrmPipelineStage {
+  id                String   @id @default(cuid())
+  pipelineVersionId String
+  code              String
+  name              String
+  sortOrder         Int
+  terminal          Boolean  @default(false)
+  /// Wave 2 consumes; Wave 1 stub OK
+  defaultProbability Int?
+  entryCriteria     Json?
+  exitCriteria      Json?
+  createdAt         DateTime @default(now())
+  updatedAt         DateTime @updatedAt
+  pipelineVersion   CrmPipelineVersion @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade)
+
+  @@unique([pipelineVersionId, code])
+  @@index([pipelineVersionId, sortOrder])
+}
+
+/// Phase 12 Wave 1 ΓÇö CrmOpportunity (Γëá Lead Γëá Customer Γëá Subscription Γëá Invoice).
+/// Never invent amount / probability / closeDate in Wave 1.
+model CrmOpportunity {
+  id                     String   @id @default(cuid())
+  opportunityNumber      String   @unique
+  pipelineCode           String   @default("NEW_BUSINESS")
+  pipelineVersionId      String?
+  stageCode              String
+  status                 String   @default("OPEN")
+  leadId                 String?
+  accountId              String?
+  contactId              String?
+  title                  String
+  ownerAdminId           String?
+  createdByAdminId       String?
+  handoffIdempotencyKey  String?  @unique
+  /// Optimistic locking for stage transitions
+  version                Int      @default(1)
+  createdAt              DateTime @default(now())
+  updatedAt              DateTime @updatedAt
+  ownerAdmin             Admin?   @relation("CrmOpportunityOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin         Admin?   @relation("CrmOpportunityCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  stageHistory           CrmOpportunityStageHistory[]
+
+  @@index([stageCode, createdAt])
+  @@index([status, createdAt])
+  @@index([leadId])
+  @@index([accountId])
+  @@index([contactId])
+  @@index([ownerAdminId, status])
+  @@index([pipelineCode, stageCode])
+}
+
+/// Phase 12 Wave 1 ΓÇö append-only Opportunity stage history (immutable).
+model CrmOpportunityStageHistory {
+  id                 String   @id @default(cuid())
+  opportunityId      String
+  fromStageCode      String?
+  toStageCode        String
+  changedByAdminId   String?
+  reason             String?
+  evidenceReferences Json?
+  idempotencyKey     String?
+  at                 DateTime @default(now())
+  opportunity        CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin     Admin?   @relation("CrmOpportunityStageChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([opportunityId, idempotencyKey])
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+  @@index([toStageCode, at])
+}
