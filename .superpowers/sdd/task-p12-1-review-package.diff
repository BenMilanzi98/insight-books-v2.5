+    const result = await evaluateOpportunityReadiness(prisma, {
+      admin,
+      leadId: body.leadId,
+      allowUnknownProductInterest: body.allowUnknownProductInterest === true,
+      accountContactExceptionReason: body.accountContactExceptionReason || null,
