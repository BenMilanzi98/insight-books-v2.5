+
+/// Phase 8 Wave 1 ΓÇö immutable health snapshot (rebuild creates a new row).
+model CustomerHealthSnapshot {
+  id                 String   @id @default(cuid())
+  tenantId           String
+  definitionVersion  String
+  score              Float?
+  band               String
+  confidence         String
+  asOf               DateTime
+  payload            Json?
