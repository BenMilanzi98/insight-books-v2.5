+/// Phase 7 Wave 3 ΓÇö CS portfolio (not AdminTenantAccess / Tenant.ownerUserId)
+model CustomerPortfolio {
+  id           String              @id @default(cuid())
+  code         String              @unique
+  name         String
+  description  String?
+  type         String              @default("CUSTOMER_SUCCESS")
+  status       String              @default("ACTIVE")
