+          leadNumber: 'LEAD-2026-000001',
+          status: 'OPPORTUNITY_READY',
+          accountId: 'acc-1',
+          contactId: 'con-1',
+        },
+      ],
+    });
+    const opp = await seedOpenOpportunity(prisma);
