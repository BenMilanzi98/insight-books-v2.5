+
+/// Phase 7 Wave 4 ΓÇö deterministic customer signals (verified sources only).
+/// Status: NEW | ACKNOWLEDGED | RESOLVED_BY_SOURCE | DISMISSED
+/// Ephemeral evaluation is used when this table/client is unavailable.
+model CustomerSignal {
