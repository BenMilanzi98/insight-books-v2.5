+/**
+ * Lead ΓåÆ CONVERTED_TO_OPPORTUNITY ΓÇö only from Opportunity create success path.
+ */
+
+import { CRM_LEAD_STATUS } from '../catalogue.js';
+import { transitionLeadStatus } from '../leads.js';
+
+/**
+ * Convert Lead after successful Opportunity create.
+ * Uses state machine with fromOpportunityCreate gate.
+ *
+ * @param {import('@prisma/client').PrismaClient} prisma
+ * @param {{
+ *   admin: object,
+ *   leadId: string,
+ *   opportunityId: string,
+ *   opportunityNumber?: string,
+ *   now?: Date,
+ * }} args
+ */
+export async function convertLeadAfterOpportunityCreate(prisma, args = {}) {
+  const leadId = args.leadId ? String(args.leadId).trim() : '';
+  if (!leadId) return { ok: false, error: 'leadId_required' };
+
+  return transitionLeadStatus(prisma, {
+    admin: args.admin,
+    leadId,
+    toStatus: CRM_LEAD_STATUS.CONVERTED_TO_OPPORTUNITY,
+    reason: `opportunity_create:${args.opportunityNumber || args.opportunityId || ''}`,
+    fromOpportunityCreate: true,
+    now: args.now,
+  });
+}
