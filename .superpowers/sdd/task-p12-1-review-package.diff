+
+/// Phase 8 Wave 3 ΓÇö CS case (not a support ticket; not signal ACK substitute).
+/// Status: OPEN | IN_PROGRESS | RESOLVED | CLOSED
+/// triggerType: SIGNAL | HEALTH | MANUAL
+model CsCase {
+  id                String           @id @default(cuid())
+  tenantId          String
+  portfolioId       String?
+  status            String           @default("OPEN")
+  priority          String           @default("MEDIUM")
+  severity          String?
+  title             String
+  summary           String?
+  triggerType       String
+  triggerCode       String?
+  definitionVersion String?
+  idempotencyKey    String
+  signalId          String?
+  snapshotId        String?
+  ownerAdminId      String?
+  openedByAdminId   String?
+  openedAt          DateTime         @default(now())
+  closedAt          DateTime?
+  resolvedAt        DateTime?
+  payload           Json?
+  createdAt         DateTime         @default(now())
+  updatedAt         DateTime         @updatedAt
+  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  portfolio         CustomerPortfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
+  ownerAdmin        Admin?           @relation("CsCaseOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  openedByAdmin     Admin?           @relation("CsCaseOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
+  tasks             CsTask[]
+  interventions     CsIntervention[]
+  playbookExecutions CsPlaybookExecution[]
+
+  // Open-only uniqueness (OPEN/IN_PROGRESS) is enforced by partial unique index
+  // CsCase_open_idempotencyKey_key in scripts/sql/customer-success-phase08.sql ΓÇö
+  // closed/resolved cases may reuse the same key so re-triggers can open a new case.
+  @@index([idempotencyKey])
+  @@index([tenantId, status])
+  @@index([status, openedAt])
+  @@index([triggerType, triggerCode])
+  @@index([ownerAdminId, status])
+  @@index([portfolioId])
+}
+
+/// Phase 8 Wave 3 ΓÇö CS task (assignee = System Admin id).
+model CsTask {
+  id                String    @id @default(cuid())
+  caseId            String?
+  tenantId          String
+  title             String
+  status            String    @default("OPEN")
+  assigneeAdminId   String?
+  dueAt             DateTime?
+  stepId            String?
+  executionId       String?
+  idempotencyKey    String?
+  notes             String?
+  createdByAdminId  String?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  assigneeAdmin     Admin?    @relation("CsTaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin    Admin?    @relation("CsTaskCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([idempotencyKey])
+  @@index([tenantId, status])
+  @@index([caseId, status])
+  @@index([assigneeAdminId, status])
+  @@index([executionId, stepId])
+}
+
+/// Phase 8 Wave 3 ΓÇö CS intervention log (not a support ticket).
+model CsIntervention {
+  id                  String   @id @default(cuid())
+  caseId              String?
+  tenantId            String
+  type                String
+  notes               String?
+  channel             String?
+  performedByAdminId  String?
+  performedAt         DateTime @default(now())
+  payload             Json?
+  createdAt           DateTime @default(now())
+  case                CsCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
+  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  performedByAdmin    Admin?   @relation("CsInterventionPerformedBy", fields: [performedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([tenantId, performedAt])
+  @@index([caseId, performedAt])
+  @@index([type])
+}
+
+/// Phase 8 Wave 3 ΓÇö renewal workspace; outcome requires AccountSubscription evidence.
+model CsRenewalWorkspace {
+  id                String    @id @default(cuid())
+  tenantId          String
+  periodKey         String
+  status            String    @default("OPEN")
+  outcome           String?
+  outcomeAt         DateTime?
+  outcomeByAdminId  String?
+  subscriptionId    String?
+  evidenceNote      String?
+  notes             String?
+  openedByAdminId   String?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  openedByAdmin     Admin?    @relation("CsRenewalOpenedBy", fields: [openedByAdminId], references: [id], onDelete: SetNull)
+  outcomeByAdmin    Admin?    @relation("CsRenewalOutcomeBy", fields: [outcomeByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([tenantId, periodKey])
+  @@index([tenantId, status])
+  @@index([outcome])
+  @@index([periodKey])
+}
+
+/// Phase 8 Wave 4 ΓÇö versioned playbook definition (steps JSON ΓåÆ tasks on execute).
+model CsPlaybook {
+  id          String                @id @default(cuid())
+  key         String
+  name        String
+  version     String
+  description String?
+  status      String                @default("ACTIVE")
+  steps       Json
+  createdAt   DateTime              @default(now())
+  updatedAt   DateTime              @updatedAt
+  executions  CsPlaybookExecution[]
+
+  @@unique([key, version])
+  @@index([status, key])
+}
+
+/// Phase 8 Wave 4 ΓÇö playbook run; idempotent per key+version+tenant+case.
+model CsPlaybookExecution {
+  id                String    @id @default(cuid())
+  playbookId        String
+  tenantId          String
+  caseId            String?
+  status            String    @default("RUNNING")
+  playbookVersion   String
+  idempotencyKey    String?   @unique
+  startedByAdminId  String?
+  startedAt         DateTime  @default(now())
+  completedAt       DateTime?
+  payload           Json?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  playbook          CsPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
+  startedByAdmin    Admin?    @relation("CsPlaybookExecutionStartedBy", fields: [startedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([tenantId, status])
+  @@index([playbookId, startedAt])
+  @@index([caseId])
+}
+
+/// Phase 8 Wave 4 ΓÇö success plan (no invented progress %).
+model CsSuccessPlan {
+  id                String          @id @default(cuid())
+  tenantId          String
+  title             String
+  status            String          @default("ACTIVE")
+  summary           String?
+  ownerAdminId      String?
+  createdByAdminId  String?
+  startedAt         DateTime?
+  targetAt          DateTime?
+  createdAt         DateTime        @default(now())
+  updatedAt         DateTime        @updatedAt
+  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  ownerAdmin        Admin?          @relation("CsSuccessPlanOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin    Admin?          @relation("CsSuccessPlanCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  goals             CsSuccessGoal[]
+
+  @@index([tenantId, status])
+  @@index([ownerAdminId, status])
+}
+
+/// Phase 8 Wave 4 ΓÇö success goal under a plan.
+model CsSuccessGoal {
+  id         String        @id @default(cuid())
+  planId     String
+  title      String
+  status     String        @default("OPEN")
+  targetNote String?
+  dueAt      DateTime?
+  sortOrder  Int           @default(0)
+  createdAt  DateTime      @default(now())
+  updatedAt  DateTime      @updatedAt
+  plan       CsSuccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
+
+  @@index([planId, status])
+  @@index([planId, sortOrder])
