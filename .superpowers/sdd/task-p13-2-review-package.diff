+
+/// Phase 8 Wave 4 ΓÇö versioned playbook definition (steps JSON ΓåÆ tasks on execute).
+model CsPlaybook {
+  id          String                @id @default(cuid())
+  key         String
+  name        String
+  version     String
+  description String?
+  status      String                @default("ACTIVE")
+  steps       Json
