+  runByAdminId String?
+  at          DateTime @default(now())
+  runByAdmin  Admin?   @relation("CrmReconciliationRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([at])
+  @@index([status, at])
+  @@index([runByAdminId])
+}
+
+/// Phase 11 Wave 4 ΓÇö CRM export audit (JSON/CSV foundation).
+model CrmExportAudit {
+  id               String   @id @default(cuid())
+  dataset          String
+  format           String
+  rowCount         Int      @default(0)
+  exportedByAdminId String?
+  at               DateTime @default(now())
+  exportedByAdmin  Admin?   @relation("CrmExportAuditBy", fields: [exportedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([at])
+  @@index([dataset, at])
+  @@index([exportedByAdminId])
+}
+
+/// Phase 12 Wave 1 ΓÇö versioned Sales Pipeline catalogue (Γëá analytics-pipeline).
+model CrmPipeline {
+  id        String   @id @default(cuid())
+  code      String   @unique
+  name      String
+  status    String   @default("ACTIVE")
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  versions  CrmPipelineVersion[]
+
+  @@index([status])
+}
+
+/// Phase 12 Wave 1 ΓÇö Pipeline version (ACTIVE NEW_BUSINESS v1 first).
+model CrmPipelineVersion {
+  id          String   @id @default(cuid())
+  pipelineId  String
+  versionId   String
+  version     String
+  status      String   @default("ACTIVE")
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
+  stages      CrmPipelineStage[]
+
+  @@unique([pipelineId, versionId])
+  @@index([pipelineId, status])
+  @@index([status])
+}
+
+/// Phase 12 Wave 1 ΓÇö Pipeline stage defs (entry/exit + optional defaultProbability stub).
+model CrmPipelineStage {
+  id                String   @id @default(cuid())
+  pipelineVersionId String
+  code              String
+  name              String
+  sortOrder         Int
+  terminal          Boolean  @default(false)
+  /// Wave 2 consumes; Wave 1 stub OK
+  defaultProbability Int?
+  entryCriteria     Json?
+  exitCriteria      Json?
+  createdAt         DateTime @default(now())
+  updatedAt         DateTime @updatedAt
+  pipelineVersion   CrmPipelineVersion @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade)
+
+  @@unique([pipelineVersionId, code])
+  @@index([pipelineVersionId, sortOrder])
+}
+
+/// Phase 12 Wave 1ΓÇô2 ΓÇö CrmOpportunity (Γëá Lead Γëá Customer Γëá Subscription Γëá Invoice).
+/// Wave 2 adds commercial / probability / close-date; never invent when unset.
+model CrmOpportunity {
+  id                     String   @id @default(cuid())
+  opportunityNumber      String   @unique
+  pipelineCode           String   @default("NEW_BUSINESS")
+  pipelineVersionId      String?
+  stageCode              String
+  status                 String   @default("OPEN")
+  leadId                 String?
+  accountId              String?
+  contactId              String?
+  title                  String
+  ownerAdminId           String?
+  createdByAdminId       String?
+  handoffIdempotencyKey  String?  @unique
+  /// Optimistic locking for stage transitions
+  version                Int      @default(1)
+  /// Wave 2 ΓÇö non-binding commercial estimate
+  amount                 Decimal? @db.Decimal(18, 2)
+  currency               String?
+  amountBasis            String?
+  recurringAnnualAmount  Decimal? @db.Decimal(18, 2)
+  oneTimeAmount          Decimal? @db.Decimal(18, 2)
+  /// Wave 2 ΓÇö explainable probability (not ML / not Revenue certainty)
+  probability            Int?
+  probabilitySource      String?
+  probabilityConfidence  String?
+  probabilityOverrideReason String?
+  /// Wave 2 ΓÇö expected close with provenance
+  expectedCloseDate      DateTime?
+  closeDateSource        String?
+  closeDateConfidence    String?
+  /// Wave 3 ΓÇö win/loss close (never provisions Tenant/Subscription/Invoice)
+  winReason              String?
+  lossReason             String?
+  decisionDate           DateTime?
+  closeEvidence          Json?
+  closedAt               DateTime?
+  closedByAdminId        String?
+  closeApprovalStatus    String?
+  reopenReason           String?
+  reopenedAt             DateTime?
+  reopenedByAdminId      String?
+  /// Wave 4 ΓÇö audited import idempotency (distinct from handoff key)
+  importIdempotencyKey   String?  @unique
+  /// Wave 4 ΓÇö controlled merge loser pointer
+  mergedIntoOpportunityId String?
+  createdAt              DateTime @default(now())
+  updatedAt              DateTime @updatedAt
+  ownerAdmin             Admin?   @relation("CrmOpportunityOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin         Admin?   @relation("CrmOpportunityCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  closedByAdmin          Admin?   @relation("CrmOpportunityClosedBy", fields: [closedByAdminId], references: [id], onDelete: SetNull)
+  reopenedByAdmin        Admin?   @relation("CrmOpportunityReopenedBy", fields: [reopenedByAdminId], references: [id], onDelete: SetNull)
+  stageHistory           CrmOpportunityStageHistory[]
+  contactRoles           CrmOpportunityContactRole[]
+  contactRoleHistory     CrmOpportunityContactRoleHistory[]
+  products               CrmOpportunityProduct[]
+  amountHistory          CrmOpportunityAmountHistory[]
+  probabilityHistory     CrmOpportunityProbabilityHistory[]
+  closeDateHistory       CrmOpportunityCloseDateHistory[]
+  risks                  CrmOpportunityRisk[]
+  duplicateCandidatesAsPrimary CrmOpportunityDuplicateCandidate[] @relation("CrmOppDupPrimary")
+  duplicateCandidatesAsPeer    CrmOpportunityDuplicateCandidate[] @relation("CrmOppDupPeer")
+
+  @@index([stageCode, createdAt])
+  @@index([status, createdAt])
+  @@index([leadId])
+  @@index([accountId])
+  @@index([contactId])
+  @@index([ownerAdminId, status])
+  @@index([pipelineCode, stageCode])
+  @@index([currency, status])
+  @@index([expectedCloseDate])
+  @@index([closedAt])
+  @@index([mergedIntoOpportunityId])
+}
+
+/// Phase 12 Wave 1 ΓÇö append-only Opportunity stage history (immutable).
+model CrmOpportunityStageHistory {
+  id                 String   @id @default(cuid())
+  opportunityId      String
+  fromStageCode      String?
+  toStageCode        String
+  changedByAdminId   String?
+  reason             String?
+  evidenceReferences Json?
+  idempotencyKey     String?
+  at                 DateTime @default(now())
+  opportunity        CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin     Admin?   @relation("CrmOpportunityStageChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([opportunityId, idempotencyKey])
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+  @@index([toStageCode, at])
+}
+
+/// Phase 12 Wave 2 ΓÇö Opportunity-specific contact roles (Γëá platform permission grant).
+model CrmOpportunityContactRole {
+  id               String   @id @default(cuid())
+  opportunityId    String
+  contactId        String
+  role             String
+  note             String?
+  createdByAdminId String?
+  createdAt        DateTime @default(now())
+  updatedAt        DateTime @updatedAt
+  opportunity      CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  createdByAdmin   Admin?   @relation("CrmOpportunityContactRoleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([opportunityId, contactId, role])
+  @@index([opportunityId, role])
+  @@index([contactId])
+}
+
+/// Phase 12 Wave 2 ΓÇö append-only contact role history.
+model CrmOpportunityContactRoleHistory {
+  id                 String   @id @default(cuid())
+  opportunityId      String
+  contactId          String
+  role               String
+  action             String
+  previousContactId  String?
+  reason             String?
+  changedByAdminId   String?
+  at                 DateTime @default(now())
+  opportunity        CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin     Admin?   @relation("CrmOpportunityContactRoleChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+}
+
+/// Phase 12 Wave 2 ΓÇö non-binding Opportunity product estimate lines.
+model CrmOpportunityProduct {
+  id                 String   @id @default(cuid())
+  opportunityId      String
+  featureCode        String?
+  moduleCode         String?
+  label              String?
+  quantity           Decimal  @default(1) @db.Decimal(18, 4)
+  unitAmountEstimate Decimal? @db.Decimal(18, 2)
+  currency           String?
+  binding            String   @default("NON_BINDING_ESTIMATE")
+  unknownInterest    Boolean  @default(false)
+  note               String?
+  createdByAdminId   String?
+  createdAt          DateTime @default(now())
+  updatedAt          DateTime @updatedAt
+  opportunity        CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  createdByAdmin     Admin?   @relation("CrmOpportunityProductCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([opportunityId, createdAt])
+  @@index([featureCode])
+  @@index([moduleCode])
+}
+
+/// Phase 12 Wave 2 ΓÇö append-only amount history (immutable).
+model CrmOpportunityAmountHistory {
+  id                     String   @id @default(cuid())
+  opportunityId          String
+  amount                 Decimal  @db.Decimal(18, 2)
+  currency               String
+  amountBasis            String
+  recurringAnnualAmount  Decimal? @db.Decimal(18, 2)
+  oneTimeAmount          Decimal? @db.Decimal(18, 2)
+  previousAmount         Decimal? @db.Decimal(18, 2)
+  previousCurrency       String?
+  previousAmountBasis    String?
+  reason                 String?
+  changedByAdminId       String?
+  at                     DateTime @default(now())
+  opportunity            CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin         Admin?   @relation("CrmOpportunityAmountChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+}
+
+/// Phase 12 Wave 2 ΓÇö append-only probability history (immutable; not ML).
+model CrmOpportunityProbabilityHistory {
+  id                   String   @id @default(cuid())
+  opportunityId        String
+  probability          Int
+  source               String
+  confidence           String?
+  previousProbability  Int?
+  stageCode            String?
+  reason               String?
+  approvalStatus       String?
+  isMl                 Boolean  @default(false)
+  isRevenueCertainty   Boolean  @default(false)
+  changedByAdminId     String?
+  at                   DateTime @default(now())
+  opportunity          CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin       Admin?   @relation("CrmOpportunityProbabilityChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+}
+
+/// Phase 12 Wave 2 ΓÇö append-only close-date history (immutable).
+model CrmOpportunityCloseDateHistory {
+  id                         String   @id @default(cuid())
+  opportunityId              String
+  expectedCloseDate          DateTime
+  source                     String
+  confidence                 String
+  previousExpectedCloseDate  DateTime?
+  previousSource             String?
+  previousConfidence         String?
+  reason                     String?
+  forecastEligible           Boolean  @default(false)
+  changedByAdminId           String?
+  at                         DateTime @default(now())
+  opportunity                CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  changedByAdmin             Admin?   @relation("CrmOpportunityCloseDateChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([opportunityId, at])
+  @@index([changedByAdminId])
+  @@index([forecastEligible, expectedCloseDate])
+}
+
+/// Phase 12 Wave 3 ΓÇö Opportunity risk signals (deterministic; Γëá Support/CS health).
+model CrmOpportunityRisk {
+  id               String    @id @default(cuid())
+  opportunityId    String
+  code             String
+  severity         String
+  status           String    @default("OPEN")
+  detail           String?   @db.Text
+  signalSource     String    @default("DETERMINISTIC")
+  evidenceJson     Json?
+  createdByAdminId String?
+  mitigatedAt      DateTime?
+  mitigationNote   String?
+  createdAt        DateTime  @default(now())
+  updatedAt        DateTime  @updatedAt
+  opportunity      CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
+  createdByAdmin   Admin?    @relation("CrmOpportunityRiskCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([opportunityId, code])
+  @@index([opportunityId, status])
+  @@index([severity, status])
+  @@index([createdByAdminId])
+}
+
+/// Phase 12 Wave 4 ΓÇö Opportunity duplicate candidates (never auto-merge).
+model CrmOpportunityDuplicateCandidate {
+  id                      String    @id @default(cuid())
+  opportunityId           String
+  candidateOpportunityId  String
+  matchType               String
+  matchValue              String?
+  status                  String    @default("NEW")
+  confidence              String?
+  reviewedByAdminId       String?
+  reviewedAt              DateTime?
+  decisionReason          String?
+  createdAt               DateTime  @default(now())
+  updatedAt               DateTime  @updatedAt
+  opportunity             CrmOpportunity @relation("CrmOppDupPrimary", fields: [opportunityId], references: [id], onDelete: Cascade)
+  candidateOpportunity    CrmOpportunity @relation("CrmOppDupPeer", fields: [candidateOpportunityId], references: [id], onDelete: Cascade)
+  reviewedByAdmin         Admin?    @relation("CrmOpportunityDuplicateReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([opportunityId, candidateOpportunityId, matchType])
+  @@index([status, createdAt])
+  @@index([opportunityId])
+  @@index([candidateOpportunityId])
+  @@index([reviewedByAdminId])
+}
+
+/// Phase 12 Wave 4 ΓÇö scheduled Pipeline report definitions (audited runs).
+model CrmPipelineReportSchedule {
+  id                String    @id @default(cuid())
+  name              String
+  pipelineCode      String?
+  cronExpression    String?
+  status            String    @default("ACTIVE")
+  createdByAdminId  String?
+  lastRunAt         DateTime?
+  lastRunStatus     String?
+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  createdByAdmin    Admin?    @relation("CrmPipelineReportScheduleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+  runs              CrmPipelineReportRun[]
+
+  @@index([status, createdAt])
+  @@index([pipelineCode])
+  @@index([createdByAdminId])
+}
+
+/// Phase 12 Wave 4 ΓÇö Pipeline report run audit (never invent KPI zeroes).
+model CrmPipelineReportRun {
+  id            String   @id @default(cuid())
+  scheduleId    String?
+  status        String
+  summaryJson   Json?
+  runByAdminId  String?
+  at            DateTime @default(now())
+  schedule      CrmPipelineReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
+  runByAdmin    Admin?   @relation("CrmPipelineReportRunBy", fields: [runByAdminId], references: [id], onDelete: SetNull)
+
+  @@index([at])
+  @@index([scheduleId, at])
+  @@index([status, at])
+  @@index([runByAdminId])
+}

