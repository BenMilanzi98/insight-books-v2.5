+      }
+    } catch {
+      // continue
+    }
+  }
+
+  let callStatus = CRM_CALL_STATUS.COMPLETED;
+  let activityStatus = CRM_ACTIVITY_STATUS.COMPLETED;
+  let consentBlocked = false;
