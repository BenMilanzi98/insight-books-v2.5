+    if (!result.ok) {
+      return NextResponse.json(
+        { success: false, error: result.error || 'Failed to get demo' },
+        { status: result.status === 'UNAVAILABLE' ? 503 : 400 }
+      );
+    }
+
+    return NextResponse.json({ success: true, ...result });
+  } catch (error) {
+    console.error('CRM demo get error:', error);
+    return NextResponse.json(
+      { success: false, error: 'Failed to get CRM demo' },
+      { status: 500 }
+    );
+  }
+}
