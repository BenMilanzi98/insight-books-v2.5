+    expect(scheduled.demo.timezone).toBe('Africa/Blantyre');
+
+    const retry = await scheduleDemo(prisma, {
+      admin,
+      demoId: demo.demo.id,
+      timezone: 'Africa/Blantyre',
+      startsAt: '2026-08-01T10:00:00.000Z',
