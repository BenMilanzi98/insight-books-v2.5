+    const admin = await getAdminFromRequest(request);
+    if (!admin) {
+      return NextResponse.json({ success: false, error: 'Unauthorized' }, { status: 401 });
+    }
+
+    const params = await context.params;
+    const result = await getDemo(prisma, {
+      admin,
+      demoId: params?.id,
+    });
+
+    if (result.forbidden) {
