+    return { ok: false, error: 'script_not_requestable', status: row.status };
+  }
+
+  const now = args.now || new Date();
+  const updated = await prisma.crmDemoScript.update({
+    where: { id: row.id },
+    data: {
+      status: CRM_DEMO_VERSION_STATUS.PENDING_APPROVAL,
