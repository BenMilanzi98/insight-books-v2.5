+    CRM_LEAD_STATUS.ON_HOLD,
+    CRM_LEAD_STATUS.NURTURE,
+    CRM_LEAD_STATUS.DISQUALIFIED,
+  ]),
+  [CRM_LEAD_STATUS.ENGAGED]: Object.freeze([
+    CRM_LEAD_STATUS.QUALIFICATION_IN_PROGRESS,
+    CRM_LEAD_STATUS.ON_HOLD,
+    CRM_LEAD_STATUS.NURTURE,
