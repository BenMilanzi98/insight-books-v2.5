+  createdAt         DateTime  @default(now())
+  updatedAt         DateTime  @updatedAt
+  case              CsCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
+  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+  assigneeAdmin     Admin?    @relation("CsTaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
+  createdByAdmin    Admin?    @relation("CsTaskCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
+
+  @@unique([idempotencyKey])
+  @@index([tenantId, status])
+  @@index([caseId, status])
+  @@index([assigneeAdminId, status])
+  @@index([executionId, stepId])
+}
+
