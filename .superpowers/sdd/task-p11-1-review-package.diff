+    CRM_LEAD_STATUS.ON_HOLD,
+    CRM_LEAD_STATUS.DISQUALIFIED,
+    CRM_LEAD_STATUS.ARCHIVED,
+    // CONVERTED_TO_OPPORTUNITY intentionally omitted ΓÇö Phase 12
+  ]),
+  [CRM_LEAD_STATUS.DISQUALIFIED]: Object.freeze([CRM_LEAD_STATUS.ARCHIVED]),
+  [CRM_LEAD_STATUS.DUPLICATE]: Object.freeze([CRM_LEAD_STATUS.ARCHIVED]),
+  [CRM_LEAD_STATUS.MERGED]: Object.freeze([]),
