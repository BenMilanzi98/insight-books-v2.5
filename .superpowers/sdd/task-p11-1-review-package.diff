+});
+
+export const CRM_LEAD_NUMBER_RE = /^LEAD-\d{4}-\d{6}$/;
+export const CRM_ACCOUNT_NUMBER_RE = /^ACC-\d{4}-\d{6}$/;
+export const CRM_CONTACT_NUMBER_RE = /^CON-\d{4}-\d{6}$/;
