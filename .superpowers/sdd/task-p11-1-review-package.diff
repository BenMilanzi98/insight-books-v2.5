+/**
+ * Concurrency-safe CRM numbering: LEAD|ACC|CON-YYYY-######
+ * Year = UTC calendar year of create time.
+ * Uses CrmNumberSeq with optimistic compare-and-swap (Support numbering pattern).
+ */
+
+import {
+  CRM_ACCOUNT_NUMBER_RE,
+  CRM_CONTACT_NUMBER_RE,
+  CRM_LEAD_NUMBER_RE,
+  CRM_NUMBER_PREFIX,
+} from './catalogue.js';
+
+const MAX_ALLOC_ATTEMPTS = 12;
+const VALID_PREFIXES = new Set(Object.values(CRM_NUMBER_PREFIX));
+
+/**
+ * @param {string} prefix
+ * @param {number} year
+ * @param {number} seq
+ * @returns {string}
+ */
+export function formatCrmNumber(prefix, year, seq) {
+  return `${prefix}-${year}-${String(seq).padStart(6, '0')}`;
+}
+
+/**
+ * @param {Date} [now]
+ * @returns {number}
+ */
+export function utcYearOf(now = new Date()) {
+  return new Date(now).getUTCFullYear();
+}
+
+function hasSeqModel(db) {
+  return typeof db?.crmNumberSeq?.findUnique === 'function';
+}
+
+/**
+ * Allocate next number for prefix + UTC year of `now`.
+ *
+ * @param {import('@prisma/client').PrismaClient|object} prisma
+ * @param {{ prefix: string, now?: Date }} opts
+ * @returns {Promise<{ ok: true, number: string, prefix: string, year: number, sequence: number } | { ok: false, error: string }>}
+ */
+export async function allocateCrmNumber(prisma, opts = {}) {
+  const prefix = String(opts.prefix || '').trim().toUpperCase();
+  const now = opts.now || new Date();
+  const year = utcYearOf(now);
+
+  if (!VALID_PREFIXES.has(prefix)) {
+    return { ok: false, error: 'invalid_crm_number_prefix' };
+  }
+
+  if (!hasSeqModel(prisma)) {
+    return { ok: false, error: 'crm_number_seq_unavailable' };
+  }
+
+  const run = async (tx) => {
+    for (let i = 0; i < MAX_ALLOC_ATTEMPTS; i += 1) {
+      const row = await tx.crmNumberSeq.findUnique({
+        where: { prefix_year: { prefix, year } },
+      });
+
+      if (!row) {
+        try {
+          await tx.crmNumberSeq.create({
+            data: { prefix, year, lastIssued: 1 },
+          });
+          return {
+            ok: true,
+            number: formatCrmNumber(prefix, year, 1),
+            prefix,
+            year,
+            sequence: 1,
+          };
+        } catch (err) {
+          if (err && typeof err === 'object' && err.code === 'P2002') continue;
+          throw err;
+        }
+      }
+
+      const next = row.lastIssued + 1;
+      const res = await tx.crmNumberSeq.updateMany({
+        where: { prefix, year, lastIssued: row.lastIssued },
+        data: { lastIssued: next },
+      });
+      if (res.count === 1) {
+        return {
+          ok: true,
+          number: formatCrmNumber(prefix, year, next),
+          prefix,
+          year,
+          sequence: next,
+        };
+      }
+    }
+    return { ok: false, error: 'crm_number_allocation_failed' };
+  };
+
+  if (typeof prisma.$transaction === 'function') {
+    return prisma.$transaction(run);
+  }
+  return run(prisma);
+}
+
+export {
+  CRM_LEAD_NUMBER_RE,
+  CRM_ACCOUNT_NUMBER_RE,
+  CRM_CONTACT_NUMBER_RE,
+};
diff --git "a/lib\\admin\\crm\\stateMachine.js" "b/lib\\admin\\crm\\stateMachine.js"
new file mode 100644
index 0000000..e2c35f1
--- /dev/null
+++ "b/lib\\admin\\crm\\stateMachine.js"
@@ -0,0 +1,95 @@
+/**
+ * CRM Lead status state machine (Phase 11 Wave 1).
+ * Invalid transitions return { ok: false, error: 'INVALID_TRANSITION' } ΓÇö never silent coerce.
+ * CONVERTED_TO_OPPORTUNITY is blocked in Wave 1 (Phase 12).
+ */
+
+import { CRM_LEAD_STATUS, CRM_TRANSITION_TABLE } from './catalogue.js';
+
+/**
+ * @param {string} from
+ * @param {string} to
+ * @returns {boolean}
+ */
+export function canTransition(from, to) {
+  const f = String(from || '').toUpperCase();
+  const t = String(to || '').toUpperCase();
+  if (t === CRM_LEAD_STATUS.CONVERTED_TO_OPPORTUNITY) return false;
+  const allowed = CRM_TRANSITION_TABLE[f];
+  if (!allowed) return false;
+  return allowed.includes(t);
+}
+
+/**
+ * Assert a Lead status transition with contextual rules.
+ *
+ * @param {string} from
+ * @param {string} to
+ * @param {{
+ *   disqualificationReason?: string|null,
+ *   reason?: string|null,
+ * }} [ctx]
+ * @returns {{ ok: true, from: string, to: string } | { ok: false, error: string, from: string, to: string, reason?: string }}
+ */
+export function assertTransition(from, to, ctx = {}) {
+  const f = String(from || '').toUpperCase();
+  const t = String(to || '').toUpperCase();
+
+  if (!f || !t) {
+    return {
+      ok: false,
+      error: 'INVALID_TRANSITION',
+      from: f,
+      to: t,
+      reason: 'from_and_to_required',
+    };
+  }
+
+  if (f === t) {
+    return {
+      ok: false,
+      error: 'INVALID_TRANSITION',
+      from: f,
+      to: t,
+      reason: 'same_status',
+    };
+  }
+
+  if (t === CRM_LEAD_STATUS.CONVERTED_TO_OPPORTUNITY) {
+    return {
+      ok: false,
+      error: 'NOT_IMPLEMENTED',
+      from: f,
+      to: t,
+      reason: 'converted_to_opportunity_phase_12',
+    };
+  }
+
+  if (!canTransition(f, t)) {
+    return {
+      ok: false,
+      error: 'INVALID_TRANSITION',
+      from: f,
+      to: t,
+      reason: 'not_in_transition_table',
+    };
+  }
+
+  if (t === CRM_LEAD_STATUS.DISQUALIFIED) {
+    const dq =
+      ctx.disqualificationReason != null
+        ? String(ctx.disqualificationReason).trim()
+        : '';
+    if (!dq) {
+      return {
+        ok: false,
+        error: 'INVALID_TRANSITION',
+        from: f,
+        to: t,
+        reason: 'disqualificationReason_required',
+      };
+    }
+  }
+
+  return { ok: true, from: f, to: t };
+}
