+          rows = rows.filter((r) =>
+            where.OR.some((clause) => {
+              if (clause.id) return r.id === clause.id;
+              if (clause.leadNumber) return r.leadNumber === clause.leadNumber;
+              return false;
+            })
+          );
+        }
+        return rows[0] || null;
+      }),
+      create: vi.fn(async ({ data }) => {
