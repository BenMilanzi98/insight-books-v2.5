diff --git a/scripts/ci-write-build-manifest.mjs b/scripts/ci-write-build-manifest.mjs
new file mode 100644
index 00000000..6fcc78d5
--- /dev/null
+++ b/scripts/ci-write-build-manifest.mjs
@@ -0,0 +1,22 @@
+import fs from 'fs';
+import path from 'path';
+
+const outDir = path.join(process.cwd(), '.next');
+if (!fs.existsSync(outDir)) {
+  console.error('ci-write-build-manifest: .next missing ΓÇö run build first');
+  process.exit(1);
+}
+
+const sha = process.env.GITHUB_SHA || process.env.GIT_SHA || '';
+const ref = process.env.GITHUB_REF_NAME || process.env.GITHUB_REF || '';
+const manifest = {
+  gitSha: sha,
+  gitRef: ref,
+  nodeVersion: process.version,
+  builtAt: new Date().toISOString(),
+  nextBuildId: 'build',
+};
+
+const dest = path.join(outDir, 'ci-build-manifest.json');
+fs.writeFileSync(dest, JSON.stringify(manifest, null, 2) + '\n');
+console.log('Wrote', dest);
