{
  "name": "insite_books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && cross-env NODE_ENV=development next dev -p 3000",
    "build": "prisma generate && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "build:clean": "rimraf .next && prisma generate && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint . --max-warnings 999",
    "lint:next": "next lint",
    "test": "vitest run",
    "test:pr-fast": "vitest run test/qa test/securityGovernance.engine.test.js test/loanReadiness.engine.test.js test/financialPlanning.engine.test.js test/authz.test.js test/performanceReliability.engine.test.js test/productionCutover.engine.test.js",
    "test:qa": "vitest run test/qa",
    "test:invariants": "vitest run test/qa/invariants test/qa/regression test/qa/architecture test/qa/golden",
    "test:integration": "vitest run test/accountingV2.postingEngine.test.js test/accountingV2.ledger.test.js test/accountingV2.reports.test.js test/bankReconciliation.domain.test.js test/equityManagement.domain.test.js test/accountingClose.domain.test.js",
    "test:nightly": "vitest run",
    "test:rc": "npm run test:pr-fast && npm run test:qa",
    "qa:certify": "node scripts/qa-release-certification.cjs",
    "test:mra-eis": "vitest run test/mraEis",
    "test:mra-eis:phase20": "vitest run test/mraEis.phase20.releaseReadiness.test.js",
    "test:mra-eis:phase21": "vitest run test/mraEis.phase21.rollout.test.js",
    "mra-eis:release-gate": "node scripts/mra-eis-phase20-release-gate.js",
    "mra-eis:secret-scan": "node scripts/mra-eis-phase20-release-gate.js --secrets-only",
    "mra-eis:phase21-status": "node scripts/mra-eis-phase21-programme-status.js",
    "test:perf": "vitest run test/performanceReliability.engine.test.js test/qa/performance",
    "perf:load-smoke": "node scripts/perf-load-smoke.cjs",
    "perf:capacity-report": "node scripts/perf-capacity-report.cjs",
    "test:cutover": "vitest run test/productionCutover.engine.test.js",
    "cutover:inventory": "node scripts/cutover-inventory.cjs",
    "cutover:manifest": "node scripts/cutover-manifest.cjs",
    "cutover:diagnostics": "node scripts/cutover-diagnostics.cjs",
    "cutover:control-totals": "node scripts/cutover-control-totals.cjs",
    "db:seed:coa": "ts-node prisma/seed/chartOfAccountsSeed.ts",
    "setup-admin": "node scripts/setup-admin.js",
    "sync-accounts": "node scripts/sync-existing-data-to-accounts.js",
    "create-test-data": "node scripts/create-test-data.js",
    "delete-test-data": "node scripts/delete-test-data.js",
    "delete-test-data:dry-run": "node scripts/delete-test-data.js --dry-run",
    "verify:accounting-scenario": "node scripts/verify-accounting-scenario.cjs",
    "backfill:legacy-gl": "node scripts/backfill-legacy-gl.cjs",
    "backfill:paychangu-ledger": "node scripts/paychangu-ledger-backfill.mjs",
    "backfill:paychangu-ledger:execute": "node scripts/paychangu-ledger-backfill.mjs --execute --max=50",
    "test:phase1": "node scripts/test-phase1-validation.js",
    "fix:orphaned-transactions": "node scripts/fix-orphaned-transactions.js",
    "fix:orphaned-transactions:dry-run": "node scripts/fix-orphaned-transactions.js --dry-run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:production": "prisma db push --accept-data-loss=false && prisma generate",
    "db:studio": "prisma studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:supabase-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-local-start-and-restore.ps1",
    "db:restore-data": "node scripts/restore-data-from-dump.js",
    "migrate:payment-accounts": "node scripts/migrate-payment-accounts.js",
    "validate:expense-categories": "node scripts/validate-expense-categories.js",
    "validate:data-integrity": "node scripts/validate-data-integrity.js",
    "validate:quick": "node scripts/quick-validation.js",
    "verify-system": "node scripts/verify-system.js",
    "seed:roles": "node scripts/seed-default-roles.js",
    "normalize:expenses": "node scripts/normalize-expense-categories.js",
    "backfill:cogs-expense-links": "node scripts/backfill-cogs-expense-links.js",
    "consolidate-salary-accounts": "node scripts/consolidate-salary-accounts.js",
    "consolidate-salary-accounts:dry-run": "node scripts/consolidate-salary-accounts.js --dry-run",
    "audit:accounting-mapping": "node scripts/audit-accounting-mapping.js",
    "remap:accounting-mappings": "node scripts/remap-accounting-mappings.js",
    "coa:snapshot": "node scripts/coa-snapshot-export.cjs",
    "audit:gl": "node scripts/audit-gl.cjs",
    "audit:rbac": "node scripts/rbac-audit.js",
    "audit:forensic": "node scripts/accounting-forensic-audit.mjs",
    "audit:forensic:journals": "node scripts/accounting-forensic-audit.mjs --module journals",
    "audit:forensic:ledger": "node scripts/accounting-forensic-audit.mjs --module ledger",
    "audit:forensic:trial-balance": "node scripts/accounting-forensic-audit.mjs --module trial-balance",
    "audit:forensic:receivables": "node scripts/accounting-forensic-audit.mjs --module ar-ap,sources",
    "audit:forensic:payables": "node scripts/accounting-forensic-audit.mjs --module ar-ap,sources",
    "audit:forensic:periods": "node scripts/accounting-forensic-audit.mjs --module periods",
    "audit:forensic:capital": "node scripts/accounting-forensic-audit.mjs --module capital",
    "audit:forensic:reversals": "node scripts/accounting-forensic-audit.mjs --module reversals",
    "audit:forensic:coa": "node scripts/accounting-forensic-audit.mjs --module coa",
    "audit:forensic:coa-v2": "node scripts/accounting-forensic-audit.mjs --module coa-v2",
    "coa:classify": "node scripts/coa-v2-governance.mjs classify",
    "coa:classify:apply": "node scripts/coa-v2-governance.mjs classify --apply",
    "coa:duplicates": "node scripts/coa-v2-governance.mjs duplicates",
    "coa:readiness": "node scripts/coa-v2-governance.mjs readiness",
    "coa:salary-audit": "node scripts/coa-v2-governance.mjs salary-audit",
    "coa:seed-templates": "node scripts/coa-v2-governance.mjs seed-templates",
    "coa:governance": "node scripts/coa-v2-governance.mjs all"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
