{
  "name": "insite_books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -p 3000",
    "build": "cross-env NODE_ENV=production next build",
    "build:clean": "rimraf .next && cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:seed:coa": "ts-node prisma/seed/chartOfAccountsSeed.ts",
    "setup-admin": "node scripts/setup-admin.js",
    "sync-accounts": "node scripts/sync-existing-data-to-accounts.js",
    "create-test-data": "node scripts/create-test-data.js",
    "delete-test-data": "node scripts/delete-test-data.js",
    "test:phase1": "node scripts/test-phase1-validation.js",
    "fix:orphaned-transactions": "node scripts/fix-orphaned-transactions.js",
    "fix:orphaned-transactions:dry-run": "node scripts/fix-orphaned-transactions.js --dry-run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:production": "prisma db push --accept-data-loss=false && prisma generate",
    "db:studio": "prisma studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:supabase-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-local-start-and-restore.ps1",
    "db:restore-data": "node scripts/restore-data-from-dump.js",
    "migrate:payment-accounts": "node scripts/migrate-payment-accounts.js",
    "validate:expense-categories": "node scripts/validate-expense-categories.js",
    "validate:data-integrity": "node scripts/validate-data-integrity.js",
    "validate:quick": "node scripts/quick-validation.js",
    "verify-system": "node scripts/verify-system.js",
    "seed:roles": "node scripts/seed-default-roles.js",
    "normalize:expenses": "node scripts/normalize-expense-categories.js",
    "consolidate-salary-accounts": "node scripts/consolidate-salary-accounts.js",
    "consolidate-salary-accounts:dry-run": "node scripts/consolidate-salary-accounts.js --dry-run",
    "coa:snapshot": "node scripts/coa-snapshot-export.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@madrimov/electron-pos-printer": "^1.0.0",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/pg": "^8.11.11",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.2.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.477.0",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.25",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.5",
    "pg": "^8.14.1",
    "postgres": "^3.4.5",
    "puppeteer": "^24.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-to-print": "^3.1.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.2.0",
    "tesseract.js": "^6.0.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/dotenv": "^6.1.1",
    "@types/react": "19.1.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.3",
    "prisma": "^6.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.0.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}
