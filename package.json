    "@types/dotenv": "^6.1.1",
    "@types/react": "19.1.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "jiti": "^2.4.2",
    "postcss": "^8.5.3",
    "prisma": "^6.8.1",
