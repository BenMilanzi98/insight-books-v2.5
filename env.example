DATABASE_URL="postgresql://henmik:Password2030@localhost:5432/insightbooks?schema=public"
# Supabase local (run: supabase start — then uncomment and run scripts/supabase-migrate.sh)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# Supabase cloud: use your project's connection string from Dashboard → Settings → Database
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"
# SHADOW_DATABASE_URL (for Prisma migrations - same as DATABASE_URL)
SHADOW_DATABASE_URL="postgresql://henmik:Password2030@localhost:5432/insightbooks?schema=public"
MIDDLEWARE_RUNTIME=nodejs

#NEXT_PUBLIC_ROOT_DOMAIN="insight-books.vercel.app"
#NEXT_PUBLIC_APP_URL="https://insight-books.vercel.app"

# Email Configuration
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT=465
EMAIL_USER="noreply@insightbooksafrica.com"
#EMAIL_PASSWORD="H*Yfa/pV]c1"
EMAIL_PASSWORD="your-email-password-he.e"
EMAIL_FROM="InsightBooks <noreply@insightbooksafrica.com>"
EMAIL_SECURE=true

# JWT/Session Secret
SESSION_SECRET="your-secure-session-secret-key-change-this-in-production"

# Application Settings
NODE_ENV=production  # Change to "production" in production environment
# On production, set both to your public HTTPS URL (e.g. https://development.insightbooksafrica.com).
# If APP_URL is an IP or different domain, login redirects and session cookies may not match the browser origin and you'll get 401s.
APP_URL="http://localhost:3000"  # Base URL of your application
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Same as APP_URL in production; used for client-side links

# Browser console logs (client-side). Optional override:
#   unset  → enabled in development, disabled in production
#   true   → always show console logs in the browser
#   false  → never show console logs in the browser
# NEXT_PUBLIC_CLIENT_CONSOLE_LOGS=false


# Android App Center integration (PHP center hosted at https://app.insightinnovationsltd.com)
# Must match android-app-center/.env MAIN_SYSTEM_API_KEY and MAIN_SYSTEM_SHARED_SECRET.
MOBILE_APP_CENTER_API_KEY="replace-with-android-app-center-main-system-api-key"
MOBILE_APP_CENTER_SHARED_SECRET="replace-with-android-app-center-main-system-shared-secret"
APK_CENTER_ADMIN_URL="https://app.insightinnovationsltd.com/admin/dashboard.php"
NEXT_PUBLIC_APK_CENTER_ADMIN_URL="https://app.insightinnovationsltd.com/admin/dashboard.php"

# You can generate a secret key using: openssl rand -base64 32
PAYCHANGU_SECRET_KEY="sec-test-your-secret-key-here"
# APP_URL="https://insightbooksmw.com"
CRON_SECRET="your-cron-secret-here"


# Google OAuth Configuration - Replace with your own credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI=https://insightbooksafrica.com/api/auth/google/callback
# Required in production for JWTs: at least 16 characters (admin, affiliate, registration).
# If JWT_SECRET is unset, SESSION_SECRET (also 16+ chars) is used as a fallback for signing/verify.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# MRA EIS Configuration
EIS_API_BASE_URL=https://dev-eis-api.mra.mw
EIS_ENVIRONMENT=sandbox
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change

# Phase 6 — EIS credential envelope master key (NEVER commit real values; 64 hex chars preferred)
# Separate from ENCRYPTION_KEY / JWT_SECRET / SESSION_SECRET.
# Generate: openssl rand -hex 32
# MRA_EIS_MASTER_KEY_v1=
# MRA_EIS_MASTER_KEY=
# EIS_CREDENTIAL_MASTER_KEY=
# MRA_EIS_DEPLOYMENT_ENV=development
# Tests only:
# MRA_EIS_ALLOW_TEST_MASTER_KEY=1
# MRA_EIS_TEST_MASTER_KEY=

# Phase 7 — terminal activation (server-only; never NEXT_PUBLIC_)
# MRA_EIS_ACTIVATION_MODE=MOCK
# MRA_EIS_PRODUCT_ID=IB-EIS-MOCK
# MRA_EIS_PRODUCT_VERSION=0.0.0-mock
# MRA_EIS_INSTALLATION_ID=insightbooks-local-installation
# MRA_EIS_SANDBOX_BASE_URL=
# MRA_EIS_PRODUCTION_BASE_URL=

# Phase 8 — configuration sync (server-only)
# MRA_EIS_BOD_TIMEZONE=Africa/Blantyre
# MRA_EIS_CONFIG_SAFE_MAX_AGE_MS=86400000
# MRA_EIS_CONFIG_REFRESH_DUE_MS=72000000

# Phase 17 — deep health diagnostics (optional)
# PERF_HEALTH_TOKEN=

# Phase 18 — cutover controls (off | maintenance | readonly | write_freeze)
# CUTOVER_MODE=off
# CUTOVER_MESSAGE=InsightBooks is in maintenance for production cutover.
# CUTOVER_OPS_TOKEN=
