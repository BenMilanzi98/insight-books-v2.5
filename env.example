DATABASE_URL="postgresql://henmik:Password2030@localhost:5432/insightbooks?schema=public"
# Supabase local (run: supabase start — then uncomment and run scripts/supabase-migrate.sh)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# Supabase cloud: use your project's connection string from Dashboard → Settings → Database
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"
# SHADOW_DATABASE_URL (for Prisma migrations - same as DATABASE_URL)
SHADOW_DATABASE_URL="postgresql://henmik:Password2030@localhost:5432/insightbooks?schema=public"
MIDDLEWARE_RUNTIME=nodejs

#NEXT_PUBLIC_ROOT_DOMAIN="insight-books.vercel.app"
#NEXT_PUBLIC_APP_URL="https://insight-books.vercel.app"

# Email Configuration
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT=465
EMAIL_USER="noreply@insightbooksafrica.com"
#EMAIL_PASSWORD="H*Yfa/pV]c1"
EMAIL_PASSWORD="your-email-password-here"
EMAIL_FROM="InsightBooks <noreply@insightbooksafrica.com>"
EMAIL_SECURE=true

# JWT/Session Secret
SESSION_SECRET="your-secure-session-secret-key-change-this-in-production"

# Application Settings
NODE_ENV=production  # Change to "production" in production environment
# On production, set both to your public HTTPS URL (e.g. https://development.insightbooksafrica.com).
# If APP_URL is an IP or different domain, login redirects and session cookies may not match the browser origin and you'll get 401s.
APP_URL="http://localhost:3000"  # Base URL of your application
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Same as APP_URL in production; used for client-side links

# You can generate a secret key using: openssl rand -base64 32
PAYCHANGU_SECRET_KEY="sec-test-your-secret-key-here"
# APP_URL="https://insightbooksmw.com"
CRON_SECRET="your-cron-secret-here"


# Google OAuth Configuration - Replace with your own credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI=https://insightbooksafrica.com/api/auth/google/callback
# Required in production: at least 16 characters (admin, affiliate, and registration JWTs).
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# MRA EIS Configuration
EIS_API_BASE_URL=https://dev-eis-api.mra.mw
EIS_ENVIRONMENT=sandbox
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change
