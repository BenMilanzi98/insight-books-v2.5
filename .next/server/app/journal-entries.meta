{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/journal-entries/layout,_N_T_/journal-entries/page,_N_T_/journal-entries"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/journal-entries/__PAGE__",
    "/journal-entries",
    "/_index",
    "/_head"
  ]
}